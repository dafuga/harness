{
	"name": "relay",
	"version": "0.1.0",
	"type": "module",
	"harness": {
		"kind": "lib"
	},
	"scripts": {
		"build": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-coding} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun build src/index.ts --target browser --format esm --external cloudflare:workers --outdir dist \"$@\"' --",
		"check": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun run format:check && bun run typecheck && bun run lint && bun run test && bun run build && bun run audit \"$@\"' --",
		"typecheck": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'tsc --noEmit \"$@\"' --",
		"format:check": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'prettier --check . \"$@\"' --",
		"format": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-coding} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'prettier --write . \"$@\"' --",
		"lint": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-coding} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'eslint . \"$@\"' --",
		"audit": "bun scripts/harness-audit.ts",
		"test": "bun run test:unit",
		"test:unit": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'vitest run \"$@\"' --"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.1",
		"@types/bun": "^1.2.18",
		"@typescript-eslint/eslint-plugin": "^8.31.1",
		"@typescript-eslint/parser": "^8.31.1",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.2",
		"prettier": "^3.5.3",
		"typescript": "^5.8.3",
		"vitest": "^3.1.2",
		"miniflare": "5.20261006.1-alpha",
		"esbuild": "0.28.2",
		"@cloudflare/workers-types": "4.20260702.1",
		"@types/node": "22.19.17",
		"ws": "8.21.0",
		"@types/ws": "8.18.1"
	}
}
