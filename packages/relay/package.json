{
	"name": "relay",
	"version": "0.1.0",
	"type": "module",
	"harness": {
		"kind": "lib"
	},
	"scripts": {
		"build": "bun build src/index.ts --target browser --format esm --external cloudflare:workers --outdir dist",
		"check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run build && bun run audit",
		"typecheck": "tsc --noEmit",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"lint": "eslint .",
		"audit": "bun scripts/harness-audit.ts",
		"test": "bun run test:unit",
		"test:unit": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.1",
		"@types/bun": "^1.2.18",
		"@typescript-eslint/eslint-plugin": "^8.31.1",
		"@typescript-eslint/parser": "^8.31.1",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.2",
		"prettier": "^3.5.3",
		"typescript": "^5.8.3",
		"vitest": "^3.1.2",
		"miniflare": "5.20261006.1-alpha",
		"esbuild": "0.28.2",
		"@cloudflare/workers-types": "4.20260702.1",
		"@types/node": "22.19.17",
		"ws": "8.21.0",
		"@types/ws": "8.18.1"
	}
}
