{
	"name": "harness-relay-development",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-12",
	"vars": { "HARNESS_ENVIRONMENT": "local", "HARNESS_RELAY_ALLOWED_ORIGINS": "" },
	"durable_objects": {
		"bindings": [{ "name": "REMOTE_HOSTS", "class_name": "RemoteHostObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RemoteHostObject"] }]
}
