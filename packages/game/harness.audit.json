{
	"limits": {
		"maxFileLines": 220,
		"maxFunctionLines": 55,
		"maxClassLines": 120,
		"maxMethodLines": 35,
		"maxNestingDepth": 4,
		"maxParameters": 4,
		"maxComplexity": 10,
		"maxClassesPerFile": 1
	},
	"ignore": [
		{
			"path": "test/examples/",
			"reason": "Phase 4 recorded contract example tests; their layout is set by the example recorder, not the game library scaffold."
		}
	],
	"cleanCode": {
		"mode": "off",
		"model": "jev-1.13.0",
		"minConfidence": 0.85,
		"apiKeyEnv": "HARNESS_JEV_API_KEY",
		"exclude": []
	}
}
