# Dedicated to this Harness Hub environment. Copy to .dev.vars for Wrangler local development.
# Leave provider values empty until the matching registrations exist. No credentials are tracked.
HARNESS_PUBLIC_ORIGIN=http://127.0.0.1:5798
HARNESS_ENVIRONMENT=local
HARNESS_GOOGLE_CLIENT_ID=
HARNESS_SESSION_SECRET=
HARNESS_GITHUB_APP_ID=
HARNESS_GITHUB_PRIVATE_KEY=
HARNESS_GITHUB_CLIENT_ID=
HARNESS_GITHUB_CLIENT_SECRET=
HARNESS_COLLABORATION_OWNER=
HARNESS_COLLABORATION_REPO=
HARNESS_COLLABORATION_REPOSITORY_ID=
HARNESS_COLLABORATION_INSTALLATION_ID=
# Optional Resend delivery for proving Google accounts with third-party email addresses.
HARNESS_EMAIL_API_KEY=
HARNESS_EMAIL_FROM=
