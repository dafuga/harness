{
	"name": "harness-hub-development",
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["nodejs_compat"],
	"vars": { "HARNESS_ENVIRONMENT": "local", "HARNESS_PUBLIC_ORIGIN": "http://127.0.0.1:5798" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "harness-hub-development",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "db/migrations"
		}
	],
	"r2_buckets": [{ "binding": "CACHE", "bucket_name": "harness-hub-development-cache" }]
}
