{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"types": ["@cloudflare/workers-types", "node"]
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		"src/**/*.ts",
		"src/**/*.svelte",
		"test/**/*.ts",
		"scripts/**/*.ts",
		"db/**/*.ts"
	]
}
