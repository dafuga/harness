{
	"limits": {
		"maxFileLines": 220,
		"maxFunctionLines": 55,
		"maxClassLines": 120,
		"maxMethodLines": 35,
		"maxNestingDepth": 4,
		"maxParameters": 4,
		"maxComplexity": 10,
		"maxClassesPerFile": 1
	},
	"ignore": [
		{
			"path": "ios/App/App/public/",
			"reason": "Copy of the built renderer that cap sync places in the native project; generated, ignored by Git, and audited as source under src/."
		}
	],
	"cleanCode": {
		"mode": "off",
		"model": "jev-1.13.0",
		"minConfidence": 0.85,
		"apiKeyEnv": "HARNESS_JEV_API_KEY",
		"exclude": []
	}
}
