{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"test/**/*.ts",
		"tests/**/*.ts",
		"db/**/*.ts",
		"scripts/**/*.ts",
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts"
	]
}
