{
	"name": "desktop",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"harness": {
		"kind": "app"
	},
	"scripts": {
		"dev": "bun run sync:shared && bun ../reports/src/initializers/initializePreview.ts --port 5799",
		"build": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-coding} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun run sync:shared && vite build && bun run build:main \"$@\"' --",
		"sync:shared": "bun run --cwd ../reports svelte-kit sync",
		"build:main": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-coding} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun scripts/build-main.ts \"$@\"' --",
		"build:mobile": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-coding} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun run sync:shared && BUILD_TARGET=mobile vite build \"$@\"' --",
		"cap:sync": "bun run build:mobile && cap sync ios",
		"cap:open:ios": "cap open ios",
		"ios:build:simulator": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-coding} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun scripts/build-ios-simulator.ts \"$@\"' --",
		"ios:check:vectors": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun scripts/check-ios-vectors.ts \"$@\"' --",
		"ios:check:native": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun scripts/check-ios-native.ts \"$@\"' --",
		"desktop": "bun scripts/start-electron.ts",
		"package:mac": "bun scripts/package-mac.ts",
		"check": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun run format:check && bun run typecheck && bun run lint && bun run test && bun run build && bun run audit && bun run ios:check:limits \"$@\"' --",
		"typecheck": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'svelte-kit sync && svelte-check --tsconfig ./tsconfig.json \"$@\"' --",
		"format:check": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'prettier --check . \"$@\"' --",
		"format": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-coding} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'prettier --write . \"$@\"' --",
		"lint": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-coding} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'svelte-kit sync && eslint . \"$@\"' --",
		"audit": "bun scripts/harness-audit.ts",
		"test": "bun run test:unit",
		"test:unit": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun run sync:shared && vitest run \"$@\"' --",
		"test:e2e": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'playwright test --project=chromium \"$@\"' --",
		"test:native": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'playwright test --project=native \"$@\"' --",
		"remote:fixture": "bun run sync:shared && vite-node scripts/remote-fixture.ts",
		"ios:check:limits": "bun ../../src/index.ts resources run --priority ${HARNESS_RESOURCE_PRIORITY:-agent-test} --cpus ${HARNESS_RESOURCE_CPUS:-1} --memory-mib ${HARNESS_RESOURCE_MEMORY_MIB:-2048} -- sh -c 'bun scripts/check-ios-limits.ts \"$@\"' --",
		"ios:acceptance": "bun run sync:shared && vite-node scripts/ios-acceptance.ts"
	},
	"dependencies": {
		"@capacitor/core": "7.4.5",
		"@decartai/sdk": "0.2.12",
		"@xyflow/svelte": "1.4.1",
		"jsonc-parser": "^3.3.1",
		"qrcode": "1.5.4",
		"smol-toml": "^1.9.1",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@capacitor/cli": "7.4.5",
		"@capacitor/ios": "7.4.5",
		"@playwright/test": "^1.28.1",
		"@eslint/js": "^9.25.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "^2.16.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@typescript-eslint/eslint-plugin": "^8.31.1",
		"@typescript-eslint/parser": "^8.31.1",
		"eslint": "^9.25.1",
		"electron": "44.7.0",
		"@types/node": "^24.3.1",
		"prettier-plugin-svelte": "^3.4.0",
		"eslint-plugin-svelte": "^3.0.0",
		"svelte-eslint-parser": "^1.0.0",
		"globals": "^16.0.0",
		"eslint-config-prettier": "^10.1.2",
		"prettier": "^3.5.3",
		"svelte-check": "^4.0.0",
		"svelte": "^5.0.0",
		"typescript": "^5.8.3",
		"vite": "^6.2.5",
		"vitest": "^3.1.2",
		"@types/ws": "8.18.1",
		"vite-node": "3.2.4",
		"appium-remote-debugger": "17.5.11",
		"@types/qrcode": "1.5.6",
		"jsqr": "1.4.0"
	},
	"main": "dist/main.cjs"
}
