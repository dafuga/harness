{
	"name": "@dafuga01/harness-reports",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"harness": {
		"kind": "app"
	},
	"scripts": {
		"dev": "BODY_SIZE_LIMIT=110M vite dev --host 127.0.0.1 --port 5588",
		"build": "vite build && vite build --config src/config/reportViteConfig.ts",
		"check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run build && bun run audit",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"lint": "svelte-kit sync && eslint .",
		"audit": "bun ../../src/index.ts audit . --profile app",
		"test": "bun run test:unit",
		"test:unit": "vitest run",
		"test:e2e": "PROJECT_REPORTS_ASSET_STORAGE=local playwright test",
		"report": "bun src/cli/index.ts",
		"test:all": "bun run test:unit && bun run test:e2e"
	},
	"devDependencies": {
		"@playwright/test": "^1.28.1",
		"@eslint/js": "^9.25.1",
		"@sveltejs/kit": "^2.16.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@typescript-eslint/eslint-plugin": "^8.31.1",
		"@typescript-eslint/parser": "^8.31.1",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.2",
		"prettier": "^3.5.3",
		"svelte-check": "^4.0.0",
		"svelte": "^5.0.0",
		"typescript": "^5.8.3",
		"vite": "^6.2.5",
		"vitest": "^3.1.2",
		"@sveltejs/adapter-node": "^5.2.12",
		"@types/node": "^24.3.1",
		"bun-types": "^1.2.21",
		"tailwindcss": "^3.4.17",
		"postcss": "^8.4.31",
		"autoprefixer": "^10.4.16",
		"prettier-plugin-svelte": "^3.4.0",
		"eslint-plugin-svelte": "^3.0.0",
		"svelte-eslint-parser": "^1.0.0",
		"globals": "^16.0.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1138.0",
		"svelte-i18n": "^4.0.1"
	}
}
