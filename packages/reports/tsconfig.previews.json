{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": {
			"$desktop": [
				"./.svelte-kit/../../desktop/src"
			],
			"$desktop/*": [
				"./.svelte-kit/../../desktop/src/*"
			],
			"$shared": [
				"./.svelte-kit/../src/components"
			],
			"$shared/*": [
				"./.svelte-kit/../src/components/*"
			],
			"$lib": [
				"./.svelte-kit/../src/lib"
			],
			"$lib/*": [
				"./.svelte-kit/../src/lib/*"
			],
			"$app/types": [
				"./.svelte-kit/types/index.d.ts"
			]
		}
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		"src/lib/atoms/*.d.ts",
		"tests/e2e/support/component-previews/**/*.ts",
		"tests/e2e/support/component-previews/**/*.svelte",
		"tests/e2e/support/shell/catalogEntry.ts",
		"tests/e2e/support/shell/hubPaths.ts"
	]
}
