	"bugClass": {
		"id": "transient-call-ends-poll",
		"title": "Transient service failures end polling prematurely",
		"cause": "Polling treats a failed service call caused by temporary unavailability or no response as a terminal result instead of retrying within a bounded wait. A refusal or other definitive response may still terminate polling.",
		"criteria": "Include a site when a polling or wait loop can end, fail cleanup, skip subsequent checks, or lose a result after a transient service-call failure without bounded retry. Each mechanism qualifies independently: a call that the service never answered is treated as terminal, or a refusal is treated as retryable when it should be terminal.",
