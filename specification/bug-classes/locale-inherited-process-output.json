	"bugClass": {
		"id": "locale-inherited-process-output",
		"title": "Child process inherits an incompatible locale",
		"cause": "A child process emits locale-dependent text while the consuming parser or identity comparison assumes a fixed locale, causing timestamp parsing or process ownership checks to misinterpret output.",
		"criteria": "Classify another site when either (1) a spawned process inherits the parent locale and emits human-formatted timestamps or identities consumed by code expecting a fixed locale, or (2) parsing/comparison logic assumes a C/English representation without enforcing that locale in the child environment. Either path qualifies independently.",
