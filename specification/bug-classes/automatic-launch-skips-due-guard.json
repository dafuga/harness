	"bugClass": {
		"id": "automatic-launch-skips-due-guard",
		"title": "Automatic launch starts future-due tasks",
		"cause": "An automatic launch, claim, reservation, recovery, resumption, or final startup path can proceed without enforcing the task’s due-time eligibility check, allowing work scheduled for the future to start early. Manual starts may intentionally bypass this guard.",
		"criteria": "Include a site if any unattended path can request, claim, reserve, recover, resume, or finally start scheduled work without checking that its due time has arrived. Each path is independently sufficient. Exclude cases where the due check is enforced before automatic dispatch and only explicit manual starts bypass it.",
