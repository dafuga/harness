	"bugClass": {
		"id": "remote-local-store-mismatch",
		"title": "Browser actions target a disabled local store",
		"cause": "A feature reads from or writes to a local snapshot or Hub-backed API even though production state is served through a linked remote connection and the local snapshot endpoint is disabled. The UI can display remote data while actions against the local store fail or appear missing.",
		"criteria": "Match when a browser-facing read or write depends on a local snapshot or Hub API that is disabled or unavailable in production, while the feature's data is sourced through a separate remote connection. Either an action is routed to the local store instead of the remote service, or a read checks the local store instead of the remote source; either path can independently cause the failure.",
