			"title": "One state before and after a change, side by side",
			"coverage": "required"
		},
		{
			"id": "removed",
			"title": "A removed unit inspected in a comparison",
			"coverage": "required"
		},
		{
			"id": "history",
			"title": "Records of a verified commit",
			"coverage": "required"
		},
		{
			"id": "media",
			"title": "Recorded screenshots and audio of one record",
			"coverage": "required"
		},
		{
			"id": "rejected",
			"title": "A rejected stale capture in the viewer",
			"coverage": "required"
		},
		{
			"id": "gap",
			"title": "A commit with no verification record",
			"coverage": "required"
		},
		{
			"id": "growth",
			"title": "Growth and timings of one component",
			"coverage": "required"
		},
		{
			"id": "unavailable",
			"title": "Component whose complexity is not counted: unavailable and not frozen",
			"coverage": "required"
		},
		{
			"id": "partial",
			"title": "Component with counted and uncounted code: a partial complexity",
			"coverage": "required"
		},
		{
			"id": "unavailable-growth",
			"title": "Growth of a component whose complexity is not counted",
			"coverage": "required"
		},
		{
			"id": "hundreds",
			"title": "A map of several hundred generated units with one selected",
			"coverage": "required"
		}
	],
	"viewports": [
		{
			"id": "desktop",
			"width": 1440,
			"height": 900
		},
		{
			"id": "tablet",
			"width": 920,
			"height": 800
		},
		{
			"id": "mobile",
			"width": 390,
			"height": 844
