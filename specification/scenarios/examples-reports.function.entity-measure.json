{
	"schemaVersion": 1,
	"id": "examples-reports.function.entity-measure",
	"title": "reports.function.entity-measure examples",
	"kind": "headless",
	"units": ["reports.function.entity-measure"],
	"builds": [],
	"states": [
		{
			"id": "byte-size-scales-and-keeps-sign",
			"title": "A byte count reads as B, KB or MB by its magnitude and keeps its sign",
			"coverage": "required"
		},
		{
			"id": "absent-measurements-read-not-measured",
			"title": "A unit with nothing recorded shows Not measured for each size and timing, never zero",
			"coverage": "required"
		},
		{
			"id": "scoped-observations-owned-callable-only",
			"title": "Observations of another unit or an unowned callable never reach this unit; an owned callable does",
			"coverage": "required"
		},
		{
			"id": "source-outranks-record-and-observation",
			"title": "A unit source measurement outranks the record and an observation of the same metric",
			"coverage": "required"
		},
		{
			"id": "timings-split-by-profile-and-target",
			"title": "Timings stay one row per profile and target; unbudgeted timings need workload and profile",
			"coverage": "required"
		},
		{
			"id": "tolerance-marked-only-above-policy",
			"title": "A tolerance is marked over only when it is above the five percent policy",
			"coverage": "required"
		},
		{
			"id": "invalid-record-measurements-still-used",
			"title": "A failed or invalid record still supplies its measurements; its status is not judged here",
			"coverage": "required"
		},
		{
			"id": "null-record-wasm-unit-not-measured",
			"title": "A null record on a unit with a Wasm target shows its Wasm size Not measured and keeps an observed Wasm size",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "examples",
			"kind": "unit",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/examples/reports.function.entity-measure.test.ts",
			"cwd": "packages/reports",
