{
	"schemaVersion": 1,
	"id": "git-evidence-read",
	"title": "Snapshot metadata and evidence are batched without changing their validation",
	"kind": "headless",
	"units": [
		"adapter.evidence-tree",
		"function.read-tree-texts",
		"repository.unit-registry",
		"repository.scenario"
	],
	"states": [
		{
			"id": "binary-read",
			"title": "Binary bytes, repeated objects, unusual filenames and missing paths",
			"coverage": "required"
		},
		{
			"id": "boundaries",
			"title": "Malformed responses and unavailable Git objects cannot become successful evidence",
			"coverage": "required"
		},
		{
			"id": "metadata-read",
			"title": "Ordered metadata reads use bounded batches and refuse unreadable files",
			"coverage": "required",
			"units": ["function.read-tree-texts", "repository.unit-registry", "repository.scenario"]
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "batch",
			"kind": "integration",
			"runner": "command",
			"target": "bun test/verification-output.ts vitest test/evidence-batch.test.ts test/utils/read-tree-texts.test.ts",
			"cwd": ".",
			"timeoutMs": 180000
		}
	],
	"evidence": [
		{
			"id": "batch-read-cases",
			"kind": "assertions",
			"states": ["binary-read"],
			"viewports": [],
			"required": true
		},
		{
			"id": "metadata-read-cases",
			"kind": "assertions",
			"states": ["metadata-read"],
			"viewports": [],
			"required": true
		},
		{
			"id": "batch-assertions",
			"kind": "assertions",
			"states": ["binary-read", "boundaries", "metadata-read"],
			"viewports": [],
			"required": true
		},
		{
			"id": "batch-output",
			"kind": "output",
			"states": ["binary-read", "boundaries", "metadata-read"],
			"viewports": [],
			"required": true
		}
	]
}
