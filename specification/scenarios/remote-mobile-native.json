{
	"schemaVersion": 1,
	"id": "remote-mobile-native",
	"title": "Native Swift cache authority and late-response refusal",
	"kind": "headless",
	"units": [
		"desktop.adapter.capacitor-bridge",
		"desktop.adapter.capacitor-environment",
		"desktop.adapter.ios-remote",
		"desktop.function.cached-snapshot",
		"desktop.function.remote-binary",
		"desktop.model.environment-types",
		"desktop.script.check-ios-native",
		"desktop.script.check-ios-vectors",
		"desktop.script.check-ios-limits",
		"desktop.script.build-ios-simulator",
		"desktop.script.ios-products",
		"desktop.script.ios-build-options"
	],
	"states": [
		{
			"id": "native-authority",
			"title": "Compiled actual Swift refuses old-grant reads and purges denied cache",
			"coverage": "required"
		},
		{
			"id": "native-profile",
			"title": "Real Swift protocol vectors, Debug/Release behavior and source limits",
			"coverage": "required"
		},
		{
			"id": "native-build",
			"title": "Clean compiled iOS shell and ad hoc simulator signatures",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "ios-authority",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/ios-cache-authority.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "ios-cache-listing",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/ios-cache-listing.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "native-profile",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/ios-native-profile.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 360000
		},
		{
			"id": "native-build",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/ios-simulator-build.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 600000
		}
	],
	"evidence": [
		{
			"id": "remote-mobile-native-output",
			"kind": "output",
			"states": ["native-authority", "native-profile", "native-build"],
			"viewports": [],
			"required": true
		},
		{
			"id": "remote-mobile-native-assertions",
			"kind": "assertions",
			"states": ["native-authority", "native-profile", "native-build"],
			"viewports": [],
			"required": true
		}
	]
}
