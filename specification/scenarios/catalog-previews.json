{
	"schemaVersion": 1,
	"id": "catalog-previews",
	"title": "Page cards show their own recorded state at the selected revision",
	"kind": "ui",
	"units": [
		"desktop.component.entity-card",
		"desktop.component.recorded-preview",
		"desktop.function.recorded-preview",
		"desktop.function.catalog-unit",
		"desktop.function.artifact-query"
	],
	"states": [
		{
			"id": "local-catalog",
			"title": "Local page cards show the exact recorded screenshot",
			"coverage": "required"
		},
		{
			"id": "hosted-catalog",
			"title": "Hosted page cards use the same recorded preview",
			"coverage": "required"
		},
		{
			"id": "history-catalog",
			"title": "A selected commit shows only its recorded screenshot",
			"coverage": "required"
		},
		{
			"id": "missing-catalog",
			"title": "A revision without evidence shows its explicit gap",
			"coverage": "required"
		},
		{
			"id": "preview-safety",
			"title": "Missing, corrupt, stale and foreign evidence is refused",
			"coverage": "required"
		}
	],
	"viewports": [
		{ "id": "desktop", "width": 1440, "height": 900 },
		{ "id": "tablet", "width": 920, "height": 1100 },
		{ "id": "mobile", "width": 390, "height": 844 }
	],
	"tests": [
		{
			"id": "cards",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/catalog-previews.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 180000
		},
		{
			"id": "binding",
			"kind": "unit",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/utils/recorded-preview.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 180000
		}
	],
	"evidence": [
		{
			"id": "page-previews",
			"kind": "screenshot",
			"states": ["local-catalog", "hosted-catalog"],
			"viewports": ["desktop", "tablet", "mobile"],
			"required": true,
			"build": "desktop-renderer",
			"provenance": "actual-capture",
			"capture": "viewport"
		},
		{
			"id": "historical-previews",
			"kind": "screenshot",
			"states": ["history-catalog", "missing-catalog"],
			"viewports": ["desktop"],
			"required": true,
			"build": "desktop-renderer",
			"provenance": "actual-capture",
			"capture": "viewport"
		},
		{
			"id": "preview-output",
			"kind": "output",
			"states": [
				"local-catalog",
				"hosted-catalog",
				"history-catalog",
				"missing-catalog",
				"preview-safety"
			],
			"viewports": [],
			"required": true
		}
	]
}
