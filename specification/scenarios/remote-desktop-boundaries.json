	"states": [
		{
			"id": "revision-authority",
			"title": "Explicit tip-pinned commit remains read-only",
			"coverage": "required"
		},
		{
			"id": "revocation",
			"title": "Pending project/provider work cannot write after revocation",
			"coverage": "required"
		},
		{
			"id": "encrypted-relay",
			"title": "Real host and device over workerd with synthetic CLI",
			"coverage": "required"
		},
		{
			"id": "relay-reconnect",
			"title": "Reconnect resumes one session without repeating mutations",
			"coverage": "required"
		},
		{
			"id": "human-authority",
			"title": "Approval stays bound to the displayed phone",
			"coverage": "required"
		},
		{
			"id": "local-authority",
			"title": "Trusted preload bootstrap and bounded unauthorized transport",
			"coverage": "required"
		},
		{
			"id": "local-socket",
			"title": "Actual loopback large images, window isolation and cancellation",
			"coverage": "required"
		},
		{
			"id": "host-authority",
			"title": "Late registration cannot restore disabled or quit access",
			"coverage": "required"
		}
	],
