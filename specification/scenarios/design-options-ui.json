{
	"schemaVersion": 1,
	"id": "design-options-ui",
	"title": "Design options are counted, switched, approved and discussed one option at a time",
	"kind": "ui",
	"units": [
		"desktop.component.agent-controls",
		"desktop.component.approval-button",
		"desktop.component.composer",
		"desktop.component.design-panel",
		"desktop.component.entity-view",
		"desktop.component.project-agent",
		"desktop.component.thread-history",
		"desktop.component.thread-panel",
		"desktop.function.compose-modes",
		"desktop.function.thread-anchor",
		"desktop.function.prior-image",
		"desktop.function.image-url",
		"desktop.store.project-agent",
		"desktop.style.design-2"
	],
	"states": [
		{
			"id": "thread-count",
			"title": "An entity Plan offers the design option count",
			"coverage": "required"
		},
		{
			"id": "thread-default",
			"title": "An entity Plan keeps the default of three",
			"coverage": "required"
		},
		{
			"id": "comment-count",
			"title": "A comment offers no count",
			"coverage": "required"
		},
		{
			"id": "creation-count",
			"title": "The project agent sends its chosen count",
			"coverage": "required"
		},
		{
			"id": "headless-count",
			"title": "A headless plan offers no count",
			"coverage": "required"
		},
		{
			"id": "legacy",
			"title": "A legacy single design shows no alternatives",
			"coverage": "required"
		},
		{
			"id": "option-fit",
			"title": "The options fit and switch with the keyboard",
			"coverage": "required"
		},
		{
			"id": "options",
			"title": "Each option shows its own image",
			"coverage": "required"
		},
		{
			"id": "selected-option",
			"title": "Switching options preserves decoded images without revoked URL errors",
			"coverage": "required"
		},
		{
			"id": "approve",
			"title": "Approval binds the option shown",
			"coverage": "required"
		},
		{
			"id": "option-thread",
			"title": "A revising Plan anchored to an option image",
			"coverage": "required"
		},
		{
			"id": "pinned",
			"title": "A pinned commit views options and approves none",
			"coverage": "required"
		},
		{
			"id": "shared",
			"title": "A shared project switches options, comments only",
			"coverage": "required"
		}
	],
	"viewports": [
		{
			"id": "desktop",
			"width": 1440,
			"height": 900
		},
		{
			"id": "tablet",
			"width": 768,
			"height": 1024
		},
		{
			"id": "phone",
			"width": 390,
			"height": 844
		}
	],
	"tests": [
		{
			"id": "design-options-count-ui",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-design-options.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "design-options-review-ui",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-design-options-review.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		}
	],
	"evidence": [
		{
			"id": "design-options-ui-output",
			"kind": "output",
			"states": [
				"thread-count",
				"thread-default",
				"comment-count",
				"creation-count",
				"headless-count",
				"legacy",
				"option-fit",
				"options",
				"selected-option",
				"approve",
				"option-thread",
				"pinned",
				"shared"
			],
			"viewports": [],
			"required": true
		},
		{
			"id": "design-options-screens-desktop",
			"kind": "screenshot",
			"states": [
				"thread-count",
				"thread-default",
				"comment-count",
				"creation-count",
				"headless-count",
				"legacy",
				"option-fit",
				"options",
				"selected-option",
				"approve",
				"option-thread",
				"pinned",
				"shared"
			],
			"viewports": ["desktop"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "full-page",
			"required": true
		},
		{
			"id": "design-options-screens-tablet",
			"kind": "screenshot",
			"states": ["option-fit"],
