{
	"schemaVersion": 1,
	"id": "desktop-recorded-evidence",
	"title": "Local Git reader of recorded evidence over synthetic fixture repositories",
	"kind": "headless",
	"units": [
		"adapter.evidence-tree",
		"desktop.adapter.evidence-refs",
		"desktop.adapter.pinned-history",
		"desktop.function.artifact-answer",
		"desktop.function.artifact-media",
		"desktop.function.binary-answer",
		"desktop.function.desktop-bridge",
		"desktop.function.evidence-payload",
		"desktop.function.recorded-answer",
		"desktop.function.recorded-capture",
		"desktop.function.recorded-projection",
		"desktop.function.recorded-scope",
		"desktop.function.remote-binary",
		"desktop.service.device-operations",
		"desktop.service.local-operations",
		"desktop.service.recorded-evidence",
		"function.evidence-manifest",
		"function.media-facts",
		"function.media-place",
		"function.note-lines",
		"function.record-lineage",
		"function.record-view",
		"function.revision-reasons",
		"function.revision-registry",
		"function.revision-summary",
		"function.seal-record",
		"function.verification-note-identity",
		"repository.evidence-branch",
		"repository.history-note",
		"repository.source-history",
		"service.attached-record",
		"service.history-status",
		"service.revision-detail"
	],
	"states": [
		{
			"id": "current-tip",
			"title": "Branch tip shown alone at its pinned notes and evidence revisions",
			"coverage": "required"
		},
		{
			"id": "first-parent",
			"title": "Commit compared with its exact first parent, or its stated gap",
			"coverage": "required"
		},
		{
			"id": "inherited-result",
			"title": "Inherited result kept apart from a run at this commit",
			"coverage": "required"
		},
		{
			"id": "refused-scope",
			"title": "Stale tip, foreign commit and unknown entity refused",
			"coverage": "required"
		},
		{
			"id": "entity-projection",
			"title": "Answer reduced to the one entity",
			"coverage": "required"
		},
		{
			"id": "artifact-binding",
			"title": "Capture read only by its exact record, side, state and hash",
			"coverage": "required"
		},
		{
			"id": "project-authority",
			"title": "Evidence and bytes read only in the granted project",
			"coverage": "required"
		},
		{
			"id": "pinned-revisions",
			"title": "Shown artifact stays readable after notes move; no newer record stands in",
			"coverage": "required"
		},
		{
			"id": "transport",
			"title": "Window reads evidence and checked bytes over the loopback socket",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "reader",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/services/recorded-evidence.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "artifact",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/recorded-artifact.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "transport",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/recorded-evidence-transport.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		}
	],
	"evidence": [
		{
			"id": "desktop-recorded-evidence-output",
			"kind": "output",
			"states": [
				"current-tip",
				"first-parent",
				"inherited-result",
				"refused-scope",
				"entity-projection",
				"artifact-binding",
				"project-authority",
				"pinned-revisions",
				"transport"
			],
			"viewports": [],
			"required": true
		},
		{
			"id": "desktop-recorded-evidence-assertions",
			"kind": "assertions",
			"states": [
				"current-tip",
				"first-parent",
				"inherited-result",
				"refused-scope",
				"entity-projection",
				"artifact-binding",
				"project-authority",
				"pinned-revisions",
				"transport"
			],
			"viewports": [],
			"required": true
		}
	]
}
