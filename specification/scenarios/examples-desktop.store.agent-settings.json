{
	"schemaVersion": 1,
	"id": "examples-desktop.store.agent-settings",
	"title": "desktop.store.agent-settings shared design count, loading and save results",
	"kind": "headless",
	"units": ["desktop.store.agent-settings"],
	"builds": [],
	"states": [
		{
			"id": "starts-at-the-default-unloaded-state",
			"title": "Starts at the default count as saved and unloaded without reading storage",
			"coverage": "required"
		},
		{
			"id": "load-reads-the-stored-count-once",
			"title": "load reads the stored count once and ignores later adapter values",
			"coverage": "required"
		},
		{
			"id": "valid-counts-update-the-shared-preference",
			"title": "A supported count updates the shared preference and is written through the adapter",
			"coverage": "required"
		},
		{
			"id": "unsupported-counts-are-refused-without-writing",
			"title": "Unsupported counts are refused without writing or changing the preference",
			"coverage": "required"
		},
		{
			"id": "failed-saves-are-reported-as-unsaved",
			"title": "A failed save reports unsaved and a later successful save clears it",
			"coverage": "required"
		},
		{
			"id": "defaults-to-the-browser-preference",
			"title": "Without an injected adapter the store uses the browser preference",
			"coverage": "required"
		}
	],
