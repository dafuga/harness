{
	"schemaVersion": 1,
	"id": "hub-recorded-evidence",
	"title": "Hub sealed-source reader and HTTP boundary of recorded evidence over a synthetic source",
	"kind": "headless",
	"units": [
		"desktop.function.artifact-answer",
		"desktop.function.artifact-media",
		"desktop.function.recorded-answer",
		"desktop.function.recorded-capture",
		"desktop.function.recorded-projection",
		"desktop.function.recorded-scope",
		"function.evidence-manifest",
		"function.note-lines",
		"function.record-lineage",
		"function.record-view",
		"function.revision-reasons",
		"function.revision-registry",
		"function.revision-summary",
		"function.seal-record",
		"function.verification-note-identity",
		"hub.controller.hub-api",
		"hub.function.hub-attached-record",
		"hub.function.hub-evidence-file",
		"hub.function.hub-evidence-query",
		"hub.function.hub-evidence-read",
		"hub.function.hub-evidence-registry",
		"hub.function.hub-evidence-revision",
		"hub.function.hub-evidence-scope",
		"hub.function.hub-evidence-views",
		"hub.function.hub-http",
		"hub.function.hub-notes",
		"hub.function.hub-pinned-source",
		"hub.service.hub-attached",
		"hub.service.hub-evidence",
		"hub.service.hub-projection",
		"hub.service.hub-record-status"
	],
	"states": [
		{
			"id": "current-tip",
			"title": "Branch tip shown alone at its pinned notes and evidence revisions",
			"coverage": "required"
		},
		{
			"id": "first-parent",
			"title": "Commit compared with its exact first parent, also for a merge",
			"coverage": "required"
		},
		{
			"id": "inherited-result",
			"title": "Inherited result kept apart from a run at this commit",
			"coverage": "required"
		},
		{
			"id": "refused-scope",
			"title": "History that does not hold together refused with its own code",
			"coverage": "required"
		},
		{
			"id": "membership",
			"title": "Non-member and other project refused before cache or source",
			"coverage": "required"
		},
		{
			"id": "selected-bytes",
			"title": "Selected capture answered with its hash and attested type",
			"coverage": "required"
		},
		{
			"id": "size-and-type",
			"title": "11 MiB boundary and markup recorded as a screenshot refused",
			"coverage": "required"
		},
		{
			"id": "pinned-revisions",
			"title": "Shown artifact stays readable after notes move; unknown revisions refused",
			"coverage": "required"
		},
		{
			"id": "cache-revocation",
			"title": "Revoked principal gets nothing from a kept answer",
			"coverage": "required"
		},
		{
			"id": "http-boundary",
			"title": "HTTP boundary over synthetic projection wiring: session, membership, strict query, statuses and headers",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "reader",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/services/hub-evidence.test.ts",
			"cwd": "packages/hub",
			"timeoutMs": 120000
		},
		{
			"id": "artifact",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/services/hub-evidence-artifact.test.ts",
			"cwd": "packages/hub",
			"timeoutMs": 120000
		},
		{
			"id": "revocation",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/services/hub-reader-revocation.test.ts",
			"cwd": "packages/hub",
			"timeoutMs": 120000
		},
		{
			"id": "http",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/controllers/hub-evidence-controller.test.ts",
			"cwd": "packages/hub",
			"timeoutMs": 120000
		}
	],
	"evidence": [
