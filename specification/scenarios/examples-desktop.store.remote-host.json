{
	"schemaVersion": 1,
	"id": "examples-desktop.store.remote-host",
	"title": "desktop.store.remote-host port presence, subscription, answers, failures and disposal",
	"kind": "headless",
	"units": ["desktop.store.remote-host"],
	"builds": [],
	"states": [
		{
			"id": "absent-port-resolves-every-action-false",
			"title": "Without a control port start returns unsubscribed and every action resolves false",
			"coverage": "required"
		},
		{
			"id": "reads-the-port-on-every-access",
			"title": "A port set on the workspace after creation is read on the next access, and a falsy port is absent",
			"coverage": "required"
		},
		{
			"id": "start-subscribes-once-and-accepts-announcements",
			"title": "start asks once, subscribes once and accepts announced statuses",
			"coverage": "required"
		},
		{
			"id": "actions-accept-the-answered-status",
			"title": "Each action forwards its input and accepts the status it answers with",
			"coverage": "required"
		},
		{
			"id": "failures-keep-the-error-and-block-overlap",
			"title": "A rejected action keeps its error text, and an action while busy is refused without calling the port",
			"coverage": "required"
		},
		{
			"id": "dispose-detaches-and-drops-a-late-answer",
			"title": "dispose detaches the listener and an answer that arrives afterwards is not accepted",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "examples",
			"kind": "unit",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/examples/desktop.store.remote-host.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 180000
		}
	],
	"evidence": [
		{
			"id": "examples-output",
			"kind": "output",
