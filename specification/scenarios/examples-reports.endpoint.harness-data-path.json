{
	"schemaVersion": 1,
	"id": "examples-reports.endpoint.harness-data-path",
	"title": "reports.endpoint.harness-data-path examples",
	"kind": "headless",
	"units": ["reports.endpoint.harness-data-path"],
	"builds": [],
	"states": [
		{
			"id": "normal-index-query",
			"title": "GET for index.json from the owner loopback peer answers 200 with the stored index text",
			"coverage": "required"
		},
		{
			"id": "missing-filename-not-found",
			"title": "GET with no filename answers 404 Not found as plain text for the owner",
			"coverage": "required"
		},
		{
			"id": "owner-refusal-forbidden",
			"title": "GET from a non-loopback peer or without owner mode answers 403 Forbidden",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "examples",
			"kind": "unit",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/examples/reports.endpoint.harness-data-path.test.ts",
			"cwd": "packages/reports",
			"timeoutMs": 180000
		}
	],
	"evidence": [
		{
			"id": "examples-output",
			"kind": "output",
			"states": ["normal-index-query", "missing-filename-not-found", "owner-refusal-forbidden"],
			"viewports": [],
			"required": true
		},
		{
			"id": "examples-assertions",
			"kind": "assertions",
			"states": ["normal-index-query", "missing-filename-not-found", "owner-refusal-forbidden"],
			"viewports": [],
			"required": true
		},
		{
			"id": "examples-cases",
			"kind": "trace",
			"states": ["normal-index-query", "missing-filename-not-found", "owner-refusal-forbidden"],
			"viewports": [],
			"required": true
		}
	]
}
