	"units": ["reports.function.entity-behavior"],
	"builds": [],
	"states": [
		{
			"id": "entity-behavior-tip-run-each-state-passed",
			"title": "the branch tip shows one passing run, each state with what it recorded",
			"coverage": "required"
		},
		{
			"id": "entity-behavior-commit-equal-results-unchanged",
			"title": "equal results on both sides are behavior unchanged, with the host scenario titles",
			"coverage": "required"
		},
		{
			"id": "entity-behavior-commit-other-bytes-not-yet-a-change",
			"title": "results with other bytes are not yet called a change: only what they hold says that",
			"coverage": "required"
		},
		{
			"id": "entity-behavior-commit-unread-results-keep-no-read",
			"title": "unread results keep their cells without a read, and the change stays unknown",
			"coverage": "required"
		},
		{
			"id": "entity-behavior-commit-parent-missing-is-unknown",
			"title": "a parent that recorded nothing leaves the change unknown, never unchanged",
			"coverage": "required"
		},
		{
			"id": "entity-behavior-current-failed-scenario-not-passed",
			"title": "a run whose scenario failed is not passed, whatever results remain listed",
			"coverage": "required"
		},
		{
			"id": "entity-behavior-current-no-end-to-end-result",
			"title": "an entity with no recorded end-to-end result says so and is not passed",
			"coverage": "required"
		},
		{
			"id": "entity-behavior-duration-sums-named-e2e-jobs",
			"title": "the duration sums only the end-to-end jobs whose id names a listed scenario",
			"coverage": "required"
		},
		{
			"id": "entity-behavior-duration-missing-jobs-give-null",
			"title": "no duration is made up: a null record, empty list, bare id or non-e2e job gives null",
			"coverage": "required"
		}
	],
	"viewports": [],
