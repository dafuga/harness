	"states": [
		{
			"id": "places-below-centred-with-the-gap",
			"title": "Places the tooltip below its mark, centred, with the 8-pixel gap",
			"coverage": "required"
		},
		{
			"id": "clamps-to-the-screen-edges",
			"title": "Clamps the tooltip to the screen edges when it fits",
			"coverage": "required"
		},
		{
			"id": "overwide-tooltip-starts-at-the-margin",
			"title": "An overwide tooltip starts at the margin and is not made to fit",
			"coverage": "required"
		},
		{
			"id": "opens-above-without-room-below",
			"title": "Opens above the mark when there is no room below",
			"coverage": "required"
		},
		{
			"id": "exact-fit-uses-no-height",
			"title": "A tooltip exactly as tall as the room on one side fits without a height",
			"coverage": "required"
		},
		{
			"id": "takes-the-roomier-side-below",
			"title": "A tooltip taller than both sides takes the roomier side below and its height",
			"coverage": "required"
		},
		{
			"id": "tie-prefers-the-side-below",
			"title": "On a tie between the two sides the tooltip goes below with that room as height",
			"coverage": "required"
		},
		{
			"id": "short-screen-takes-the-roomier-side-above",
			"title": "On a short screen a tooltip takes the roomier side above, starting at the gap",
			"coverage": "required"
		}
