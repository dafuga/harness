		},
		{
			"id": "examples-assertions",
			"kind": "assertions",
			"states": [
				"renderaudit-printed-the-passed-line-or-each-finding-in-order",
				"renderauditcoverage-printed-findings-and-the-coverage-report"
			],
			"viewports": [],
			"required": true
		},
		{
			"id": "examples-cases",
