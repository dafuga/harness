{
	"schemaVersion": 1,
	"id": "history-fixture-integrity",
	"title": "Isolated history seeding preserves recorded behavior and refuses changed inherited evidence",
	"kind": "headless",
	"units": [
		"service.evidence-attach",
		"service.verification-check",
		"reports.script.harness-seed-attacher"
	],
	"states": [
		{
			"id": "history-equivalence",
			"title": "Seed attachment leaves the same records, notes and refs as the CLI",
			"coverage": "required",
			"units": ["service.evidence-attach", "reports.script.harness-seed-attacher"]
		},
		{
			"id": "seed-isolation",
			"title": "Another repository, another attacher, changed records and closed use are refused",
			"coverage": "required",
			"units": ["reports.script.harness-seed-attacher"]
		},
		{
			"id": "changed-parent-log",
			"title": "Changed parent test output refuses its child",
			"coverage": "required",
			"units": ["service.evidence-attach"]
		},
		{
			"id": "changed-grandparent-log",
			"title": "Changed ancestor test output refuses its descendant",
			"coverage": "required",
			"units": ["service.evidence-attach"]
		},
		{
			"id": "changed-parent-capture",
			"title": "Changed parent capture refuses its child",
			"coverage": "required",
			"units": ["service.evidence-attach"]
		},
		{
			"id": "indexer-parity",
			"title": "Shared and fresh checkers agree across source changes and corrupted evidence",
			"coverage": "required",
			"units": ["service.verification-check"]
		},
		{
			"id": "historical-derived-contract",
			"title": "A newer derived contract preserves exact committed historical metadata",
			"coverage": "required",
			"units": ["service.verification-check"]
		},
		{
			"id": "historical-version-tampering",
			"title": "Every altered recorded version field remains invalid",
			"coverage": "required",
			"units": ["service.verification-check"]
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "seed-attacher",
			"kind": "integration",
			"runner": "command",
			"target": "bun test/verification-output.ts vitest test/seed-attacher.test.ts",
			"cwd": ".",
			"timeoutMs": 300000
		},
		{
			"id": "history-attach-inherited",
			"kind": "integration",
			"runner": "command",
			"target": "bun test/verification-output.ts vitest test/history-attach-inherited.test.ts",
			"cwd": ".",
			"timeoutMs": 300000
		},
		{
			"id": "verification-check-shared",
			"kind": "integration",
			"runner": "command",
			"target": "bun test/verification-output.ts vitest test/verification-check-shared.test.ts",
			"cwd": ".",
			"timeoutMs": 300000
		}
	],
	"evidence": [
		{
			"id": "history-fixture-output",
			"kind": "output",
			"states": [
				"history-equivalence",
				"seed-isolation",
				"changed-parent-log",
				"changed-grandparent-log",
				"changed-parent-capture",
				"indexer-parity",
				"historical-derived-contract",
				"historical-version-tampering"
			],
			"viewports": [],
			"required": true
		},
		{
			"id": "history-fixture-assertions",
			"kind": "assertions",
			"states": [
				"history-equivalence",
				"seed-isolation",
				"changed-parent-log",
				"changed-grandparent-log",
				"changed-parent-capture",
				"indexer-parity",
				"historical-derived-contract",
				"historical-version-tampering"
			],
			"viewports": [],
			"required": true
		}
	]
}
