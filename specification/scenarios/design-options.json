{
	"schemaVersion": 1,
	"id": "design-options",
	"title": "A Plan makes its design options apart and saves them together, or saves nothing",
	"kind": "headless",
	"units": [
		"desktop.function.approval-match",
		"desktop.function.design-count",
		"desktop.function.design-directions",
		"desktop.function.ipc-payload",
		"desktop.function.plan-design",
		"desktop.service.desktop-run",
		"desktop.service.project-run"
	],
	"states": [
		{
			"id": "option-plan-runs",
			"title": "Plan runs generate each option apart and save one version, or none",
