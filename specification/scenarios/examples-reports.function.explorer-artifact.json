{
	"schemaVersion": 1,
	"id": "examples-reports.function.explorer-artifact",
	"title": "reports.function.explorer-artifact examples",
	"kind": "headless",
	"units": ["reports.function.explorer-artifact"],
	"builds": [],
	"states": [
		{
			"id": "explorer-artifact-reads-stored-media-by-hash",
			"title": "an artifact is read from its stored media file named by the recorded hash, under the protected base",
			"coverage": "required"
		},
		{
			"id": "explorer-artifact-joins-base-without-separator",
			"title": "the media base is joined to the file name exactly as given, with no separator inserted",
			"coverage": "required"
		},
		{
			"id": "explorer-artifact-hash-mismatch-stays-text",
			"title": "bytes that do not match the recorded hash stay text, are not parsed and are not trusted",
			"coverage": "required"
		},
		{
			"id": "explorer-artifact-http-error-unverified",
			"title": "a response that is not OK resolves unverified with its status and reads no text",
			"coverage": "required"
		},
		{
			"id": "explorer-artifact-absent-capture-gap-or-default",
			"title": "an absent capture says why it is absent and never fetches",
			"coverage": "required"
		},
		{
			"id": "explorer-artifact-fetcher-rejection-propagates",
			"title": "a rejection from the supplied fetcher reaches the caller unchanged",
			"coverage": "required"
		},
		{
			"id": "explorer-artifact-payload-types",
			"title": "object, array, number and text payloads are read as their own types",
			"coverage": "required"
		},
		{
			"id": "artifact-behavior-first-request-and-response-name",
			"title": "a run takes its request and answer from the first of their names that is present",
			"coverage": "required"
		},
		{
			"id": "artifact-behavior-non-object-documents-null",
			"title": "documents that are null, arrays or primitives give no behavior",
			"coverage": "required"
		},
		{
			"id": "artifact-text-display-and-thrown-type-error",
			"title": "artifact text passes strings through, names missing values, indents structures and throws for cycles and BigInt",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "examples",
			"kind": "unit",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/examples/reports.function.explorer-artifact.test.ts",
			"cwd": "packages/reports",
			"timeoutMs": 180000
		}
	],
	"evidence": [
