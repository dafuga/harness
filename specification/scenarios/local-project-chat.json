{
	"schemaVersion": 1,
	"id": "local-project-chat",
	"title": "Local web project chat and its managed runtime",
	"kind": "headless",
	"units": [
		"reports.adapter.console-bridge",
		"reports.component.console-chat",
		"reports.controller.console-agent",
		"reports.function.preview-node",
		"reports.initializer.initialize-preview",
		"reports.service.console-agent",
		"reports.service.preview-server",
		"reports.store.console-workspace"
	],
	"states": [
		{
			"id": "history-navigation",
			"title": "Chat references open entity history",
			"coverage": "required"
		},
		{
			"id": "transport-recovery",
			"title": "Interrupted requests retain identity and release closed sessions",
			"coverage": "required"
		},
		{
			"id": "owner-boundary",
			"title": "Only same-origin loopback JSON reaches the local executor",
			"coverage": "required"
		},
		{
			"id": "route-runtime",
			"title": "One preview keeps route modules aligned after normal sync",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "console-workspace",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/console-workspace.test.ts",
			"cwd": "packages/reports",
			"timeoutMs": 180000
		},
		{
			"id": "console-bridge",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/console-bridge.test.ts",
			"cwd": "packages/reports",
			"timeoutMs": 180000
		},
		{
			"id": "console-agent",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/console-agent.test.ts",
			"cwd": "packages/reports",
			"timeoutMs": 180000
		},
		{
			"id": "preview-lifecycle",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/preview-lifecycle.test.ts",
			"cwd": "packages/reports",
			"timeoutMs": 180000
		}
	],
	"evidence": [
		{
			"id": "local-chat-output",
			"kind": "output",
			"states": ["history-navigation", "transport-recovery", "owner-boundary", "route-runtime"],
			"viewports": [],
			"required": true
		},
		{
			"id": "local-chat-assertions",
			"kind": "assertions",
			"states": ["history-navigation", "transport-recovery", "owner-boundary", "route-runtime"],
			"viewports": [],
			"required": true
		}
	]
}
