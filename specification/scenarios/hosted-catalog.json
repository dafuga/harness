{
	"schemaVersion": 1,
	"id": "hosted-catalog",
	"title": "Hosted catalog of a commit over a synthetic source: what the hub lists, what it still opens, and what it does not serve from its cache",
	"kind": "headless",
	"units": [
		"desktop.function.catalog-unit",
		"hub.controller.hub-agent",
		"hub.function.hub-catalog",
		"hub.function.hub-entity",
		"hub.function.hub-projection-cache",
		"hub.function.hub-snapshot",
		"hub.service.hub-projection"
	],
	"states": [
		{
			"id": "hosted-listing",
			"title": "Every ordinary entity listed and no page manifest that only loads for an address",
			"coverage": "required"
		},
		{
			"id": "hosted-detail",
			"title": "What the list leaves out opened by its identity, with its source and history",
			"coverage": "required"
		},
		{
			"id": "hosted-history",
			"title": "The same identity listed in the tree of the commit where it renders",
			"coverage": "required"
		},
		{
			"id": "hosted-cache",
			"title": "A snapshot cached with a route loader listed not shown",
			"coverage": "required"
		},
		{
			"id": "write-access",
			"title": "Read and Comment refuse AI; Write is project-bound and revoked access cancels work",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "listing",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/hub-catalog-listing.test.ts",
			"cwd": "packages/hub",
			"timeoutMs": 180000
		},
		{
			"id": "project-agent-access",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/controllers/hub-agent.test.ts",
			"cwd": "packages/hub",
			"timeoutMs": 180000
		}
	],
	"evidence": [
		{
			"id": "hosted-catalog-output",
			"kind": "output",
			"states": [
				"hosted-listing",
				"hosted-detail",
				"hosted-history",
				"hosted-cache",
				"write-access"
			],
			"viewports": [],
			"required": true
		},
		{
			"id": "hosted-catalog-assertions",
			"kind": "assertions",
			"states": [
				"hosted-listing",
				"hosted-detail",
				"hosted-history",
				"hosted-cache",
				"write-access"
			],
			"viewports": [],
			"required": true
		}
	]
}
