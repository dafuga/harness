{
	"schemaVersion": 1,
	"id": "hosted-client-copies",
	"title": "Copies the computer keeps of a hosted project, over a local stand-in hub and a real cache on disk",
	"kind": "headless",
	"units": [
		"desktop.adapter.remote-http-project",
		"desktop.function.projection-cache-purge",
		"desktop.service.hosted-read",
		"desktop.service.projection-cache",
		"desktop.service.remote-projection",
		"desktop.validator.hosted-failure",
		"desktop.validator.remote-project-response"
	],
	"states": [
		{
			"id": "earlier-copy",
			"title": "A snapshot kept before the catalog left route loaders out not shown while the hub is away",
			"coverage": "required"
		},
		{
			"id": "current-copy",
			"title": "A snapshot this build kept shown while the hub is away, at the tip and at a pinned commit",
			"coverage": "required"
		},
		{
			"id": "other-copies",
			"title": "Every other kept read still shown while the hub is away",
			"coverage": "required"
		},
		{
			"id": "denial",
			"title": "A denial removing an earlier copy with every other copy",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "copies",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/hosted-copy-listing.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 180000
		}
	],
	"evidence": [
		{
			"id": "hosted-client-copies-output",
			"kind": "output",
			"states": ["earlier-copy", "current-copy", "other-copies", "denial"],
			"viewports": [],
			"required": true
		},
		{
			"id": "hosted-client-copies-assertions",
			"kind": "assertions",
			"states": ["earlier-copy", "current-copy", "other-copies", "denial"],
			"viewports": [],
			"required": true
		}
	]
}
