{
	"schemaVersion": 1,
	"id": "harness-reports",
	"title": "Reports of the hosting site as their export shows them, and where the removed report and analytics screens lead",
	"kind": "ui",
	"units": [
		"reports.page.harness-reports",
		"reports.page.harness-reports-id",
		"reports.page.harness-analytics",
		"reports.component.report-view",
		"reports.component.report-summary",
		"reports.component.report-checks",
		"reports.component.coverage-list",
		"reports.component.evidence-grid",
		"reports.component.evidence-card",
		"reports.component.evidence-viewer",
		"reports.component.image-zoom",
		"reports.component.audio-comparison",
		"reports.component.audio-comparison-viewer",
		"reports.component.audio-evidence",
		"reports.repository.site-report",
		"reports.service.report-export",
		"reports.serializer.report-export",
		"reports.endpoint.api-reports-id-type-file"
	],
	"states": [
		{
			"id": "retired-hub",
			"title": "The explorer page that the address of the removed report hub leads to",
			"coverage": "required"
		},
		{
			"id": "retired-report",
			"title": "The explorer page that the address of a removed report page leads to",
			"coverage": "required"
		},
		{
			"id": "retired-analytics",
			"title": "The explorer page that the address of the removed analytics dashboard leads to",
			"coverage": "required"
		},
		{
			"id": "exported",
			"title": "Exported report with its summary, checks and coverage, as the server serves it",
			"coverage": "required"
		},
		{
			"id": "gallery",
			"title": "Evidence gallery of the exported report",
			"coverage": "required"
		},
		{
			"id": "viewer",
			"title": "Screenshot viewer open on a tall capture",
			"coverage": "required"
		},
		{
			"id": "comparison",
			"title": "Before and after screenshots in the viewer",
			"coverage": "required"
		},
		{
			"id": "audio",
			"title": "Paired recording in the audio comparison viewer, played from the bytes the report API serves",
			"coverage": "required"
		}
	],
	"viewports": [
		{
			"id": "desktop",
			"width": 1440,
			"height": 900
		},
		{
			"id": "tablet",
			"width": 920,
			"height": 800
		},
		{
			"id": "mobile",
			"width": 390,
			"height": 844
		}
	],
	"tests": [
		{
			"id": "evidence",
			"kind": "e2e",
			"runner": "playwright",
			"target": "tests/e2e/harness-reports-evidence.spec.ts",
			"cwd": "packages/reports"
		}
	],
	"evidence": [
		{
			"id": "screens",
			"kind": "screenshot",
			"states": [
				"retired-hub",
				"retired-report",
				"retired-analytics",
				"exported",
				"gallery",
				"viewer",
				"comparison",
				"audio"
			],
			"viewports": ["desktop", "tablet", "mobile"],
			"provenance": "actual-capture",
			"build": "reports",
			"required": true
		},
		{
			"id": "tone",
			"kind": "audio",
			"states": ["audio"],
			"viewports": [],
			"provenance": "actual-capture",
			"build": "reports",
			"required": true
		}
	]
}
