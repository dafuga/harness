{
	"schemaVersion": 1,
	"id": "harness-reports",
	"title": "Report hub, report pages and analytics of the hosting site",
	"kind": "ui",
	"units": [
		"reports.page.harness-reports",
		"reports.page.harness-reports-id",
		"reports.page.harness-analytics",
		"reports.component.hub-view",
		"reports.component.report-view",
		"reports.component.report-summary",
		"reports.component.report-checks",
		"reports.component.coverage-list",
		"reports.component.evidence-grid",
		"reports.component.evidence-card",
		"reports.component.evidence-viewer",
		"reports.component.image-zoom",
		"reports.component.audio-comparison",
		"reports.component.audio-comparison-viewer",
		"reports.component.audio-evidence",
		"reports.component.analytics-history",
		"reports.component.analytics-filters",
		"reports.component.analytics-cpu",
		"reports.repository.site-report",
		"reports.service.harness-analytics",
		"reports.service.report-export",
		"reports.serializer.report-export"
	],
	"states": [
		{
			"id": "hub",
			"title": "Report hub listing the reports of this site",
			"coverage": "required"
		},
		{
			"id": "report",
			"title": "Report page with its summary, checks and coverage",
			"coverage": "required"
		},
		{
			"id": "gallery",
			"title": "Evidence gallery of a report",
			"coverage": "required"
		},
		{
			"id": "viewer",
			"title": "Screenshot viewer open on a tall capture",
			"coverage": "required"
		},
		{
			"id": "comparison",
			"title": "Before and after screenshots in the viewer",
			"coverage": "required"
		},
		{
			"id": "audio",
			"title": "Paired recording in the audio comparison viewer",
			"coverage": "required"
		},
		{
			"id": "analytics",
			"title": "Analytics dashboard of this site",
			"coverage": "required"
		},
		{
			"id": "exported",
			"title": "Exported portable report opened as a file",
			"coverage": "required"
		}
	],
	"viewports": [
		{
			"id": "desktop",
			"width": 1440,
			"height": 900
		},
		{
			"id": "tablet",
			"width": 920,
			"height": 800
		},
		{
			"id": "mobile",
			"width": 390,
			"height": 844
		}
	],
	"tests": [
		{
			"id": "evidence",
			"kind": "e2e",
			"runner": "playwright",
			"target": "tests/e2e/harness-reports-evidence.spec.ts",
			"cwd": "packages/reports"
		}
	],
	"evidence": [
		{
			"id": "screens",
			"kind": "screenshot",
			"states": [
				"hub",
				"report",
				"gallery",
				"viewer",
				"comparison",
				"audio",
				"analytics",
				"exported"
			],
			"viewports": ["desktop", "tablet", "mobile"],
			"provenance": "actual-capture",
			"build": "reports",
			"required": true
		},
		{
			"id": "tone",
			"kind": "audio",
			"states": ["audio"],
			"viewports": [],
			"provenance": "actual-capture",
			"build": "reports",
			"required": true
		}
	]
}
