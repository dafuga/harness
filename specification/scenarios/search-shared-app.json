{
	"schemaVersion": 1,
	"id": "search-shared-app",
	"title": "The search of the shared workspace over synthetic projects: every category, a pinned commit and a project being read",
	"kind": "ui",
	"units": [
		"desktop.component.nav-bar",
		"desktop.function.workspace-search",
		"desktop.store.workspace",
		"reports.component.entity-search",
		"reports.component.entity-search-results",
		"reports.function.entity-search",
		"desktop.style.responsive"
	],
	"states": [
		{
			"id": "search-entries",
			"title": "The entries of exactly the shown project and revision, and none while another is read",
			"coverage": "required",
			"units": ["desktop.function.workspace-search"]
		},
		{
			"id": "search-ui",
			"title": "The renderer specs of the search, as they ran",
			"coverage": "required",
			"units": [
				"desktop.component.nav-bar",
				"desktop.function.workspace-search",
				"desktop.store.workspace",
				"reports.component.entity-search",
				"reports.component.entity-search-results",
				"reports.function.entity-search"
			]
		},
		{
			"id": "search-results",
			"title": "Results of all six categories in the top bar, the first one active",
			"coverage": "required",
			"units": [
				"desktop.component.nav-bar",
				"desktop.function.workspace-search",
				"reports.component.entity-search",
				"reports.component.entity-search-results",
				"reports.function.entity-search"
			]
		},
		{
			"id": "search-pinned",
			"title": "A pinned commit named by the field and searched alone",
			"coverage": "required",
			"units": [
				"desktop.component.nav-bar",
				"desktop.function.workspace-search",
				"desktop.store.workspace",
				"reports.component.entity-search",
				"reports.component.entity-search-results",
				"reports.function.entity-search"
			]
		},
		{
			"id": "search-project-loading",
			"title": "Another project being read with the results open: nothing of the project left is offered",
			"coverage": "required",
			"units": [
				"desktop.function.workspace-search",
				"desktop.store.workspace",
				"reports.component.entity-search",
				"reports.component.entity-search-results"
			]
		}
	],
	"viewports": [
		{
			"id": "desktop",
			"width": 1440,
			"height": 900
		},
		{
			"id": "tablet",
			"width": 920,
			"height": 1100
		},
		{
			"id": "mobile",
			"width": 390,
			"height": 844
		}
	],
	"tests": [
		{
			"id": "search-entries",
			"kind": "unit",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/utils/workspace-search.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 180000
		},
		{
			"id": "search-ui",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-search.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "search-scope-ui",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-search-scope.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "search-fit-ui",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-search-fit.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		}
	],
	"evidence": [
		{
			"id": "search-shared-output",
			"kind": "output",
			"states": ["search-entries", "search-ui"],
			"viewports": [],
			"required": true
		},
		{
			"id": "search-shared-assertions",
			"kind": "assertions",
			"states": ["search-entries"],
			"viewports": [],
			"required": true
		},
		{
			"id": "search-screens-desktop",
			"kind": "screenshot",
			"states": ["search-results", "search-pinned", "search-project-loading"],
			"viewports": ["desktop"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "full-page",
			"required": true
		},
		{
			"id": "search-screens-tablet",
			"kind": "screenshot",
			"states": ["search-results"],
			"viewports": ["tablet"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "full-page",
			"required": true
		},
		{
			"id": "search-screens-mobile",
			"kind": "screenshot",
			"states": ["search-results"],
			"viewports": ["mobile"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "full-page",
			"required": true
		}
	]
}
