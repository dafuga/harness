			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "host",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-remote-host.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "cache",
			"kind": "e2e",
			"runner": "command",
