{
	"schemaVersion": 1,
	"id": "remote-mobile-ui",
	"title": "Shared remote connection controls and cached phone workspace",
	"kind": "ui",
	"units": [
		"desktop.adapter.capacitor-bridge",
		"desktop.adapter.capacitor-environment",
		"desktop.adapter.electron-environment",
		"desktop.component.project-gate",
		"desktop.component.project-switcher",
		"desktop.component.remote-approval",
		"desktop.component.remote-connection",
		"desktop.component.remote-devices",
		"desktop.component.remote-host-panel",
		"desktop.component.remote-phone-panel",
		"desktop.component.status-bar",
		"desktop.function.remote-labels",
		"desktop.function.select-environment",
		"desktop.model.environment-types",
		"desktop.store.remote-host",
		"desktop.store.remote-phone",
		"desktop.store.workspace",
		"desktop.style.remote"
	],
	"states": [
		{
			"id": "phone-interaction",
			"title": "Pick a linked computer and connect from the signed-in phone",
			"coverage": "required"
		},
		{
			"id": "desktop-interaction",
			"title": "Manage linked computers and revoke devices",
			"coverage": "required"
		},
		{
			"id": "cached-interaction",
			"title": "cached interaction",
			"coverage": "required"
		},
		{
			"id": "scan-interaction",
			"title": "Require Google account discovery and expose no camera path",
			"coverage": "required"
		},
		{
			"id": "phone-start",
			"title": "Signed-in iPhone lists its linked Macs",
			"coverage": "required"
		},
		{
			"id": "phone-connecting",
			"title": "iPhone connects directly to the selected Mac",
			"coverage": "required"
		},
		{
			"id": "phone-account-discovery",
			"title": "Signed-in iPhone lists both Macs without pairing controls",
			"coverage": "required"
		},
		{
			"id": "phone-connected",
			"title": "phone connected",
			"coverage": "required"
		},
		{
			"id": "phone-connection-dialog",
			"title": "Connection details and actions beneath the connected status",
			"coverage": "required"
		},
		{
			"id": "phone-workspace",
			"title": "phone workspace",
			"coverage": "required"
		},
		{
			"id": "phone-offline",
			"title": "phone offline",
			"coverage": "required"
		},
		{
			"id": "phone-revoked",
			"title": "phone revoked",
			"coverage": "required"
		},
		{
			"id": "desktop-start",
			"title": "An unlinked Mac can be linked from Settings",
			"coverage": "required"
		},
		{
			"id": "desktop-linked-device",
			"title": "Mac settings list the device and its access",
			"coverage": "required"
		},
		{
			"id": "desktop-access",
			"title": "Linked Mac settings show access and unlink",
			"coverage": "required"
		},
		{
			"id": "tablet-interaction",
			"title": "Tablet workspace and linked device layout",
			"coverage": "required"
		},
		{
			"id": "tablet-phone-workspace",
			"title": "tablet phone workspace",
			"coverage": "required"
		},
		{
			"id": "tablet-linked-device",
			"title": "Tablet shows the linked device and the revoke control",
			"coverage": "required"
		}
	],
	"viewports": [
		{
			"id": "desktop",
			"width": 1440,
			"height": 900
		},
		{
			"id": "mobile",
			"width": 390,
			"height": 844
		},
		{
			"id": "mobile-narrow",
			"width": 320,
			"height": 844
		},
		{
			"id": "tablet",
			"width": 820,
			"height": 1180
		}
	],
	"tests": [
		{
			"id": "phone",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-remote-phone.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "host",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-remote-host.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "cache",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-remote-cache.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "scan",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-remote-scan.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "tablet",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-remote-tablet.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		}
	],
	"evidence": [
		{
			"id": "remote-mobile-ui-output",
			"kind": "output",
			"states": [
				"phone-interaction",
				"desktop-interaction",
				"cached-interaction",
				"scan-interaction",
				"tablet-interaction"
			],
			"viewports": [],
			"required": true
		},
		{
			"id": "remote-screens-mobile",
			"kind": "screenshot",
			"states": [
				"phone-start",
				"phone-account-discovery",
				"phone-connecting",
				"phone-connected",
				"phone-connection-dialog",
				"phone-workspace",
				"phone-offline",
				"phone-revoked"
			],
			"viewports": ["mobile"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "viewport",
			"required": true
		},
		{
			"id": "remote-screens-mobile-narrow",
			"kind": "screenshot",
			"states": ["phone-connected", "phone-connection-dialog"],
			"viewports": ["mobile-narrow"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "viewport",
			"required": true
		},
		{
			"id": "remote-screens-desktop",
			"kind": "screenshot",
			"states": ["desktop-start", "desktop-linked-device", "desktop-access"],
			"viewports": ["desktop"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "viewport",
			"required": true
		},
		{
			"id": "remote-screens-tablet",
			"kind": "screenshot",
			"states": ["tablet-phone-workspace", "tablet-linked-device"],
			"viewports": ["tablet"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "viewport",
			"required": true
		}
	]
}
