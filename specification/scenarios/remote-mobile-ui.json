	"evidence": [
		{
			"id": "remote-mobile-ui-output",
			"kind": "output",
			"states": [
				"phone-interaction",
				"desktop-interaction",
				"cached-interaction",
				"link-interaction",
				"tablet-interaction"
			],
			"viewports": [],
			"required": true
		},
		{
			"id": "remote-screens-mobile",
			"kind": "screenshot",
			"states": [
				"phone-start",
				"phone-pending",
				"phone-connected",
				"phone-workspace",
				"phone-offline",
				"phone-revoked"
			],
			"viewports": ["mobile"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "viewport",
			"required": true
		},
		{
			"id": "remote-screens-desktop",
			"kind": "screenshot",
			"states": ["desktop-start", "desktop-approval", "desktop-access"],
			"viewports": ["desktop"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "viewport",
			"required": true
		},
		{
			"id": "remote-screens-tablet",
			"kind": "screenshot",
			"states": ["tablet-phone-workspace", "tablet-desktop-approval"],
			"viewports": ["tablet"],
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "viewport",
			"required": true
		}
	]
