{
	"schemaVersion": 1,
	"id": "modular-h-branding-contract",
	"title": "Modular H geometry, favicons and shared mark",
	"kind": "headless",
	"units": [
		"desktop.script.brand-assets",
		"reports.component.brand-mark",
		"reports.function.brand-mark"
	],
	"states": [
		{
			"id": "mark-geometry",
			"title": "Five equal tiles and the favicon drawn from them",
			"coverage": "required"
		},
		{
			"id": "favicons",
			"title": "Every app serves and links the shared favicon",
			"coverage": "required"
		},
		{
			"id": "shared-mark",
			"title": "The shared mark renders decorative or labelled",
			"coverage": "required"
		},
		{
			"id": "shared-surfaces",
			"title": "Every brand surface compiles to the shared mark",
			"coverage": "required"
		}
	],
	"viewports": [],
	"tests": [
		{
			"id": "brand-geometry",
			"kind": "unit",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/utils/brand-mark.test.ts",
			"cwd": "packages/reports",
			"timeoutMs": 180000
		},
		{
			"id": "brand-surfaces",
			"kind": "unit",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/components/brand-mark.test.ts",
			"cwd": "packages/reports",
			"timeoutMs": 180000
		}
	],
	"evidence": [
		{
			"id": "modular-h-branding-contract-output",
			"kind": "output",
			"states": ["mark-geometry", "favicons", "shared-mark", "shared-surfaces"],
			"viewports": [],
			"required": true
		},
		{
			"id": "modular-h-branding-contract-assertions",
			"kind": "assertions",
			"states": ["mark-geometry", "favicons", "shared-mark", "shared-surfaces"],
			"viewports": [],
			"required": true
		}
	]
}
