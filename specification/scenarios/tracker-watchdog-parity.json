			"units": ["service.projects-sessions-watchdog-pane"]
		},
		{
			"id": "idle",
			"title": "Nudges eligible panes once and escalates, while protecting other sessions.",
			"coverage": "required",
			"units": ["service.projects-sessions-watchdog-idle"]
		},
		{
			"id": "startup",
			"title": "Proposes trust only for an eligible owned launch and tracks startup alerts.",
			"coverage": "required",
			"units": ["service.projects-sessions-watchdog-startup"]
		},
		{
			"id": "recovery",
			"title": "Protects live runs and recovers missing runs under the current holds.",
			"coverage": "required",
			"units": [
				"service.projects-sessions-watchdog-recovery",
				"service.projects-sessions-watchdog-recovery-service-watchdog-recovery-sessions"
			]
		},
		{
			"id": "resume",
			"title": "Reopens an answered run with its original live pane.",
			"coverage": "required",
			"units": ["service.projects-sessions-watchdog-recovery"]
		}
	],
