{
	"schemaVersion": 1,
	"id": "browser-error-evidence",
	"title": "Browser errors in component evidence",
	"kind": "ui",
	"units": [
		"function.browser-diagnostics",
		"function.read-browser-diagnostics",
		"function.record-view",
		"service.check-run",
		"reports.component.browser-errors",
		"reports.function.browser-error-rows",
		"reports.component.harness-entity-tests",
		"desktop.component.coverage-panel",
		"reports.function.explorer-coverage",
		"desktop.function.hosted-evidence-record"
	],
	"states": [
		{
			"id": "desktop",
			"title": "Component Evidence diagnostics",
			"coverage": "required"
		},
		{
			"id": "console",
			"title": "Component Tests diagnostics",
			"coverage": "required"
		}
	],
	"viewports": [
		{
			"id": "desktop",
			"width": 1440,
			"height": 1000
		},
		{
			"id": "mobile",
			"width": 390,
			"height": 1000
		}
	],
	"tests": [
		{
			"id": "persistence",
			"kind": "integration",
			"runner": "command",
			"target": "bun x vitest run test/browser-error-evidence.test.ts test/utils/read-browser-diagnostics.test.ts test/browser-console-expected.e2e.test.ts",
			"timeoutMs": 180000
		},
		{
			"id": "classification",
			"kind": "unit",
			"runner": "command",
			"cwd": "packages/reports",
			"target": "bun x vitest run test/components/browser-errors.test.ts test/utils/browser-error-rows.test.ts",
			"timeoutMs": 180000
		},
		{
			"id": "desktop",
			"kind": "e2e",
			"runner": "playwright",
			"cwd": "packages/desktop",
			"target": "tests/e2e/browser-error-evidence.spec.ts",
			"timeoutMs": 180000
		},
		{
			"id": "console",
			"kind": "e2e",
			"runner": "command",
			"cwd": "packages/reports",
			"target": "bun x playwright test --config src/configs/shellPlaywrightConfig.ts explorer-shell-browser-errors.spec.ts",
			"timeoutMs": 180000
		},
		{
			"id": "hosted",
			"kind": "integration",
			"runner": "command",
			"cwd": "packages/desktop",
			"target": "bun x vitest run test/validators/hosted-evidence.test.ts test/hosted-evidence-bounds.test.ts test/services/hosted-evidence.test.ts",
			"timeoutMs": 180000
		}
	],
	"evidence": [
		{
			"id": "desktop-screens",
			"kind": "screenshot",
			"states": ["desktop"],
			"viewports": ["desktop", "mobile"],
			"required": true,
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "full-page"
		},
		{
			"id": "screens",
			"kind": "screenshot",
			"states": ["console"],
			"viewports": ["desktop", "mobile"],
			"required": true,
			"provenance": "actual-capture",
			"build": "shell-fixture",
			"capture": "full-page"
		}
	]
}
