{
	"schemaVersion": 1,
	"id": "agent-references",
	"title": "Agent and entity threads link the units they name",
	"kind": "ui",
	"units": [
		"desktop.component.message-list",
		"desktop.component.project-agent",
		"desktop.component.reference-text",
		"desktop.component.run-status",
		"desktop.component.thread-panel",
		"desktop.component.workspace-link",
		"desktop.function.change-execute",
		"desktop.function.changed-units",
		"desktop.function.entity-references",
		"desktop.function.project-proposal",
		"desktop.function.proposal-units",
		"desktop.function.reference-prompt",
		"desktop.function.run-context",
		"desktop.function.unit-links",
		"desktop.service.project-run",
		"desktop.store.project-agent",
		"desktop.store.thread-run"
	],
	"states": [
		{
			"id": "reference-functions",
			"title": "References read, resolved and listed in prompts",
			"coverage": "required"
		},
		{
			"id": "change-notice",
			"title": "Change reply and owned units kept in the notice",
			"coverage": "required"
		},
		{
			"id": "creation-reply",
			"title": "Checked creation notes or plain question said in public",
			"coverage": "required"
		},
		{
			"id": "question",
			"title": "Thread question with linked and unknown references",
			"coverage": "required"
		},
		{
			"id": "stream",
			"title": "Split streamed text and run progress linked when whole",
			"coverage": "required"
		},
		{
			"id": "pinned",
			"title": "Reference at a pinned commit keeps that commit",
			"coverage": "required"
		},
		{
			"id": "hosted-comment",
			"title": "Shared project comment with a link and no agent",
			"coverage": "required"
		},
		{
			"id": "agent-reply",
			"title": "Project agent public reply with linked units",
			"coverage": "required"
		}
	],
	"viewports": [
		{
			"id": "desktop",
			"width": 1440,
			"height": 900
		},
		{
			"id": "tablet",
			"width": 768,
			"height": 1024
		},
		{
			"id": "mobile",
			"width": 390,
			"height": 844
		}
	],
	"tests": [
		{
			"id": "reference-parsing",
			"kind": "unit",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/entity-references.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 180000
		},
		{
			"id": "reference-grammar",
			"kind": "unit",
			"runner": "command",
