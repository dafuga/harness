	"states": [
		{
			"id": "context-rotation",
			"title": "Harness stops over-threshold sessions and resumes from a bounded checkpoint",
			"coverage": "required"
		},
		{
			"id": "contract-admission",
			"title": "Only wanted-contract tasks enter the committed queue",
			"coverage": "required"
		},
		{
			"id": "assigned-worker",
			"title": "Assigned model, intelligence and trusted checks run in isolated worktrees",
			"coverage": "required"
		},
		{
			"id": "provider-platform",
			"title": "Explicit Linux task commands use the offline Docker policy and macOS commands use the native runtime",
			"coverage": "required"
		},
		{
			"id": "quota-fallback",
			"title": "Confirmed provider quota switches auto tasks to the other provider",
			"coverage": "required"
		},
		{
			"id": "owner-recovery",
			"title": "Active owners are preserved and abandoned claims remain in history",
			"coverage": "required"
		},
		{
			"id": "usage-pricing",
			"title": "Models, tokens and API pricing retain reported and unknown values",
			"coverage": "required"
		},
		{
			"id": "reviewed-repairs",
			"title": "Incomplete reviews retain work and requeue once before acceptance",
			"coverage": "required"
		},
		{
			"id": "run-records",
			"title": "Shared run records and cost-aware model recommendations",
			"coverage": "required"
		},
		{
			"id": "verified-acceptance",
			"title": "Acceptance cites a verified commit carrying the submission; resent verdicts replay",
			"coverage": "required"
		},
		{
			"id": "dispatch-preflight",
			"title": "Workers block on unwritable worktrees, missing tools and exhausted quota before claiming",
			"coverage": "required"
		}
	],
