{
	"schemaVersion": 1,
	"id": "agent-creation",
	"title": "Conversational creation of reviewable entities",
	"kind": "ui",
	"units": [
		"desktop.component.agent-controls",
		"desktop.component.catalog-view",
		"desktop.component.composer",
		"desktop.component.entity-view",
		"desktop.component.project-agent",
		"desktop.component.workspace-shell",
		"desktop.function.created-thread",
		"desktop.function.ipc-payload",
		"desktop.function.planning-writes",
		"desktop.function.prepare-project-run",
		"desktop.function.project-proposal",
		"desktop.model.desktop-bridge-types",
		"desktop.service.desktop-run",
		"desktop.service.project-run",
		"desktop.store.project-agent",
		"desktop.component.agents-providers-chat-agents"
	],
	"states": [
		{
			"id": "boundary-tests",
			"title": "Persisted plans and refused unsafe requests",
			"coverage": "required"
		},
		{
			"id": "catalog",
			"title": "Creation-free catalog and bottom-right launcher",
			"coverage": "required"
		},
		{
			"id": "request",
			"title": "Prompt with selected provider and model",
			"coverage": "required"
		},
		{
			"id": "conversation",
			"title": "Responsive agent conversation",
			"coverage": "required"
		},
		{
			"id": "compact-agent-functions",
			"title": "Adding a function, the project agent composer keeps at most 115 px below the message, with model and effort",
			"coverage": "required",
			"units": [
				"desktop.component.composer",
				"desktop.component.agent-controls",
				"desktop.component.project-agent"
			]
		},
		{
			"id": "compact-agent-components",
			"title": "Adding a component, the composer keeps at most 115 px below the message with model and effort icons; it sends the count saved on Settings",
			"coverage": "required",
			"units": [
				"desktop.component.composer",
				"desktop.component.agent-controls",
				"desktop.component.project-agent"
			]
		},
		{
			"id": "chat-agents",
			"title": "Project chat lists registered sessions and module ownership while preserving drafts",
			"coverage": "required",
			"units": ["desktop.component.project-agent", "desktop.component.agents-providers-chat-agents"]
		}
	],
	"viewports": [
		{
			"id": "desktop",
			"width": 1440,
			"height": 900
		},
		{
			"id": "tablet",
			"width": 768,
			"height": 1024
		},
		{
			"id": "mobile",
			"width": 390,
			"height": 844
		},
		{
			"id": "agent-phone",
			"width": 390,
			"height": 900
		},
		{
			"id": "agents-tablet",
			"width": 920,
			"height": 900
		}
	],
	"tests": [
		{
			"id": "creation-persistence",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/project-conversation.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 180000
		},
		{
			"id": "creation-boundaries",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/project-conversation-boundaries.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 180000
		},
		{
			"id": "creation-ownership",
			"kind": "integration",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts vitest test/project-conversation-ownership.test.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 180000
		},
		{
			"id": "creation-ui",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/ui-agent-creation.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		},
		{
			"id": "compact-agent-ui",
			"kind": "e2e",
			"runner": "command",
			"target": "bun ../../test/verification-output.ts playwright tests/e2e/compact-agent.spec.ts",
			"cwd": "packages/desktop",
			"timeoutMs": 240000
		}
	],
	"evidence": [
		{
			"id": "creation-runner-output",
			"kind": "output",
			"states": [
				"boundary-tests",
				"catalog",
				"request",
				"conversation",
				"compact-agent-functions",
				"compact-agent-components"
			],
			"viewports": [],
			"required": true
		},
		{
			"id": "creation-assertions",
			"kind": "assertions",
			"states": ["boundary-tests"],
			"viewports": [],
			"required": true
		},
		{
			"id": "creation-catalog",
			"kind": "screenshot",
			"states": ["catalog"],
			"viewports": ["desktop"],
			"required": true,
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "full-page"
		},
		{
			"id": "creation-request",
			"kind": "screenshot",
			"states": ["request"],
			"viewports": ["desktop"],
			"required": true,
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "full-page"
		},
		{
			"id": "creation-conversation",
			"kind": "screenshot",
			"states": ["conversation"],
			"viewports": ["tablet", "mobile"],
			"required": true,
			"provenance": "actual-capture",
			"build": "desktop-renderer",
			"capture": "full-page"
		},
		{
			"id": "creation-compact",
			"kind": "screenshot",
			"states": ["compact-agent-functions", "compact-agent-components"],
			"viewports": ["desktop", "agent-phone"],
			"required": true,
			"build": "desktop-renderer",
			"capture": "viewport"
		},
		{
			"id": "chat-agents",
			"kind": "screenshot",
			"states": ["chat-agents"],
			"viewports": ["desktop", "agents-tablet", "agent-phone"],
			"required": true,
			"build": "desktop-renderer",
			"capture": "viewport"
		}
	]
}
