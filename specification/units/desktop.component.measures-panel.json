{
	"schemaVersion": 1,
	"id": "desktop.component.measures-panel",
	"kind": "component",
	"title": "Measures panel",
	"responsibility": "Displays recorded size and performance without estimating missing measurements.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.shared-primitives-atoms-html-h2",
