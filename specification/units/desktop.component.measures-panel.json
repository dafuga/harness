		"origin": "declared",
		"primitives": ["reports.component.shared-primitives-detail-list"],
		"inputs": [
			{
				"name": "MeasuresPanel.size",
				"type": "Measure",
				"required": true,
				"description": "Required measure whose nonempty text is displayed, otherwise Not measured. Its available flag controls measured styling."
			},
			{
				"name": "MeasuresPanel.performance",
				"type": "Measure",
				"required": true,
				"description": "Required performance measure with the same text fallback; available controls measured styling."
			}
		],
		"outputs": [
			{
				"name": "MeasuresPanel",
				"type": "markup",
				"description": "Size & performance panel with the two supplied values. Does not calculate measurements or infer availability from displayed text. Throws nothing: a measure without text is shown as Not measured. Catalog states: default (both measured), not-measured (both not taken) and mixed (size measured, performance not taken)."
			}
		],
