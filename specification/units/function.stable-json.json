{
	"schemaVersion": 1,
	"id": "function.stable-json",
	"kind": "function",
	"title": "Formatted JSON output",
	"responsibility": "Formats JSON-shaped data using the project’s tab-indented layout and short primitive-array style.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/utils/development-tooling/stableJson.ts",
			"src/utils/development-tooling/stableJson.types.ts",
			"src/utils/stableJson.ts"
		],
		"symbols": ["stableJson", "Position", "stableJson"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "stableJson.value",
				"type": "unknown",
				"description": "JSON-shaped value to render; undefined object fields are omitted, while nullish values elsewhere become null."
			}
		],
		"outputs": [
			{
				"name": "stableJson",
				"type": "string",
				"description": "Formatted text with a trailing newline. Objects retain entry order; primitive arrays stay inline when they fit the 100-column layout calculation, otherwise values expand with tabs."
			}
		],
		"errors": [
			{
				"name": "Error",
				"type": "thrown",
				"description": "An enumerable getter can throw while stableJson reads object entries, and the original error propagates."
			},
			{
				"name": "TypeError",
				"type": "thrown",
				"description": "BigInt values have no JSON form, so JSON.stringify throws a TypeError."
			}
		]
	},
	"dependencies": [],
	"runtime": {
		"kind": "module",
		"entry": "src/utils/development-tooling/stableJson.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/utils/development-tooling/stableJson.ts"
			}
		]
	},
	"scenarios": [],
	"testing": {
		"version": 1,
		"shape": "helper",
		"examples": [
			{
				"subject": "stableJson",
				"name": "Match the project Prettier style across escaped text and width boundaries",
				"call": "stableJson(prettierRepresentative())",
				"input": [
					{
						"$fixture": "prettier-workload",
						"value": {
							"text": "quotes \" and \\ slashes / plus\nnewlines",
							"flag": true,
							"none": null,
							"count": 12.5
						}
					}
				],
				"expected": {
					"kind": "value",
					"value": "{\n\t\"text\": \"quotes \\\" and \\\\ slashes / plus\\nnewlines\",\n\t\"flag\": true,\n\t\"none\": null,\n\t\"count\": 12.5\n}\n"
				}
			},
			{
				"subject": "stableJson",
				"name": "Preserve object order and a trailing newline",
				"call": "stableJson({ b: 1, a: [true, null] })",
				"input": [
					{
						"b": 1,
						"a": [true, null]
					}
				],
				"expected": {
					"kind": "value",
					"value": "{\n\t\"b\": 1,\n\t\"a\": [true, null]\n}\n"
				}
			},
			{
				"subject": "stableJson",
				"name": "Render an empty array",
				"call": "stableJson([])",
				"input": [
					[]
				],
				"expected": {
					"kind": "value",
					"value": "[]\n"
				}
			},
			{
				"subject": "stableJson",
				"name": "Render an empty object",
				"call": "stableJson({})",
				"input": [
					{}
				],
				"expected": {
					"kind": "value",
					"value": "{}\n"
				}
			},
			{
				"subject": "stableJson",
				"name": "Render a null primitive",
				"call": "stableJson(null)",
				"input": [null],
				"expected": {
					"kind": "value",
					"value": "null\n"
				}
			},
			{
				"subject": "stableJson",
				"name": "Render a string primitive",
				"call": "stableJson('plain')",
				"input": ["plain"],
				"expected": {
					"kind": "value",
					"value": "\"plain\"\n"
				}
			},
			{
				"subject": "stableJson",
				"name": "Render top-level undefined as null",
				"call": "stableJson(undefined)",
				"input": [
					{
						"$fixture": "undefined"
					}
				],
				"expected": {
					"kind": "value",
					"value": "null\n"
				}
			},
			{
				"subject": "stableJson",
				"name": "Omit undefined object fields and write array items as null",
				"call": "stableJson({ visible: true, missing: undefined, items: [1, undefined, 3] })",
				"input": [
					{
						"visible": true,
						"missing": {
							"$fixture": "undefined"
						},
						"items": [
							1,
							{
								"$fixture": "undefined"
							},
							3
						]
					}
				],
				"expected": {
					"kind": "value",
					"value": "{\n\t\"visible\": true,\n\t\"items\": [1, null, 3]\n}\n"
				}
			},
			{
				"subject": "stableJson",
				"name": "Read an enumerable getter through its current value",
				"call": "stableJson({ computed: getter })",
				"input": [
					{
						"computed": {
							"$fixture": "getter",
							"value": "from getter"
						}
					}
				],
				"expected": {
					"kind": "value",
					"value": "{\n\t\"computed\": \"from getter\"\n}\n"
				}
			},
			{
				"subject": "stableJson",
				"name": "Read own keys while preserving a prototype and iterator",
				"call": "stableJson(iterableWithPrototype())",
				"input": [
					{
						"$fixture": "prototype-and-iterator",
						"fields": {
							"own": "kept"
						}
					}
				],
				"expected": {
					"kind": "value",
					"value": "{\n\t\"own\": \"kept\"\n}\n"
				}
			},
			{
				"subject": "stableJson",
				"name": "Propagate an enumerable getter error",
				"call": "stableJson({ invalid: throwingGetter })",
				"input": [
					{
						"invalid": {
							"$fixture": "throwing-getter",
							"message": "invalid property"
						}
					}
				],
				"expected": {
					"kind": "error",
					"value": {
						"name": "Error",
						"message": "invalid property"
					}
				}
			},
			{
				"subject": "stableJson",
				"name": "Reject a BigInt input because JSON cannot carry it",
				"call": "stableJson(1n)",
				"input": [
					{
						"$fixture": "bigint",
						"value": "1"
					}
				],
				"expected": {
					"kind": "error",
					"value": {
						"name": "TypeError",
						"message": "Do not know how to serialize a BigInt"
					}
				}
			}
		],
		"states": ["input", "boundary", "admission", "invalid"],
		"props": ["value"],
		"cases": [
			{
				"id": "stable-json.prettier-style",
				"state": "boundary",
				"subject": "stableJson",
				"example": "Match the project Prettier style across escaped text and width boundaries",
				"fixture": "specification/units/function.stable-json.json",
