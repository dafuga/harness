	"kind": "component",
	"title": "Audio upload files",
	"responsibility": "Provides the file inputs for a single recording or a before/after pair.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
		"uses": [
			"reports.component.shared-primitives-atoms-html-div",
