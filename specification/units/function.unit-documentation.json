{
	"schemaVersion": 1,
	"id": "function.unit-documentation",
	"uid": "u_lyivsufqmy",
	"kind": "function",
	"title": "Read committed usage documentation",
	"responsibility": "Reads expected usage examples from one entity’s committed Markdown document without borrowing another revision.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/services/explorer-ui/revision-detail-service/unitDocumentation.ts",
			"src/services/revision-detail-service/unitDocumentation.ts",
			"src/utils/explorer-ui/unit-documentation/unitDocumentation.ts",
			"src/utils/explorer-ui/unit-documentation/unitDocumentation.types.ts",
			"src/utils/unit-documentation/unitDocumentation.ts",
			"src/utils/unitDocumentation.ts"
		],
		"symbols": [
			"hydrateUnitDocumentation",
			"hydrateUnitDocumentation",
			"unitDocumentation",
			"readUnitDocumentation",
			"UsageExample",
			"UnitDocumentation",
			"UsageExample",
			"UnitDocumentation",
			"unitDocumentation",
			"readUnitDocumentation",
			"UsageExample",
			"UnitDocumentation",
			"unitDocumentation",
			"readUnitDocumentation",
			"hydrateUnitDocumentation"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "hydrateUnitDocumentation.tree",
				"type": "Pick<SourceTree, 'read'>",
				"required": true,
				"description": "Revision-pinned reader used to load each declared document.",
				"examples": [
					{
						"revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
					}
				]
			},
			{
				"name": "hydrateUnitDocumentation.units",
				"type": "Array<{ id: string; documentation?: UnitDocumentation }>",
				"required": true,
				"description": "Entity views whose declared documentation paths should be replaced with parsed documents.",
				"examples": [
					[
						{
							"id": "app.component.toolbar",
							"documentation": {
								"path": "src/components/toolbar/usage.md"
							}
						}
					]
				]
			},
			{
				"name": "unitDocumentation.text",
				"type": "string",
				"required": true,
				"description": "Committed Markdown containing the unit identity and its expected usage examples.",
				"examples": [
					"# Toolbar\n\n```harness-examples\n{\"schemaVersion\": 1, \"unitId\": \"app.component.toolbar\", \"examples\": [{\"name\": \"Empty toolbar\", \"input\": {\"items\": []}, \"output\": \"No actions\"}]}\n```\n"
				]
			},
			{
				"name": "unitDocumentation.unitId",
				"type": "string",
				"required": true,
				"description": "Registered entity that the document must describe.",
				"examples": ["app.component.toolbar"]
			},
			{
				"name": "unitDocumentation.path",
				"type": "string",
				"required": false,
				"default": "",
				"description": "Repository-relative path of that entity’s committed document.",
				"examples": ["src/components/toolbar/usage.md"]
			},
			{
				"name": "readUnitDocumentation.tree",
				"type": "Pick<SourceTree, 'read'>",
				"required": true,
				"description": "Reader pinned to the selected Git revision; working-tree files are never substituted.",
				"examples": [
					{
						"revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
					}
				]
			},
			{
				"name": "readUnitDocumentation.unit",
				"type": "{ id: string; documentation?: string }",
				"required": true,
				"description": "Registered unit and its optional committed documentation path.",
				"examples": [
					{
						"id": "app.component.toolbar",
						"documentation": "src/components/toolbar/usage.md"
					}
				]
			}
		],
		"outputs": [
			{
				"name": "unitDocumentation",
				"type": "UnitDocumentation",
				"description": "Parsed unit usage document with expected examples and any format problems.",
				"examples": [
					{
						"path": "src/components/toolbar/usage.md",
						"text": "# Toolbar\n\n```harness-examples\n{\"schemaVersion\": 1, \"unitId\": \"app.component.toolbar\", \"examples\": [{\"name\": \"Empty toolbar\", \"input\": {\"items\": []}, \"output\": \"No actions\"}]}\n```\n",
						"examples": [
							{
								"name": "Empty toolbar",
								"input": {
									"items": []
								},
								"output": "No actions"
							}
						]
					}
				]
			},
			{
				"name": "readUnitDocumentation",
				"type": "Promise<UnitDocumentation | undefined>",
				"description": "The parsed committed document, or undefined when no document was declared or readable.",
				"examples": [
					{
						"path": "src/components/toolbar/usage.md",
						"text": "# Toolbar\n\n```harness-examples\n{\"schemaVersion\": 1, \"unitId\": \"app.component.toolbar\", \"examples\": [{\"name\": \"Empty toolbar\", \"input\": {\"items\": []}, \"output\": \"No actions\"}]}\n```\n",
						"examples": [
							{
								"name": "Empty toolbar",
								"input": {
									"items": []
								},
								"output": "No actions"
							}
						]
					}
				]
			},
			{
				"name": "hydrateUnitDocumentation",
				"type": "Promise<void>",
				"description": "Attaches parsed documentation to the supplied entity views; resolves without a return value.",
				"examples": [null]
			}
		],
		"errors": [],
