{
	"schemaVersion": 1,
	"id": "reports.component.harness-explorer-index",
	"kind": "component",
	"title": "Entity catalog",
	"responsibility": "Groups and searches a category’s entities with accessible status and empty-state guidance.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/explorer-index/ExplorerIndex.svelte",
			"packages/reports/src/components/explorer-ui/explorer-index/catalogGroups.ts"
		],
		"symbols": ["ExplorerIndex", "catalogSections", "catalogGroups"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ExplorerIndex.category",
				"type": "ExplorerCategory",
				"description": "Required category used for headings, icon and explanatory text."
			},
			{
				"name": "ExplorerIndex.rows",
				"type": "CatalogRow[]",
				"description": "Required complete category rows before filtering."
			},
			{
				"name": "ExplorerIndex.list",
				"type": "Snippet<[CatalogRow[]]>",
				"description": "Required snippet receiving filtered/sorted rows to render as cards or table."
			}
		],
		"outputs": [
			{
				"name": "ExplorerIndex",
				"type": "markup",
				"description": "Catalog with a local search field and alphabetical ordering. Shows count status, distinct no-registry/no-match states and a Show all action that clears search. Adds verification legend and category-specific guidance."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.component.harness-explorer-controls",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.harness-harness-icon",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.harness-harness-verdict",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.entity-catalog",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.entity-lens",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.harness-icons",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.explorer-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/components/explorer-ui/explorer-index/ExplorerIndex.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/components/explorer-ui/explorer-index/ExplorerIndex.svelte"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
