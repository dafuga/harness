				"type": "CatalogRow[]",
				"description": "Required complete category rows before filtering."
			},
			{
				"name": "ExplorerIndex.list",
				"type": "Snippet<[CatalogRow[]]>",
				"description": "Required snippet receiving filtered/sorted rows to render as cards or table."
			}
		],
		"outputs": [
			{
				"name": "ExplorerIndex",
				"type": "markup",
				"description": "Searchable alphabetical catalog with one source-file section per config and responsibility sections for other kinds. Retains count status, explicit empty states and a clear-search action. Catalog rows are presented without a standalone proof legend footer."
