		"inputs": [
			{
				"name": "ExplorerDependenciesScreen.index",
				"type": "HarnessIndex",
				"required": true,
				"description": "Project and branch history supplied by the Explorer host."
			},
			{
				"name": "ExplorerDependenciesScreen.head",
				"type": "HarnessRevision",
				"required": true,
				"description": "Selected immutable revision; its dependency inventory is rendered without borrowing another revision."
			},
			{
				"name": "ExplorerDependenciesScreen.parent",
				"type": "HarnessRevision | null",
				"required": true,
				"description": "First parent used by the shared Explorer frame; null at a branch tip or first commit."
			},
			{
				"name": "ExplorerDependenciesScreen.scope",
				"type": "ExplorerScope",
				"required": true,
				"description": "Selected branch, commit and availability context used by the shared frame."
			},
			{
				"name": "ExplorerDependenciesScreen.route",
				"type": "ExplorerLocation",
				"required": true,
				"description": "Current Dependencies screen address, including selected branch and optional commit."
			},
			{
				"name": "ExplorerDependenciesScreen.entities",
				"type": "ExplorerEntity[]",
				"required": true,
				"description": "Revision-scoped entity catalog supplied to the shared Explorer frame."
			},
			{
				"name": "ExplorerDependenciesScreen.lens",
				"type": "EntityLens",
				"required": true,
				"description": "Host readers for entity contracts, measurements and captured evidence."
			},
			{
				"name": "ExplorerDependenciesScreen.client",
				"type": "Pick<HarnessClient, 'revision'>",
				"required": true,
				"description": "Revision loader used by the shared Explorer frame for historical navigation."
			},
			{
				"name": "ExplorerDependenciesScreen.mediaBase",
				"type": "string",
				"required": true,
				"description": "Base URL from which the shared frame resolves captured media."
			},
			{
				"name": "ExplorerDependenciesScreen.onroute",
				"type": "(to: ExplorerLocation) => void",
				"required": true,
				"description": "Requests navigation while preserving the selected explorer scope."
			}
		],
		"outputs": [
			{
				"name": "ExplorerDependenciesScreen",
				"type": "markup",
				"description": "Searchable direct package declarations grouped by ecosystem, with version requirements, dependency types, declaring workspaces and explicit unavailable-data messages."
			}
		],
