		"inputs": [
			{
				"name": "ExplorerDependenciesScreen.index",
				"type": "HarnessIndex",
				"required": true,
				"description": "Project and branch context supplied to the shared Explorer frame; this component does not read index fields when building the dependency inventory."
			},
			{
				"name": "ExplorerDependenciesScreen.head",
				"type": "HarnessRevision",
				"required": true,
				"description": "The selected revision passed to the shared Explorer frame. This screen reads dependencies only from head.projectDependencies; when that record is absent it shows the pre-index empty state and does not borrow data from the working copy."
			},
			{
				"name": "ExplorerDependenciesScreen.parent",
				"type": "HarnessRevision | null",
				"required": true,
				"description": "Parent revision context, or null, passed to the shared Explorer frame. Dependency rows are read from the selected head record rather than derived from the parent.",
				"examples": [[null]]
			},
			{
				"name": "ExplorerDependenciesScreen.scope",
				"type": "ExplorerScope",
				"required": true,
				"description": "Selected explorer scope passed through to the shared Explorer frame; this component does not use it to select or filter dependency declarations."
			},
			{
				"name": "ExplorerDependenciesScreen.route",
				"type": "ExplorerLocation",
				"required": true,
				"description": "Current Explorer location passed through to the shared frame for navigation. This component does not parse route fields to build the dependency inventory."
			},
			{
				"name": "ExplorerDependenciesScreen.entities",
				"type": "ExplorerEntity[]",
				"required": true,
				"description": "Revision-scoped entity catalog passed to the shared Explorer frame. Dependency declarations on this screen come from head.projectDependencies, not from the entity catalog.",
				"examples": [[]]
			},
			{
				"name": "ExplorerDependenciesScreen.lens",
				"type": "EntityLens",
				"required": true,
				"description": "Host readers for entity contracts, measurements, and captured evidence passed to the shared frame. This component does not call them to build dependency rows."
			},
			{
				"name": "ExplorerDependenciesScreen.client",
				"type": "Pick<HarnessClient, 'revision'>",
				"required": true,
				"description": "The revision-loading capability passed to the shared frame for shared revision navigation; this component does not load revisions itself."
			},
			{
				"name": "ExplorerDependenciesScreen.mediaBase",
				"type": "string",
				"required": true,
				"description": "Base URL passed to the shared frame for captured media; this component does not resolve media URLs itself.",
				"examples": ["/"]
			},
			{
				"name": "ExplorerDependenciesScreen.onroute",
				"type": "(to: ExplorerLocation) => void",
				"required": true,
				"description": "Navigation callback passed to the shared frame. The dependency search does not invoke it."
			}
		],
		"outputs": [
			{
				"name": "ExplorerDependenciesScreen",
				"type": "markup",
				"description": "Searchable direct declarations from head.projectDependencies are grouped by ecosystem, package name, manifest version, and dependency kind; each row lists its workspace label, falling back to source, that declares it. Search is trimmed and case-insensitive over names, versions, kinds, workspace labels, and manifest sources or conditions; versions are manifest requirements rather than resolved installs, and missing records or unreadable manifests are reported without borrowing data from the working copy."
			}
		],
