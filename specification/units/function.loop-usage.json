									"status": "complete"
								},
								{
									"id": "verify-recovery",
									"title": "Verify recovery",
									"status": "complete"
								}
							]
						}
					]
				]
			}
		],
		"outputs": [
			{
				"name": "loopUsage",
				"type": "{ total: number; types: LoopUsage[] }",
				"description": "An object with the number of input loops in total and one LoopUsage summary per template in types. Groups sort by descending count then ascending locale order of template; complete requires at least one step and all steps complete, open is the remainder, lastUsedAt is the latest updatedAt, and names holds at most five names ordered by latest update.",
