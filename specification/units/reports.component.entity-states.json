			{
				"name": "EntityStates.mediaBase",
				"type": "string",
				"required": false,
				"default": "",
				"description": "Optional prefix for prebuilt media assets, defaulting to an empty string. It is passed to EvidenceCard and EvidenceViewer as their asset base only when resolveImage is omitted; when resolveImage is given, the asset base is empty and mediaBase is ignored.",
				"examples": ["/harness/media/"]
			},
			{
				"name": "EntityStates.resolveImage",
				"type": "(item: Evidence) => Promise<string>",
				"required": false,
				"default": "undefined (omitted)",
				"description": "Optional bridge callback, undefined by default, that receives each recorded capture and resolves to the file to show in its place; when it is omitted, mediaBase resolves image paths. A rejected promise becomes a missing-capture note showing the error message, or 'Capture could not be loaded.' when the rejection is not an Error."
			}
		],
		"outputs": [
			{
				"name": "EntityStates",
				"type": "markup",
				"description": "The States gallery for the selected scenario: one card per state of that scenario with its Before and After or Current captures, a Viewport select when a viewport is available, a Scenario select only when there is more than one scenario, a Notice that joins the incomparable notes, a Notice for each state whose coverage is not required and a Notice for each missing capture. Opening a capture shows it at full size in an EvidenceViewer."
			}
		],
		"errors": [
			{
				"name": "each_key_duplicate",
				"type": "thrown",
				"description": "Svelte throws this runtime error when two items of one keyed list share a key: scenario IDs among the scenarios with viewports, viewport IDs of the selected scenario, or the state rows' scenario, state and viewport key, which repeats when one state ID is declared twice in a scenario."
			}
		],
