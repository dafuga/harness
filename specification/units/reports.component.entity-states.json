		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/EntityStates.svelte",
			"packages/reports/src/components/explorer-ui/EntityStates.svelte"
		],
		"symbols": ["EntityStates", "EntityStates"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityStates.name",
				"type": "string",
				"description": "The readable entity name used to label the gallery.",
				"examples": ["Activity list"]
			},
			{
				"name": "EntityStates.evidence",
				"type": "ExplorerEvidence",
				"description": "Declared states and verified captures for this entity on both revision sides."
			},
			{
				"name": "EntityStates.scope",
				"type": "ExplorerScope",
				"description": "The viewed branch tip or commit and its parent, without changing their identity."
			},
			{
				"name": "EntityStates.mediaBase",
				"type": "string",
				"description": "Optional prefix for prebuilt media assets; empty when a bridge resolves images.",
				"examples": ["/harness/media/"]
			},
			{
				"name": "EntityStates.resolveImage",
				"type": "(item: Evidence) => Promise<string>",
				"description": "Optional bridge callback that returns an image URL only after validating the artifact bytes."
			}
		],
		"outputs": [
			{
				"name": "EntityStates",
				"type": "markup",
				"description": "Screenshot gallery with named states, viewport selection, revision labels, explicit gaps and full-size previews."
			}
		],
		"errors": []
	},
