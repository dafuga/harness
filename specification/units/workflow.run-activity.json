{
	"schemaVersion": 1,
	"id": "workflow.run-activity",
	"kind": "workflow",
	"title": "runActivity",
	"responsibility": "Runs the activity commands for the checkout they are called in: show, register, heartbeat, finish and list.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["src/workflows/runActivity.ts"],
		"symbols": [
			"Shown",
			"activityRoot",
			"showActivity",
			"registerAgent",
			"beatAgent",
			"finishAgent",
			"beatFromEnvironment",
			"listAgents",
			"renderRoster",
			"renderShown"
		]
	},
	"contract": {
		"origin": "derived",
		"inputs": [
			{
				"name": "activityRoot.directory",
				"type": "unknown"
			},
			{
				"name": "showActivity.options",
				"type": "{ limit?: string }"
			},
			{
				"name": "registerAgent.input",
				"type": "AgentInput"
			},
			{
				"name": "beatAgent.id",
				"type": "string"
			},
			{
				"name": "beatAgent.input",
				"type": "AgentInput"
			},
			{
				"name": "finishAgent.id",
				"type": "string"
			},
			{
				"name": "finishAgent.options",
				"type": "{ failed?: boolean; outcome?: string }"
			},
			{
				"name": "beatFromEnvironment.env",
				"type": "unknown"
			},
			{
				"name": "renderRoster.roster",
				"type": "AgentRoster"
			},
			{
				"name": "renderShown.input",
				"type": "Shown"
			}
		],
		"outputs": [
			{
				"name": "activityRoot",
				"type": "Promise<string>"
			},
			{
				"name": "showActivity",
				"type": "Promise<Shown>"
			},
			{
				"name": "registerAgent",
				"type": "unknown"
			},
			{
				"name": "beatAgent",
				"type": "unknown"
			},
			{
				"name": "finishAgent",
				"type": "unknown"
			},
			{
				"name": "beatFromEnvironment",
				"type": "Promise<void>"
			},
			{
				"name": "listAgents",
				"type": "Promise<AgentRoster>"
			},
			{
				"name": "renderRoster",
				"type": "string"
			},
			{
				"name": "renderShown",
				"type": "string"
			}
		],
		"errors": [
			{
				"name": "ExpectedCliError",
				"type": "thrown"
			}
		]
	},
	"dependencies": [
		{
			"unit": "adapter.git",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.activity-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.agent-statement",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.errors",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "repository.project-work",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "service.agent-activity",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "service.project-activity",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/workflows/runActivity.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/workflows/runActivity.ts"
			}
