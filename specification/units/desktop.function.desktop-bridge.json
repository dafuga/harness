{
	"schemaVersion": 1,
	"id": "desktop.function.desktop-bridge",
	"kind": "function",
	"title": "Expose desktop project operations",
	"responsibility": "Connects desktop project, planning, evidence and agent operations to the selected project session.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/lib/desktop-bridge/desktopBridge.ts",
			"packages/desktop/src/lib/development-tooling/desktop-bridge/desktopBridge.ts",
			"packages/desktop/src/lib/development-tooling/desktop-bridge/desktopBridge.types.ts",
			"packages/desktop/src/utils/desktopBridge.ts"
		],
		"symbols": ["desktopBridge", "desktopBridge", "BridgeContext", "desktopBridge"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "desktopBridge.context",
				"type": "BridgeContext",
				"description": "The project session, provider discovery, run service, folder chooser and optional session-liveness check. The folder chooser returns a directory or null for cancellation."
			}
		],
		"outputs": [
			{
				"name": "desktopBridge",
				"type": "Omit<DesktopBridge, 'onRunEvent'>",
				"description": "A desktop operations object without the run-event subscription. Most operations assert any supplied project identity and track a pending request until completion; open, select and list operations are delegated separately. Planning writes are serialized per repository. Opening returns the selected project snapshot or null when cancelled."
			}
		],
		"errors": [
			{
				"name": "Error",
				"type": "thrown",
				"description": "Returned operations can reject stale project context and underlying service failures. Planning changes refuse a busy repository or ended client. Opening a thread refuses an unknown entity; source reading refuses a draft without registered source. Hosted connection refuses when sign-in is not configured."
			}
		]
	},
	"dependencies": [
		{
			"unit": "desktop.function.repository-lease",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.deployment-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-bridge-types",
