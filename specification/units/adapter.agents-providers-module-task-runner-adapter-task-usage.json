		"inputs": [
			{
				"name": "taskUsage.provider",
				"type": "'claude' | 'codex'",
				"required": true,
				"description": "Selects the provider whose usage event is read: 'claude' uses the last event of type 'result', and any other value uses the last event of type 'turn.completed'. The value is not validated at runtime, and only the exact string 'codex' changes how inputTokens is computed.",
				"examples": ["claude", "codex"]
			},
			{
				"name": "taskUsage.events",
				"type": "TaskPublicEvent[]",
				"required": true,
				"description": "The provider's public events in array order; usage and total_cost_usd come from the last event whose type matches the provider (type 'result' for claude, 'turn.completed' for codex), and all other events are ignored. The array is copied before the search, so the caller's array is not modified, and when no matching event exists every field of the result is null.",
				"examples": [
					[
						{
							"type": "assistant"
						},
						{
							"type": "result",
							"subtype": "success",
