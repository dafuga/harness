{
	"schemaVersion": 1,
	"id": "desktop.component.revision-picker",
	"kind": "component",
	"title": "Revision picker",
	"responsibility": "Shows the selected branch, commit or environment with its update time and opens revision choices.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.choice-dialog",
			"desktop.component.icon",
			"reports.component.select",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-label",
			"reports.component.shared-primitives-atoms-html-option",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-atoms-html-time"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/RevisionPicker.svelte",
			"packages/desktop/src/components/shared-primitives/RevisionPicker.svelte"
		],
		"symbols": ["RevisionPicker", "RevisionPicker"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RevisionPicker.workspace",
				"type": "Workspace",
				"description": "Workspace supplying snapshot, revision, branch/commit lists, pinned state and navigation. Values follow the displayed revision. Branch navigation supplies only branch; commit navigation includes both."
			}
		],
		"outputs": [
			{
				"name": "RevisionPicker",
				"type": "markup",
				"description": "One summary line names the branch or explicit short commit hash with its timestamp. For an environment scope, it reads Updated at and the deployment date and time; the selector already names the environment. Icon dialogs select revisions and Go to tip exits a pinned revision."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.choice-dialog",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.icon",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.revision-time",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.workspace",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.select",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-button",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-label",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-option",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-small",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-strong",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-time",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.select",
			"via": "contract",
			"origin": "declared",
			"contract": "The shared Select component supplies keyboard and value selection behavior through the $shared alias."
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/shared-primitives/RevisionPicker.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/shared-primitives/RevisionPicker.svelte"
			}
		]
	},
	"scenarios": ["desktop-native", "desktop-renderer"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
