			"packages/reports/src/components/shared-primitives/image-zoom/ImageZoom.types.ts",
			"packages/reports/src/components/shared-primitives/image-zoom/imageZoom.css"
		],
		"symbols": ["ImageZoom", "Point", "DragStart"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ImageZoom.src",
				"type": "string",
				"required": true,
				"description": "This required string is bound directly to the image element and identifies the source compared when tracking whether that image is loading or failed. The component does not parse or validate the source.",
				"examples": [
					"https://reports.example.com/evidence/inspection-42.jpg",
					"/evidence/inspection-42.jpg"
				]
			},
			{
				"name": "ImageZoom.alt",
				"type": "string",
				"required": true,
				"description": "This required string is bound to the image element's alt attribute for the selected source. The component does not derive or validate its text.",
				"examples": [
					"South elevation showing the installed flashing.",
					"Close-up of the roof framing at the north wall."
				]
			}
		],
		"outputs": [
			{
				"name": "ImageZoom",
				"type": "markup",
				"description": "Renders zoom controls, a fitted image stage, and loading or failure status for the current source; the percentage is shown only after that source loads. Zoom controls provide fit and 1× natural-size actions plus fixed scale steps from 0.25× to 4×, while trackpad controls use the fitted scale as their minimum and 4× as their maximum; mouse dragging pans the image only when zoomed and starts on the image with the primary button."
			}
		],
