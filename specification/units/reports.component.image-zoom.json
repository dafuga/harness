	"kind": "component",
	"title": "Zoomable evidence image",
	"responsibility": "Lets users inspect a recorded image at fitted, actual or enlarged size.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
		"uses": [
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-img",
			"reports.component.shared-primitives-atoms-html-output",
