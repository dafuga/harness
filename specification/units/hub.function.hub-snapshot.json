	"kind": "function",
	"title": "Read a hosted workspace snapshot",
	"responsibility": "Resolve the selected branch and commit and build or reuse a validated read-only catalog snapshot.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["packages/hub/src/routes/api/[...path]/hub-projection-service/hubSnapshot.ts"],
		"symbols": ["hubSnapshot"]
