	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "hubSnapshot.input",
				"type": "{ actor: Actor; source: SourceHistoryAdapter; cache: CollaborationCache; project: ProjectSummary; }",
				"required": true,
				"description": "The actor (its id becomes the cache identity's principalId), the source history adapter, the collaboration cache, and the project summary: its id, name, sourceRepository and role are read, and its collaborationCommit is copied into the identity. This function checks no authorization, so the caller must resolve permissions first; only role decides whether comments are on."
			},
			{
				"name": "hubSnapshot.query",
				"type": "RevisionQuery",
				"required": true,
				"description": "The branch to read: null or an empty string selects main if it is listed, otherwise the first listed branch, and a non-empty name that no listed branch has fails with not-found. The commit: null selects the branch tip, and any other value must already be the full commit id (a value that the source resolves to a different id, such as a ref name, fails with revision-mismatch).",
				"examples": [
					{
						"branch": "main",
						"commit": null
					},
					{
						"branch": "feature/hosted-catalog",
						"commit": "a41f0c9e27d5b3816f04e2c7d9a8b5136e0f4d2c"
					},
