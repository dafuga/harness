	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ChoiceRow.name",
				"type": "string",
				"required": true,
				"description": "Visible name, also available as the button's title when the text is truncated."
			},
			{
				"name": "ChoiceRow.meta",
				"type": "string",
				"required": false,
				"default": "",
				"description": "Secondary label placed beside the name. Defaults to an empty string."
			},
			{
				"name": "ChoiceRow.current",
				"type": "boolean",
				"required": false,
				"default": false,
				"description": "Whether the choice is current and marked as pressed. Defaults to false."
			},
			{
				"name": "ChoiceRow.disabled",
				"type": "boolean",
				"required": false,
				"default": false,
				"description": "Makes the choice unavailable while retaining its displayed name and metadata."
			},
			{
				"name": "ChoiceRow.label",
				"type": "string",
				"required": false,
				"default": "undefined (omitted)",
				"description": "Optional accessible name that describes the action taken when the row is chosen."
			},
			{
				"name": "ChoiceRow.onchoose",
				"type": "() => void",
				"required": true,
				"description": "Runs when the user activates the choice."
			}
		],
		"outputs": [
			{
				"name": "ChoiceRow",
				"type": "markup",
				"description": "Renders a button with the name, optional metadata and current-choice state."
			}
