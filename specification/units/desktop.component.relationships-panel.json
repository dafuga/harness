{
	"schemaVersion": 1,
	"id": "desktop.component.relationships-panel",
	"kind": "component",
	"title": "Used In and Uses",
	"responsibility": "Shows recorded dependencies or the entities recorded as using the current entity.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.icon",
			"desktop.component.plan-badge",
			"desktop.component.workspace-link",
			"reports.component.shared-primitives-atoms-html-article",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-h3",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/RelationshipsPanel.svelte",
			"packages/desktop/src/components/shared-primitives/RelationshipsPanel.svelte"
		],
		"symbols": ["RelationshipsPanel", "RelationshipsPanel"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RelationshipsPanel.relationships",
				"type": "Relationship[]",
				"description": "Required relationships filtered by direction and deduplicated by identifier; the last matching duplicate supplies displayed values. Includes category, title and plan flag."
			},
			{
				"name": "RelationshipsPanel.workspace",
				"type": "Workspace",
				"description": "Workspace used to link known-category entities. Records without a category remain plain text."
			},
			{
				"name": "RelationshipsPanel.direction",
				"type": "Relationship['direction']",
				"description": "Required uses or used-by. Uses groups dependencies by category; used-by produces one Used In list with kind badges."
			}
		],
		"outputs": [
			{
				"name": "RelationshipsPanel",
				"type": "markup",
				"description": "Lists dependencies or users with names, category icons and optional plan badges. Verification marks stay on entity pages. Dependencies are grouped by kind; empty lists explain missing records."
			}
		],
		"errors": []
	},
