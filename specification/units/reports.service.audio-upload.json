{
	"schemaVersion": 1,
	"id": "reports.service.audio-upload",
	"kind": "service",
	"title": "AudioUploadService",
	"responsibility": "Validates and stores single or paired audio evidence in active reports.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/reports/src/services/AudioUploadService.ts",
			"packages/reports/src/services/reports-media/AudioUploadService.ts",
			"packages/reports/src/services/reports-media/AudioUploadService.types.ts"
		],
		"symbols": [
			"AudioUploadService",
			"AudioUploadService",
			"AudioUploadService.constructor",
			"AudioUploadService.upload",
			"AudioUploadService.uploadComparison",
			"AudioUploadInput",
			"AudioComparisonInput",
			"AudioDetails",
			"AudioUploadInput",
			"AudioComparisonInput"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "AudioUploadService.constructor.repository",
				"type": "ReportRepository",
				"description": "Repository holding the target report and its evidence assets."
			},
			{
				"name": "AudioUploadService.upload.reportId",
				"type": "string",
				"description": "Identity of the active report receiving one audio file."
			},
			{
				"name": "AudioUploadService.upload.input",
				"type": "AudioUploadInput",
				"description": "Title, note, source and one audio File; text limits and audio format are validated."
			},
			{
				"name": "AudioUploadService.uploadComparison.reportId",
				"type": "string",
				"description": "Identity of the active report receiving the comparison."
			},
			{
				"name": "AudioUploadService.uploadComparison.input",
				"type": "AudioComparisonInput",
				"description": "Title, note, source and before/after audio Files; both files are validated before either is written."
			}
		],
		"outputs": [
			{
				"name": "AudioUploadService.upload",
				"type": "Promise<Report>",
				"description": "Updated report with one not-proven audio evidence item and the original content-addressed bytes."
			},
			{
				"name": "AudioUploadService.uploadComparison",
				"type": "Promise<Report>",
				"description": "Updated report with before and after audio evidence sharing a comparison identity."
			}
		],
		"errors": [
			{
				"name": "validation",
				"type": "Error",
				"description": "Rejects blank or oversized titles, excessive notes or source, empty or oversized files, unsupported formats and invalid audio content."
			},
			{
				"name": "report-not-active",
				"type": "Error",
				"description": "Rejects uploads when the report is finalizing or finalized."
			},
			{
				"name": "repository",
				"type": "Error",
				"description": "Propagates invalid or absent report identities and repository failures."
			}
		]
	},
	"dependencies": [
		{
			"unit": "reports.function.audio-asset",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.report-assets",
