{
	"schemaVersion": 1,
	"id": "desktop.component.remote-approval",
	"kind": "component",
	"title": "Remote approval",
	"responsibility": "Lets a computer user grant selected projects and optional agent permission to a requesting phone.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.select",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-fieldset",
			"reports.component.shared-primitives-atoms-html-input",
			"reports.component.shared-primitives-atoms-html-label",
			"reports.component.shared-primitives-atoms-html-option",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/RemoteApproval.svelte",
			"packages/desktop/src/components/networking-security/RemoteApproval.svelte"
		],
		"symbols": ["RemoteApproval", "RemoteApproval"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RemoteApproval.request",
				"type": "RemotePairingRequest",
				"description": "Required phone request supplying name, platform, device identity and pairing identity. Approval sends both displayed identities; denial sends the pairing identifier."
			},
			{
				"name": "RemoteApproval.projects",
				"type": "{ id: string; name: string }[]",
				"description": "Required project choices; none are initially selected. An empty list explains that a local project is needed."
			},
			{
				"name": "RemoteApproval.store",
				"type": "RemoteHost",
				"description": "Host state providing busy and approve/deny operations. Approval receives selected project identifiers and agents=false unless explicitly checked. Operation failures are delegated to this store."
			}
		],
		"outputs": [
			{
				"name": "RemoteApproval",
				"type": "markup",
				"description": "Request fieldset showing phone identity, project checkboxes and Plan/Change permission. Approve is disabled while busy or without a chosen project; Deny is disabled while busy. Submits exactly the selected project list and agent flag."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.function.remote-labels",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.environment-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.remote-host",
