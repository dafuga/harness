{
	"schemaVersion": 1,
	"id": "desktop.model.desktop-bridge-types",
	"kind": "model",
	"title": "DesktopBridge",
	"responsibility": "Owns desktop bridge request and channel models.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/models/DesktopBridge.types.ts",
			"packages/desktop/src/models/development-tooling/DesktopBridge.types.ts",
			"packages/desktop/src/models/development-tooling/DesktopBridgeValues.ts"
		],
		"symbols": [
			"channels",
			"runEventChannel",
			"cacheEventChannel",
			"ChannelName",
			"RevisionQuery",
			"EntityQuery",
			"SourceQuery",
			"SourceFile",
			"ImageQuery",
			"ProposedContract",
			"PlanDraft",
			"ThreadDraft",
			"ThreadQuery",
			"ApprovalDraft",
			"FeaturePlanSelection",
			"FeaturePlanApproval",
			"RunRequest",
			"ProjectRunRequest",
			"DesktopBridge",
			"CreatedEntity",
			"RunPhase",
			"RunEvent",
			"ProjectTaskRequest",
			"channels",
			"runEventChannel",
			"cacheEventChannel",
			"CreatedEntity",
			"RunPhase",
			"RunEvent",
			"ProjectTaskRequest",
			"channels",
			"runEventChannel",
			"cacheEventChannel"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RunRequest",
				"type": "ProjectContext & {environment?:DeploymentEnvironment,mode:\"plan\"|\"change\",provider:\"codex\"|\"claude\",model:string,effort:string|null,entityId:string,threadId:string,text:string,approval:Omit<ApprovalDraft,\"entityId\">|null,designOptions?:number}",
				"description": "designOptions is plan-only, 1–10/default 3; no explicit reference selector is declared."
			},
			{
				"name": "ApprovalDraft",
				"type": "ProjectContext & {entityId:string,version:string,imageHashes:string[],contractHash:string,option?:string}",
				"description": "Option is required for an optioned version."
			},
			{
				"name": "ImageQuery",
				"type": "EntityQuery & {version:string,sha256:string}",
				"description": "EntityQuery binds entityId and commit; ImageQuery has no option field."
			},
			{
				"name": "FeaturePlanSelection",
				"type": "{projectId:string,feature:string,page:string,option:string,expectedDigest:string}",
				"description": "Names the selected project, page option and exact current feature-plan digest."
			},
			{
				"name": "FeaturePlanApproval",
				"type": "{projectId:string,feature:string,reviewer:string,expectedDigest:string}",
				"description": "Names the selected project, reviewer and exact current feature-plan digest."
			}
		],
		"outputs": [
			{
				"name": "entity",
				"type": "(input:EntityQuery)=>Promise<EntityDetail>"
			},
			{
				"name": "image",
				"type": "(input:ImageQuery)=>Promise<Uint8Array>"
			},
			{
				"name": "approve",
				"type": "(input:ApprovalDraft)=>Promise<ApprovalInfo>"
			},
			{
				"name": "channels",
				"type": "unknown",
				"description": "Typed desktop channel map; projectWork uses project:work."
			},
			{
				"name": "runEventChannel",
				"type": "unknown"
			},
			{
				"name": "cacheEventChannel",
				"type": "unknown"
			},
			{
				"name": "projectWork",
				"type": "optional (input:{projectId:string})=>Promise<FeatureWorkSnapshot>",
				"description": "Reads one project-scoped committed feature-work snapshot when supported by the host."
			},
			{
				"name": "selectFeaturePlan",
				"type": "optional (input:FeaturePlanSelection)=>Promise<FeaturePlan>",
				"description": "Local desktop feature-plan selection; absent on unsupported hosts."
			},
			{
				"name": "approveFeaturePlan",
				"type": "optional (input:FeaturePlanApproval)=>Promise<FeaturePlan>",
				"description": "Local desktop feature-plan approval and task admission; absent on unsupported hosts."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.model.deployment-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-evidence-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.game-desktop-bridge-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.project-context-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.project-task-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.run-context-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.activity-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "repository.agents-providers-module-task",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "service.agents-providers-feature-work",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "planning.entry.index",
			"via": "contract",
			"origin": "declared",
			"contract": "IPC planning DTOs preserve public versions, approvals, anchors and change targets."
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/models/development-tooling/DesktopBridge.types.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/models/development-tooling/DesktopBridge.types.ts"
			}
		]
	},
	"scenarios": ["desktop-native", "desktop-project-runs", "desktop-renderer", "agent-creation"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
