						}
					}
				]
			},
			{
				"name": "emittedTargets.unit",
				"type": "ComponentManifest",
				"required": true,
				"description": "The unit whose runtime.targets are read: only targets of kind wasm or process are kept, in manifest order, and runtime.kind and runtime.entry are not read. A unit whose targets are all module or http gets an empty list.",
