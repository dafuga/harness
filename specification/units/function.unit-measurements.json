			{
				"name": "unitMeasurements.files",
				"type": "ReadonlyMap<string, SourceFile>",
				"required": true,
				"description": "Source-file facts keyed by path and read only for the unit's owns.source paths: bytes, lines, read state, decision-point blocks, decisions, language and references. A file with read set to false leaves the source sizes unavailable, a file with decisions 'unsupported' is left out of the complexity count, which then becomes partial or unavailable, and a path missing from the map is skipped without a note."
			},
			{
				"name": "unitMeasurements.testedRevision",
				"type": "string",
				"required": true,
				"description": "The revision that every returned measurement is attributed to, copied unchanged into each testedRevision. The code neither checks nor parses it, and the verification record schema requires each measurement's testedRevision to be a full 40-character lowercase hex commit or tree hash.",
				"examples": [
					"8f3a1c9e72b40d5f6a18e4c3b97d02f15e6a4c7b",
					"0d7e4b19a6c2f38e5d01b7a94c6e2f8a3b5d9c71"
				]
			},
			{
				"name": "unitMeasurements.artifacts",
				"type": "BuiltArtifacts",
				"required": false,
				"default": {},
				"description": "Built size and SHA-256 digest of each declared artifact, keyed by its path; it defaults to {}, so every wasm or process target reports an unavailable size. A target's size is the sum of the bytes of its distinct entry paths and is unavailable when any of those paths has no entry, and the digests are copied into the measurement without being checked.",
				"examples": [
					{},
					{
						"dist/wasm/evidence-grid.wasm": {
							"bytes": 183402,
							"sha256": "4e9a1f7c3b8d52e60a9c1d4f7b2e8a35c6d0f1e92b7a4c8d3e5f6a0b1c2d3e4f"
						},
