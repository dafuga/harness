{
	"schemaVersion": 1,
	"id": "reports.component.entity-contract",
	"kind": "component",
	"title": "Typed contract",
	"responsibility": "Shows component fields, callable APIs and source-declared service or model methods with shared parameter, return and example tables.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.contract-example",
			"reports.component.contract-table",
			"reports.component.explorer-ui-explorer-kit-card",
			"reports.component.harness-harness-icon",
			"reports.component.modal",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-h3",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-detail-list"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/entity-contract/EntityContract.svelte",
			"packages/reports/src/components/explorer-ui/entity-contract/entityContract.css"
		],
		"symbols": [
			"EntityContract",
			"EntityContract.summaryRows",
			"EntityContract.label",
			"EntityContract.children",
			"EntityContract.callableSection"
		]
	},
	"contract": {
		"origin": "declared",
		"primitives": [
			"reports.component.explorer-ui-explorer-kit-card",
			"reports.component.shared-primitives-detail-list"
		],
		"inputs": [
			{
				"name": "EntityContract.unit",
				"type": "HarnessUnit",
				"required": true,
				"description": "The entity at the selected revision, including source-declared model definitions, fields, methods and recorded examples."
			},
			{
				"name": "EntityContract.category",
				"type": "ExplorerCategory",
				"required": true,
				"description": "The kind of entity; config outputs are labelled Provides."
			},
			{
				"name": "EntityContract.contract",
				"type": "ContractRow[]",
				"required": true,
				"description": "Prepared contract facts such as purpose, route and execution targets."
			},
			{
				"name": "EntityContract.last",
				"type": "string",
				"required": false,
				"description": "Optional parent commit, defaulting to JavaScript undefined and the current Contract heading. A supplied nonempty commit shows its first seven characters as the last contract."
			}
		],
		"outputs": [
			{
				"name": "EntityContract",
				"type": "markup",
				"description": "Component props, source fields and callable parameter/return tables retain requirement/default metadata. Declared errors or their explicit absence appear, and info controls open full examples."
			}
		],
		"errors": [
			{
				"name": "TypeError",
				"type": "thrown",
				"description": "A literal default or example contains BigInt or circular data that JSON cannot serialize."
			},
			{
				"name": "RangeError",
				"type": "thrown",
				"description": "Deeply nested default or example data exceeds the JSON serializer stack."
			},
			{
				"name": "Getter, proxy or conversion error",
				"type": "propagated",
				"description": "Errors from supplied field/default/example getters, proxy traps or JSON conversion methods propagate."
			}
		],
		"errorStatus": "declared",
		"operations": [],
		"initialization": [],
		"snippets": [
			{
				"name": "EntityContract.summaryRows",
				"inputs": [
					{
						"name": "EntityContract.summaryRows.rows",
						"type": "ContractRow[]",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "EntityContract.summaryRows",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			},
			{
				"name": "EntityContract.label",
				"inputs": [
					{
						"name": "EntityContract.label.row",
						"type": "unknown",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "EntityContract.label",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			},
			{
				"name": "EntityContract.children",
				"inputs": [
					{
						"name": "EntityContract.children.row",
						"type": "unknown",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "EntityContract.children",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			},
			{
				"name": "EntityContract.callableSection",
				"inputs": [
					{
						"name": "EntityContract.callableSection.callable",
						"type": "CallableContract",
						"required": true
					},
					{
						"name": "EntityContract.callableSection.label",
						"type": "string",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "EntityContract.callableSection",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			}
		]
	},
