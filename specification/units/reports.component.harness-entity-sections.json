			{
				"name": "EntitySections.nav",
				"type": "EntityNav",
				"required": true,
				"description": "How the screen reaches other addresses: this component passes `nav` unchanged to `EntityRelations`, `EntitySource` and, through the verification panel, `EntityTests`, and it never reads or calls its members. Its members (`route`, `href`, `go` and the optional `source`) are not inspected here."
			},
			{
				"name": "EntitySections.pane",
				"type": "Snippet",
				"required": true,
				"description": "The evidence snippet, rendered with no arguments as the children of `EntityOverview`, so it shows only on the overview branch that this component takes when no tab branch matches. Its prop comment says it is shown above the entity's summary, and any error it throws propagates out of this component."
			}
		],
		"outputs": [
			{
				"name": "EntitySections.entityTabPanel",
				"type": "markup",
				"description": "The markup of the selected entity tab, taken from the first branch that matches in this order: the API permissions screen, the relations list (`used-in`, `uses`, `models` or `apis`), examples for functions and services on the examples or tests tab, component audio, states or tests, source, contract, the model table, and otherwise `EntityOverview` with the pane snippet. Each `tabpanel` block is labelled with the entity name and the tab it shows, and the model table gives every column row `data-label` cells (Column, Property, Type, Primary key, Nullable, Default) and shows the note that this revision records no database table for this model when it has neither a table nor a gap."
			}
		],
		"errors": [
			{
				"name": "Caller callback or content error",
				"type": "propagated",
				"description": "Errors from the `pane` snippet, from the `host.lens` callbacks (`relations`, `evidence`, `behavior`) when the rendered branch calls them, and from the helpers and child components it calls all propagate out of this component, which has no try/catch or error boundary."
			}
		],
