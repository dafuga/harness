			},
			{
				"name": "EvidenceGrid.assetBase",
				"type": "string",
				"required": true,
				"description": "Asset URL prefix the grid forwards unchanged to EvidenceCard, EvidenceViewer and AudioComparisonViewer. The cards and viewers that receive it build each file URL by plain concatenation with item.file, so the value must end with the separator the URL needs.",
				"examples": ["/harness/media/"]
			},
			{
				"name": "EvidenceGrid.idPrefix",
				"type": "string",
				"required": false,
				"default": "",
				"description": "Prefix added to the gallery heading id and to its aria-labelledby reference, so a page with a second gallery keeps those ids unique; it defaults to the empty string. It is not applied to the evidence card ids, which stay 'evidence-' followed by the item id.",
				"examples": ["", "entity-"]
			}
		],
		"outputs": [
			{
				"name": "EvidenceGrid",
				"type": "markup",
				"description": "Gallery section with a search input, category tabs, a status select, viewport tabs (all, mobile, tablet, desktop; hidden in audio mode) and, when audio exists, media tabs; it shows filtered counts and an empty-result message when nothing matches. Paired audio opens AudioComparisonViewer and screenshots open EvidenceViewer, whose size switch moves the viewport filter to the chosen screenshot's size (cleared for 'other') and clears search, category and status when they would hide it; the audio tab clears the viewport filter."
			}
		],
		"errors": [
			{
				"name": "each_key_duplicate",
				"type": "thrown",
				"description": "Rendering throws this error when two entries in the filtered gallery share an evidence id, because the gallery keys its each block by item.id. Duplicates that the active search, category, status, media or viewport filters remove from the list do not throw."
			}
		],
