{
	"schemaVersion": 1,
	"id": "reports.component.evidence-grid",
	"kind": "component",
	"title": "Evidence grid",
	"responsibility": "Filters report media and coordinates screenshot and paired-audio viewers plus optional uploads.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.audio-comparison-viewer",
			"reports.component.evidence-card",
			"reports.component.evidence-viewer",
			"reports.component.select",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-input",
			"reports.component.shared-primitives-atoms-html-option",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.upload-audio",
			"reports.component.upload-comparison"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/evidence-grid/EvidenceGrid.svelte",
			"packages/reports/src/components/verification-evidence/evidence-grid/EvidenceGrid.svelte",
			"packages/reports/src/components/verification-evidence/evidence-grid/EvidenceGrid.types.ts"
		],
		"symbols": ["EvidenceGrid", "EvidenceGrid", "Media"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EvidenceGrid.items",
				"type": "Evidence[]",
				"description": "Required evidence list. Helpers pair related audio and choose gallery entries; screenshot-only lists feed image navigation."
			},
			{
				"name": "EvidenceGrid.assetBase",
				"type": "string",
				"description": "Required asset prefix forwarded to cards and viewers."
			},
			{
				"name": "EvidenceGrid.reportId",
				"type": "string",
				"description": "Optional report identifier. Upload controls appear only when both this value and onUploaded are supplied."
			},
			{
				"name": "EvidenceGrid.onUploaded",
				"type": "(report: Report) => void",
				"description": "Optional callback receiving an updated report from upload controls. Also gates their visibility alongside reportId."
			},
			{
				"name": "EvidenceGrid.idPrefix",
				"type": "string",
				"description": "Optional prefix, empty by default, keeping the gallery heading ID unique on pages with multiple galleries. Does not prefix individual evidence-card IDs."
			}
		],
		"outputs": [
			{
				"name": "EvidenceGrid",
				"type": "markup",
				"description": "Gallery with search/category/status and screenshot-size filters, plus media tabs when audio or upload support exists. Shows filtered counts and an empty-result message. Paired audio opens a dedicated viewer; screenshots open a zoom/comparison viewer. Selecting another viewport can adjust filters to reveal it. Audio mode clears the viewport filter. Upload effects and failures belong to child controls."
			}
		],
		"errors": []
	},
