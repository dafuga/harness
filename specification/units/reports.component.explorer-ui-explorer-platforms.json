		"inputs": [
			{
				"name": "ExplorerPlatforms.index",
				"type": "HarnessIndex",
				"required": true,
				"description": "The index value accepted by ExplorerScreenProps and provided to ExplorerFrame within host. ExplorerPlatforms does not read it directly."
			},
			{
				"name": "ExplorerPlatforms.head",
				"type": "HarnessRevision",
				"required": true,
				"description": "The selected revision supplies head.platforms, whose entries and gap drive the platform cards and notice. If no catalog is present, the component uses the unrecorded gap and still builds cards from platformViews."
			},
			{
				"name": "ExplorerPlatforms.parent",
				"type": "HarnessRevision | null",
				"required": true,
				"description": "An optional comparison revision accepted by ExplorerScreenProps and provided to ExplorerFrame within host. ExplorerPlatforms does not use it to build platform statuses or details.",
				"examples": [null]
			},
			{
				"name": "ExplorerPlatforms.scope",
				"type": "ExplorerScope",
				"required": true,
				"description": "The ExplorerScope value accepted by ExplorerScreenProps and provided to ExplorerFrame within host. ExplorerPlatforms does not inspect its fields."
			},
			{
				"name": "ExplorerPlatforms.route",
				"type": "ExplorerLocation",
				"required": true,
				"description": "The current location selects the detail view when route.entity is truthy; otherwise the component displays the catalog. Platform links use its branch and commit and set category to platforms.",
				"examples": [
					{
						"branch": "main",
						"commit": "0123456789abcdef0123456789abcdef01234567",
						"category": "platforms"
					}
				]
			},
			{
				"name": "ExplorerPlatforms.entities",
				"type": "ExplorerEntity[]",
				"required": true,
				"description": "The entity array accepted by ExplorerScreenProps and provided to child screens within host. ExplorerPlatforms does not read its entries directly.",
				"examples": [[]]
			},
			{
				"name": "ExplorerPlatforms.lens",
				"type": "EntityLens",
				"required": true,
				"description": "The EntityLens value accepted by ExplorerScreenProps and provided to child screens within host. ExplorerPlatforms does not read its fields directly."
			},
			{
				"name": "ExplorerPlatforms.client",
				"type": "Pick<HarnessClient, 'revision'>",
				"required": true,
				"description": "The revision member of HarnessClient accepted by ExplorerScreenProps and provided to ExplorerFrame within host. ExplorerPlatforms does not call it directly."
			},
			{
				"name": "ExplorerPlatforms.mediaBase",
				"type": "string",
				"required": true,
				"description": "The media-base string accepted by ExplorerScreenProps and provided to ExplorerFrame within host. ExplorerPlatforms does not read it directly.",
				"examples": ["/media/"]
			},
			{
				"name": "ExplorerPlatforms.onroute",
				"type": "(to: ExplorerLocation) => void",
				"required": true,
				"description": "The navigation callback accepted by ExplorerScreenProps and provided to child screens within host. Platform links are given a destination based on the current branch and commit."
			}
		],
		"outputs": [
			{
				"name": "ExplorerPlatforms",
				"type": "markup",
				"description": "The four-target catalog or selected platform details, with search, a status dialog and explicit missing-data states."
			}
		],
		"errors": [
			{
				"name": "lens.href callback error",
				"type": "thrown",
				"description": "An error from the host URL reader propagates while rendering platform links."
			},
			{
				"name": "onroute callback error",
				"type": "thrown",
				"description": "An error from the host navigation callback propagates when a platform link is activated."
			},
			{
				"name": "URIError",
				"type": "thrown",
				"description": "A recorded source path with an unpaired UTF-16 surrogate cannot be encoded as a GitHub URL in platform details."
			}
		],
