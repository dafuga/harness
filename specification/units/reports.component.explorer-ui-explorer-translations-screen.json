		"outputs": [
			{
				"name": "ExplorerTranslationsScreen",
				"type": "markup",
				"description": "Svelte markup renders the Translations section with English and one selected non-English locale, case-insensitive search, source gaps, consumer links, and empty states. It initially shows up to 50 matching rows, adds 50 with View More, resets that limit when search or commit changes, defaults to `fr` or the first available non-English locale, excludes English from choices, and keeps the table scrollable with a tighter fixed layout at widths up to 720px."
			}
		],
		"errors": [
			{
				"name": "lens.href callback error",
				"type": "thrown",
				"description": "While rendering a resolved consumer link, this component calls the snippet-provided `nav.href(to)` and propagates any exception from that callback. It does not call `host.lens.href` directly."
			},
			{
				"name": "onroute callback error",
				"type": "thrown",
				"description": "For a consumer-link click without modifier keys, the handler calls `nav.go(to)` and propagates any exception from that callback. This component does not invoke `host.onroute` directly."
			},
			{
				"name": "each_key_duplicate",
				"type": "thrown",
				"description": "Visible translation rows use `${row.scope}:${row.key}` as their keyed-each identity. Duplicate identities can make Svelte's keyed list throw during mount or update."
			}
