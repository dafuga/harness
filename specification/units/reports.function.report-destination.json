{
	"schemaVersion": 1,
	"id": "reports.function.report-destination",
	"kind": "function",
	"title": "Legacy report destination",
	"responsibility": "Routes an older report link to its stored revision or the explorer home.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/reports/src/routes/harness/reports/[id]/reportDestination.ts",
			"packages/reports/src/utils/explorer-ui/reportDestination.ts",
			"packages/reports/src/utils/reportDestination.ts"
		],
		"symbols": ["reportDestination", "NamedReport", "reportDestination", "reportDestination"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "reportDestination.index",
				"type": "HarnessIndex | null",
				"description": "History index or null."
			},
			{
				"name": "reportDestination.report",
				"type": "NamedReport | null",
				"description": "Report identifier and optional recorded revision, or null."
			}
		],
		"outputs": [
			{
				"name": "reportDestination",
				"type": "string",
				"description": "Console-relative Pages address for the first stored match among the report revision and imported legacy linkage; otherwise canonical home. Empty when there is no index or home."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "function.console-canonical",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.explorer-route",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.harness-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/utils/explorer-ui/reportDestination.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/utils/explorer-ui/reportDestination.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
