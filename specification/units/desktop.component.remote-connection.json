{
	"schemaVersion": 1,
	"id": "desktop.component.remote-connection",
	"kind": "component",
	"title": "Remote connection",
	"responsibility": "Chooses connection controls appropriate to the current computer or phone environment.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": ["desktop.component.remote-host-panel", "desktop.component.remote-phone-panel"]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/RemoteConnection.svelte",
			"packages/desktop/src/components/networking-security/RemoteConnection.svelte"
		],
		"symbols": ["RemoteConnection", "RemoteConnection"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RemoteConnection.workspace",
				"type": "Workspace",
				"description": "Workspace whose remote.host or remote.phone selects the panel; host takes precedence if both are set."
			},
			{
				"name": "RemoteConnection.compact",
				"type": "boolean",
				"description": "Optional compact flag, false by default, forwarded to the chosen panel."
			}
		],
		"outputs": [
			{
				"name": "RemoteConnection",
				"type": "markup",
				"description": "Host panel or phone panel when matching remote mode and context stores exist; otherwise nothing. Does not initiate pairing itself."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.remote-host-panel",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.remote-phone-panel",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.environment-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.remote-host",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.remote-phone",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.workspace",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/networking-security/RemoteConnection.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/networking-security/RemoteConnection.svelte"
			}
		]
	},
	"scenarios": ["remote-mobile-ui"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
