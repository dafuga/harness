		],
		"symbols": ["NavBar"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "NavBar.workspace",
				"type": "Workspace",
				"required": true,
				"description": "Workspace supplying category links, project and revision pickers, search context and navigation. Settings is offered only when agent capability is enabled and includes the current workspace path as its return location. Search navigation uses only entries accepted by the current search context."
			},
			{
				"name": "NavBar.account",
				"type": "Snippet",
				"required": false,
				"description": "Optional content supplied by the host for account controls, such as the signed-in identity. When omitted, no account container is rendered; this component does not supply sign-in or sign-out behavior itself. Defaults to JavaScript undefined (omitted), not the literal string."
			}
		],
		"outputs": [
			{
				"name": "NavBar",
				"type": "markup",
				"description": "Top bar with project, search and optional account controls; one grouped environment and revision rail; a complete category row on desktop and tablet; and evenly filled mobile category cells with icons, including Game Views. Search uses the current workspace context."
			}
		],
		"errors": [
			{
				"name": "Caller callback or content error",
				"type": "propagated",
				"description": "Errors from supplied account callbacks or snippets propagate when invoked; this component does not provide an error boundary."
			}
		],
		"errorStatus": "declared",
