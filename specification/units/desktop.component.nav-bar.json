		],
		"symbols": ["NavBar"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "NavBar.workspace",
				"type": "Workspace",
				"required": true,
				"description": "Required Workspace value passed to the project, environment, revision and category navigation components. Its path(), category, capabilities.agents, local, optional bridge.deploymentActivities and navigate() values determine the settings link, active category, optional game views and deployment activity, while search opens only a path accepted by the current workspace search context."
			},
			{
				"name": "NavBar.account",
				"type": "Snippet",
				"required": false,
				"default": "undefined (omitted)",
				"description": "Optional host-supplied Svelte snippet rendered in the account area; when truthy, the header uses account layout and renders available local deployment activity alongside it. Defaults to JavaScript undefined when omitted."
			}
		],
		"outputs": [
			{
				"name": "NavBar",
				"type": "markup",
				"description": "Renders a top bar containing the workspace brand link, project switcher, environment and revision controls, workspace-scoped search, an agent-gated Settings link, category links and an optional Game Views link; a supplied account snippet and local deployment activity appear only when their conditions are met. Category links use eight equal columns on wider layouts and four columns at widths up to 760px, while Game Views changes those counts to nine and three; at widths up to 560px, the context rail becomes a compact grid and its search controls shrink."
			}
		],
