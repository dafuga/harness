{
	"schemaVersion": 1,
	"id": "desktop.component.nav-bar",
	"kind": "component",
	"title": "Nav bar",
	"responsibility": "Provides project, category and revision navigation, workspace search, agent settings access and optional host-account controls.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.deployment-activity",
			"desktop.component.deployment-dialog",
			"desktop.component.environment-picker",
			"desktop.component.icon",
			"desktop.component.project-switcher",
			"desktop.component.revision-picker",
			"desktop.component.workspace-link",
			"reports.component.brand-mark",
			"reports.component.entity-search",
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-header",
			"reports.component.shared-primitives-atoms-html-nav",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/nav-bar/NavBar.svelte",
			"packages/desktop/src/components/projects-sessions/nav-bar/NavBar.svelte"
		],
		"symbols": ["NavBar", "NavBar"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "NavBar.workspace",
				"type": "Workspace",
				"description": "Workspace supplying category links, project and revision pickers, search context and navigation. Settings is offered only when agent capability is enabled and includes the current workspace path as its return location. Search navigation uses only entries accepted by the current search context."
			},
			{
				"name": "NavBar.account",
				"type": "Snippet",
				"description": "Optional content supplied by the host for account controls, such as the signed-in identity. When omitted, no account container is rendered; this component does not supply sign-in or sign-out behavior itself."
			}
		],
		"outputs": [
			{
				"name": "NavBar",
				"type": "markup",
				"description": "Top bar with project and revision controls, category navigation, search, optional Settings and account content. On phones all category icon-and-text labels fit in two rows, with search controls in the spare cell. Search uses the current workspace context; desktop navigation behavior is preserved."
			}
		],
		"errors": []
	},
