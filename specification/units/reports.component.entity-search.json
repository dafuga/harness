{
	"schemaVersion": 1,
	"id": "reports.component.entity-search",
	"kind": "component",
	"title": "Entity search",
	"responsibility": "Opens project search from a navbar icon and finds entities in the selected revision.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.entity-search-results",
			"reports.component.modal",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-input",
			"reports.component.shared-primitives-atoms-svg-circle",
			"reports.component.shared-primitives-atoms-svg-path",
			"reports.component.shared-primitives-atoms-svg-svg"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/entity-search/EntitySearch.svelte",
			"packages/reports/src/components/explorer-ui/entity-search/EntitySearch.svelte"
		],
		"symbols": ["EntitySearch", "EntitySearch"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntitySearch.entries",
				"type": "SearchEntry[] | null",
				"description": "Required list of entities, or null while the host loads them. Null yields no matches and loading wording; the component does not fetch entries."
			},
			{
				"name": "EntitySearch.scope",
				"type": "{ label: string; pinned: string | null }",
				"description": "Required label and optional pinned commit. Label names searched scope; pinned takes precedence in placeholder wording over loading."
			},
			{
				"name": "EntitySearch.href",
				"type": "(entry: SearchEntry) => string",
				"description": "Required callback providing complete result link targets."
			},
			{
				"name": "EntitySearch.open",
				"type": "(entry: SearchEntry) => void",
				"description": "Opens the chosen entity in the host after closing the search modal."
			}
		],
		"outputs": [
			{
				"name": "EntitySearch",
				"type": "markup",
				"description": "A search icon opens a modal by click or Cmd/Ctrl+K. The focused query offers ranked results; arrows and Enter navigate. Escape closes the modal and restores icon focus."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.component.entity-search-results",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.modal",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-button",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-input",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-svg-circle",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-svg-path",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-svg-svg",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.entity-search",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/components/explorer-ui/entity-search/EntitySearch.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/components/explorer-ui/entity-search/EntitySearch.svelte"
			}
		]
	},
	"scenarios": ["explorer-shell", "harness-console", "search-shared-app"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
