{
	"schemaVersion": 1,
	"id": "desktop.service.recorded-evidence",
	"kind": "service",
	"title": "RecordedEvidenceService",
	"responsibility": "Owns the RecordedEvidenceService service workflow.",
	"responsibilityOrigin": "derived",
	"status": "active",
	"owns": {
		"source": ["packages/desktop/src/services/RecordedEvidenceService.ts"],
		"symbols": [
			"RecordedEvidenceService",
			"RecordedEvidenceService.constructor",
			"RecordedEvidenceService.evidence",
			"RecordedEvidenceService.artifact"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RecordedEvidenceService.constructor.session",
				"type": "ProjectSessionService"
			},
			{
				"name": "RecordedEvidenceService.evidence.query",
				"type": "EntityEvidenceQuery"
			},
			{
				"name": "RecordedEvidenceService.artifact.query",
				"type": "EvidenceArtifactQuery"
			}
		],
		"outputs": [
			{
				"name": "RecordedEvidenceService.evidence",
				"type": "Promise<EntityEvidenceResult>"
			},
			{
				"name": "RecordedEvidenceService.artifact",
				"type": "Promise<EvidenceArtifactResult>"
			}
		],
		"errors": [
			{
				"name": "project-required",
				"type": "refused",
				"description": "No registered project is open for the read, or no branch is named."
			},
			{
				"name": "stale-or-foreign-commit",
				"type": "refused",
				"description": "Current mode needs the branch tip; a commit must be on the branch."
			},
			{
				"name": "pin-not-held",
				"type": "refused",
				"description": "A repeated notes or evidence revision that its ref never held."
			},
			{
				"name": "capture-unlisted",
				"type": "refused",
				"description": "The binding is not a capture of this entity, record, side, state and hash."
			},
			{
				"name": "bytes-refused",
				"type": "refused",
				"description": "Bytes over 11 MiB, of another SHA-256, or of a media type that is not attested."
			}
		]
	},
	"dependencies": [
