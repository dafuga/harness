{
	"schemaVersion": 1,
	"id": "reports.endpoint.api-analytics-cpu",
	"kind": "endpoint",
	"title": "/api/analytics-cpu",
	"responsibility": "Serves site-scoped CPU telemetry to loopback hosts and rejects other hosts.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["packages/reports/src/routes/api/analytics-cpu/+server.ts"],
		"symbols": ["GET"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "GET.url",
				"type": "URL",
				"description": "Request URL; only localhost, 127.0.0.1 and [::1] hostnames are admitted."
			}
		],
		"outputs": [
			{
				"name": "GET",
				"type": "Promise<Response>",
				"description": "JSON telemetry with all snapshot fields and site-scoped agents; local responses disable caching."
			},
			{
				"name": "status",
				"type": "string",
				"description": "Telemetry availability, or unavailable when a non-loopback host is refused."
			},
			{
				"name": "sampledAt",
				"type": "string",
				"description": "Time the telemetry sample was taken for admitted hosts."
			},
			{
				"name": "intervalMs",
				"type": "number",
				"description": "Measured sample interval in milliseconds."
			},
			{
				"name": "logicalCores",
				"type": "number",
				"description": "Number of logical CPU cores in the sample."
			},
			{
				"name": "machinePercent",
				"type": "number | null",
				"description": "Machine CPU percentage, or null when unavailable."
			},
			{
				"name": "trackedPercent",
				"type": "number | null",
				"description": "Site-scoped total of tracked groups, or null when unavailable."
			},
			{
				"name": "groups",
				"type": "CpuGroup[]",
				"description": "CPU groups with the agents group recalculated for this site."
			},
			{
				"name": "agents",
				"type": "CpuAgent[]",
				"description": "Only agent processes attributable to this site."
			}
		],
		"errors": [
			{
				"name": "remote-host",
				"type": "HTTP 403",
				"description": "A non-loopback hostname receives an unavailable JSON response before telemetry is sampled."
			},
			{
				"name": "telemetry-unavailable",
				"type": "HTTP 503",
				"description": "An admitted host receives the complete unavailable snapshot with caching disabled."
			}
		]
	},
	"dependencies": [
		{
			"unit": "reports.function.site-processes",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "service.cpu-usage",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/routes/api/analytics-cpu/+server.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/routes/api/analytics-cpu/+server.ts"
			}
		]
	},
