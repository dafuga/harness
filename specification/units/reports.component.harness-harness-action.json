{
	"schemaVersion": 1,
	"id": "reports.component.harness-harness-action",
	"kind": "component",
	"title": "Explorer action",
	"responsibility": "Renders a button or real navigation link with optional icons.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-harness-icon",
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-button"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/HarnessAction.svelte"],
		"symbols": ["HarnessAction"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "HarnessAction.href",
				"type": "string",
				"description": "Optional address. Nonempty and enabled renders an anchor; otherwise a button."
			},
			{
				"name": "HarnessAction.onclick",
				"type": "(event: MouseEvent) => void",
				"description": "Optional handler. For links, only plain clicks are intercepted; other clicks remain native. Buttons invoke it directly if supplied."
			},
			{
				"name": "HarnessAction.disabled",
				"type": "boolean",
				"description": "Optional flag, false by default. True renders a disabled button even when href exists."
			},
			{
				"name": "HarnessAction.tone",
				"type": "'gold' | 'plain'",
				"description": "Optional gold or plain styling, default gold."
			},
			{
				"name": "HarnessAction.icon",
				"type": "HarnessIconName",
				"description": "Optional trailing icon."
			},
			{
				"name": "HarnessAction.lead",
				"type": "HarnessIconName",
				"description": "Optional leading icon."
			},
			{
				"name": "HarnessAction.label",
				"type": "string",
				"description": "Optional fuller accessible name."
			},
			{
				"name": "HarnessAction.children",
				"type": "Snippet",
				"description": "Required visible action content."
			}
		],
		"outputs": [
			{
				"name": "HarnessAction",
				"type": "markup",
				"description": "Styled action with leading/trailing icons at size 18. Buttons have type button. Handler failures are not caught."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.component.harness-harness-icon",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-a",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-button",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.harness-icons",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.harness-shell",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/components/explorer-ui/HarnessAction.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/components/explorer-ui/HarnessAction.svelte"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
