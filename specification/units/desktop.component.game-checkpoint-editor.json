		"symbols": ["GameCheckpointEditor", "Props"]
	},
	"contract": {
		"origin": "declared",
		"primitives": ["reports.component.select"],
		"inputs": [
			{
				"name": "GameCheckpointEditor.checkpoint",
				"type": "Checkpoint | null",
				"required": true,
				"description": "A checkpoint to edit, or null when none is selected. A non-null value supplies the prerequisites, repeatability, conditions and actions shown by the editor; null renders the selection prompt and makes edit updates no-op.",
				"examples": [null]
			},
			{
				"name": "GameCheckpointEditor.change",
				"type": "(node: Checkpoint) => void",
				"required": true,
				"description": "Receives a shallow copy of the selected checkpoint after an edit; no callback occurs when checkpoint is null."
			},
			{
				"name": "GameCheckpointEditor.readonly",
				"type": "boolean",
				"required": false,
				"default": false,
				"description": "Controls whether the selected checkpoint's fieldset is disabled. Its declared default is false.",
				"examples": [false, true]
			}
		],
		"outputs": [
			{
				"name": "GameCheckpointEditor",
				"type": "markup",
				"description": "With a selected checkpoint, it renders prerequisite, repeatable, condition and action controls; without one, it prompts for checkpoint selection. Text whose trimmed value is true or false becomes a boolean, finite numeric text becomes a number, and other input remains the original text; readonly disables the fieldset."
			}
		],
		"errors": [
			{
				"name": "Caller callback or content error",
				"type": "thrown",
				"description": "If the supplied change callback throws while an edit publishes an updated checkpoint, that error propagates from the component; the component does not catch it."
			}
		],
		"errorStatus": "declared",
