{
	"schemaVersion": 1,
	"id": "desktop.function.reference-prompt",
	"kind": "function",
	"title": "Unit reference instructions",
	"responsibility": "Build agent instructions for referencing a bounded list of unit IDs.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/utils/development-tooling/referencePrompt.ts",
			"packages/desktop/src/utils/referencePrompt.ts"
		],
		"symbols": ["referencePrompt", "referencePrompt"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "referencePrompt.ids",
				"type": "string[]",
				"description": "Candidate IDs; invalid grammar and duplicates are removed, preserving the first occurrence, up to 120 IDs."
			}
		],
		"outputs": [
			{
				"name": "referencePrompt",
				"type": "string",
				"description": "Instructions to use registered unit references, followed by the accepted IDs or none."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.function.entity-references",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/utils/development-tooling/referencePrompt.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/utils/development-tooling/referencePrompt.ts"
			}
		]
	},
	"scenarios": ["agent-references"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
