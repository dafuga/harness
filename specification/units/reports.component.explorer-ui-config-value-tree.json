						"required": true
					}
				],
				"outputs": [
					{
						"name": "ConfigValueTree.contents",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			},
			{
				"name": "ConfigValueTree.item",
				"inputs": [
					{
						"name": "ConfigValueTree.item.name",
						"type": "string",
						"required": true
					},
					{
						"name": "ConfigValueTree.item.value",
						"type": "ConfigValueNode",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "ConfigValueTree.item",
