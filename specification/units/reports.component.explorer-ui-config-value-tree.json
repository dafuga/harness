{
	"schemaVersion": 1,
	"id": "reports.component.explorer-ui-config-value-tree",
	"uid": "u_aqokuxsnj3",
	"kind": "component",
	"title": "ConfigValueTree",
	"responsibility": "Presents statically inspected config objects and arrays as expandable source values with exact keys and known counts.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-harness-icon",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-li",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.shared-primitives-atoms-html-ul"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/ConfigValueTree.module.types.ts",
			"packages/reports/src/components/explorer-ui/ConfigValueTree.svelte"
		],
		"symbols": [
			"ConfigCollection",
			"ConfigValueMark",
			"ConfigValueTree",
			"collection",
			"valueMark",
			"ConfigCollection",
			"ConfigValueMark",
			"ConfigValueTree.shape",
			"ConfigValueTree.contents",
			"ConfigValueTree.item"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ConfigValueTree.node",
				"type": "ConfigValueNode",
				"required": true,
				"description": "A committed ConfigValueNode whose source is shown as read-only content. Listed object or array entries can be expanded, and the source is never evaluated.",
				"examples": [
					{
						"kind": "expression",
						"source": "process.env.API_URL"
					},
					{
						"kind": "object",
						"source": "{ host: 'localhost' }",
						"count": 1,
						"entries": [
							{
								"name": "host",
								"node": {
									"kind": "expression",
									"source": "'localhost'"
								}
							}
						]
					}
				]
			}
		],
		"outputs": [
			{
				"name": "ConfigValueTree",
				"type": "markup",
				"description": "Renders a Value contents section with the node source and any listed entries. Collections with listed entries use nested disclosures, and source text is displayed without evaluation."
			},
			{
				"name": "collection",
				"type": "ConfigCollection | undefined",
				"description": "Returns an object or array node unchanged, or undefined when the argument is absent or is an expression.",
				"examples": [
					{
						"kind": "object",
						"source": "{ host: 'localhost' }",
						"count": 1,
						"entries": [
							{
								"name": "host",
								"node": {
									"kind": "expression",
									"source": "'localhost'"
								}
							}
						]
					}
				]
			},
			{
				"name": "valueMark",
				"type": "ConfigValueMark | undefined",
				"description": "Returns a shape icon and holds label for a collection, or a code icon and source-size label for a long expression. A single-line expression of at most 48 characters has no mark.",
				"examples": [
					{
						"icon": "object",
						"size": "1 attribute"
					},
					{
						"icon": "code",
						"size": "2 lines"
					}
				]
			}
		],
		"errors": [],
		"errorStatus": "none-found",
		"operations": [
			{
				"name": "collection",
				"inputs": [
					{
						"name": "collection.node",
						"type": "ConfigValueNode",
						"required": false,
						"default": "undefined",
						"description": "Optional source node inspected for collection shape. The omitted argument defaults to undefined; undefined and expression nodes return undefined.",
						"examples": [
							{
								"kind": "expression",
								"source": "process.env.API_URL"
							},
							{
								"kind": "object",
								"source": "{ host: 'localhost' }",
								"count": 1,
								"entries": [
									{
										"name": "host",
										"node": {
											"kind": "expression",
											"source": "'localhost'"
										}
									}
								]
							}
						]
					}
				],
				"outputs": [
					{
						"name": "collection",
						"type": "ConfigCollection | undefined",
						"description": "Returns an object or array node unchanged, or undefined when the argument is absent or is an expression.",
						"examples": [
							{
								"kind": "object",
								"source": "{ host: 'localhost' }",
								"count": 1,
								"entries": [
									{
										"name": "host",
										"node": {
											"kind": "expression",
											"source": "'localhost'"
										}
									}
								]
							}
						]
					}
				],
				"errors": [],
				"errorStatus": "declared"
			},
			{
				"name": "valueMark",
				"inputs": [
					{
						"name": "valueMark.node",
						"type": "ConfigValueNode | undefined",
						"required": true,
						"description": "Optional structured node used to choose a collection mark before measuring text. Undefined or expression nodes use the text rules.",
						"examples": [
							{
								"kind": "expression",
								"source": "process.env.API_URL"
							},
							{
								"kind": "object",
								"source": "{ host: 'localhost' }",
								"count": 1,
								"entries": [
									{
										"name": "host",
										"node": {
											"kind": "expression",
											"source": "'localhost'"
										}
									}
								]
							}
						]
					},
					{
						"name": "valueMark.text",
						"type": "string",
						"required": true,
						"description": "Source text measured when node is absent or an expression. A one-line value at most 48 characters has no mark; longer one-line text is measured in characters and multiline text in lines.",
						"examples": ["process.env.API_URL", "feature.enabled &&\nrollout.isOpen"]
					}
				],
				"outputs": [
					{
						"name": "valueMark",
						"type": "ConfigValueMark | undefined",
						"description": "Returns a collection shape and holds label, or a code icon and source-size label for a long expression. A single-line expression of at most 48 characters returns undefined.",
						"examples": [
							{
								"icon": "object",
								"size": "1 attribute"
							},
							{
								"icon": "code",
								"size": "2 lines"
							}
						]
					}
				],
				"errors": [],
				"errorStatus": "declared"
			}
		],
		"initialization": [],
		"snippets": [
			{
				"name": "ConfigValueTree.shape",
