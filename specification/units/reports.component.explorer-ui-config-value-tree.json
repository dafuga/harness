			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-li",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.shared-primitives-atoms-html-ul"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/ConfigValueTree.module.types.ts",
			"packages/reports/src/components/explorer-ui/ConfigValueTree.svelte"
		],
		"symbols": [
			"ConfigCollection",
			"ConfigValueMark",
			"ConfigValueTree",
			"collection",
			"valueMark",
			"ConfigCollection",
			"ConfigValueMark",
			"ConfigValueTree.shape",
			"ConfigValueTree.contents",
			"ConfigValueTree.item"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ConfigValueTree.node",
				"type": "ConfigValueNode",
				"required": true,
				"description": "Committed source expression or collection node to inspect. Object and array entries preserve exact keys; unknown counts stay omitted. No source is executed."
			}
		],
		"outputs": [
			{
				"name": "ConfigValueTree",
				"type": "markup",
				"description": "Read-only source hierarchy with a Value contents region, exact keys, collection counts and keyboard-operated nested disclosures. Source expressions render as escaped text."
			},
			{
				"name": "collection",
				"type": "ConfigCollection | undefined",
				"description": "The supplied object or array collection node, or undefined for an absent or expression node."
			},
			{
				"name": "valueMark",
				"type": "ConfigValueMark | undefined",
				"description": "Icon name and count/size label for an inspectable value, or undefined for a short unstructured expression."
			}
		],
		"errors": [
			{
				"name": "Property access error",
				"type": "thrown",
				"description": "A caller-supplied node getter or proxy can throw when its source structure is read."
			}
		],
		"operations": [
			{
				"name": "collection",
				"inputs": [
					{
						"name": "collection.node",
						"type": "ConfigValueNode",
						"required": false
					}
				],
				"outputs": [
					{
						"name": "collection",
						"type": "ConfigCollection | undefined",
						"description": "The supplied object or array collection node, or undefined for an absent or expression node."
					}
				],
				"errors": [
					{
						"name": "Property access error",
						"type": "thrown",
						"description": "A supplied node getter or proxy can throw when its kind is read."
					}
				],
				"errorStatus": "declared"
			},
			{
				"name": "valueMark",
				"inputs": [
					{
						"name": "valueMark.node",
						"type": "ConfigValueNode | undefined",
						"required": true
					},
					{
						"name": "valueMark.text",
						"type": "string",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "valueMark",
						"type": "ConfigValueMark | undefined",
						"description": "Icon name and count/size label for an inspectable value, or undefined for a short unstructured expression."
					}
				],
				"errors": [
					{
						"name": "Property access error",
						"type": "thrown",
						"description": "A supplied node getter or proxy can throw when its shape and count are read."
					}
				],
				"errorStatus": "declared"
			}
		],
		"initialization": [],
		"snippets": [
			{
				"name": "ConfigValueTree.shape",
