{
	"schemaVersion": 1,
	"id": "hub.function.hub-runtime",
	"kind": "function",
	"title": "Assemble the hosted API",
	"responsibility": "Create authentication and optional relay services and a connector for GitHub-backed collaboration.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/hub/src/utils/hubRuntime.ts",
			"packages/hub/src/routes/api/[...path]/-server/hubRuntime.ts"
		],
		"symbols": [
			"HubApiRuntime",
			"hubRuntime"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "hubRuntime.env",
				"type": "HubEnv",
				"description": "Hub environment with optional authentication database, cache, relay binding and collaboration repository settings."
			}
		],
		"outputs": [
			{
				"name": "hubRuntime",
				"type": "HubApiRuntime",
				"description": "Runtime with auth, nullable remote access and connect(). Connecting creates collaboration and projection services using configured repository identity and auth-provided tokens. Missing required repository settings throw collaboration-disabled."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "hub.config.hub-env",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.controller.hub-agent",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.function.hub-cache",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.function.hub-json",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.function.hub-remote",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.module.server-auth",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.service.hub-projection",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/hub/src/utils/hubRuntime.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/hub/src/utils/hubRuntime.ts"
			}
		]
	},
	"scenarios": [],
