{
	"schemaVersion": 1,
	"id": "reports.component.gameplay-replay",
	"kind": "component",
	"title": "Gameplay replay",
	"responsibility": "Plays a report’s recorded screenshot frames as a seekable replay.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.replay-controls",
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-h3",
			"reports.component.shared-primitives-atoms-html-img",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.status-badge"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/gameplay-replay/GameplayReplay.svelte",
			"packages/reports/src/components/reports-media/gameplay-replay/GameplayReplay.svelte",
			"packages/reports/src/components/reports-media/gameplay-replay/replayPresentation.ts"
		],
		"symbols": [
			"GameplayReplay",
			"GameplayReplay",
			"replayScenes",
			"replayCursorIndex",
			"replayNotice"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "GameplayReplay.report",
				"type": "Report",
				"description": "Required report supplying evidence frames, ID and run state. Active plus running means live; newly supplied frames are followed by stable frame identity rather than shifting the cursor. The component does not poll for report updates."
			},
			{
				"name": "GameplayReplay.assetBase",
				"type": "string",
				"description": "Required prefix for frame image URLs and next-frame preloading."
			},
			{
				"name": "GameplayReplay.portable",
				"type": "boolean",
				"description": "Optional flag, false by default. True omits the server-generated MP4 download link."
			}
		],
		"outputs": [
			{
				"name": "GameplayReplay",
				"type": "markup",
				"description": "Replay when frames exist or the run is live. Starts paused at the helper-selected frame with speed 1. Offers playback, seeking, scenes and native/fullscreen fallback controls. Playback waits during image loading, can retry or skip errors, and waits at the end of live runs but stops for finished runs. Nonportable download links to an export endpoint and shows preparation text for eight seconds. Failed images and empty live recordings have explicit overlays."
			}
		],
		"errors": []
	},
