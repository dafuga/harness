			},
			{
				"name": "EntityTests.behavior",
				"type": "ExplorerBehavior",
				"required": true,
				"description": "Behavior results for the entity: the panel is rendered only when `rows` is non-empty, keyed to the entity id and the commit, and it receives the whole value along with `scope`, `mediaBase` and `nav`. The component checks only `rows.length` itself.",
				"examples": [
					{
						"mode": "current",
						"rows": [],
						"summary": "not-compared",
						"reason": null,
						"scenarios": []
					},
					{
						"mode": "commit",
						"rows": [],
						"summary": "unknown",
						"reason": "The before side holds no recorded behavior, so the two sides cannot be compared.",
						"scenarios": []
					}
				]
			},
			{
				"name": "EntityTests.nav",
				"type": "EntityNav",
				"required": true,
				"description": "Navigation context: the regression proof's `href` and `follow` callbacks build a location with `testLocation(nav.route, entity, commit)` and pass it to `nav.href` or `nav.go`, and the whole value also goes to the behavior panel when there are rows. Because `nav.href` and `nav.go` are functions, the value holds callbacks and cannot be written as JSON."
			},
			{
				"name": "EntityTests.mediaBase",
				"type": "string",
				"required": true,
				"description": "The base for recorded artifacts and media: it is passed unchanged as `assetBase` to the evidence grid, which renders only when there is media, and as `mediaBase` to the behavior panel, which renders only when there are rows. This component neither validates nor normalizes it, so it must already be in the form those components expect.",
				"examples": ["/artifacts", "/media/artifacts"]
			}
		],
		"outputs": [
			{
				"name": "EntityTests",
				"type": "markup",
				"description": "The rendered verification panel for one entity revision: verdict and reasons, each scenario with its state table and check statuses (durations where the record holds them), and the removed-declarations card, behavior panel and media grid, each shown only when it has content. Missing evidence or a missing record shows an explicit notice, required states carry their declared reason, slot reasons a state already gives are omitted, and checks with recorded browser diagnostics render them through BrowserErrors."
			}
		],
