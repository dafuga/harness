			"reports.component.shared-primitives-atoms-html-ul"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/entity-tests/EntityTests.svelte",
			"packages/reports/src/components/explorer-ui/entity-tests/coverageLabels.ts"
		],
		"symbols": [
			"EntityTests"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityTests.entity",
				"type": "ExplorerEntity",
				"description": "Required entity with name, identifier, category and supplied verdict."
			},
			{
				"name": "EntityTests.scope",
				"type": "ExplorerScope",
				"description": "Required displayed commit/parent context."
			},
			{
				"name": "EntityTests.evidence",
				"type": "ExplorerEvidence",
				"description": "Required coverage, scenarios, records and media. After-side coverage judges the displayed revision; removed declarations are listed separately. Coverage tests may carry diagnostics from their own run or the origin of an inherited result."
			},
			{
				"name": "EntityTests.behavior",
				"type": "ExplorerBehavior",
				"description": "Required behavior results; nonempty rows render a behavior panel keyed to entity and commit."
			},
			{
				"name": "EntityTests.nav",
				"type": "EntityNav",
				"description": "Required context for behavior-panel navigation."
			},
			{
				"name": "EntityTests.mediaBase",
				"type": "string",
				"description": "Required base for recorded artifacts and media gallery."
			},
			{
				"name": "EntityTests.exportHref",
				"type": "string",
				"description": "Optional record-download base, empty by default. A record and nonempty base produce a link with its record ID as query."
			}
		],
		"outputs": [
			{
				"name": "EntityTests",
				"type": "markup",
				"description": "Verdict and reasons, scenario/state coverage and underlying check outcomes/durations, removed declarations, behavior and media. Missing records/scenarios remain explicit. Inapplicable states are labeled, and repeated slot reasons are suppressed when the state already says them. Each check with recorded browser diagnostics shows expandable expected, unexpected and missing-expected errors with test-attempt context."
			}
		],
		"errors": []
	},
