	"schemaVersion": 1,
	"id": "reports.component.harness-entity-tests",
	"kind": "component",
	"title": "Entity verification details",
	"responsibility": "Explains recorded coverage, test outcomes and media for one entity revision.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.browser-errors",
			"reports.component.evidence-grid",
			"reports.component.harness-entity-behavior",
			"reports.component.harness-harness-verdict",
