{
	"schemaVersion": 1,
	"id": "desktop.model.agent-runner-types",
	"kind": "model",
	"title": "AgentRunner",
	"responsibility": "Owns the AgentRunner data model.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/models/AgentRunner.types.ts",
			"packages/desktop/src/models/agents-providers/AgentRunner.types.ts",
			"packages/desktop/src/models/agents-providers/AgentRunnerValues.ts"
		],
		"symbols": [
			"RunCancelled",
			"CliCommand",
			"AgentTurn",
			"AgentResult",
			"AgentRunner",
			"ImageRequest",
			"GeneratedImage",
			"ImageGenerator",
			"RunCancelled",
			"RunCancelled",
			"RunCancelled.constructor"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ImageRequest",
				"type": "{prompt:string,reference:string|null,cwd:string,model:string,signal:AbortSignal,onStatus:(status:string)=>void,onFile?:(path:string)=>void}",
				"description": "reference is an original image local file path, or null for an initial design. cwd is the task-owned temporary directory and only generation write location."
			},
			{
				"name": "AgentTurn",
				"type": "{model:string,effort:string|null,cwd:string,prompt:string,reference?:string|null,access:\"read-only\"|\"write\",signal:AbortSignal,onText:(text:string)=>void,onStatus:(status:string)=>void,onFile?:(path:string)=>void}"
			}
		],
		"outputs": [
			{
				"name": "ImageGenerator.generateImage",
				"type": "(request:ImageRequest)=>Promise<{bytes:Uint8Array,revisedPrompt:string|null}>"
			},
			{
				"name": "AgentRunner",
				"type": "{discover():Promise<ProviderState>,run(turn:AgentTurn):Promise<{text:string,model:string}>}"
			},
			{
				"name": "CliCommand",
				"type": "{command:string,args:string[]}"
			},
			{
				"name": "RunCancelled",
				"type": "class extends Error",
				"description": "Sets name RunCancelled and message The run was cancelled."
			}
		],
		"errors": [
			{
				"name": "RunCancelled",
				"type": "Error"
			}
		]
	},
	"dependencies": [
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/models/agents-providers/AgentRunner.types.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/models/agents-providers/AgentRunner.types.ts"
			}
		]
	},
	"scenarios": ["desktop-native", "desktop-project-runs"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
