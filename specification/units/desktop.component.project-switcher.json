{
	"schemaVersion": 1,
	"id": "desktop.component.project-switcher",
	"kind": "component",
	"title": "Project switcher",
	"responsibility": "Lets a person switch between listed projects or open another local project.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.choice-dialog",
			"desktop.component.icon",
			"reports.component.select",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-label",
			"reports.component.shared-primitives-atoms-html-optgroup",
			"reports.component.shared-primitives-atoms-html-option",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/projects-sessions/project-switcher/ProjectSwitcher.svelte"
		],
		"symbols": ["ProjectSwitcher", "ProjectSwitcher.icon", "ProjectSwitcher.children"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ProjectSwitcher.workspace",
				"type": "Workspace",
				"required": true,
				"description": "Workspace supplying current project, project list, snapshot and navigation operations. After switchProject resolves, the listbox resets to the resulting workspace project identifier."
			}
		],
		"outputs": [
			{
				"name": "ProjectSwitcher",
				"type": "markup",
				"description": "Project name and an icon opening a grouped listbox of local-device/connected-computer and Shared projects. An empty list visibly says No projects yet. Busy state shows Loading project and disables opening choices and Add local project. Selection calls switchProject, then resets to the resulting project id. Local Add is shown only with a local bridge."
			}
		],
		"errors": [
			{
				"name": "Workspace operation failure",
				"type": "propagated",
				"description": "Synchronous errors and rejected promises from the supplied workspace navigation or project operations are not caught by this component."
			}
		],
		"errorStatus": "declared",
		"operations": [],
		"initialization": [],
		"snippets": [
			{
				"name": "ProjectSwitcher.icon",
				"inputs": [],
				"outputs": [
					{
						"name": "ProjectSwitcher.icon",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			},
			{
				"name": "ProjectSwitcher.children",
				"inputs": [
					{
						"name": "ProjectSwitcher.children.close",
						"type": "() => void",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "ProjectSwitcher.children",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			}
		]
	},
	"dependencies": [
		{
			"unit": "desktop.component.choice-dialog",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.icon",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.project-list",
