		],
		"symbols": ["ProjectSwitcher", "ProjectSwitcher"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ProjectSwitcher.workspace",
				"type": "Workspace",
				"description": "Workspace supplying current project, project list, snapshot and navigation operations. After switchProject resolves, the dropdown resets to the resulting workspace project identifier."
			}
		],
		"outputs": [
			{
				"name": "ProjectSwitcher",
				"type": "markup",
				"description": "Dropdown grouped into local-device/connected-computer projects and Shared projects. Shows Add local project only for a local workspace with a bridge and disables it while busy. Selection changes call switchProject. This component does not catch rejected promises or display switching errors."
			}
		],
		"errors": []
	},
