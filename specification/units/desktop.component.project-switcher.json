{
	"schemaVersion": 1,
	"id": "desktop.component.project-switcher",
	"kind": "component",
	"title": "Project switcher",
	"responsibility": "Lets a person switch between listed projects or open another local project.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.choice-dialog",
			"desktop.component.icon",
			"reports.component.select",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-label",
			"reports.component.shared-primitives-atoms-html-optgroup",
