	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "HarnessEmittedGrowth.unit",
				"type": "string",
				"description": "Required unit identifier used to label this history."
			},
			{
				"name": "HarnessEmittedGrowth.growth",
				"type": "EmittedGrowth",
				"description": "Required target definitions and revision rows, including sizes, changes, limits and review notes. Targets remain separate rather than being added together."
			},
			{
				"name": "HarnessEmittedGrowth.reasons",
				"type": "(commit: string) => HarnessExplanation[]",
				"description": "Required lookup for recorded explanations at a commit. A changed row without explanations says none were recorded."
			},
			{
				"name": "HarnessEmittedGrowth.oncompare",
				"type": "(commit: string) => void",
				"description": "Required callback invoked with the commit when the user chooses before-and-after evidence."
			}
		],
		"outputs": [
			{
				"name": "HarnessEmittedGrowth",
				"type": "markup",
				"description": "Per-target size history with signed changes and review notes. Missing sizes remain unavailable; missing limits distinguish reviewed nonbuildable targets from targets with no limit yet."
			}
		],
		"errors": []
	},
