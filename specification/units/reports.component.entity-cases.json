			"packages/reports/src/components/explorer-ui/entity-cases/EntityCases.types.ts"
		],
		"symbols": ["EntityCases", "EntityCases", "Row"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityCases.document",
				"type": "unknown",
				"description": "Optional parsed test result. Used when no documented examples are supplied."
			},
			{
				"name": "EntityCases.unit",
				"type": "string",
				"description": "Optional unit identifier limiting direct invocation rows to that function."
			},
			{
				"name": "EntityCases.callable",
				"type": "boolean",
				"description": "Optional flag, true by default. Controls wording distinguishing observed end-to-end behavior from a direct function call; false is suitable for noncallable entities."
			},
			{
				"name": "EntityCases.examples",
				"type": "UsageExample[] | undefined",
				"description": "Documented uses with input and one expected output or error. These are never recorded test results."
			}
		],
		"outputs": [
			{
				"name": "EntityCases",
				"type": "markup",
				"description": "Readable input and output rows. Authored examples show expected outcomes; test records show observed outcomes. Full values remain available in a disclosure."
			}
		],
		"errors": []
	},
