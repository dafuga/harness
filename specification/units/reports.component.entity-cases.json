{
	"schemaVersion": 1,
	"id": "reports.component.entity-cases",
	"kind": "component",
	"title": "Input and output examples",
	"responsibility": "Shows documented uses beside expected outcomes, or recorded calls beside observed results.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.recorded-value",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-pre",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.shared-primitives-atoms-html-table",
			"reports.component.shared-primitives-atoms-html-tbody",
			"reports.component.shared-primitives-atoms-html-td",
			"reports.component.shared-primitives-atoms-html-th",
			"reports.component.shared-primitives-atoms-html-thead",
			"reports.component.shared-primitives-atoms-html-tr"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/entity-cases/EntityCases.svelte",
			"packages/reports/src/components/explorer-ui/entity-cases/EntityCases.types.ts"
		],
		"symbols": ["EntityCases", "Row"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityCases.document",
				"type": "unknown",
				"required": false,
				"description": "Optional; defaults to JavaScript undefined, producing an explicit missing-result message when examples are also omitted."
			},
			{
				"name": "EntityCases.examples",
				"type": "UsageExample[]",
				"required": false,
				"description": "Optional; defaults to JavaScript undefined and reads document instead. An explicit empty array shows the no-documented-examples message."
			},
			{
				"name": "EntityCases.unit",
				"type": "string",
				"required": false,
				"description": "Optional; defaults to JavaScript undefined, leaving recorded invocation rows unrestricted by unit identifier."
			},
			{
				"name": "EntityCases.callable",
				"type": "boolean",
				"required": false,
				"default": true,
				"description": "Optional flag, true by default. Controls wording distinguishing observed end-to-end behavior from a direct function call; false is suitable for noncallable entities."
			}
		],
		"outputs": [
			{
				"name": "EntityCases",
				"type": "markup",
				"description": "Readable input and output rows. Authored examples show expected outcomes; test records show observed outcomes. Full values remain available in a disclosure."
			}
		],
		"errors": [
			{
				"name": "TypeError",
				"type": "thrown",
				"description": "Expanding full values cannot serialize BigInt or circular input."
			},
			{
				"name": "RangeError",
				"type": "thrown",
				"description": "Expanding deeply nested full values can exceed the JSON serializer stack."
			},
			{
				"name": "Value access or serialization callback error",
				"type": "thrown",
				"description": "A supplied getter, proxy or toJSON method can throw while a document or example value is read or serialized."
			}
		],
		"errorStatus": "declared",
		"operations": [],
		"initialization": []
	},
	"dependencies": [
		{
			"unit": "function.unit-documentation",
			"via": "import",
