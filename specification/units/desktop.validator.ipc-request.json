{
	"schemaVersion": 1,
	"id": "desktop.validator.ipc-request",
	"kind": "validator",
	"title": "IpcRequestValidator",
	"responsibility": "Validate desktop bridge requests before dispatch.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/validators/IpcRequestValidator.ts",
			"packages/desktop/src/validators/development-tooling/IpcRequestValidator.ts"
		],
		"symbols": ["IpcRequestValidator", "IpcRequestValidator", "IpcRequestValidator.parse"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "IpcRequestValidator.parse.channel",
				"type": "string",
				"description": "A known typed desktop bridge channel."
			},
			{
				"name": "IpcRequestValidator.parse.input",
				"type": "unknown",
				"description": "Untrusted request payload."
			}
		],
		"outputs": [
			{
				"name": "IpcRequestValidator.parse",
				"type": "unknown",
				"description": "Channel-specific validated payload. project:work and feature-plan actions require a nonblank projectId; feature-plan actions retain only the declared project, feature, digest and selected option or reviewer fields."
			}
		],
		"errors": [
			{
				"name": "unknown channel or invalid request",
				"type": "Error",
				"description": "Reject before dispatch."
			}
		]
	},
	"dependencies": [
		{
			"unit": "desktop.function.game-payload",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.ipc-payload",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-bridge-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.validator.project-context",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/validators/development-tooling/IpcRequestValidator.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/validators/development-tooling/IpcRequestValidator.ts"
			}
		]
	},
	"scenarios": ["desktop-native", "desktop-project-runs"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
