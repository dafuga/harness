{
	"schemaVersion": 1,
	"id": "reports.component.harness-entity-screens",
	"kind": "component",
	"title": "Entity screenshots",
	"responsibility": "Displays recorded screenshots with viewport selection and their capture commit. Images open their full-size viewer, which retains capture provenance without a full verdict.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.evidence-viewer",
			"reports.component.harness-entity-reasons",
