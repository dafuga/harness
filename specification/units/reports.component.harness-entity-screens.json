		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/EntityScreens.svelte"],
		"symbols": ["EntityScreens"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityScreens.options",
				"type": "ScreenOption[]",
				"description": "Available visual scenarios and viewports. Overview uses the fixed page preview, or the first declared scenario and state."
			},
			{
				"name": "EntityScreens.evidence",
				"type": "ExplorerEvidence",
				"description": "Required captures/comparison mode and incomparability reasons."
			},
			{
				"name": "EntityScreens.scope",
				"type": "ExplorerScope",
				"description": "Required commit/parent context for labels and links."
			},
			{
				"name": "EntityScreens.mediaBase",
				"type": "string",
				"description": "Required prefix concatenated with screenshot files."
			},
			{
				"name": "EntityScreens.nav",
				"type": "EntityNav",
				"description": "Required navigation to tests or selected-commit view."
			},
			{
				"name": "EntityScreens.reasons",
				"type": "Reasons",
				"description": "Required recorded change reasons, shown for paired comparisons with original text available."
			},
			{
				"name": "EntityScreens.preview",
				"type": "ScreenPick | undefined",
				"description": "Exact optional scenario, state and initial viewport declared for this page. Viewport buttons preserve its scenario and state."
			}
		],
		"outputs": [
			{
				"name": "EntityScreens",
				"type": "markup",
				"description": "Captions show the revision that recorded each screenshot; a comparison retains Before/After labels with each capture's revision. Viewport buttons change only the viewport. Activating an image opens its full-size viewer with provenance. Rejected or absent captures remain explicit gaps."
			}
		],
		"errors": []
	},
