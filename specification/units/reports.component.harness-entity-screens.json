			"reports.component.shared-primitives-atoms-html-li",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-atoms-html-ul",
			"reports.component.shared-primitives-compare-panes"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/EntityScreens.svelte"],
		"symbols": ["EntityScreens", "EntityScreens.children"]
	},
	"contract": {
		"origin": "declared",
		"primitives": [
			"reports.component.explorer-ui-explorer-kit-card",
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-compare-panes"
		],
		"inputs": [
			{
				"name": "EntityScreens.options",
				"type": "ScreenOption[]",
				"required": true,
				"description": "Available visual scenarios and viewports. Overview uses the fixed page preview, or the first declared scenario and state."
			},
			{
				"name": "EntityScreens.evidence",
				"type": "ExplorerEvidence",
				"required": true,
				"description": "Required captures/comparison mode and incomparability reasons."
			},
			{
				"name": "EntityScreens.scope",
				"type": "ExplorerScope",
				"required": true,
				"description": "Required commit/parent context for labels and links."
			},
			{
				"name": "EntityScreens.mediaBase",
				"type": "string",
				"required": true,
				"description": "Required prefix concatenated with screenshot files."
			},
			{
				"name": "EntityScreens.nav",
				"type": "EntityNav",
				"required": true,
				"description": "Required navigation to tests or selected-commit view."
			},
			{
				"name": "EntityScreens.reasons",
				"type": "Reasons",
				"required": true,
				"description": "Required recorded change reasons, shown for paired comparisons with original text available."
			},
			{
				"name": "EntityScreens.preview",
				"type": "ScreenPick",
				"required": false,
				"description": "Exact optional scenario, state and initial viewport declared for this page. Viewport buttons preserve its scenario and state. Defaults to JavaScript undefined (omitted), not the literal string."
			}
		],
		"outputs": [
			{
				"name": "EntityScreens",
				"type": "markup",
				"description": "Captions retain capture revisions without a separator when none exists. Viewport buttons retain scenario and state. Selecting an image mounts its full-size viewer; a closed viewer adds no empty-selection text. Rejected or absent captures remain explicit gaps."
			}
		],
		"errors": [
			{
				"name": "Navigation callback error",
				"type": "propagated",
				"description": "Errors from nav.href while rendering the comparison link or nav.go when following it propagate; missing screenshots remain visible gaps."
			}
		],
		"operations": [],
		"initialization": [],
		"snippets": [
			{
				"name": "EntityScreens.children",
				"inputs": [
					{
						"name": "EntityScreens.children.pane",
						"type": "unknown",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "EntityScreens.children",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			}
		]
	},
