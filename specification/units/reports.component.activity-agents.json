{
	"schemaVersion": 1,
	"id": "reports.component.activity-agents",
	"kind": "component",
	"title": "Activity agents",
	"responsibility": "Shows declared agent activity while making stale, unavailable and unreadable registrations explicit.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.activity-list",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-em",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-atoms-html-summary"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/activity-agents/ActivityAgents.svelte",
			"packages/reports/src/components/projects-sessions/activity-agents/ActivityAgents.svelte"
		],
		"symbols": ["ActivityAgents", "ActivityAgents"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ActivityAgents.agents",
				"type": "AgentRoster | null",
				"description": "Required roster or null. Null means live activity is not available in this recorded history, not zero working agents. Roster supplies counts, tracking state and declared agent details."
			},
			{
				"name": "ActivityAgents.sampledAt",
				"type": "string",
				"description": "Optional sample timestamp, empty by default. Supplies displayed UTC read time and freshness calculation."
			},
			{
				"name": "ActivityAgents.reading",
				"type": "{ now: number; failed: boolean; refresh: () => void }",
				"description": "Optional current clock, refresh-failure flag and refresh callback. When absent the view uses the sample time for freshness and offers no refresh button."
			}
		],
		"outputs": [
			{
				"name": "ActivityAgents",
				"type": "markup",
				"description": "Working-agents card with current or Unknown count, stale/failed-read notices and registration guidance when tracking was never used. Lists agents with state, model, checkout, branch and details. Working agents expose task/loop and four unit chips initially; nonworking declarations stay behind a disclosure. Unreadable registrations are reported as uncounted."
			}
		],
		"errors": []
	},
