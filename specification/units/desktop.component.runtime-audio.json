{
	"schemaVersion": 1,
	"id": "desktop.component.runtime-audio",
	"kind": "component",
	"title": "Runtime audio",
	"responsibility": "Plays recorded audio with transcripts and matching before/after clips.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.status-icon",
			"reports.component.shared-primitives-atoms-html-audio",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h3",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/RuntimeAudio.svelte",
			"packages/desktop/src/components/reports-media/RuntimeAudio.svelte"
		],
		"symbols": ["RuntimeAudio", "RuntimeAudio"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RuntimeAudio.result",
				"type": "EntityEvidenceResult",
				"description": "Required evidence result with audio entries, declarations, comparison mode and commit scope. Groups clips by comparison identity; after falls back to current."
			},
			{
				"name": "RuntimeAudio.evidence",
				"type": "EntityEvidence",
				"description": "Evidence state providing a URL for side and file. Promise failures are caught and shown as unverified."
			}
		],
		"outputs": [
			{
				"name": "RuntimeAudio",
				"type": "markup",
				"description": "Audio panel when clips exist or audio is declared. Commit mode pairs before/after; other modes show current. Includes playback controls, transcript when present, standing/status and reading/error states. Missing sides and declared-but-absent clips are explicit gaps."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.status-icon",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-evidence-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.entity-evidence",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-audio",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-h3",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-p",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-span",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.entity-screens",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.report-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/reports-media/RuntimeAudio.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/reports-media/RuntimeAudio.svelte"
			}
		]
	},
	"scenarios": ["runtime-evidence-ui"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
