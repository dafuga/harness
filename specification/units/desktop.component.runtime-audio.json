			{
				"name": "RuntimeAudio.evidence",
				"type": "EntityEvidence",
				"required": true,
				"description": "The EntityEvidence store instance whose url(side, file) returns a promise for an object URL of one clip; the component calls it for each clip pane it renders. A rejected promise is caught and shown in that pane as a Not verified notice with the error's message."
			}
		],
		"outputs": [
			{
				"name": "RuntimeAudio",
				"type": "markup",
				"description": "The audio card, shown only when a clip exists or a scenario declares audio: commit mode is headed 'Audio before and after' with Before and After panes, and other modes are headed 'Current audio'. A loaded clip shows its audio controls, its transcript when it has one and its 'standing · status' line; a clip still being read shows 'Reading the clip…' and a failed read shows a Not verified notice, and neither of those shows a standing line; a missing side or a declared clip with no recording shows a 'No clip' gap."
			}
		],
		"errors": [
			{
				"name": "Clip read failure",
				"type": "caught",
				"description": "A clip whose evidence.url promise rejects is caught by the {:catch} branch and shown in its pane as a Not verified notice with the error's message."
			}
		],
