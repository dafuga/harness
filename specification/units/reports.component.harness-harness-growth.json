{
	"schemaVersion": 1,
	"id": "reports.component.harness-harness-growth",
	"kind": "component",
	"title": "Unit measurement history",
	"responsibility": "Displays recorded source, build-output and timing changes for a selected unit.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
