	"schemaVersion": 1,
	"id": "reports.component.harness-entity-change",
	"kind": "component",
	"title": "Entity change",
	"responsibility": "Explains a selected historical change with recorded reasons, review notes and before/after measurements.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-entity-reasons",
			"reports.component.harness-harness-action",
			"reports.component.shared-primitives-atoms-html-dd",
