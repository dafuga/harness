				]
			}
		],
		"outputs": [
			{
				"name": "explorerLegacy",
				"type": "ExplorerLocation",
				"description": "The explorer address retains the input branch and commit. Without a unit it selects Pages; with a unit it uses the category mapped from the penultimate id segment (falling back to functions for unknown kinds), preserves the full id as entity, and marks history for history or growth views.",
