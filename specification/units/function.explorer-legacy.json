		"inputs": [
			{
				"name": "explorerLegacy.route",
				"type": "ConsoleRoute",
				"required": true,
				"description": "The legacy console route supplies branch, commit, and a view, with optional base commit, verification record, and unit id. This mapper reads only branch, commit, view, and unit; branch may be null, the view is one of the five console views, and base and record do not affect its result.",
				"examples": [
					{
						"branch": "main",
						"commit": "0123456789abcdef0123456789abcdef01234567",
