{
	"schemaVersion": 1,
	"id": "reports.function.entity-lens",
	"kind": "function",
	"title": "Entity navigation context",
	"responsibility": "Builds related explorer locations while preserving branch and revision context.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/reports/src/helpers/strings/shortCommit.ts",
			"packages/reports/src/utils/entityLens.ts",
			"packages/reports/src/utils/explorer-ui/entityLens.ts",
			"packages/reports/src/utils/explorer-ui/entityLens.types.ts"
		],
		"symbols": [
			"shortCommit",
			"entityLabels",
			"entityLens",
			"shortCommit",
			"entityLabels",
			"entityLens",
			"shortCommit",
			"EntityLens",
			"EntityNav",
			"EntityLabel",
			"EntityLens",
			"EntityNav",
			"EntityLabel",
			"Target"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "entityLens.from",
				"type": "ExplorerLocation",
				"description": "Current explorer location."
			},
			{
				"name": "entityLens.to",
				"type": "Target",
				"description": "Optional target commit, category, entity, section and tab. Omitted commit/category retain the current values; null commit explicitly selects current mode."
			},
			{
				"name": "shortCommit.commit",
				"type": "string",
				"description": "Commit text to abbreviate."
			}
		],
		"outputs": [
			{
				"name": "entityLabels",
				"type": "Record<ExplorerCategory, EntityLabel>",
				"description": "Titles, singular labels and descriptions for the six explorer collections."
			},
			{
				"name": "entityLens",
				"type": "ExplorerLocation",
				"description": "Location retaining branch and revision; helper identity follows tabs and commits only within the same owning entity. Catalog and different-entity links discard it."
			},
			{
				"name": "shortCommit",
				"type": "string",
				"description": "First seven characters of the supplied commit."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.model.explorer-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.harness-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"helperContracts": [
		{
			"name": "shortCommit",
			"source": "packages/reports/src/helpers/strings/shortCommit.ts",
			"inputs": [
				{
					"name": "shortCommit.commit",
					"type": "string"
				}
			],
			"output": "string",
			"pure": true,
			"examples": [
				{
					"name": "Abbreviate a commit to its first seven characters",
					"call": "shortCommit(\"0123456789abcdef\")",
					"input": ["0123456789abcdef"],
					"output": "0123456"
				},
				{
					"name": "Preserve commit text shorter than seven characters",
					"call": "shortCommit(\"abc\")",
					"input": ["abc"],
					"output": "abc"
				}
			],
			"consumers": [
				{
					"unit": "reports.component.explorer-ui-explorer-module-card"
				},
				{
					"unit": "reports.component.explorer-ui-explorer-platform-details"
				},
				{
					"unit": "reports.component.explorer-usage-link"
				},
				{
					"unit": "reports.component.harness-entity-audio"
				},
				{
					"unit": "reports.component.harness-entity-behavior"
				},
				{
					"unit": "reports.component.harness-entity-change"
				},
				{
					"unit": "reports.component.harness-entity-config"
				},
				{
					"unit": "reports.component.harness-entity-frame"
				},
				{
					"unit": "reports.component.harness-entity-history-row"
				},
				{
					"unit": "reports.component.harness-entity-history"
				},
				{
					"unit": "reports.component.harness-entity-screens"
				},
				{
					"unit": "reports.component.harness-entity-summary"
				},
				{
					"unit": "reports.component.harness-entity-tests"
				},
				{
					"unit": "reports.component.harness-explorer-frame"
				}
			]
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/utils/explorer-ui/entityLens.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/utils/explorer-ui/entityLens.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
