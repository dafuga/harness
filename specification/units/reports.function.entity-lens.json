				"type": "ExplorerLocation",
				"required": true,
				"description": "The location a link starts from (`from`). Its branch is always kept, its commit and category are kept when `to` omits them, and its section and tab are never carried over; its helper is carried over only when `to` names the same entity and names no helper of its own.",
				"examples": [
					{
						"branch": "main",
						"commit": null,
						"category": "components",
						"entity": "reports.component.source-viewer",
						"tab": "source"
