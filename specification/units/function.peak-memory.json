{
	"schemaVersion": 1,
	"id": "function.peak-memory",
	"kind": "function",
	"title": "Process peak memory",
	"responsibility": "Runs a command under the system time utility and extracts its peak resident memory when available.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/cli/program/run-kernel-bench/kernel-benchmark-service/peakMemory.ts",
			"src/utils/development-tooling/peakMemory.ts",
			"src/utils/peakMemory.ts"
		],
		"symbols": ["peakMemory", "PeakMemory", "peakMemory", "peakMemory"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "peakMemory.command",
				"type": "string",
				"description": "Executable to run under /usr/bin/time."
			},
			{
				"name": "peakMemory.args",
				"type": "string[]",
				"description": "Arguments passed to that executable."
			},
			{
				"name": "peakMemory.input",
				"type": "string",
				"description": "Text sent to the process standard input."
			}
		],
		"outputs": [
			{
				"name": "peakMemory",
				"type": "PeakMemory",
				"description": "Peak resident bytes from a successful BSD/GNU time report, converting GNU kilobytes by 1024; otherwise an unavailable explanation. Execution is synchronous and the command actually runs."
			}
		],
		"errors": []
	},
	"dependencies": [],
	"runtime": {
