{
	"schemaVersion": 1,
	"id": "desktop.component.agent-model-picker",
	"kind": "component",
	"title": "Agent model picker",
	"responsibility": "Presents models grouped by provider and updates both identifiers of the chosen agent model.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.choice-dialog",
			"desktop.component.icon",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-small"
		]
	},
	"owns": {
		"source": ["packages/desktop/src/components/agents-providers/AgentModelPicker.svelte"],
		"symbols": ["AgentModelPicker", "AgentModelPicker.icon", "AgentModelPicker.children"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "AgentModelPicker.providers",
				"type": "ProviderState[]",
				"required": true,
				"description": "Required providers with labels, models, availability and reasons. Unavailable providers stay visible with disabled model buttons; an available provider with no models gets an explicit empty message."
			},
			{
				"name": "AgentModelPicker.provider",
				"type": "ProviderId",
				"required": false,
				"description": "Required bindable provider identifier. Selecting a model stores its provider identifier unchanged. Together with model, determines the selected button and tooltip."
			},
			{
				"name": "AgentModelPicker.model",
				"type": "string",
				"required": false,
				"description": "Required bindable model identifier. Selecting a model stores its identifier unchanged and closes the picker. Does not choose a default model."
			}
		],
		"outputs": [
			{
				"name": "AgentModelPicker",
				"type": "markup",
				"description": "Model icon and provider-grouped dialog with reasons, selected state and empty-provider messages. An enabled choice updates provider and model together."
			}
		],
		"errors": [],
		"operations": [],
		"initialization": [],
		"snippets": [
			{
				"name": "AgentModelPicker.icon",
				"inputs": [],
				"outputs": [
					{
						"name": "AgentModelPicker.icon",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			},
			{
				"name": "AgentModelPicker.children",
				"inputs": [
					{
						"name": "AgentModelPicker.children.close",
						"type": "() => void",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "AgentModelPicker.children",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			}
		]
	},
	"dependencies": [
		{
			"unit": "desktop.component.choice-dialog",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.icon",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-button",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-h2",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-section",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-small",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/agents-providers/AgentModelPicker.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/agents-providers/AgentModelPicker.svelte"
			}
		]
	},
	"scenarios": ["agent-settings"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
