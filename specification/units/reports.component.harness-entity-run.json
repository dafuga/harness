{
	"schemaVersion": 1,
	"id": "reports.component.harness-entity-run",
	"kind": "component",
	"title": "Recorded test run",
	"responsibility": "Displays one side of grouped test outcomes and their artifacts.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-entity-artifact",
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h3",
			"reports.component.shared-primitives-atoms-html-header",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/EntityRun.svelte"],
		"symbols": ["EntityRun"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityRun.shown",
				"type": "EntityBehavior",
				"description": "Required grouped behavior/scenario data. Overall passes only with at least one group and every selected-side group passing."
			},
			{
				"name": "EntityRun.side",
				"type": "'before' | 'after'",
				"description": "Required before or after, selecting each group/line outcome. After alone displays difference paths."
			},
			{
				"name": "EntityRun.title",
				"type": "string",
				"description": "Required pane heading and accessible name."
			},
			{
				"name": "EntityRun.role",
				"type": "string",
				"description": "Required descriptive side badge."
			},
			{
				"name": "EntityRun.mediaBase",
				"type": "string",
				"description": "Required artifact URL base passed to result viewers."
			},
			{
				"name": "EntityRun.lost",
				"type": "boolean",
				"description": "Optional flag, false by default, telling artifacts that reading failed rather than remains pending."
			},
			{
				"name": "EntityRun.unit",
				"type": "string",
				"description": "Optional function identifier passed through to callable case rows."
			}
		],
		"outputs": [
			{
				"name": "EntityRun",
				"type": "markup",
				"description": "Run pane with overall/state verdicts, scenario/state names, result kinds and Passed/Failed/Not recorded labels. Shows supplied artifacts and after-side differences without calculating new verification."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.component.harness-entity-artifact",
			"via": "import",
			"origin": "derived"
		},
