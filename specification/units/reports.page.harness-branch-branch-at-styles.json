{
	"schemaVersion": 1,
	"id": "reports.page.harness-branch-branch-at-styles",
	"kind": "page",
	"title": "/harness/branch/[branch]/[...at]/styles",
	"responsibility": "Shows running explorer design tokens while preserving selected branch or commit navigation.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "page",
		"uses": [
			"reports.component.explorer-ui-harness-explorer-styles-screen",
			"reports.component.harness-screen"
		]
	},
	"owns": {
		"source": ["packages/reports/src/routes/harness/branch/[branch]/[...at]/styles/+page.svelte"],
		"symbols": ["+page"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "branch",
				"type": "string",
				"description": "The selected project branch, preserved in Styles navigation."
