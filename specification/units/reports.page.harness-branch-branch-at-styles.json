			"unit": "reports.component.harness-screen",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/routes/harness/branch/[branch]/[...at]/styles/+page.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/routes/harness/branch/[branch]/[...at]/styles/+page.svelte"
			}
		]
	},
	"scenarios": ["harness-styles"],
	"budgets": {
		"size": "frozen",
