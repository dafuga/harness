	},
	"contract": {
		"origin": "declared",
		"primitives": ["reports.component.explorer-ui-explorer-kit-card"],
		"inputs": [
			{
				"name": "EntityFrame.host",
				"type": "ExplorerScreenProps",
				"required": true,
				"description": "Host props provide the shown revision, route, listed entities, parent revision, lens data and navigation/rendering inputs used to resolve the address. An unlisted entity resolves only from an active head unit or, when a parent revision contains it and head.sourceImpact marks its id removed, from that prior unit."
			},
			{
				"name": "EntityFrame.children",
				"type": "Snippet<[ExplorerEntity, EntityNav]>",
				"required": true,
				"description": "Screen snippet used for a resolved entity, receiving the entity and navigation state. It is not rendered while an unselected function unit with multiple helpers shows its chooser or when no entity resolves."
			}
		],
		"outputs": [
			{
				"name": "EntityFrame.entityHeaderAndScreen",
				"type": "markup",
				"description": "Markup wraps ExplorerFrame and shows either the multi-helper chooser, the resolved entity header with its supplied screen, or the missing-state view. Listed entities take precedence; otherwise an entity is available only from an active head unit or a parent unit whose id head.sourceImpact marks removed."
			}
		],
