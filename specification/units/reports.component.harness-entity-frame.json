{
	"schemaVersion": 1,
	"id": "reports.component.harness-entity-frame",
	"kind": "component",
	"title": "EntityFrame",
	"responsibility": "Finds the entity an address names, heads its screen with it, and says that the entity is missing where the revision does not hold it. Selected-helper Uses visibility follows only the selected callable; empty Uses tabs are omitted.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-entity-header",
			"reports.component.harness-entity-link",
			"reports.component.harness-entity-missing",
			"reports.component.harness-entity-screens",
			"reports.component.harness-explorer-frame",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h1",
			"reports.component.shared-primitives-atoms-html-li",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-ul"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/EntityFrame.svelte"],
		"symbols": ["EntityFrame"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityFrame.host",
				"type": "ExplorerScreenProps",
				"description": "Everything the host gives a screen: the shown revision, address, entities and its answers."
			},
			{
				"name": "EntityFrame.children",
				"type": "Snippet<[ExplorerEntity, EntityNav]>",
				"description": "The screen of the entity the address names; it is given that entity."
			}
		],
		"outputs": [
			{
				"name": "EntityFrame.entityHeaderAndScreen",
				"type": "markup",
				"description": "Selected entity header and screen. A helper address selects only its callable API; a legacy multi-callable address offers individual links. Missing helpers remain explicit. Owning module identity/history is retained. Screenshot selection receives the entity preview binding."
			}
		],
		"errors": [
			{
				"name": "no-registry",
				"type": "stated",
				"description": "A revision that stores no unit registry says so; nothing of another revision is shown."
			},
			{
				"name": "entity-missing",
				"type": "stated",
				"description": "An entity the shown revision does not hold is said to be missing, with the way back to its collection."
			}
		]
	},
