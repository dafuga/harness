{
	"schemaVersion": 1,
	"id": "reports.component.explorer-ui-explorer-kit-card",
	"kind": "component",
	"title": "Explorer card",
	"responsibility": "Draws one explorer card as an article, or as a labelled section, around the content it is given.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
		"uses": [
			"reports.component.shared-primitives-atoms-html-article",
			"reports.component.shared-primitives-atoms-html-section"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/explorer-kit/Card.svelte"],
		"symbols": ["Card"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "Card.as",
				"type": "'article' | 'section'",
				"description": "'article' (default) or 'section'; a section names a labelled region of the screen."
			},
			{
				"name": "Card.tone",
				"type": "string",
				"description": "Extra class names for the owner's own card styling."
			},
			{
				"name": "Card.labelledby",
				"type": "string",
				"description": "Id of the heading that names the card."
			},
			{
				"name": "Card.children",
				"type": "Snippet",
				"description": "The card content."
			}
		],
		"outputs": [
			{
				"name": "Card",
				"type": "markup",
				"description": "An article or section with the shared ex-card style."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.component.shared-primitives-atoms-html-article",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-section",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/components/explorer-ui/explorer-kit/Card.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/components/explorer-ui/explorer-kit/Card.svelte"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
