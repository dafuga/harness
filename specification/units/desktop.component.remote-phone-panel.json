{
	"schemaVersion": 1,
	"id": "desktop.component.remote-phone-panel",
	"kind": "component",
	"title": "Remote phone panel",
	"responsibility": "Guides pairing from a phone and displays connection status and granted access.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-form",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-input",
			"reports.component.shared-primitives-atoms-html-label",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/networking-security/remote-phone-panel/RemotePhonePanel.svelte",
			"packages/desktop/src/components/remote-phone-panel/RemotePhonePanel.svelte"
		],
		"symbols": ["RemotePhonePanel", "RemotePhonePanel"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RemotePhonePanel.store",
				"type": "RemotePhone",
				"description": "Phone status and operations, including scan/disconnect, busy/errors, scan failure and fixture flag. Scan receives the entered device name, initially iPhone."
			},
			{
				"name": "RemotePhonePanel.compact",
				"type": "boolean",
				"description": "Optional flag, false by default. Compact hides unpaired setup form/instructions, grant/device details and fixture notice; applicable connection actions and store errors remain."
			}
		],
		"outputs": [
			{
				"name": "RemotePhonePanel",
				"type": "markup",
				"description": "Connection panel when status and labels exist. Full unpaired view offers a phone-name input limited to 80 characters and QR scan/retry. Other states display status and a disconnect action labeled Cancel for pairing/pending approval, Connect again for revoked, otherwise Disconnect. Full mode shows grant and phone identity. Busy disables buttons; errors are alerts."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.function.remote-labels",
			"via": "import",
			"origin": "derived"
		},
