{
	"schemaVersion": 1,
	"id": "reports.component.explorer-ui-explorer-kit-pill",
	"kind": "component",
	"title": "Explorer pill",
	"responsibility": "Shows a short inline label, such as a state or a count, in the explorer pill style.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
		"uses": ["reports.component.shared-primitives-atoms-html-span"]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/explorer-kit/Pill.svelte"],
		"symbols": ["Pill"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "Pill.tone",
				"type": "string",
				"required": false,
				"default": "",
				"description": "Extra class names for the owner's styling."
			},
			{
				"name": "Pill.state",
				"type": "string",
				"required": false,
				"description": "Optional state exposed as data-state for styling. Defaults to JavaScript undefined, omitting data-state."
			},
			{
				"name": "Pill.children",
				"type": "Snippet",
