	"contract": {
		"origin": "declared",
		"primitives": ["reports.component.select"],
		"inputs": [
			{
				"name": "ProviderPicker.label",
				"type": "string",
				"required": false,
				"default": "Model picker",
				"description": "The heading text rendered above the picker. It defaults to \"Model picker\" and changes only the heading.",
				"examples": ["Model picker", "Choose a model"]
			}
		],
		"outputs": [
			{
				"name": "ProviderPicker",
				"type": "markup",
				"description": "The rendered picker section for binding a session, displaying catalog and queued state, and selecting a provider, model, and effort to refresh, queue, cancel, or list requests. Queueing submits a request only; it does not itself change the active selection or defaults, and queued sessions are loaded only on request."
			}
		],
		"errors": [
			{
				"name": "Picker client rejection",
				"type": "thrown",
				"description": "Opening the picker client or calling it for status, switch, cancellation, or observed-session data can reject. The component catches these failures and displays failure text with the relevant fallback message."
			},
			{
				"name": "Error",
				"type": "thrown",
				"description": "Loading observed sessions throws Error('Queued sessions could not be read.') when readSessions produces no list. The action handler catches it and displays the failure text."
			}
		],
		"errorStatus": "declared",
