{
	"schemaVersion": 1,
	"id": "reports.page.reports-id",
	"kind": "page",
	"title": "/reports/[id]",
	"responsibility": "Redirects a former report address to the console, which opens the explorer where that report belongs.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["packages/reports/src/routes/reports/[id]/+page.server.ts"],
		"symbols": ["load"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "load.input",
				"type": "{ params: { id: string } }",
				"description": "The legacy report identifier to carry into the console address."
			}
		],
		"outputs": [
			{
				"name": "load",
				"type": "never",
				"description": "Does not return; throws the permanent redirect to the report address in the explorer."
			}
		],
		"errors": [
			{
				"name": "Redirect",
				"type": "SvelteKit redirect",
				"description": "Throws HTTP 308 to /harness/reports/{encoded id}."
			}
		]
	},
	"dependencies": [],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/routes/reports/[id]/+page.server.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/routes/reports/[id]/+page.server.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
