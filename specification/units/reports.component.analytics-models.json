	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "AnalyticsModels.models",
				"type": "Models",
				"description": "Required analytics model summary with check/loop author counts, evaluator counts/tokens and per-author first-try figures for response and clean-code checks. Names, including unknown, are preserved."
			}
		],
		"outputs": [
			{
				"name": "AnalyticsModels",
				"type": "markup",
				"description": "Role-separated usage cards, token totals and author first-try table. Usage bars scale to the largest count. A zero assessed denominator displays an unavailable rate regardless of its stored rate, with excluded/check counts kept visible. Empty categories are stated explicitly. Does not recompute which checks count as assessments."
			}
		],
