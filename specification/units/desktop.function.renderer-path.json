{
	"schemaVersion": 1,
	"id": "desktop.function.renderer-path",
	"kind": "function",
	"title": "Read a renderer route",
	"responsibility": "Extract branch, commit, category, entity and tab from an explorer route.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/utils/development-tooling/rendererPath.ts",
			"packages/desktop/src/utils/development-tooling/rendererPath.types.ts",
			"packages/desktop/src/utils/rendererPath.ts"
		],
		"symbols": ["rendererPath", "RendererRoute", "RendererRoute", "rendererPath"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "rendererPath.path",
				"type": "string",
				"description": "Path beginning with /harness/branch to parse; other paths use the default route."
			}
		],
		"outputs": [
			{
				"name": "rendererPath",
				"type": "RendererRoute",
				"description": "Parsed route; defaults are pages and null branch, commit, entity and tab. Branch/entity are URI-decoded; unknown categories become pages."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/utils/development-tooling/rendererPath.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/utils/development-tooling/rendererPath.ts"
			}
		]
	},
	"scenarios": ["desktop-native", "desktop-project-runs"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
