{
	"schemaVersion": 1,
	"id": "adapter.agents-providers-module-task-sandbox-process",
	"kind": "adapter",
	"title": "ModuleTaskSandboxProcessAdapter",
	"responsibility": "Build a trusted per-process sandbox-runtime driver that adds a native hardlink deny before the provider is launched.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/adapters/agents-providers/ModuleTaskSandboxProcessAdapter.ts",
			"src/adapters/agents-providers/ModuleTaskSandboxProcessAdapter.types.ts"
		],
		"symbols": [
			"ModuleTaskSandboxProcessAdapter",
			"ModuleTaskSandboxProcessAdapter.constructor",
			"ModuleTaskSandboxProcessAdapter.connect",
			"ModuleTaskSandboxProcessAdapter.command",
			"ModuleTaskSandboxProcessAdapter.validateScratch",
			"ModuleTaskSandboxProcessAdapter.arguments",
			"ModuleTaskSandboxProcessAdapter.environment",
			"ModuleTaskSandboxProcessAdapterConfig",
			"ModuleTaskSandboxProcessAdapterConfig"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "constructor.config",
				"type": "{name?:string}",
				"description": "Optional connect label; null is not an admitted configuration."
			},
			{
				"name": "command.sdk",
				"type": "absolute string path to pinned sandbox-runtime index.js",
				"description": "Trusted sandbox-runtime module path passed unchanged to the driver."
			},
			{
				"name": "command.settings",
				"type": "absolute string path to trusted immutable JSON settings",
				"description": "Trusted settings file path passed unchanged to the driver."
			},
			{
				"name": "command.argv",
				"type": "string[] exact provider command arguments",
				"description": "Provider argument vector serialized without shell interpretation."
			},
			{
				"name": "validateScratch.path",
				"type": "absolute canonical trusted scratch directory",
				"description": "Trusted scratch root to inspect; the caller supplies an absolute path."
			},
			{
				"name": "arguments.scope",
				"type": "ModuleTaskSandboxInput",
				"description": "Validated scope whose scratch and cwd form the isolated provider command."
			},
			{
				"name": "environment.scope",
				"type": "ModuleTaskSandboxInput",
				"description": "Validated scope with sealed CLI directory and contract snapshot."
			},
			{
				"name": "environment.directory",
				"type": "string",
				"description": "Trusted outer process directory for temporary runtime state."
			}
		],
		"outputs": [
			{
				"name": "connect",
				"type": "string",
				"description": "Configured name or module-task-sandbox-process by default."
			},
			{
				"name": "command",
				"type": "string[]",
				"description": "Node/Bun interpreter argv for a per-process trusted driver. Initializes sandbox-runtime in that process, preserves its filesystem/network policy, inserts (deny file-link) into its pinned macOS profile, then launches provider with inherited stdio. Refuses an unexpected native wrapper format. Closes native proxy state only after child exit; no nested sandbox_apply."
			},
			{
				"name": "validateScratch",
				"type": "Promise<void>",
				"description": "Before native launch, inspect only scratch file metadata with bounded traversal. Reject symbolic links, hardlinked files, special files or excessive entries. No file contents read; safe regular files and directories retained for retries. A preexisting alias into writable scratch must never widen file permissions."
			},
			{
				"name": "arguments",
				"type": "string[]",
				"description": "Builds isolated provider argv with task cwd and generic and Claude temporary directories in scratch."
			},
			{
				"name": "environment",
				"type": "Record<string,string | undefined>",
				"description": "Selects trusted runtime environment values and sealed contract snapshot; excludes provider API keys."
			}
		],
		"errors": [
			{
				"name": "Unknown wrapper shape or sandbox initialization failure",
				"type": "safe prelaunch nonzero process result; no unrestricted fallback"
			},
			{
				"name": "Unsafe scratch contents",
				"type": "Error before native process return",
				"description": "Fail closed on any preexisting symbolic/hard link or unsafe special file; no cleanup of caller contents."
			},
			{
				"name": "TypeError",
				"type": "thrown",
				"description": "Null configuration or method scope throws TypeError when a method reads it."
			}
		]
	},
	"dependencies": [
		{
			"unit": "adapter.agents-providers-module-task-sandbox",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/adapters/agents-providers/ModuleTaskSandboxProcessAdapter.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/adapters/agents-providers/ModuleTaskSandboxProcessAdapter.ts"
			}
		]
	},
