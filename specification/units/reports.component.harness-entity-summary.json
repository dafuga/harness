		"origin": "declared",
		"inputs": [
			{
				"name": "EntitySummary.measure",
				"type": "EntityMeasure",
				"description": "Required prepared size and performance rows including emitted target identity, notes, environment, tolerance and over-policy flags."
			},
			{
				"name": "EntitySummary.compact",
				"type": "boolean",
				"description": "Optional flag, false by default. True hides inline size notes while retaining their tooltips."
			}
		],
		"outputs": [
			{
				"name": "EntitySummary",
				"type": "markup",
				"description": "One Performance profile card with equal-height label/value rows. Output-size rows with target none are omitted; real target sizes and unavailable reasons remain visible. Workload profiles stay separate and supplied tolerance flags remain visible."
			}
