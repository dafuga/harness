{
	"schemaVersion": 1,
	"id": "repository.source-history",
	"kind": "repository",
	"title": "SourceHistoryRepository",
	"responsibility": "Lists the branches and commits of source history, leaving out evidence, notes and internal refs and marking commits kept only by an archive ref.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/repositories/SourceHistoryRepository.ts",
			"src/repositories/source-history-repository/SourceHistoryRepository.ts"
		],
		"symbols": [
			"SourceRevision",
			"SourceHistory",
			"SourceHistoryRepository",
			"SourceHistoryRepository.constructor",
			"SourceHistoryRepository.read",
			"SourceHistoryRepository.revision",
			"SourceRevision",
			"SourceHistory",
			"SourceHistoryRepository"
		]
	},
	"contract": {
		"origin": "derived",
		"inputs": [
			{
				"name": "SourceHistoryRepository.constructor.root",
				"type": "string"
			},
			{
				"name": "SourceHistoryRepository.read.limit",
				"type": "number"
			},
			{
				"name": "SourceHistoryRepository.revision.commit",
				"type": "string"
			},
			{
				"name": "SourceHistoryRepository.revision.branches",
				"type": "string[]"
			}
		],
		"outputs": [
			{
				"name": "SourceHistoryRepository.read",
				"type": "Promise<SourceHistory>"
			},
			{
				"name": "SourceHistoryRepository.revision",
				"type": "Promise<SourceRevision | undefined>"
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "adapter.git",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.history-refs",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.source-branches",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/repositories/source-history-repository/SourceHistoryRepository.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/repositories/SourceHistoryRepository.ts"
			}
		]
	},
	"scenarios": ["desktop-recorded-evidence"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
