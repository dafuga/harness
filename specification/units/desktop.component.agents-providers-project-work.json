{
	"schemaVersion": 1,
	"id": "desktop.component.agents-providers-project-work",
	"kind": "component",
	"title": "ProjectWork",
	"responsibility": "Present selected-project feature plans, reference-bound design choices, wanted contracts, approval controls and actual task progress.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.agents-providers-project-work-feature",
			"reports.component.shared-primitives-atoms-html-button",
