			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.shared-primitives-atoms-html-ul"
		]
	},
	"owns": {
		"source": ["packages/desktop/src/components/agents-providers/ProjectWork.svelte"],
		"symbols": ["ProjectWork"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ProjectWork.snapshot",
				"type": "FeatureWorkSnapshot | null",
				"description": "One committed project-scoped queue snapshot including plan choices, wanted contracts and persisted task states."
			},
			{
				"name": "ProjectWork.loading",
				"type": "boolean",
				"description": "Whether the feature work snapshot is currently loading."
			},
			{
				"name": "ProjectWork.error",
				"type": "string | null",
				"description": "Unavailable or stale-read explanation."
			},
			{
				"name": "ProjectWork.workspace",
				"type": "Workspace",
				"description": "Selected project identity, exact-image reader and current bridge capabilities."
			},
			{
				"name": "ProjectWork.actions",
				"type": "ProjectWorkActionsStore",
				"description": "Digest-bound design selection and explicit approval with pending/error state."
			}
		],
		"outputs": [
			{
				"name": "ProjectWork",
				"type": "markup",
				"description": "Honest loading, unavailable, empty and stale states; each feature has a plan/design/approval/work timeline and nested module tree with wanted contracts and dependency-ordered task dots. Page choices show exact committed images and preferred/selected state. Selection is bound to the current digest; approval requires all page choices and a named reviewer, then submits only approved task records."
			}
		],
		"errors": [
			{
				"name": "unavailable or stale project",
				"type": "visible status",
				"description": "Shows the last committed snapshot as stale or a clear unavailable state; never invents task progress or displays an image from another revision."
			},
			{
				"name": "stale plan action",
				"type": "visible action error",
				"description": "Preserves the plan and reports a digest or revision conflict; no stale selection or approval is shown as successful."
			}
		]
	},
