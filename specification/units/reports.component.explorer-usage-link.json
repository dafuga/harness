{
	"schemaVersion": 1,
	"id": "reports.component.explorer-usage-link",
	"kind": "component",
	"title": "ExplorerUsageLink",
	"responsibility": "Opens a consumer entity and previews its own revision-bound screenshot on hover or keyboard focus.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-entity-link",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-img",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/ExplorerUsageLink.svelte",
			"packages/reports/src/components/explorer-ui/ExplorerUsageLink.svelte"
		],
		"symbols": ["ExplorerUsageLink", "ExplorerUsageLink"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ExplorerUsageLink.entity",
				"type": "ExplorerEntity",
				"description": "Referenced entity at the shown revision; its own capture is used."
			},
			{
				"name": "ExplorerUsageLink.nav",
				"type": "EntityNav",
				"description": "Navigation preserving the selected branch and commit."
			},
			{
				"name": "ExplorerUsageLink.lens",
				"type": "EntityLens",
				"description": "The selected revision evidence resolver; no screenshot is borrowed from another entity."
			},
			{
				"name": "ExplorerUsageLink.mediaBase",
				"type": "string",
				"description": "URL prefix resolving the referenced screenshot file."
			}
		],
		"outputs": [
			{
				"name": "ExplorerUsageLink",
				"type": "markup",
				"description": "A normal entity link with a viewport-bounded hover/focus preview, screenshot provenance and explicit missing-image fallback. Escape dismisses the preview; touch and Enter navigate."
			}
		],
		"errors": []
	},
	"dependencies": [
