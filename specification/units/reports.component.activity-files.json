{
	"schemaVersion": 1,
	"id": "reports.component.activity-files",
	"kind": "component",
	"title": "Activity files",
	"responsibility": "Separates currently uncommitted files from recent committed file changes.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.activity-list",
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-h3",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-time"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/ActivityFiles.svelte",
			"packages/reports/src/components/projects-sessions/ActivityFiles.svelte",
			"packages/reports/src/components/projects-sessions/ActivityFiles.types.ts"
		],
		"symbols": ["ActivityFiles", "ActivityFiles", "Open"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ActivityFiles.files",
				"type": "CommittedFile[]",
				"description": "Required committed changes with path, status, last-change commit/time and unit owners. Kept in supplied order."
			},
			{
				"name": "ActivityFiles.worktrees",
				"type": "WorktreeState[] | null",
				"description": "Required checkout snapshots or null. Null denotes unavailable live checkout state; an empty array or no changes displays no uncommitted changes. Includes truncation information."
			},
			{
				"name": "ActivityFiles.href",
				"type": "(commit: string) => string",
				"description": "Required callback forming a commit-page link for each committed file."
			},
			{
				"name": "ActivityFiles.registry",
				"type": "string",
				"description": "Required wording identifying which revision’s registry supplied component ownership labels."
			}
		],
		"outputs": [
			{
				"name": "ActivityFiles",
				"type": "markup",
				"description": "Uncommitted and committed lists with paths, status, ownership chips and commit links. Shows six entries initially in each list, with expansion controls. Counts changed files and checkouts, mentions truncation and distinguishes unavailable live state from empty lists. The data is displayed without querying Git."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "function.activity-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.activity-list",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-a",
			"via": "import",
