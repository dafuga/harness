		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-time",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.activity-display",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/components/projects-sessions/ActivityFiles.svelte",
		"targets": [
			{
				"kind": "module",
