{
	"schemaVersion": 1,
	"id": "kernel.impact-kernel",
	"kind": "kernel",
	"title": "impact-kernel",
	"responsibility": "Rust implementation of the impact kernel, built as a native JSON process and a core Wasm module.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"crates/impact-kernel/Cargo.toml",
			"crates/impact-kernel/src/abi.rs",
			"crates/impact-kernel/src/impact.rs",
			"crates/impact-kernel/src/lib.rs",
			"crates/impact-kernel/src/main.rs",
			"crates/impact-kernel/src/request.rs",
			"crates/impact-kernel/tests/vectors.json",
			"crates/impact-kernel/tests/vectors.rs"
		],
		"symbols": []
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "request.operation",
				"type": "\"impact\" | \"version\""
			},
			{
				"name": "impact.base",
				"type": "KernelGraph"
			},
			{
				"name": "impact.head",
				"type": "KernelGraph"
			},
			{
				"name": "impact.changed",
				"type": "string[]"
			},
			{
				"name": "impact.uncertain",
				"type": "string[]"
			},
			{
				"name": "impact.sinks",
				"type": "string[]"
			}
		],
		"outputs": [
			{
				"name": "impact",
				"type": "ImpactOutput"
			},
			{
				"name": "version",
				"type": "{ contract: \"impact-kernel/1\" }"
			}
		],
		"errors": [
			{
				"name": "invalid-json",
				"type": "refused"
			},
			{
				"name": "invalid-request",
				"type": "refused"
			},
			{
				"name": "invalid-graph",
				"type": "refused"
			},
			{
				"name": "unknown-operation",
				"type": "refused"
			}
		]
	},
	"dependencies": [
		{
			"unit": "function.impact-kernel",
			"via": "contract",
			"origin": "declared",
			"contract": "impact-kernel/1"
		}
	],
	"runtime": {
		"kind": "process",
		"entry": "target/kernel/impact-kernel",
		"targets": [
			{
				"kind": "process",
				"entry": "target/kernel/impact-kernel"
			},
			{
				"kind": "wasm",
				"entry": "target/kernel/impact-kernel.wasm",
				"environment": "wasm32-unknown-unknown"
			}
		]
	},
	"scenarios": ["kernel-build"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
