{
	"schemaVersion": 1,
	"id": "function.agent-liveness",
	"kind": "function",
	"title": "Agent liveness",
	"responsibility": "Determines whether an agent finished, lost its process, exceeded its heartbeat allowance or is still working.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/services/agent-activity-service/agentLiveness.ts",
			"src/services/agents-providers/agent-activity-service/agentLiveness.ts",
			"src/utils/agentLiveness.ts",
			"src/utils/agents-providers/agentLiveness.ts"
		],
		"symbols": [
			"agentLiveness",
			"agentLiveness",
			"agentLiveness",
			"AgentFacts",
			"ProcessFacts",
			"agentLiveness"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "agentLiveness.agent",
				"type": "AgentFacts",
				"description": "Registration and latest heartbeat facts, heartbeat allowance in seconds, optional process identity, and any final completed or failed record. Dates are expected to be parseable strings."
			},
			{
				"name": "agentLiveness.now",
				"type": "number",
				"description": "Time of the assessment in milliseconds since the Unix epoch; a heartbeat is stale only when its age is greater than the allowance."
			},
			{
				"name": "agentLiveness.processOf",
				"type": "(pid: number) => ProcessFacts",
				"description": "Lookup for the named process, returning existence and start time. Called only for an unfinished agent with a non-null pid; undefined existence means the process could not be checked."
			}
		],
		"outputs": [
			{
				"name": "agentLiveness",
				"type": "{ state: AgentState; detail: string }",
				"description": "State and explanation: a final status wins, an absent or reused process is gone, an overdue heartbeat is stale, and otherwise the agent is working."
			}
		],
		"errors": [
			{
				"name": "Process lookup error",
				"type": "Error",
				"description": "Exceptions from a requested process lookup propagate."
			},
			{
				"name": "Invalid agent",
				"type": "TypeError",
				"description": "A null or undefined agent cannot supply the required registration fields."
			},
			{
				"name": "Invalid process lookup",
				"type": "TypeError",
				"description": "A non-callable process lookup fails when an unfinished agent has a process ID."
			},
			{
				"name": "Invalid process result",
				"type": "TypeError",
				"description": "A null process lookup result cannot supply the required process facts."
			}
		]
	},
	"dependencies": [
		{
			"unit": "function.activity-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/utils/agents-providers/agentLiveness.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/utils/agents-providers/agentLiveness.ts"
			}
		]
	},
	"scenarios": [],
	"testing": {
		"version": 1,
		"shape": "helper",
		"examples": [
			{
				"subject": "agentLiveness",
				"name": "Fresh heartbeat",
				"call": "agentLiveness({\"registeredAt\":\"2026-10-11T11:00:00.000Z\",\"heartbeatAt\":\"2026-10-11T11:59:30.000Z\",\"ttlSeconds\":900,\"pid\":null,\"processStartedAt\":null,\"finished\":null}, 1791720000000, () => ({\"exists\":true,\"startedAt\":\"Sun Oct 11 10:07:29 2026\"}))",
				"input": [
					{
						"registeredAt": "2026-10-11T11:00:00.000Z",
						"heartbeatAt": "2026-10-11T11:59:30.000Z",
						"ttlSeconds": 900,
						"pid": null,
						"processStartedAt": null,
						"finished": null
					},
					1791720000000,
					{
						"exists": true,
						"startedAt": "Sun Oct 11 10:07:29 2026"
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"state": "working",
						"detail": "Last heartbeat at 2026-10-11T11:59:30.000Z"
					}
				}
			},
			{
				"subject": "agentLiveness",
				"name": "Overdue heartbeat",
				"call": "agentLiveness({\"registeredAt\":\"2026-10-11T11:00:00.000Z\",\"heartbeatAt\":\"2026-10-11T11:44:59.000Z\",\"ttlSeconds\":900,\"pid\":null,\"processStartedAt\":null,\"finished\":null}, 1791720000000, () => ({\"exists\":true,\"startedAt\":\"Sun Oct 11 10:07:29 2026\"}))",
				"input": [
					{
						"registeredAt": "2026-10-11T11:00:00.000Z",
						"heartbeatAt": "2026-10-11T11:44:59.000Z",
						"ttlSeconds": 900,
						"pid": null,
						"processStartedAt": null,
						"finished": null
					},
					1791720000000,
					{
						"exists": true,
						"startedAt": "Sun Oct 11 10:07:29 2026"
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"state": "stale",
						"detail": "No heartbeat since 2026-10-11T11:44:59.000Z; it allowed 900 seconds between heartbeats"
					}
				}
			},
			{
				"subject": "agentLiveness",
				"name": "Completed registration",
				"call": "agentLiveness({\"registeredAt\":\"2026-10-11T11:00:00.000Z\",\"heartbeatAt\":\"2026-10-11T11:59:30.000Z\",\"ttlSeconds\":900,\"pid\":null,\"processStartedAt\":null,\"finished\":{\"status\":\"completed\",\"at\":\"2026-10-11T11:59:00.000Z\"}}, 1791720000000, () => ({\"exists\":true,\"startedAt\":\"Sun Oct 11 10:07:29 2026\"}))",
				"input": [
					{
						"registeredAt": "2026-10-11T11:00:00.000Z",
						"heartbeatAt": "2026-10-11T11:59:30.000Z",
						"ttlSeconds": 900,
						"pid": null,
						"processStartedAt": null,
						"finished": {
							"status": "completed",
							"at": "2026-10-11T11:59:00.000Z"
						}
					},
					1791720000000,
					{
						"exists": true,
						"startedAt": "Sun Oct 11 10:07:29 2026"
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"state": "completed",
						"detail": "Finished at 2026-10-11T11:59:00.000Z"
					}
				}
			},
			{
				"subject": "agentLiveness",
				"name": "Failed registration",
				"call": "agentLiveness({\"registeredAt\":\"2026-10-11T11:00:00.000Z\",\"heartbeatAt\":\"2026-10-11T11:59:30.000Z\",\"ttlSeconds\":900,\"pid\":null,\"processStartedAt\":null,\"finished\":{\"status\":\"failed\",\"at\":\"2026-10-11T11:59:00.000Z\"}}, 1791720000000, () => ({\"exists\":true,\"startedAt\":\"Sun Oct 11 10:07:29 2026\"}))",
				"input": [
					{
						"registeredAt": "2026-10-11T11:00:00.000Z",
						"heartbeatAt": "2026-10-11T11:59:30.000Z",
						"ttlSeconds": 900,
						"pid": null,
						"processStartedAt": null,
						"finished": {
							"status": "failed",
							"at": "2026-10-11T11:59:00.000Z"
						}
					},
					1791720000000,
					{
						"exists": true,
						"startedAt": "Sun Oct 11 10:07:29 2026"
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"state": "failed",
						"detail": "Failed at 2026-10-11T11:59:00.000Z"
					}
				}
			},
			{
				"subject": "agentLiveness",
				"name": "Reused process ID",
				"call": "agentLiveness({\"registeredAt\":\"2026-10-11T11:00:00.000Z\",\"heartbeatAt\":\"2026-10-11T11:59:30.000Z\",\"ttlSeconds\":900,\"pid\":4242,\"processStartedAt\":\"Sun Oct 11 10:07:29 2026\",\"finished\":null}, 1791720000000, () => ({\"exists\":true,\"startedAt\":\"Sun Oct 11 11:30:00 2026\"}))",
				"input": [
					{
						"registeredAt": "2026-10-11T11:00:00.000Z",
						"heartbeatAt": "2026-10-11T11:59:30.000Z",
						"ttlSeconds": 900,
						"pid": 4242,
						"processStartedAt": "Sun Oct 11 10:07:29 2026",
						"finished": null
					},
					1791720000000,
					{
						"exists": true,
						"startedAt": "Sun Oct 11 11:30:00 2026"
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"state": "gone",
						"detail": "Process 4242 is another process now; the one that registered has ended"
					}
				}
			},
			{
				"subject": "agentLiveness",
				"name": "Missing process",
				"call": "agentLiveness({\"registeredAt\":\"2026-10-11T11:00:00.000Z\",\"heartbeatAt\":\"2026-10-11T11:59:30.000Z\",\"ttlSeconds\":900,\"pid\":4242,\"processStartedAt\":\"Sun Oct 11 10:07:29 2026\",\"finished\":null}, 1791720000000, () => ({\"exists\":false,\"startedAt\":null}))",
				"input": [
					{
						"registeredAt": "2026-10-11T11:00:00.000Z",
						"heartbeatAt": "2026-10-11T11:59:30.000Z",
						"ttlSeconds": 900,
						"pid": 4242,
						"processStartedAt": "Sun Oct 11 10:07:29 2026",
						"finished": null
					},
					1791720000000,
					{
						"exists": false,
						"startedAt": null
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"state": "gone",
						"detail": "Its process 4242 ended without saying it finished"
					}
				}
			},
			{
				"subject": "agentLiveness",
				"name": "Process lookup error",
				"call": "agentLiveness({\"registeredAt\":\"2026-10-11T11:00:00.000Z\",\"heartbeatAt\":\"2026-10-11T11:59:30.000Z\",\"ttlSeconds\":900,\"pid\":4242,\"processStartedAt\":\"Sun Oct 11 10:07:29 2026\",\"finished\":null}, 1791720000000, () => { throw new Error(\"Process lookup unavailable\"); })",
				"input": [
					{
						"registeredAt": "2026-10-11T11:00:00.000Z",
						"heartbeatAt": "2026-10-11T11:59:30.000Z",
						"ttlSeconds": 900,
						"pid": 4242,
						"processStartedAt": "Sun Oct 11 10:07:29 2026",
						"finished": null
					},
					1791720000000,
					{
						"$fixture": "throwing-process",
						"message": "Process lookup unavailable"
					}
				],
				"expected": {
					"kind": "error",
					"value": {
						"name": "Error",
						"message": "Process lookup unavailable"
					}
				}
			}
		],
		"states": ["working", "stale", "completed", "failed", "reused", "missing", "error"],
		"props": ["agent", "now", "processOf"],
		"cases": [
