{
	"schemaVersion": 1,
	"id": "reports.component.source-viewer",
	"kind": "component",
	"title": "SourceViewer",
	"responsibility": "Shows selected source text with its file selector, exact revision and explicit loading or failure states.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-harness-icon",
			"reports.component.select",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-option",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-pre",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/SourceViewer.svelte",
			"packages/reports/src/components/explorer-ui/SourceViewer.svelte"
		],
		"symbols": ["SourceViewer", "SourceViewer"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "SourceViewer.state",
				"type": "SourceState",
				"description": "Current files, selected path, text, loading and error from the shared reader."
			},
			{
				"name": "SourceViewer.commit",
				"type": "string",
				"description": "Revision label for these contents; displayed with its short hash."
			},
			{
				"name": "SourceViewer.empty",
				"type": "string",
				"description": "Optional explanation when no files were recorded."
			},
			{
				"name": "SourceViewer.onSelect",
				"type": "(path: string) => void",
				"description": "Requests the selected recorded file."
			}
		],
		"outputs": [
			{
				"name": "SourceViewer",
				"type": "markup",
				"description": "Escaped, unmodified file text in a scrolling code block. Empty files remain valid; unavailable code never displays previous contents."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.component.harness-harness-icon",
			"via": "import",
