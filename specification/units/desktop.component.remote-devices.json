{
	"schemaVersion": 1,
	"id": "desktop.component.remote-devices",
	"kind": "component",
	"title": "Remote devices",
	"responsibility": "Lists approved phones, granted projects and connection status with a revoke action.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-li",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-atoms-html-ul"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/RemoteDevices.svelte",
			"packages/desktop/src/components/networking-security/RemoteDevices.svelte"
		],
		"symbols": ["RemoteDevices", "RemoteDevices"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RemoteDevices.devices",
				"type": "RemoteDeviceInfo[]",
				"description": "Required approved-device records with identities, names, project grants and connection information. Online means Connected; otherwise shows last-seen time or Not connected."
			},
			{
				"name": "RemoteDevices.projects",
				"type": "{ id: string; name: string }[]",
				"description": "Required identifier/name lookup for grants; absent projects say Project no longer listed."
			},
			{
				"name": "RemoteDevices.store",
				"type": "RemoteHost",
				"description": "Host store supplying busy state and revoke. A click passes the device identifier; busy disables the button."
			}
		],
		"outputs": [
			{
				"name": "RemoteDevices",
				"type": "markup",
				"description": "Approved-phone list with project badges, permission summaries, connectivity and Revoke actions, or No phone is approved for an empty list. Revocation effects and errors are handled outside this list."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.function.remote-labels",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.time-label",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.environment-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.remote-host",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-button",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-li",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-span",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-strong",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-ul",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/networking-security/RemoteDevices.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/networking-security/RemoteDevices.svelte"
			}
		]
	},
	"scenarios": ["remote-mobile-ui"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
