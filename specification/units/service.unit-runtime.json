				"entry": "src/services/execution-runtimes/UnitRuntimeService.ts"
			}
		]
	},
	"scenarios": ["invocation-boundary"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": [
			{
				"workload": "graph-1k",
				"metric": "latency-floor-ms",
				"target": "module",
				"tolerance": 0.05
			},
			{
				"workload": "graph-1k",
				"metric": "latency-floor-ms",
				"target": "wasm",
				"tolerance": 0.05
			},
			{
				"workload": "graph-1k",
