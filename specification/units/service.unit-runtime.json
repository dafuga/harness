{
	"schemaVersion": 1,
	"id": "service.unit-runtime",
	"kind": "service",
	"title": "UnitRuntimeService",
	"responsibility": "Turns declared execution targets into working runtimes and selects the measured kernel default.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/services/UnitRuntimeService.ts",
			"src/services/execution-runtimes/UnitRuntimeService.ts"
		],
		"symbols": [
			"UnitRuntimeService",
			"RuntimeServiceOptions",
			"UnitRuntimeService",
			"UnitRuntimeService.constructor",
			"UnitRuntimeService.forTarget",
			"UnitRuntimeService.forUnit",
			"UnitRuntimeService.kernelDefault",
			"UnitRuntimeService.kernel"
		]
	},
	"contract": {
		"origin": "derived",
		"inputs": [
			{
				"name": "UnitRuntimeService.constructor.root",
				"type": "unknown"
			},
			{
				"name": "UnitRuntimeService.constructor.options",
				"type": "RuntimeServiceOptions"
			},
			{
				"name": "UnitRuntimeService.forTarget.target",
				"type": "ExecutionTarget"
			},
			{
				"name": "UnitRuntimeService.forUnit.manifest",
				"type": "ComponentManifest"
			},
			{
				"name": "UnitRuntimeService.forUnit.kind",
				"type": "RuntimeKind"
			},
			{
				"name": "UnitRuntimeService.kernel.kind",
				"type": "RuntimeKind | 'default'"
			}
		],
		"outputs": [
			{
				"name": "UnitRuntimeService.forTarget",
				"type": "UnitRuntime"
			},
			{
				"name": "UnitRuntimeService.forUnit",
				"type": "UnitRuntime"
			},
			{
				"name": "UnitRuntimeService.kernelDefault",
				"type": "RuntimeChoice"
			},
			{
				"name": "UnitRuntimeService.kernel",
				"type": "UnitRuntime"
			}
		],
		"errors": [
			{
				"name": "ExpectedCliError",
				"type": "thrown"
			}
		]
	},
	"dependencies": [
		{
			"unit": "adapter.http-runtime",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "adapter.module-runtime",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "adapter.process-runtime",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "adapter.wasm-runtime",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.benchmark-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.choose-runtime",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.errors",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.impact-kernel",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.kernel-artifacts",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.machine-profile",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.runtime-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.unit-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "repository.measurement",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/services/execution-runtimes/UnitRuntimeService.ts",
		"targets": [
			{
