	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "AnalyticsTasks.jev",
				"type": "Jev",
				"description": "Required Jev summary containing response and clean-code task arrays. Each row supplies task, loop/step, author model, assessed attempts, first-pass flag, attempts-to-pass and optional report identifier."
			}
		],
		"outputs": [
			{
				"name": "AnalyticsTasks",
				"type": "markup",
				"description": "Two task tables with missing text as a dash and links for supplied report IDs. First pass shows Yes when flagged, otherwise No for assessed attempts or Not assessed for none. Null attempts-to-pass is Not yet passed. Describes excluded cached/dry/incomplete runs; relies on supplied assessed counts."
			}
		],
