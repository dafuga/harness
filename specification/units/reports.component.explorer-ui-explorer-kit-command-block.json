	"kind": "component",
	"title": "Command block",
	"responsibility": "Shows a labelled CLI command for the reader to copy and run.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
		"uses": [
			"reports.component.shared-primitives-atoms-html-code",
