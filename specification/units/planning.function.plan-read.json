				"type": "string",
				"required": true,
				"description": "The unit ID of the plan to read: a lowercase identity of at least two dot-separated segments, such as page.home, at most 200 characters; anything else is rejected before any Git read. planRead reads the one plan.json at rev whose unitId matches, and rejects with not-found when none exists or with artifact-tampered when two do.",
				"examples": ["reports.component.evidence-grid", "page.home"]
			}
