				"name": "transaction.operation",
				"type": "(records: CollaborationRecords) => Promise<T>",
				"required": true,
				"description": "Async callback that receives the parsed records and may mutate them; its resolved value becomes value. It runs again on a fresh snapshot after each failed compare-and-swap, for at most five attempts in total."
			},
