{
	"schemaVersion": 1,
	"id": "remote.service.host-pairing",
	"kind": "service",
	"title": "HostPairingService",
	"responsibility": "Owns host pairing offers, validates sealed device requests and issues single-use approvals across expiry, denial and close states.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/services/networking-security/remote-host-service/host-pairing-service/HostPairingService.ts",
			"packages/desktop/src/services/networking-security/remote-host-service/host-pairing-service/HostPairingService.types.ts",
			"packages/desktop/src/services/remote-host-service/host-pairing-service/HostPairingService.ts",
			"packages/remote/src/services/host-pairing-service/HostPairingService.ts"
		],
		"symbols": [
			"HostPairingService",
			"HostPairingService.constructor",
			"HostPairingService.open",
			"HostPairingService.offer",
			"HostPairingService.requests",
			"HostPairingService.receive",
			"HostPairingService.approve",
			"HostPairingService.deny",
			"HostPairingService.close",
			"HostPairingOptions",
			"HostPairingOffer",
			"HostPairingFrame",
			"HostPairingApproved",
			"HostPairingOptions",
			"HostPairingOffer",
			"HostPairingFrame",
			"HostPairingApproved",
			"Requested",
			"Offer",
			"HostPairingService",
			"HostPairingService",
			"HostPairingOptions",
			"HostPairingOffer",
			"HostPairingFrame",
			"HostPairingApproved"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "HostPairingService.constructor.options",
				"type": "HostPairingOptions",
				"description": "Host identity and key pair, with an optional clock, offer lifetime and failed-attempt limit."
			},
			{
				"name": "HostPairingService.receive.frame",
				"type": "HostPairingFrame",
				"description": "Pairing identity, ephemeral public key, authenticated sealed device request and PKCE challenge."
			},
			{
				"name": "HostPairingService.approve.pairingId",
				"type": "string",
				"description": "Identity of the live offer whose pending device request is being approved."
			},
			{
				"name": "HostPairingService.approve.approval",
				"type": "{ hostName: string; generation: number; grant: RemoteGrant; deviceId?: string }",
				"description": "Host display name, credential generation and granted project/agent access, optionally pinned to the shown device."
			},
			{
				"name": "HostPairingService.deny.pairingId",
				"type": "string",
				"description": "Identity of the pending request to deny; other or spent offers remain unchanged."
			}
		],
		"outputs": [
			{
				"name": "HostPairingService.open",
				"type": "HostPairingOffer",
				"description": "Fresh public offer with a typed code and expiry; replaces any prior offer or request."
			},
			{
				"name": "HostPairingService.offer",
				"type": "HostPairingOffer | null",
				"description": "Current unexpired offer, or null after expiry, exhaustion, approval, denial or close."
			},
			{
				"name": "HostPairingService.requests",
				"type": "RemotePairingRequest[]",
				"description": "A fresh public projection of the pending device request, or an empty array."
			},
			{
				"name": "HostPairingService.receive",
				"type": "Promise<RemotePairingRequest | null>",
				"description": "Exact authenticated device request, or null for rejected, repeated, expired or spent requests."
			},
			{
				"name": "HostPairingService.approve",
				"type": "Promise<HostPairingApproved>",
				"description": "Device identity and key with the approval encrypted to that request’s approval key; consumes the offer once."
			},
			{
				"name": "HostPairingService.deny",
				"type": "boolean",
				"description": "True when a pending request was removed, otherwise false."
			},
			{
				"name": "HostPairingService.close",
				"type": "void",
				"description": "No return value; clears any active offer and pending request."
			}
		],
		"errors": [
			{
				"name": "Error",
				"type": "thrown",
				"description": "Refuses approval without a pending request or for a device different from the shown phone."
			},
			{
				"name": "TypeError",
				"type": "thrown",
				"description": "Null request frames or approval objects cannot supply the required properties."
			}
		]
	},
	"dependencies": [
		{
			"unit": "remote.function.pairing-envelope",
			"via": "import",
			"origin": "derived"
		},
