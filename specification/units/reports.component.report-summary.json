			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.status-badge"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/report-summary/ReportSummary.svelte",
			"packages/reports/src/components/reports-media/report-summary/ReportSummary.svelte"
		],
		"symbols": ["ReportSummary", "ReportSummary"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ReportSummary.report",
				"type": "Report",
				"description": "Required report supplying status, summary, findings, coverage, checks, revision, timestamps and export availability. The gap count includes failed, blocked or not-proven findings and coverage plus a missing revision; it does not count failed checks."
			},
			{
				"name": "ReportSummary.downloadBase",
				"type": "string",
				"description": "Required address prefix used to build available PDF, ZIP and HTML download links."
			},
			{
				"name": "ReportSummary.portable",
				"type": "boolean",
				"description": "Optional portable-view flag, defaulting to false. Hides ZIP and HTML downloads while retaining an available PDF link."
			}
		],
		"outputs": [
			{
				"name": "ReportSummary",
				"type": "markup",
				"description": "Outcome and summary, passed-check and evidence-gap counts, lifecycle and historical/stale notices, and expandable run metadata. Missing revisions remain not proven. Exports are shown only when available, otherwise as pending; finalizing receives its own notice."
			}
		],
		"errors": []
	},
