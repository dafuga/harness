{
	"schemaVersion": 1,
	"id": "reports.component.report-summary",
	"kind": "component",
	"title": "Report overview and downloads",
	"responsibility": "Summarizes the report’s recorded outcome, evidence gaps, lifecycle and available exports.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h1",
