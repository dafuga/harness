{
	"schemaVersion": 1,
	"id": "desktop.component.history-panel",
	"kind": "component",
	"title": "History panel",
	"responsibility": "Displays entity history and retrieves earlier pages without mixing different project or revision views.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.workspace-link",
			"reports.component.regression-proof",
			"reports.component.shared-primitives-atoms-html-article",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/git-source-history/history-panel/HistoryPanel.svelte",
			"packages/desktop/src/components/history-panel/HistoryPanel.svelte"
		],
		"symbols": ["HistoryPanel", "HistoryPanel"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "HistoryPanel.entity",
				"type": "EntityDetail",
				"description": "Initial history and optional coverage metadata. Without metadata, history is treated as complete. Changes of view or coverage reset additionally loaded pages."
			},
			{
				"name": "HistoryPanel.workspace",
				"type": "Workspace",
				"description": "Workspace supplying project/revision identity, known commits, navigation and an optional history bridge. Only event commits present in the snapshot’s commit list become links."
			}
		],
		"outputs": [
			{
				"name": "HistoryPanel",
				"type": "markup",
				"description": "Timeline with names, formatted dates, details and commit references, or an empty-history message. Load more requires incomplete history, a next page and bridge support and is disabled during loading. Discards responses for another view; displays current-view errors as alerts. Incomplete history without a usable next-page operation is explicitly labeled not loaded."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.workspace-link",
			"via": "import",
			"origin": "derived"
		},
