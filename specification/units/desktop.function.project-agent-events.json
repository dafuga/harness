{
	"schemaVersion": 1,
	"id": "desktop.function.project-agent-events",
	"kind": "function",
	"title": "Follow project replies",
	"responsibility": "Keeps public replies, changed-unit references, failures and saved plans in the project conversation.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["packages/desktop/src/utils/projectAgentEvents.ts"],
		"symbols": ["projectAgentEvents"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "projectAgentEvents.agent",
				"type": "ProjectAgent",
				"description": "The project conversation that owns the active run and its visible messages.",
				"examples": [
					{
						"workspace": {
							"projectId": "local-demo"
						},
						"runId": "run-1",
						"messages": [],
						"said": ""
					}
				]
			},
			{
				"name": "projectAgentEvents.value",
				"type": "RunEvent",
				"description": "Public progress, answer text, changes or terminal result from a specific run.",
				"examples": [
					{
						"runId": "run-1",
						"kind": "text",
						"text": "See [[unit:app.component.toolbar]]"
					}
				]
			}
		],
		"outputs": [
			{
				"name": "projectAgentEvents",
				"type": "Promise<void>",
				"description": "Updates only the matching conversation, keeps terminal text and refreshes its project. Resolves without a return value.",
				"examples": [null]
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.function.created-thread",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-bridge-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.project-agent",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/utils/projectAgentEvents.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/utils/projectAgentEvents.ts"
			}
		]
	},
	"scenarios": ["agent-references"],
	"budgets": {
