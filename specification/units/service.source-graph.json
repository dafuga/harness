{
	"schemaVersion": 1,
	"id": "service.source-graph",
	"kind": "service",
	"title": "SourceGraphService",
	"responsibility": "Owns the SourceGraphService service workflow.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/services/SourceGraphService.ts",
			"src/services/development-tooling/SourceGraphService.ts"
		],
		"symbols": [
			"fileNode",
			"unitNode",
			"scenarioNode",
			"SourceGraphService",
			"fileNode",
			"unitNode",
			"scenarioNode",
			"SourceGraphService",
			"SourceGraphService.build"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "fileNode.path",
				"type": "string"
			},
			{
				"name": "unitNode.id",
				"type": "string"
			},
			{
				"name": "scenarioNode.id",
				"type": "string"
			},
			{
				"name": "SourceGraphService.build.index",
				"type": "SourceIndex"
			},
			{
				"name": "SourceGraphService.build.manifests",
				"type": "ComponentManifest[]"
			},
			{
				"name": "SourceGraphService.build.scenarios",
				"type": "ScenarioManifest[]"
			}
		],
		"outputs": [
			{
				"name": "fileNode",
				"type": "string"
			},
			{
				"name": "unitNode",
				"type": "string"
			},
			{
				"name": "scenarioNode",
				"type": "string"
			},
			{
				"name": "SourceGraphService.build",
				"type": "SourceGraph",
				"description": "Builds file:<path>, unit:<id> and scenario:<id> nodes. Edges point from consumer to dependency: file imports, unit owns file, declared cross-runtime dependencies, scenario covers unit or proves test. File node kind copies index classification and unit is set only for an exact active owner; duplicate owners choose the last. Each uncertain reference preserves origin node/reason/detail, but drops via, typeOnly and target candidates. No missing-target validation is performed."
			}
		],
		"errors": [
			{
				"name": "Incomplete ownership or unresolved target",
				"type": "represented in graph/uncertain, not thrown",
				"description": "Missing owner or candidate target cannot be inferred absent; consumers must not treat empty or unrelated-looking fields as proof of completeness."
			}
		]
	},
	"dependencies": [
		{
			"unit": "function.source-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.unit-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "service.source-index",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/services/development-tooling/SourceGraphService.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/services/development-tooling/SourceGraphService.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
