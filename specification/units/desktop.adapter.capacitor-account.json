			"principal"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "plugin",
				"type": "AccountNativePlugin",
				"description": "Native status, approval, sign-out and project-request operations. The native side supplies the fixed trusted Hub address."
			}
		],
		"outputs": [
			{
				"name": "bridge",
				"type": "DesktopBridge",
				"description": "Owned and accepted-invitation projects, with native account status and authorized project operations. Session refusal clears protected views immediately."
			}
		],
		"errors": [
			{
				"name": "unavailable",
				"type": "Error & { status: number; code: string }",
				"description": "Network, permission and decoding failures retain their public error status. No request falls back to the Mac."
			}
		]
