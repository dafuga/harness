{
	"schemaVersion": 1,
	"id": "desktop.adapter.capacitor-account",
	"kind": "adapter",
	"title": "Account projects on a phone",
	"responsibility": "Connects the native phone account to the shared project interface without exposing its credential.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/lib/select-environment/capacitor-account-adapter/CapacitorAccountAdapter.ts",
			"packages/desktop/src/lib/select-environment/capacitor-account-adapter/capacitorAccountCodec.ts"
