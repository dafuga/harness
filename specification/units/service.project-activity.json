			"src/services/projects-sessions/project-activity-service/ProjectActivityService.types.ts"
		],
		"symbols": [
			"ProjectActivityService",
			"ProjectActivityService",
			"ProjectActivityService.constructor",
			"ProjectActivityService.show",
			"ProjectActivityService.recorded",
			"Owners",
			"Reason",
			"RecordedDetail"
		]
	},
	"contract": {
		"origin": "derived",
		"inputs": [
			{
				"name": "ProjectActivityService.constructor.root",
				"type": "string"
			},
			{
				"name": "ProjectActivityService.show.limit",
				"type": "number"
			},
			{
