{
	"schemaVersion": 1,
	"id": "service.project-activity",
	"kind": "service",
	"title": "ProjectActivityService",
	"responsibility": "Shows the activity of the repository a checkout belongs to: recorded work from Git and, live, its checkouts and agents.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
