{
	"schemaVersion": 1,
	"id": "reports.component.harness-harness-console",
	"kind": "component",
	"title": "Explorer console",
	"responsibility": "Loads recorded repository revisions and supplies the selected explorer screen with navigation, entities and evidence.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-loading-state",
			"reports.layout.explorer-layout"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/HarnessConsole.svelte",
			"packages/reports/src/components/explorer-ui/harness-console/consoleView.ts",
			"packages/reports/src/components/explorer-ui/harness-console/consoleView.types.ts"
		],
		"symbols": [
			"HarnessConsole",
			"consoleContentKey",
			"consoleRelations",
			"consoleView",
			"ConsoleAnswer",
			"ConsoleAnswer",
			"ViewInput"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "HarnessConsole.base",
				"type": "string",
				"description": "Required URL prefix used for the data client, media and export addresses."
			},
			{
				"name": "HarnessConsole.path",
				"type": "string",
				"description": "Required address within the base, including any query string. Determines the selected branch, revision and screen."
			},
			{
				"name": "HarnessConsole.navigate",
				"type": "(path: string, replace: boolean) => void",
				"description": "Required host callback receiving the next relative address and whether to replace browser history. Corrections replace history; user navigation normally adds an entry."
			},
			{
				"name": "HarnessConsole.links",
				"type": "Array<{ label: string; href: string }>",
				"description": "Compatibility input accepted by the prop type but not read or rendered by this component."
			},
			{
				"name": "HarnessConsole.exportable",
				"type": "boolean",
				"description": "Optional export availability flag, defaulting to true. False supplies the screen with an empty export address."
			},
			{
				"name": "HarnessConsole.content",
				"type": "ExplorerScreen",
				"description": "Required screen component rendered once its selected revision and parent context are ready."
			}
		],
		"outputs": [
			{
				"name": "HarnessConsole",
				"type": "markup",
				"description": "Explorer header and selected screen, with loading, unavailable-address and missing-registry notices. Index and selected-revision failures become visible problem text; unavailable parent data becomes null."
			}
		],
		"errors": []
	},
