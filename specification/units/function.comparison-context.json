{
	"schemaVersion": 1,
	"id": "function.comparison-context",
	"kind": "function",
	"title": "Benchmark comparison context",
	"responsibility": "Identifies a benchmark’s full request and records the invocation boundary and sampling protocol needed for valid comparisons.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/utils/comparison-context/comparisonContext.ts",
			"src/utils/comparisonContext.ts",
			"src/utils/development-tooling/comparison-context/comparisonContext.ts"
		],
		"symbols": [
			"requestDigest",
			"comparisonContext",
			"requestDigest",
			"comparisonContext",
			"requestDigest",
			"comparisonContext"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "requestDigest.request",
				"type": "unknown",
				"description": "Complete JSON-shaped request, including operation and input, to fingerprint with canonical serialization."
			},
			{
				"name": "comparisonContext.request",
				"type": "unknown",
				"description": "Complete JSON-shaped request actually sent by the benchmark."
			},
			{
				"name": "comparisonContext.sampling",
				"type": "{ rounds: number; iterations: number }",
				"description": "Round count and calls per round used by the benchmark; this helper copies rather than validates them."
			}
		],
		"outputs": [
			{
				"name": "requestDigest",
				"type": "string",
				"description": "Lowercase SHA-256 digest of canonical request JSON, independent of object-key order."
			},
			{
				"name": "comparisonContext",
				"type": "Comparison",
				"description": "Context containing the request digest, public-invocation boundary, harness-rounds/1 protocol and sampling with three warm-up calls."
			}
		],
		"errors": [
			{
				"name": "Error",
				"type": "thrown",
				"description": "An error raised while reading the request or sampling is propagated unchanged."
			},
			{
				"name": "TypeError",
				"type": "thrown",
				"description": "A request without JSON text or a null sampling value throws TypeError."
			}
		]
	},
	"dependencies": [
		{
			"unit": "function.canonical-json",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.comparison-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/utils/comparisonContext.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/utils/comparisonContext.ts"
			}
		]
	},
	"scenarios": [],
	"testing": {
		"version": 1,
		"shape": "helper",
		"examples": [
			{
				"subject": "requestDigest",
				"name": "Fingerprint the complete request",
				"call": "requestDigest({\"operation\":\"rank\",\"input\":{\"size\":20000,\"seed\":7}})",
				"input": [
					{
						"operation": "rank",
						"input": {
							"size": 20000,
							"seed": 7
						}
					}
				],
				"expected": {
					"kind": "value",
					"value": "c1fe9c28f809bfb762c68fcf39bcedcd36128025bfdf9ea8ef925b9054167181"
				}
			},
			{
				"subject": "requestDigest",
				"name": "Ignore object key order",
				"call": "requestDigest({\"input\":{\"seed\":7,\"size\":20000},\"operation\":\"rank\"})",
				"input": [
					{
						"input": {
							"seed": 7,
							"size": 20000
						},
						"operation": "rank"
					}
				],
				"expected": {
					"kind": "value",
					"value": "c1fe9c28f809bfb762c68fcf39bcedcd36128025bfdf9ea8ef925b9054167181"
				}
			},
			{
				"subject": "requestDigest",
				"name": "Include a changed input value",
				"call": "requestDigest({\"operation\":\"rank\",\"input\":{\"size\":20000,\"seed\":8}})",
				"input": [
					{
						"operation": "rank",
						"input": {
							"size": 20000,
							"seed": 8
						}
					}
				],
				"expected": {
					"kind": "value",
					"value": "5d58526be7e3db341f6a55dba37717359dd78482c0464bc4850788a59d2dee7a"
				}
			},
			{
				"subject": "requestDigest",
				"name": "Include a missing input field",
				"call": "requestDigest({\"operation\":\"rank\"})",
				"input": [
					{
						"operation": "rank"
					}
				],
				"expected": {
					"kind": "value",
					"value": "5d7a12e7a33893751760c740c01eb411d2db3f9e5a4334789232a934e3e003ff"
				}
			},
			{
				"subject": "requestDigest",
				"name": "Fingerprint a null request",
				"call": "requestDigest(null)",
				"input": [null],
				"expected": {
					"kind": "value",
					"value": "74234e98afe7498fb5daf1f36ac2d78acc339464f950703b8c019892f982b90b"
				}
			},
			{
				"subject": "requestDigest",
				"name": "Propagate a request getter error",
				"call": "requestDigest({ get input() { throw new Error(\"request unavailable\"); } })",
				"input": [
					{
						"$fixture": "throwing-request",
						"message": "request unavailable"
					}
				],
				"expected": {
					"kind": "error",
					"value": {
						"name": "Error",
						"message": "request unavailable"
					}
				}
			},
			{
				"subject": "comparisonContext",
				"name": "Describe a complete benchmark request",
				"call": "comparisonContext({\"operation\":\"rank\",\"input\":{\"size\":20000,\"seed\":7}}, {\"rounds\":5,\"iterations\":30})",
				"input": [
					{
						"operation": "rank",
						"input": {
							"size": 20000,
							"seed": 7
						}
					},
					{
						"rounds": 5,
						"iterations": 30
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"request": "c1fe9c28f809bfb762c68fcf39bcedcd36128025bfdf9ea8ef925b9054167181",
						"boundary": "public-invocation",
						"protocol": "harness-rounds/1",
						"sampling": {
							"warmup": 3,
							"rounds": 5,
							"iterations": 30
						}
					}
				}
			},
			{
				"subject": "comparisonContext",
				"name": "Copy sampling values without validation",
				"call": "comparisonContext({\"operation\":\"rank\",\"input\":{\"size\":20000,\"seed\":7}}, {\"rounds\":0,\"iterations\":30})",
				"input": [
					{
						"operation": "rank",
						"input": {
							"size": 20000,
							"seed": 7
						}
					},
					{
						"rounds": 0,
						"iterations": 30
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"request": "c1fe9c28f809bfb762c68fcf39bcedcd36128025bfdf9ea8ef925b9054167181",
						"boundary": "public-invocation",
						"protocol": "harness-rounds/1",
						"sampling": {
							"warmup": 3,
							"rounds": 0,
							"iterations": 30
						}
					}
				}
			},
			{
				"subject": "comparisonContext",
				"name": "Propagate a sampling getter error",
				"call": "comparisonContext({\"operation\":\"rank\",\"input\":{\"size\":20000,\"seed\":7}}, { get rounds() { throw new Error(\"sampling unavailable\"); }, iterations: 30 })",
				"input": [
					{
						"operation": "rank",
						"input": {
							"size": 20000,
							"seed": 7
						}
					},
					{
						"$fixture": "throwing-sampling",
						"message": "sampling unavailable",
						"iterations": 30
					}
				],
				"expected": {
					"kind": "error",
					"value": {
						"name": "Error",
						"message": "sampling unavailable"
					}
				}
			}
		],
		"states": ["digest", "digest-error", "context", "invalid-sampling", "sampling-error"],
		"props": ["request", "sampling"],
		"cases": [
