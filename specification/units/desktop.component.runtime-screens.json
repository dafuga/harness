	"id": "desktop.component.runtime-screens",
	"kind": "component",
	"title": "Runtime screens",
	"responsibility": "Lets a person inspect recorded captures by scenario, state and viewport with comparison and provenance explained.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.runtime-pane",
			"desktop.component.segmented-choice",
			"desktop.component.status-icon",
			"reports.component.select",
			"reports.component.shared-primitives-atoms-html-div",
