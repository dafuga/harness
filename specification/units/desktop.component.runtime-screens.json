			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-ul"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/RuntimeScreens.svelte",
			"packages/desktop/src/components/execution-runtimes/RuntimeScreens.svelte"
		],
		"symbols": ["RuntimeScreens", "RuntimeScreens"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RuntimeScreens.result",
				"type": "EntityEvidenceResult",
				"description": "Required comparison mode, scope, captures and incomparability reasons. Shared explorer helpers determine selected captures and provenance."
			},
			{
				"name": "RuntimeScreens.options",
				"type": "ScreenOption[]",
				"description": "Required scenarios with states and viewports. Selection is reconciled through the picker helper; viewport size is displayed."
			},
			{
				"name": "RuntimeScreens.evidence",
				"type": "EntityEvidence",
				"description": "Evidence state forwarded to panes for reading recorded bytes."
			}
		],
		"outputs": [
			{
				"name": "RuntimeScreens",
				"type": "markup",
				"description": "Current or before/after screenshots with controls when a valid option exists. Scenario picker is disabled with fewer than two options. Lists incomparability reasons. Current views distinguish fresh, inherited with origin commit, and absent capture. Child panes handle image loading and errors."
			}
		],
		"errors": []
	},
