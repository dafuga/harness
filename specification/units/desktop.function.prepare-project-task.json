{
	"schemaVersion": 1,
	"id": "desktop.function.prepare-project-task",
	"kind": "function",
	"title": "Check a project request",
	"responsibility": "Checks the selected project, branch, commit and chosen model before a conversation starts work.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/services/agents-providers/desktop-run-service/prepareProjectTask.ts",
			"packages/desktop/src/services/desktop-run-service/prepareProjectTask.ts",
			"packages/desktop/src/utils/agents-providers/prepareProjectTask.ts",
			"packages/desktop/src/utils/prepareProjectTask.ts"
		],
		"symbols": [
			"prepareProjectTask",
			"prepareProjectTask",
			"ProjectTaskContext",
			"prepareProjectTask",
			"prepareProjectTask"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "prepareProjectTask.preparation",
				"type": "Preparation",
				"description": "The selected project session and its verified model inventory.",
				"examples": [
					{
						"session": "Selected project session",
						"providers": "Available model providers"
					}
				]
			},
			{
				"name": "prepareProjectTask.request",
				"type": "ProjectTaskRequest",
				"description": "The question or code request, including its exact project, branch, commit and chosen model.",
				"examples": [
					{
						"intent": "task",
						"category": "components",
						"mode": "ask",
						"projectId": "local-demo",
						"branch": "main",
						"commit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
						"provider": "claude",
						"model": "claude-opus-5-5",
						"effort": "high",
						"text": "Explain the toolbar"
					}
				]
			},
			{
				"name": "prepareProjectTask.controller",
				"type": "AbortController",
				"description": "Cancellation controller for this one request. A cancelled request never starts the model.",
				"examples": ["new AbortController()"]
			}
		],
		"outputs": [
			{
				"name": "prepareProjectTask",
				"type": "Promise<ProjectTaskContext>",
				"description": "A checked execution context with the chosen runner, project root, revision and cancellation signal.",
				"examples": [
					{
						"id": "run-1",
						"root": "/projects/atlas",
						"revision": {
							"branch": "main",
							"commit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
						},
						"request": {
							"intent": "task",
							"category": "components",
							"mode": "ask",
							"projectId": "local-demo",
							"branch": "main",
							"commit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
							"provider": "claude",
							"model": "claude-opus-5-5",
							"effort": "high",
							"text": "Explain the toolbar"
						}
					}
				]
			}
		],
		"errors": [
			{
				"name": "Error",
				"type": "thrown",
				"description": "Refuses another project, a historical or changed revision, or a model that is unavailable.",
				"examples": ["The project revision changed. Refresh before asking the agent."]
			},
			{
				"name": "RunCancelled",
				"type": "thrown",
				"description": "Stops preparation when the request was cancelled before the model could start.",
				"examples": ["Request cancelled"]
			}
		]
	},
	"dependencies": [
		{
			"unit": "desktop.function.prepare-project-run",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.prepare-run",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.agent-runner-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-bridge-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/utils/agents-providers/prepareProjectTask.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/utils/agents-providers/prepareProjectTask.ts"
			}
		]
	},
	"scenarios": ["agent-references"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
