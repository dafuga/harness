{
	"schemaVersion": 1,
	"id": "desktop.function.remote-host-status",
	"uid": "u_mit2du7odn",
	"kind": "function",
	"title": "Public phone-access status",
	"responsibility": "Build displayable computer status from persisted state and live relay and pairing activity.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/services/networking-security/remote-host-service/remoteHostStatus.ts",
			"packages/desktop/src/utils/networking-security/remoteHostStatus.ts"
		],
		"symbols": ["remoteHostStatus", "RemoteHostPhase", "RemoteHostStatusInput", "remoteHostStatus"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "remoteHostStatus.input",
				"type": "RemoteHostStatusInput",
				"required": true,
				"description": "The facts the status is built from: whether OS encryption allows remote access (`supported`); the persisted host state (`state`, null when nothing is stored yet; its host, origin, devices and pairing are used only when `supported` and `enabled` are both true); the live `runtime` (a RemoteHostRuntimeService, or null, in which case no pairing request is listed and no device is online); the switch `phase` and `reason`; the display `name`; and the `projects` (only each project's id and name are read). Unless `supported` is false, a phase other than 'idle' is reported as the state itself, and a non-null `reason` replaces the default message of that state.",
				"examples": [
					{
						"supported": true,
						"state": null,
						"runtime": null,
						"phase": "idle",
						"reason": null,
						"name": "Office Mac",
						"projects": []
					},
					{
						"supported": true,
						"state": null,
						"runtime": null,
						"phase": "signed-out",
						"reason": null,
						"name": "Office Mac",
						"projects": [
							{
								"id": "local-9d2c4e7a1b8f03d5e6a4c9f1027b5d384f0a9c2e7d1b6835a2e8d4c0f7b93e16",
								"name": "orders-app"
							}
						]
					},
					{
						"supported": true,
						"state": null,
						"runtime": null,
						"phase": "idle",
						"reason": "Remote access could not be registered. Try again.",
						"name": "Office Mac",
						"projects": []
					}
				]
			}
		],
		"outputs": [
			{
				"name": "remoteHostStatus",
				"type": "RemoteHostStatus",
				"description": "The status shown to the renderer: `supported`, `enabled`, `state`, `reason`, `host` as {id, name}, `origin`, the open `pairing` offer or null, the pending `requests`, the device summaries in `devices`, and `projects` as {id, name}. It carries no key or credential: devices omit their device key, the offer holds only its pairing id, code, expiry, host, origin and scan text, and project roots are never copied.",
				"examples": [
					{
						"supported": true,
						"enabled": false,
						"state": "disabled",
