						"fixture": "flow",
						"capture": {}
					}
				],
				"expected": {
					"kind": "void"
				}
			},
			{
				"subject": "scenarioCoverage",
				"name": "accepts an element screenshot",
				"call": "scenarioCoverage(coverageFixture({\"fixture\":\"image\",\"capture\":{},\"mode\":\"element\"})).failures",
				"input": [
					{
						"fixture": "image",
						"capture": {},
