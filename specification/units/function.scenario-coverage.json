				"name": "accepts a stamped flow",
				"call": "scenarioCoverage(coverageFixture({\"fixture\":\"flow\",\"capture\":{\"provenance\":\"actual-capture\",\"server\":{\"buildId\":\"build-1\",\"revision\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}})).failures",
				"input": [
					{
						"fixture": "flow",
						"capture": {
							"provenance": "actual-capture",
							"server": {
								"buildId": "build-1",
								"revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
							}
						}
					}
				],
				"expected": {
					"kind": "value",
					"value": []
				}
