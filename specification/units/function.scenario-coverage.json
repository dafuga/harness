	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "scenarioCoverage.input",
				"type": "CoverageInput",
				"description": "Scenario contract, exact verified commit, gathered captures, whether the producing check failed, and optionally declared/compiled build identities."
			}
		],
		"outputs": [
			{
				"name": "scenarioCoverage",
				"type": "CoverageResult",
				"description": "Scenario states with capture statuses plus prefixed failures for missing or invalid evidence. A capture must match its declared evidence kind; screenshots require valid dimensions and revision/build provenance, audio requires duration/transcript and stated provenance, and benchmarks must match their schema."
			}
		],
		"errors": []
	},
