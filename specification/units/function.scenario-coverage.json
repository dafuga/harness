					]
				}
			},
			{
				"subject": "scenarioCoverage",
				"name": "accepts a viewport screenshot",
				"call": "scenarioCoverage(coverageFixture({\"fixture\":\"image\",\"capture\":{},\"mode\":\"viewport\",\"width\":920,\"height\":700})).failures",
