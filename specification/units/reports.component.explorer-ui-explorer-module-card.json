{
	"schemaVersion": 1,
	"id": "reports.component.explorer-ui-explorer-module-card",
	"kind": "component",
	"title": "ExplorerModuleCard",
	"responsibility": "Renders catalog and relationship cards with optional revision-scoped images and up to three flat Used In links.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.explorer-usage",
			"reports.component.harness-entity-link",
			"reports.component.harness-harness-icon",
			"reports.component.shared-primitives-atoms-html-article",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-figure",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-img",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/ExplorerModuleCard.svelte"],
		"symbols": ["ExplorerModuleCard"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ExplorerModuleCard.row",
				"type": "CatalogRow | SupportRow",
				"description": "Selected module or support dependency with its actual identity and revision-scoped consumers."
			},
			{
				"name": "ExplorerModuleCard.nav",
				"type": "EntityNav",
				"description": "Navigation preserving branch, commit, entity and selected helper."
			},
			{
				"name": "ExplorerModuleCard.lens",
				"type": "EntityLens",
				"description": "Revision-scoped evidence and consumer previews."
			},
			{
				"name": "ExplorerModuleCard.mediaBase",
				"type": "string",
				"description": "URL prefix for the selected evidence assets."
			},
			{
				"name": "ExplorerModuleCard.shot",
				"type": "Evidence | null",
				"description": "Optional own visual capture. Nonvisual modules omit the image region; missing visual captures remain explicit."
			},
			{
				"name": "ExplorerModuleCard.category",
				"type": "ExplorerCategory | null",
				"description": "Module category, defaulting to the row category. Visual and nonvisual cards share this renderer."
			}
		],
		"outputs": [
			{
				"name": "ExplorerModuleCard",
				"type": "markup",
				"description": "One name or helper invocation, its own image for visual modules, and at most three distinct Used In links followed by an ellipsis when more exist. Unsupported dependencies have no invented detail link."
			}
		],
		"errors": []
	},
