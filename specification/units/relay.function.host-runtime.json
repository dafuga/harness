	"id": "relay.function.host-runtime",
	"kind": "function",
	"title": "Relay host runtime wiring",
	"responsibility": "Constructs the controllers and services used by one durable host object.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
