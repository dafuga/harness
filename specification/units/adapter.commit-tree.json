{
	"schemaVersion": 1,
	"id": "adapter.commit-tree",
	"kind": "adapter",
	"title": "CommitTreeAdapter",
	"responsibility": "Reads the files of one exact commit from the Git object database.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/adapters/CommitTreeAdapter.ts",
			"src/adapters/git-source-history/CommitTreeAdapter.ts",
			"src/adapters/git-source-history/commit-tree-adapter/blobTexts.ts"
		],
		"symbols": [
			"CommitTreeAdapter",
			"CommitTreeAdapter",
			"CommitTreeAdapter.open",
			"CommitTreeAdapter.list",
			"CommitTreeAdapter.read",
			"cachedBlobText",
			"keepBlobText"
		]
	},
	"contract": {
		"origin": "derived",
		"inputs": [
			{
				"name": "CommitTreeAdapter.open.root",
				"type": "string"
			},
			{
				"name": "CommitTreeAdapter.open.reference",
				"type": "string"
			},
			{
				"name": "CommitTreeAdapter.read.path",
				"type": "string"
			},
			{
				"name": "cachedBlobText.key",
				"type": "string"
			},
			{
				"name": "keepBlobText.key",
				"type": "string"
			},
			{
				"name": "keepBlobText.text",
				"type": "string"
			}
		],
		"outputs": [
			{
				"name": "CommitTreeAdapter.open",
				"type": "Promise<CommitTreeAdapter>"
			},
			{
				"name": "CommitTreeAdapter.list",
				"type": "Promise<TreeEntry[]>"
			},
			{
				"name": "CommitTreeAdapter.read",
				"type": "Promise<string>"
			},
			{
				"name": "cachedBlobText",
				"type": "string | undefined"
			},
			{
				"name": "keepBlobText",
				"type": "void"
			}
		],
		"errors": [
			{
				"name": "Error",
				"type": "thrown"
			},
			{
				"name": "ExpectedCliError",
				"type": "thrown"
			}
		]
	},
	"dependencies": [
		{
			"unit": "adapter.git",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.errors",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.source-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/adapters/git-source-history/CommitTreeAdapter.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/adapters/git-source-history/CommitTreeAdapter.ts"
			}
		]
	},
	"scenarios": [],
	"testing": {
		"version": 1,
		"shape": "service",
		"states": ["empty", "populated"],
		"cases": [
			{
				"id": "open.empty",
				"state": "empty",
				"subject": "CommitTreeAdapter.open",
				"fixture": "test/adapters/git-source-history/commit-tree.test.ts",
				"test": {
					"file": "test/adapters/git-source-history/commit-tree.test.ts",
					"title": "CommitTreeAdapter.open empty resolves the exact commit and refuses absent revisions"
				},
				"expected": {
					"kind": "value",
					"value": {
						"tree": "empty",
						"method": "open",
						"preservesImmutableSource": true
					}
				},
				"errors": ["ExpectedCliError"]
			},
			{
				"id": "open.populated",
				"state": "populated",
				"subject": "CommitTreeAdapter.open",
				"fixture": "test/adapters/git-source-history/commit-tree.test.ts",
				"test": {
					"file": "test/adapters/git-source-history/commit-tree.test.ts",
					"title": "CommitTreeAdapter.open populated establishes the object format before caching"
				},
				"expected": {
					"kind": "value",
					"value": {
						"tree": "populated",
						"method": "open",
						"preservesImmutableSource": true
					}
				},
				"errors": ["ExpectedCliError"]
			},
			{
				"id": "list.empty",
				"state": "empty",
				"subject": "CommitTreeAdapter.list",
				"fixture": "test/adapters/git-source-history/commit-tree.test.ts",
				"test": {
					"file": "test/adapters/git-source-history/commit-tree.test.ts",
					"title": "CommitTreeAdapter.list empty returns no source entries"
				},
				"expected": {
					"kind": "value",
					"value": {
						"tree": "empty",
						"method": "list",
						"preservesImmutableSource": true
					}
				}
			},
			{
				"id": "list.populated",
				"state": "populated",
				"subject": "CommitTreeAdapter.list",
				"fixture": "test/adapters/git-source-history/commit-tree.test.ts",
				"test": {
					"file": "test/adapters/git-source-history/commit-tree.test.ts",
					"title": "CommitTreeAdapter.list populated retains blob identities and paths"
				},
				"expected": {
					"kind": "value",
					"value": {
						"tree": "populated",
						"method": "list",
						"preservesImmutableSource": true
					}
				}
			},
			{
				"id": "read.empty",
				"state": "empty",
				"subject": "CommitTreeAdapter.read",
				"fixture": "test/adapters/git-source-history/commit-tree.test.ts",
				"test": {
					"file": "test/adapters/git-source-history/commit-tree.test.ts",
					"title": "CommitTreeAdapter.read empty rejects missing paths"
				},
				"expected": {
					"kind": "value",
					"value": {
						"tree": "empty",
						"method": "read",
						"preservesImmutableSource": true
					}
				},
				"errors": ["Error"]
			},
			{
				"id": "read.populated",
				"state": "populated",
				"subject": "CommitTreeAdapter.read",
				"fixture": "test/adapters/git-source-history/commit-tree.test.ts",
				"test": {
					"file": "test/adapters/git-source-history/commit-tree.test.ts",
					"title": "CommitTreeAdapter.read populated reuses immutable blobs across revisions without stale paths"
				},
				"expected": {
					"kind": "value",
					"value": {
						"tree": "populated",
						"method": "read",
						"preservesImmutableSource": true
					}
				},
				"errors": ["Error"]
			}
		]
	},
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
