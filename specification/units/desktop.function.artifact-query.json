						"mode": "current"
					}
				]
			},
			{
				"name": "artifactQuery.side",
				"type": "EvidenceSide",
				"required": true,
				"description": "Which side of the result to search, `before` or `after`. Only the captures listed on that side are searched, and `before` returns null when the result has no before side.",
