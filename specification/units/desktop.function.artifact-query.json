				"name": "artifactQuery.file",
				"type": "string | ExplorerCapture",
				"required": true,
				"description": "A stored filename (the media file name without its `media/` prefix) or the exact `ExplorerCapture` object listed on the chosen side. Objects are matched by identity (`===`), so an equal copy finds nothing, and only captures whose stored media is not null are searched.",
