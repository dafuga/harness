			{
				"name": "artifactQuery.scope",
				"type": "EntityEvidenceQuery",
				"required": true,
				"description": "The entity, project context, branch, commit and viewing mode, copied unchanged into the returned request, including `projectId` when it is set. It must be the scope that produced `result`: the function does not compare the two, so a mismatch is returned with no error.",
