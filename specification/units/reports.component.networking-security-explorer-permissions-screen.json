	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ExplorerPermissionsScreen.index",
				"type": "HarnessIndex",
				"required": true,
				"description": "Project and branch history supplied by the Explorer host."
			},
			{
				"name": "ExplorerPermissionsScreen.head",
				"type": "HarnessRevision",
				"required": true,
				"description": "Selected immutable revision; its permission catalog supplies the displayed profiles and grants."
			},
			{
				"name": "ExplorerPermissionsScreen.parent",
				"type": "HarnessRevision | null",
				"required": true,
				"description": "First parent used by the shared Explorer frame; null at a branch tip or first commit."
			},
			{
				"name": "ExplorerPermissionsScreen.scope",
				"type": "ExplorerScope",
				"required": true,
				"description": "Selected branch, commit and availability context used by the shared frame."
			},
			{
				"name": "ExplorerPermissionsScreen.route",
				"type": "ExplorerLocation",
				"required": true,
				"description": "Current permissions index or profile address, including selected branch and commit."
			},
			{
				"name": "ExplorerPermissionsScreen.entities",
				"type": "ExplorerEntity[]",
				"required": true,
				"description": "Revision-scoped entity catalog used to link declared API, page and data resources."
			},
			{
				"name": "ExplorerPermissionsScreen.lens",
				"type": "EntityLens",
				"required": true,
				"description": "Host readers for entity contracts, measurements and captured evidence."
			},
			{
				"name": "ExplorerPermissionsScreen.client",
				"type": "Pick<HarnessClient, 'revision'>",
				"required": true,
				"description": "Revision loader used by the shared Explorer frame for historical navigation."
			},
			{
				"name": "ExplorerPermissionsScreen.mediaBase",
				"type": "string",
				"required": true,
				"description": "Base URL from which the shared frame resolves captured media."
			},
			{
				"name": "ExplorerPermissionsScreen.onroute",
				"type": "(to: ExplorerLocation) => void",
				"required": true,
				"description": "Requests navigation while preserving the selected explorer scope."
			},
			{
				"name": "ExplorerPermissionsScreen.exportHref",
				"type": "string",
				"required": true,
				"description": "Project export URL; empty when the host provides no export."
			},
			{
				"name": "ExplorerPermissionsScreen.endpoint",
				"type": "string | undefined",
				"required": false,
				"description": "Optional API unit ID restricting the screen to the profile grants declared for that endpoint."
			}
		],
		"outputs": [
			{
				"name": "ExplorerPermissionsScreen",
				"type": "markup",
				"description": "Profile index, one profile detail page or endpoint permission panel with method, data action, field and scope declarations; missing declarations remain explicit."
			}
		],
		"errors": [
			{
				"name": "lens.href callback error",
				"type": "thrown",
				"description": "An error supplied by the URL callback propagates while rendering permission links."
			},
			{
				"name": "onroute callback error",
				"type": "thrown",
				"description": "An error supplied by the navigation callback propagates when a permission link is activated."
			}
		]
	},
