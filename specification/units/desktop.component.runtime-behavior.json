		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-strong",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.entity-behavior",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/execution-runtimes/RuntimeBehavior.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/execution-runtimes/RuntimeBehavior.svelte"
			}
		]
	},
	"scenarios": ["runtime-evidence-ui", "shared-test-cases"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
