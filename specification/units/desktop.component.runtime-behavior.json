{
	"schemaVersion": 1,
	"id": "desktop.component.runtime-behavior",
	"kind": "component",
	"title": "Runtime behavior",
	"responsibility": "Shows recorded end-to-end behavior and comparison without presenting pending reads as verified changes.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.runtime-run",
			"reports.component.shared-primitives-atoms-html-dd",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-dl",
			"reports.component.shared-primitives-atoms-html-dt",
			"reports.component.shared-primitives-atoms-html-h3",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/RuntimeBehavior.svelte",
			"packages/desktop/src/components/execution-runtimes/RuntimeBehavior.svelte"
		],
		"symbols": ["RuntimeBehavior", "RuntimeBehavior"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RuntimeBehavior.result",
				"type": "EntityEvidenceResult",
				"description": "Required behavior rows, scenarios, scope and after-side record. Comparison has two sides only for commit mode with a parent."
			},
			{
				"name": "RuntimeBehavior.evidence",
				"type": "EntityEvidence",
				"description": "Read state: undefined is pending, null is failure, populated data supplies comparison input. Refusal messages are forwarded to run panels."
			},
			{
				"name": "RuntimeBehavior.unit",
				"type": "string",
				"description": "Optional function identifier forwarded to result rows on both sides."
			}
		],
		"outputs": [
			{
				"name": "RuntimeBehavior",
				"type": "markup",
				"description": "Current or compared behavior with verdict/reasons, result groups, recorded duration and scenario outcomes. Pending reads show a reading verdict unless already fixed as not-compared or unknown with a reason. Failed reads say Behavior unknown. Missing groups or duration are explicitly marked absent."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.runtime-run",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-evidence-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.entity-evidence",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-dd",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-dl",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-dt",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-h3",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-p",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-span",
			"via": "import",
