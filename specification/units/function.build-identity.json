{
	"schemaVersion": 1,
	"id": "function.build-identity",
	"kind": "function",
	"title": "buildIdentity",
	"responsibility": "Derives the identity of a compiled build from the path and content of every file in it.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["src/utils/buildIdentity.ts"],
		"symbols": ["BuiltFile", "buildIdentity", "builtFileHash"]
	},
	"contract": {
		"origin": "derived",
		"inputs": [
			{
				"name": "buildIdentity.files",
				"type": "BuiltFile[]"
			},
			{
				"name": "builtFileHash.bytes",
				"type": "Buffer"
			}
		],
		"outputs": [
			{
				"name": "buildIdentity",
				"type": "string"
			},
			{
				"name": "builtFileHash",
				"type": "{ sha256: string; stamps: string[]; slots: number }"
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "function.build-stamp",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/utils/buildIdentity.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/utils/buildIdentity.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
