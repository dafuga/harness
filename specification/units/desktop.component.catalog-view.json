	"kind": "component",
	"title": "Catalog view",
	"responsibility": "Lists the selected category with local search, verification and planning filters.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.entity-card",
			"reports.component.filter-dialog",
