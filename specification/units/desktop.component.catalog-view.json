{
	"schemaVersion": 1,
	"id": "desktop.component.catalog-view",
	"kind": "component",
	"title": "Catalog view",
	"responsibility": "Lists the selected category with local search, verification and planning filters.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["packages/desktop/src/components/CatalogView.svelte"],
		"symbols": ["CatalogView"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "CatalogView.workspace",
				"type": "Workspace",
				"description": "Workspace supplying the current category, optional project snapshot and entity-card context. A missing snapshot contributes an empty entity list. The category must be nonempty because it is used to build the heading."
			}
		],
		"outputs": [
			{
				"name": "CatalogView",
				"type": "markup",
				"description": "Local search and one filter icon above the catalog. The shared modal holds filters and ordering."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.entity-card",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.workspace",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.helper-contract",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.filter-dialog",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.select",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.explorer-name",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.select",
			"via": "contract",
			"origin": "declared",
			"contract": "The shared Select component supplies keyboard and value selection behavior through the $shared alias."
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/CatalogView.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/CatalogView.svelte"
			}
		]
	},
	"scenarios": [
		"desktop-native",
		"desktop-renderer",
		"agent-creation",
		"shells-shared-app",
		"component-catalog-previews"
	],
	"preview": {
		"scenario": "component-catalog-previews",
		"state": "desktop-component-catalog-view",
		"viewport": "desktop"
	},
	"budgets": {
