							"storage": "r2"
						}
					]
				]
			},
			{
				"name": "EvidenceViewer.selected",
				"type": "Evidence | null",
				"required": true,
				"description": "Required selected evidence record, or null; a record opens the modal and null shows the unselected message. The view starts at after and resets to after on close and after navigation.",
				"examples": [
					null,
					{
						"id": "a7e3c2d1-5b8f-4a60-9c73-2d4f6b8a102e-after",
						"title": "Checkout flow after",
						"category": "Uploaded comparison",
						"file": "e61e91619a84ab065171c246903711097699a5d6e5823dc395e59d86191f7054.png",
						"status": "not-proven",
						"source": "Manual upload · Cloudflare R2",
						"capturedAt": "2026-11-15T12:00:00.000Z",
						"viewport": "390px mobile",
						"phase": "after",
						"comparison": "a7e3c2d1-5b8f-4a60-9c73-2d4f6b8a102e",
						"storage": "r2"
					}
				]
			},
			{
				"name": "EvidenceViewer.assetBase",
				"type": "string",
				"required": true,
				"description": "Required URL or path prefix prepended directly to each file for the image source and download link. The component does not normalize or join paths, so include any needed separator.",
				"examples": ["/assets/"]
			},
			{
				"name": "EvidenceViewer.onclose",
				"type": "() => void",
				"required": true,
				"description": "Required callback invoked when the modal closes; the viewer resets its view to after before calling it."
			},
			{
				"name": "EvidenceViewer.onselect",
				"type": "(item: Evidence, updateViewport?: boolean) => void",
				"required": true,
				"description": "Required callback invoked when navigation or viewport switching selects an item. Previous/next passes only the item, while viewport switching passes true as the optional second argument."
			}
		],
		"outputs": [
			{
				"name": "EvidenceViewer",
				"type": "markup",
				"description": "Renders the lightbox when selected is non-null and the unselected message otherwise; after is the default view, and before/after/compare controls appear only when a matching before item exists. It shows a missing note instead of an image for missing records, includes available provenance and per-side captions, lays out comparisons in two panes, and remounts image zoom when the view changes."
			}
		],
		"errors": [
			{
				"name": "onclose callback error",
				"type": "thrown",
				"description": "An exception thrown synchronously by onclose propagates when the modal closes; the view resets to after before the callback runs."
			},
			{
				"name": "onselect callback error",
				"type": "thrown",
				"description": "An exception thrown synchronously by onselect propagates when navigation or viewport switching invokes it; only viewport switching passes true as the optional second argument."
			}
		],
		"errorStatus": "declared",
