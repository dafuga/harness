					]
				]
			},
			{
				"name": "EvidenceViewer.navigableItems",
				"type": "Evidence[]",
				"required": true,
				"description": "Required ordered list used by previous/next buttons and arrow keys. Navigation is enabled only when selected is non-null and this list contains an id different from selected; the viewer wraps the supplied order without sorting or filtering it.",
				"examples": [
					[
						{
							"id": "b14d9c6f-27a3-4e81-b6d5-0f8a2c4e7193-after",
							"title": "Checkout flow after",
							"category": "Uploaded comparison",
