		],
		"symbols": ["ContractPanel", "ContractPanel"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ContractPanel.contract",
				"type": "EntityContract",
				"description": "Required contract containing input, output and error arrays. Each field supplies its name and type and may supply a description. Missing descriptions are shown explicitly; this panel does not derive an explanation from the type."
			}
		],
		"outputs": [
			{
				"name": "ContractPanel",
				"type": "markup",
				"description": "Accepts, Returns and Can fail with sections. Uses a readable form of the final part of each field name and its recorded description, or “No description recorded.” when absent. Empty groups show “Nothing declared.” An expandable Technical contract section shows the full names and types."
			}
		],
		"errors": []
