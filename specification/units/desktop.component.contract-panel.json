			"ContractPanel",
			"ContractPanel.label",
			"ContractPanel.children",
			"ContractPanel.empty"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ContractPanel.contract",
				"type": "EntityContract",
				"required": true,
				"description": "Required contract containing input, output and error arrays. Each field supplies its name and type and may supply a description. Missing descriptions are shown explicitly; this panel does not derive an explanation from the type. Each group requires distinct field names because both readable and technical rows are keyed by name."
			}
		],
		"outputs": [
			{
				"name": "ContractPanel",
				"type": "markup",
				"description": "Accepts, Returns and Can fail with sections. Uses a readable form of the final part of each field name and its recorded description, or “No description recorded.” when absent. Empty groups show “Nothing declared.” An expandable Technical contract section shows the full names and types."
			}
		],
		"errors": [
			{
				"name": "Duplicate row key",
				"type": "Svelte keyed-each error",
				"description": "Repeated field names within a group are rejected by Svelte keyed-list updates."
			}
		],
		"errorStatus": "declared",
		"operations": [],
		"initialization": [],
		"snippets": [
			{
