	"id": "desktop.component.contract-panel",
	"kind": "component",
	"title": "Contract panel",
	"responsibility": "Presents an entity’s declared inputs, outputs and errors in ordinary language, with technical names and types available on expansion.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
		"uses": [
			"reports.component.shared-primitives-atoms-html-code",
