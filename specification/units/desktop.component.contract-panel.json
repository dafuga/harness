			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.shared-primitives-detail-list"
		]
	},
	"owns": {
		"source": ["packages/desktop/src/components/shared-primitives/ContractPanel.svelte"],
		"symbols": [
			"ContractPanel",
			"ContractPanel.label",
			"ContractPanel.children",
			"ContractPanel.empty"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ContractPanel.contract",
				"type": "EntityContract",
				"required": true,
				"description": "Required contract with distinct input/output/error names, public types and optional descriptions. Input required flags and own literal defaults remain visible; absent metadata and descriptions are stated explicitly."
			}
		],
		"outputs": [
			{
				"name": "ContractPanel",
				"type": "markup",
				"description": "Accepts, Returns and Can fail with sections show field descriptions and types. Inputs show Required/Optional or missing metadata, plus exact literal defaults or No default. Empty groups say Nothing declared. Technical contract expands full names and types."
			}
		],
		"errors": [
			{
				"name": "Duplicate row key",
				"type": "Svelte keyed-each error",
				"description": "Repeated field names within a group are rejected by Svelte keyed-list updates."
			},
			{
				"name": "TypeError",
				"type": "thrown",
				"description": "A literal default contains BigInt or circular data that JSON cannot serialize."
			},
			{
				"name": "RangeError",
				"type": "thrown",
				"description": "Deeply nested literal defaults exceed the JSON serializer stack."
			},
			{
				"name": "Getter, proxy or conversion error",
				"type": "propagated",
				"description": "Errors from supplied field/default/example getters, proxy traps or JSON conversion methods propagate."
			}
		],
		"errorStatus": "declared",
		"operations": [],
		"initialization": [],
		"snippets": [
			{
				"name": "ContractPanel.label",
				"inputs": [
					{
						"name": "ContractPanel.label.field",
						"type": "EntityContract['inputs'][number]",
						"required": true
					}
				],
				"outputs": [
