{
	"schemaVersion": 1,
	"id": "desktop.adapter.remote-registration",
	"kind": "adapter",
	"title": "RemoteRegistrationAdapter",
	"responsibility": "Owns the RemoteRegistrationAdapter integration boundary.",
	"responsibilityOrigin": "derived",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/adapters/RemoteRegistrationAdapter.ts",
			"packages/desktop/src/lib/desktop-initialization/RemoteRegistrationAdapter.ts"
		],
		"symbols": [
			"RemoteRegistrationAdapter",
			"RemoteRegistrationAdapterConfig",
			"RemoteRegistrationAdapterConfig",
			"RemoteRegistrationAdapter",
			"RemoteRegistrationAdapter.constructor",
			"RemoteRegistrationAdapter.register"
		]
	},
