			"origin": "derived"
		},
		{
			"unit": "remote.entry.index",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/lib/desktop-initialization/RemoteRegistrationAdapter.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/lib/desktop-initialization/RemoteRegistrationAdapter.ts"
			}
		]
	},
	"scenarios": ["remote-desktop-boundaries"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
