{
	"schemaVersion": 1,
	"id": "hub.layout.root",
	"kind": "layout",
	"title": "Hub root layout",
	"responsibility": "Provides the browser session and shared workspace styles around the current hosted page.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"catalog": {
		"visibility": "internal"
	},
	"owns": {
		"source": ["packages/hub/src/routes/+layout.svelte", "packages/hub/src/routes/+layout.ts"],
		"symbols": ["+layout", "ssr"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "+layout.children",
				"type": "Snippet",
				"description": "Page content rendered through the layout children snippet."
			}
		],
		"outputs": [
			{
				"name": "+layout",
				"type": "markup",
				"description": "Rendered child page with the shared styles and session context."
			},
			{
				"name": "ssr",
				"type": "unknown",
				"description": "Disables server rendering for the browser workspace."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.style.design",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.style.workspace",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.function.browser-context",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.style.hub",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/hub/src/routes/+layout.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/hub/src/routes/+layout.svelte"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
