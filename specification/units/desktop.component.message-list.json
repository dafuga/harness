{
	"schemaVersion": 1,
	"id": "desktop.component.message-list",
	"kind": "component",
	"title": "Message list",
	"responsibility": "Shows conversation entries with authors, timestamps, optional status details and entity-reference links.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.reference-text",
			"reports.component.shared-primitives-atoms-html-article",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-strong"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/MessageList.svelte",
			"packages/desktop/src/components/shared-primitives/MessageList.svelte"
		],
		"symbols": ["MessageList", "MessageList"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "MessageList.messages",
				"type": "ThreadEntry[]",
				"description": "Required entries in display order. User names fall back to You; other authors display their provider followed by CLI, or Harness. Optional pending state, note, detail and version are displayed."
			},
			{
				"name": "MessageList.workspace",
				"type": "Workspace",
				"description": "Workspace for resolving references within the shown project and revision."
			},
			{
				"name": "MessageList.entity",
				"type": "CatalogEntity | null",
				"description": "Optional viewed entity for reference resolution before the catalog lists it; defaults to null."
			}
		],
		"outputs": [
			{
				"name": "MessageList",
				"type": "markup",
				"description": "Polite live list with author badges, formatted timestamps and reference-aware text. Shows pending styling and optional note/detail/design version. Empty lists prompt a conversation about the design."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.reference-text",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.comment-entries",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.time-label",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.workspace",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-article",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-p",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-small",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-strong",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/shared-primitives/MessageList.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/shared-primitives/MessageList.svelte"
			}
		]
	},
	"scenarios": ["agent-references", "desktop-native", "desktop-renderer"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
