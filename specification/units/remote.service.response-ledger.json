{
	"schemaVersion": 1,
	"id": "remote.service.response-ledger",
	"kind": "service",
	"title": "ResponseLedgerService",
	"responsibility": "Owns the ResponseLedgerService service workflow.",
	"responsibilityOrigin": "derived",
	"status": "active",
	"owns": {
		"source": [
			"packages/remote/src/services/ResponseLedgerService.ts",
			"packages/remote/src/services/networking-security/wire-session-service/ResponseLedgerService.ts",
			"packages/remote/src/services/networking-security/wire-session-service/ResponseLedgerService.types.ts",
			"packages/remote/src/services/wire-session-service/ResponseLedgerService.ts"
		],
		"symbols": [
			"ResponseLedgerService",
			"LedgerOptions",
			"ResponseLedgerService",
			"ResponseLedgerService.constructor",
			"ResponseLedgerService.run",
			"LedgerOptions",
			"Entry",
			"LedgerOptions",
			"ResponseLedgerService"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ResponseLedgerService.constructor.options",
				"type": "LedgerOptions"
			},
			{
				"name": "ResponseLedgerService.run.request",
				"type": "{ id: string; digest: string }"
			},
			{
				"name": "ResponseLedgerService.run.execute",
				"type": "() => Promise<unknown>"
			}
		],
		"outputs": [
			{
				"name": "ResponseLedgerService.run",
				"type": "Promise<unknown>"
			}
		],
		"errors": [
			{
				"name": "RemoteFailure",
				"type": "thrown"
			}
		]
	},
	"dependencies": [
		{
			"unit": "remote.model.remote-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/remote/src/services/networking-security/wire-session-service/ResponseLedgerService.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/remote/src/services/networking-security/wire-session-service/ResponseLedgerService.ts"
			}
		]
	},
	"scenarios": ["remote-desktop-boundaries"],
	"testing": {
		"version": 1,
		"shape": "service",
		"states": [
			"initialized-settled-replay",
			"pending-replay",
			"digest-conflict",
			"remembered-failure",
			"expired-evicted",
			"pending-capacity-full"
		],
		"cases": [
			{
				"id": "run-initialized-settled-replay",
				"state": "initialized-settled-replay",
				"subject": "ResponseLedgerService.run",
				"fixture": "packages/remote/test/support/wireHarness.ts",
				"test": {
					"file": "packages/remote/test/services/response-ledger.test.ts",
					"title": "run initialized settled replay preserves the first answer"
				},
				"expected": {
					"kind": "value",
					"value": {
						"first": {
							"run": 1
						},
						"replay": {
							"run": 1
						},
						"runs": 1
					}
				},
				"props": ["id", "digest", "execute", "settled operation"]
			},
			{
				"id": "run-pending-replay",
				"state": "pending-replay",
				"subject": "ResponseLedgerService.run",
				"fixture": "packages/remote/test/support/wireHarness.ts",
				"test": {
					"file": "packages/remote/test/services/response-ledger.test.ts",
					"title": "run pending replay joins an answer that is still being produced"
				},
				"expected": {
					"kind": "value",
					"value": {
						"answers": ["done", "done"],
						"runs": 1
					}
				},
				"props": ["id", "digest", "execute", "pending operation"]
			},
			{
				"id": "run-digest-conflict",
				"state": "digest-conflict",
				"subject": "ResponseLedgerService.run",
				"fixture": "packages/remote/test/support/wireHarness.ts",
				"test": {
					"file": "packages/remote/test/services/response-ledger.test.ts",
					"title": "run digest conflict rejects another digest and runs nothing"
				},
				"expected": {
					"kind": "value",
					"value": {
						"code": "request-conflict",
						"runs": 1
					}
				},
				"props": ["id", "digest", "execute", "settled operation"],
				"errors": ["RemoteFailure"]
			},
			{
				"id": "run-remembered-failure",
				"state": "remembered-failure",
				"subject": "ResponseLedgerService.run",
				"fixture": "packages/remote/test/support/wireHarness.ts",
				"test": {
					"file": "packages/remote/test/services/response-ledger.test.ts",
					"title": "run remembered failure is not retried"
				},
				"expected": {
					"kind": "value",
					"value": {
						"message": "refused",
						"runs": 1
					}
				},
				"props": ["id", "digest", "execute", "failed operation"],
				"errors": ["Error"]
			},
			{
				"id": "run-expired-evicted",
				"state": "expired-evicted",
				"subject": "ResponseLedgerService.run",
				"fixture": "packages/remote/test/support/wireHarness.ts",
				"test": {
					"file": "packages/remote/test/services/response-ledger.test.ts",
					"title": "run expired or evicted answer is refused and never runs again"
				},
				"expected": {
					"kind": "value",
					"value": {
						"expired": {
							"code": "request-expired"
						},
						"evicted": {
							"code": "request-expired"
						},
						"runs": {
							"expired": 1,
							"evicted": 3
						}
					}
				},
				"props": ["id", "digest", "execute", "capacity", "ttlMs", "now", "settled operation"],
				"errors": ["RemoteFailure"]
			},
			{
				"id": "run-pending-capacity-full",
				"state": "pending-capacity-full",
				"subject": "ResponseLedgerService.run",
				"fixture": "packages/remote/test/support/wireHarness.ts",
				"test": {
					"file": "packages/remote/test/services/response-ledger.test.ts",
					"title": "run pending capacity full refuses new ones"
				},
				"expected": {
					"kind": "value",
					"value": {
						"code": "too-many-requests",
						"answer": "a"
					}
				},
				"props": ["id", "digest", "execute", "capacity", "tombstones", "pending operation"],
				"errors": ["RemoteFailure"]
			}
		]
	},
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
