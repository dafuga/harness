{
	"schemaVersion": 1,
	"id": "remote.validator.remote-input",
	"kind": "validator",
	"title": "RemoteInputValidator",
	"responsibility": "Owns the RemoteInputValidator input validation.",
	"responsibilityOrigin": "derived",
	"status": "active",
	"owns": {
		"source": ["packages/remote/src/validators/RemoteInputValidator.ts"],
		"symbols": [
			"RemoteInputValidator",
			"RemoteInputValidator.attach",
			"RemoteInputValidator.projectId",
			"RemoteInputValidator.revision",
			"RemoteInputValidator.approval",
			"RemoteInputValidator.pairing",
			"RemoteInputValidator.device"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RemoteInputValidator.attach.input",
				"type": "unknown"
			},
			{
				"name": "RemoteInputValidator.projectId.input",
				"type": "Fields"
			},
			{
				"name": "RemoteInputValidator.revision.input",
				"type": "Fields"
			},
			{
				"name": "RemoteInputValidator.approval.input",
				"type": "unknown",
				"description": "Exact approval fields: pairingId, deviceId, one to 64 distinct local projectIds and boolean agents, with optional boolean comments. Explicit comments must be true when agents is true; omitted comments retain legacy admission."
			},
			{
				"name": "RemoteInputValidator.pairing.input",
				"type": "unknown"
			},
			{
				"name": "RemoteInputValidator.device.input",
				"type": "unknown"
			}
		],
		"outputs": [
			{
				"name": "RemoteInputValidator.attach",
				"type": "AttachInput"
			},
			{
				"name": "RemoteInputValidator.projectId",
				"type": "string"
			},
			{
				"name": "RemoteInputValidator.revision",
				"type": "RemoteRevision"
			},
			{
				"name": "RemoteInputValidator.approval",
				"type": "RemoteApprovalInput",
				"description": "Validated approval preserves project order, agents and the presence or absence of comments. Invalid fields throw RemoteFailure with invalid-message."
			},
			{
				"name": "RemoteInputValidator.pairing",
				"type": "{ pairingId: string }"
			},
			{
				"name": "RemoteInputValidator.device",
				"type": "{ deviceId: string }"
			}
		],
		"errors": [
			{
				"name": "RemoteFailure",
				"type": "thrown"
			}
		]
	},
	"dependencies": [
		{
			"unit": "remote.function.remote-identity",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "remote.model.remote-control-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "remote.model.remote-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/remote/src/validators/RemoteInputValidator.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/remote/src/validators/RemoteInputValidator.ts"
			}
		]
	},
	"scenarios": ["remote-desktop-boundaries"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
