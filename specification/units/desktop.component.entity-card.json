{
	"schemaVersion": 1,
	"id": "desktop.component.entity-card",
	"kind": "component",
	"title": "Catalog card",
	"responsibility": "Shows one catalog entity; page cards contain only a title and its recorded screenshot or planned design.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.plan-badge",
			"desktop.component.recorded-preview",
			"desktop.component.status-icon",
			"desktop.component.workspace-link",
			"reports.component.shared-primitives-atoms-html-article",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-img",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/EntityCard.svelte",
			"packages/desktop/src/components/explorer-ui/EntityCard.svelte"
		],
		"symbols": ["EntityCard", "EntityCard"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityCard.entity",
				"type": "CatalogEntity",
				"description": "The project item to show, including its summary, preview and recorded verification status."
			},
			{
				"name": "EntityCard.workspace",
				"type": "Workspace",
				"description": "The selected project and revision, used to load the preview and open the item."
			}
		],
		"outputs": [
			{
				"name": "EntityCard",
				"type": "markup",
				"description": "Pages use one title-and-image navigation link. Other entities retain their summary, plan marker, verification and open action. Recorded screenshots and planned designs keep separate identity and accessible labels."
			}
		],
		"errors": []
	},
