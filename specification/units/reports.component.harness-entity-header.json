			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/EntityHeader.svelte",
			"packages/reports/src/components/explorer-ui/EntityHeader.types.ts"
		],
		"symbols": ["EntityHeader", "Place"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityHeader.entity",
				"type": "ExplorerEntity",
				"description": "Required identity, category, role, purpose and verdict. Page headers keep identity concise; purpose and app route remain in Contract."
			},
			{
				"name": "EntityHeader.nav",
				"type": "EntityNav",
				"description": "The branch, commit and selected tab, with functions for links and navigation."
			},
			{
				"name": "EntityHeader.preview",
				"type": "Snippet",
				"description": "Optional component screenshot shown above every tab."
			},
			{
				"name": "EntityHeader.owner",
				"type": "ExplorerEntity | undefined",
				"description": "Sole recorded consumer for a private function breadcrumb; absent when ownership is unknown or not unique."
			},
			{
				"name": "EntityHeader.usesAvailable",
				"type": "boolean | undefined",
				"description": "Optional Uses visibility; false for a selected helper with no recorded helper callees."
			}
		],
		"outputs": [
			{
				"name": "EntityHeader",
				"type": "markup",
				"description": "Entity identity, verification and one tab bar. Pages omit Used In, purpose prose and route metadata. Models expose a Table tab after Contract. Component screenshots remain above tabs, and component recordings open in Audio. Private function breadcrumbs identify their recorded owner and never link to Helpers. Grouped catalog entities include the selected revision’s responsibility folder between collection and entity in every tab breadcrumb."
			}
		],
		"errors": []
	},
