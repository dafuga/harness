{
	"schemaVersion": 1,
	"id": "reports.component.harness-entity-header",
	"kind": "component",
	"title": "Entity header",
	"responsibility": "Shows entity identity and scoped section tabs, including model Table schema, component audio, usage, tests, history and optional source.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-entity-link",
			"reports.component.harness-harness-icon",
			"reports.component.harness-harness-tabs",
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-atoms-html-div",
