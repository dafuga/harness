		],
		"inputs": [
			{
				"name": "ExplorerTable.category",
				"type": "Kind",
				"required": true,
				"description": "Selects the catalog heading, columns, and row rendering. Configs use only Variable and Value columns; other categories use their configured columns.",
				"examples": ["configs", "services"]
			},
			{
				"name": "ExplorerTable.rows",
				"type": "CatalogRow[]",
				"required": true,
				"description": "Rows render in input order and are keyed by `row.id`; an empty array renders `No rows to display.` The selected category determines which row fields are read.",
				"examples": [[]]
			},
			{
				"name": "ExplorerTable.nav",
				"type": "EntityNav",
				"required": true,
				"description": "Provides the current route and navigation methods used by entity links and open actions. It matters when a row link or open action is rendered."
			},
			{
				"name": "ExplorerTable.lens",
				"type": "EntityLens",
				"required": true,
				"description": "A lens object forwarded to `ExplorerUsage` with usage cells; this table does not call its methods directly. It matters only for categories that render a usage cell."
			},
			{
				"name": "ExplorerTable.mediaBase",
				"type": "string",
				"required": true,
				"description": "A string forwarded to `ExplorerUsage` with usage cells. It matters only for categories that render a usage cell.",
				"examples": ["/media"]
			},
			{
				"name": "ExplorerTable.verification",
				"type": "boolean",
				"required": false,
				"default": true,
				"description": "Defaults to true. For non-config categories, it controls whether the Verification column and each row verdict are rendered; configs always use only Variable and Value columns.",
				"examples": [true, false]
			}
		],
		"outputs": [
			{
				"name": "ExplorerTable",
				"type": "markup",
				"description": "Renders a category-labeled table whose heading, columns, and row content depend on `category`; empty `rows` render `No rows to display.` The config view has only Variable and Value columns and can inspect a value in a modal, while other categories use their configured columns and show Verification when `verification` is true."
			},
			{
				"name": "ConfigValue",
				"type": "markup",
				"description": "Renders supported scalar literals as typed marks and literal arrays as chips only when they contain at most 10 scalar items whose displayed text totals at most 96 characters. Other values show the initializer as text unless a structured-collection mark offers read-only inspection; the initializer is never executed."
			}
		],
		"errors": [
			{
				"name": "Duplicate row key",
				"type": "thrown",
				"description": "The keyed row loop uses `row.id`, so duplicate ids can cause a Svelte keyed-each error. Row ids must be unique within the displayed rows."
			}
		],
		"errorStatus": "declared",
