		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ExplorerTable.category",
				"type": "Kind",
				"required": true,
				"description": "Required table category: functions, configs, services, models, types, layouts, APIs or platforms. Configs keep only Variable and Value columns; layout rows also show their descriptions."
			},
			{
				"name": "ExplorerTable.rows",
				"type": "CatalogRow[]",
				"required": true,
				"description": "Required rows in display order. A config table receives one source file with committed expressions, decoded literals and static collection structures. Row identifiers must be distinct."
			},
			{
				"name": "ExplorerTable.nav",
				"type": "EntityNav",
				"required": true,
				"description": "Required navigation context for entity links and actions."
			},
			{
				"name": "ExplorerTable.lens",
				"type": "EntityLens",
				"required": true,
				"description": "Revision-scoped screenshot evidence for linked consumers."
			},
			{
				"name": "ExplorerTable.mediaBase",
				"type": "string",
				"required": true,
				"description": "URL prefix resolving consumer screenshots."
			},
			{
				"name": "ExplorerTable.verification",
				"type": "boolean",
				"required": false,
				"default": true,
				"description": "Defaults to true for module catalogs. Configs always show only Variable and Value columns; relationship tabs omit verification indicators."
			}
		],
		"outputs": [
			{
				"name": "ExplorerTable",
				"type": "markup",
				"description": "A source-named Variable/Value table with typed scalar/array presentation, icon controls and expandable read-only inspection. Links retain the selected revision. Empty categories show a body cell spanning all columns; overflowing columns retain an explicit horizontal scroll hint."
			},
			{
				"name": "ConfigValue",
				"type": "markup",
				"description": "Owned private renderer, not another public component unit. Required props: name: string identifies the variable and inspection action; source: string is the exact committed initializer; onview: (event: MouseEvent) => void handles the inspection action. Optional literal: unknown and structure: ConfigValueNode both default to undefined. It renders typed scalar or short-array marks, collection counts, strings with preserved line breaks, or clipped single-line text. It does not execute initializers. onview callback failures propagate."
			}
		],
		"errors": [
			{
				"name": "Duplicate row key",
				"type": "Svelte keyed-each error",
				"description": "Duplicate row identifiers are rejected by Svelte keyed-list updates."
			},
			{
				"name": "ConfigValue onview callback error",
				"type": "thrown",
				"description": "The owned ConfigValue renderer forwards inspection events to its required onview callback; callback failures propagate. ExplorerTable supplies its normal internal view handler."
			}
		],
		"errorStatus": "declared",
