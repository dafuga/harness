{
	"schemaVersion": 1,
	"id": "desktop.component.plan-badge",
	"kind": "component",
	"title": "Plan badge",
	"responsibility": "Marks content with a short plan label.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
		"uses": ["reports.component.shared-primitives-atoms-html-span"]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/PlanBadge.svelte",
			"packages/desktop/src/components/planning-collaboration/PlanBadge.svelte"
		],
		"symbols": ["PlanBadge", "PlanBadge"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "PlanBadge.label",
				"type": "string",
				"description": "Optional badge text, defaulting to Plan. Explicitly empty text stays empty."
			}
		],
		"outputs": [
			{
				"name": "PlanBadge",
				"type": "markup",
				"description": "A styled span with the given label; it does not inspect plan or approval state."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.component.shared-primitives-atoms-html-span",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/planning-collaboration/PlanBadge.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/planning-collaboration/PlanBadge.svelte"
			}
		]
	},
	"scenarios": ["desktop-native", "desktop-renderer"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
