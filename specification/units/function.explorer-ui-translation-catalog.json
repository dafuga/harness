{
	"schemaVersion": 1,
	"id": "function.explorer-ui-translation-catalog",
	"kind": "function",
	"title": "Translation catalog",
	"responsibility": "Read registered translation dictionaries from one source revision without executing application code.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/core/explorer-ui/Translation.types.ts",
			"src/services/explorer-ui/revision-detail-service/translationCatalog.ts",
			"src/services/explorer-ui/revision-detail-service/translationCatalog.types.ts",
			"src/services/explorer-ui/revision-detail-service/translationMessages.ts",
			"src/services/explorer-ui/revision-detail-service/translationMessages.types.ts"
		],
		"symbols": [
			"TranslationRow",
			"TranslationCatalog",
			"translationCatalog",
			"TranslationScan",
			"flattenMessages",
			"translationMessages",
			"TranslationRegistration",
			"TranslationSource"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "tree",
				"type": "SourceTree",
				"description": "Repository files at the selected commit."
			},
			{
				"name": "units",
				"type": "RevisionRegistry['units']",
				"description": "Registered source owners used to link verified message callers."
			}
		],
		"outputs": [
			{
				"name": "catalog",
				"type": "Promise<TranslationCatalog>",
				"description": "Static language values, literal caller links and unreadable source gaps from that revision."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "function.revision-registry",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.source-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/services/explorer-ui/revision-detail-service/translationCatalog.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/services/explorer-ui/revision-detail-service/translationCatalog.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
