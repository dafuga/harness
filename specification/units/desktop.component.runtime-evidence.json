	"kind": "component",
	"title": "Runtime evidence",
	"responsibility": "Combines recorded screenshots, behavior and audio while identifying evidence gaps and offline copies.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.runtime-audio",
			"desktop.component.runtime-behavior",
