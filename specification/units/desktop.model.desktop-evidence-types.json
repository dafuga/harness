{
	"schemaVersion": 1,
	"id": "desktop.model.desktop-evidence-types",
	"kind": "model",
	"title": "DesktopEvidence",
	"responsibility": "Owns recorded desktop evidence and artifact query models.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/models/DesktopEvidence.types.ts",
			"packages/desktop/src/models/verification-evidence/DesktopEvidence.types.ts"
		],
		"symbols": [
			"EntityEvidenceQuery",
			"EntityEvidenceResult",
			"EvidenceArtifactQuery",
			"EvidenceArtifactResult"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityEvidenceQuery",
				"type": "EntityQuery & {branch:string,mode:\"current\"|\"commit\"}",
				"description": "current uses the branch tip; commit compares the selected commit with its first parent."
			},
			{
				"name": "EvidenceArtifactQuery",
				"type": "EntityEvidenceQuery & {side:\"before\"|\"after\",recordId:string,scenarioId:string,state:string,evidenceId:string,viewport:string|null,sha256:string,notesRevision:string|null,evidenceRevision:string|null}",
				"description": "Identifies recorded capture bytes by bindings; no path or address is supplied."
			}
		],
		"outputs": [
			{
				"name": "EntityEvidenceResult",
				"type": "{scope:ExplorerScope,identity:CacheIdentity,evidence:ExplorerEvidence,behavior:ExplorerBehavior}"
			},
			{
				"name": "EvidenceArtifactResult",
				"type": "{bytes:Uint8Array,mediaType:string,sha256:string}"
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "collaboration.model.collaboration-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-bridge-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.explorer-evidence-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.explorer-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/models/verification-evidence/DesktopEvidence.types.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/models/verification-evidence/DesktopEvidence.types.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
