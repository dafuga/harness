{
	"schemaVersion": 1,
	"id": "reports.component.console-chat",
	"kind": "component",
	"title": "Local web project chat",
	"responsibility": "Hosts the shared project conversation in the web explorer and connects its backend when the bubble opens.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.project-agent",
			"reports.component.shared-primitives-atoms-html-div"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/ConsoleChat.svelte",
			"packages/reports/src/components/planning-collaboration/ConsoleChat.svelte"
		],
		"symbols": ["ConsoleChat", "ConsoleChat"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ConsoleChat.base",
				"type": "string",
				"description": "URL prefix of the local explorer.",
				"examples": ["/harness"]
			},
			{
				"name": "ConsoleChat.path",
				"type": "string",
				"description": "Selected branch, optional commit and entity path, including its tab query.",
				"examples": ["/branch/main/components/app.component.toolbar?tab=contract"]
			},
			{
				"name": "ConsoleChat.navigate",
				"type": "(path: string, replace: boolean) => void",
				"description": "Host router callback. Receives the explorer path and whether to replace the current history entry.",
				"examples": ["navigate(\"/branch/main/pages\", false)"]
			}
		],
		"outputs": [
			{
				"name": "ConsoleChat",
				"type": "markup",
				"description": "The shared round launcher and conversation, connected lazily to the local project executor.",
				"examples": ["<button aria-label=\"Work with agent\">…</button>"]
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.project-agent",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.store.console-workspace",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/components/planning-collaboration/ConsoleChat.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/components/planning-collaboration/ConsoleChat.svelte"
			}
		]
	},
	"scenarios": ["local-project-chat"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
