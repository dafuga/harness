{
	"schemaVersion": 1,
	"id": "reports.component.regression-proof",
	"kind": "component",
	"title": "Regression proof",
	"responsibility": "Show the failing-test commit beside the fix that passes the same test.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-article",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-h3",
			"reports.component.shared-primitives-atoms-html-h4",
			"reports.component.shared-primitives-atoms-html-header",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-pre",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-atoms-html-summary"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/RegressionProof.svelte",
			"packages/reports/src/components/verification-evidence/RegressionProof.svelte",
			"packages/reports/src/components/verification-evidence/regression-proof/regressionProof.css"
		],
		"symbols": ["RegressionProof", "RegressionProof"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RegressionProof.items",
				"type": "RegressionView[]",
				"required": false,
				"default": [],
				"description": "Optional recorded regression views. An empty or unmatched list shows that proof is unavailable."
			},
			{
				"name": "RegressionProof.unit",
				"type": "string",
				"required": true,
				"description": "Required unit identifier used to retain matching or unscoped regression views."
			},
			{
				"name": "RegressionProof.href",
				"type": "(commit: string) => string",
				"required": true,
				"description": "Required function producing the destination for each recorded commit."
			},
			{
				"name": "RegressionProof.follow",
				"type": "(commit: string) => void",
				"required": false,
				"description": "Optional client-side commit navigation callback for unmodified primary clicks; modified clicks keep normal link behavior."
			}
		],
		"outputs": [
			{
				"name": "RegressionProof",
				"type": "markup",
				"description": "Matching regression evidence with commit links and recorded output, or an unavailable message when no matching views are supplied."
			}
		],
		"errors": [
			{
				"name": "href callback error",
				"type": "thrown",
				"description": "An error thrown by href propagates while rendering recorded commit links."
			},
			{
				"name": "follow callback error",
				"type": "thrown",
				"description": "An error thrown by follow propagates when an unmodified primary click opens a commit."
			}
		]
	},
