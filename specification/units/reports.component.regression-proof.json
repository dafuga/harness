		"inputs": [
			{
				"name": "RegressionProof.items",
				"type": "RegressionView[]",
				"required": false,
				"default": [],
				"description": "An ordered list of regression views; views are shown when their units list is empty or contains the supplied unit. An empty list shows the unavailable message, while views without a gap or red checkpoint show that no failing-test checkpoint is recorded.",
				"examples": [
					[]
				]
			},
			{
				"name": "RegressionProof.unit",
				"type": "string",
				"required": true,
				"description": "The unit identifier used to retain scoped views whose units list contains it; views with no unit scope are also retained. It does not alter the display of retained views.",
				"examples": ["reports.component.regression-proof"]
			},
			{
				"name": "RegressionProof.href",
				"type": "(commit: string) => string",
				"required": true,
				"description": "The required callback that turns a recorded checkpoint commit into the destination used by its anchor. It is called only for a pane with a recorded value and can throw while rendering."
			},
			{
				"name": "RegressionProof.follow",
				"type": "(commit: string) => void",
				"required": false,
				"default": "undefined (omitted)",
				"description": "An optional callback for client-side navigation to a checkpoint commit; when omitted, links use their ordinary anchor behavior. It is called only for an unprevented, unmodified primary click and defaults to undefined."
			}
		],
		"outputs": [
			{
				"name": "RegressionProof",
				"type": "markup",
				"description": "A rendered regression-proof section for unscoped views and views matching the supplied unit, with checkpoint links and expandable recorded output where checkpoints exist. When no views match, it renders the unavailable message."
			}
		],
		"errors": [
			{
				"name": "href callback error",
				"type": "thrown",
				"description": "An exception thrown by href propagates while rendering a link for a recorded red or green checkpoint."
			},
			{
				"name": "follow callback error",
				"type": "thrown",
				"description": "An exception thrown by follow propagates when an eligible unmodified primary click invokes it; the callback is skipped when absent, when the event was prevented, or for non-primary or modified clicks."
			}
		],
		"errorStatus": "declared",
