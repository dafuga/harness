{
	"schemaVersion": 1,
	"id": "reports.component.browser-errors",
	"kind": "component",
	"title": "Recorded browser errors",
	"responsibility": "Display recorded console errors and uncaught exceptions alongside their expectations and test-attempt context.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
		"uses": [
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-li",
			"reports.component.shared-primitives-atoms-html-ol",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-pre",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-atoms-html-summary"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/browser-errors/BrowserErrors.svelte",
			"packages/reports/src/components/shared-primitives/browser-errors/BrowserErrors.svelte"
		],
		"symbols": ["BrowserErrors", "BrowserErrors"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "BrowserErrors.diagnostics",
				"type": "BrowserDiagnostic[]",
				"description": "Optional recorded test-attempt diagnostics. Missing or empty arrays render nothing; each supplied attempt may contain observations, expectations or both."
			}
		],
		"outputs": [
			{
				"name": "BrowserErrors",
				"type": "markup",
				"description": "Expandable Browser errors group with the total classified row count, test/file/project or browser identity and retry number. Rows show expected, unexpected or missing-expected status, message, expectation reason and available source/page/stack as escaped text. Source line and column display one-based coordinates. A supplied attempt with no rows still appears under a zero-entry summary."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "function.browser-diagnostics",
