{
	"schemaVersion": 1,
	"id": "reports.function.preview-arguments",
	"kind": "function",
	"title": "Read preview launch options",
	"responsibility": "Checks the local launch options and identifies the checkout and history data.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"documentation": "packages/reports/specification/features/planned/managed-preview-server.md",
	"owns": {
		"source": [
			"packages/reports/src/utils/previewArguments.ts",
			"packages/reports/src/utils/preview-node/previewArguments.ts"
		],
		"symbols": [
			"PreviewArguments",
			"previewArguments"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "previewArguments.args",
				"type": "string[]",
				"description": "Launch options from the dev command.",
				"examples": [
					[
						"--port",
						"5688",
						"--config",
						"/projects/harness/packages/reports/vite.config.ts",
						"--host",
						"127.0.0.1"
					]
				]
			},
			{
				"name": "previewArguments.env",
				"type": "NodeJS.ProcessEnv",
				"description": "Launch settings; only Harness, report storage and body-size settings affect identity.",
				"examples": [
					{
						"HARNESS_CONSOLE_DATA": "/tmp/harness-history"
					}
				]
			}
		],
		"outputs": [
			{
				"name": "previewArguments",
				"type": "PreviewArguments",
				"description": "Validated root, optional config, web port and checkout fingerprint.",
				"examples": [
					{
						"root": "/projects/harness/packages/reports",
						"port": 5688,
						"identity": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
					}
				]
			}
		],
		"errors": [
			{
				"name": "Error",
				"type": "thrown",
				"description": "Refuses unknown or missing options, invalid ports and addresses that would expose the preview remotely.",
				"examples": [
					"Harness previews bind to 127.0.0.1 only."
				]
			}
		]
	},
	"dependencies": [],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/utils/previewArguments.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/utils/previewArguments.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
