{
	"schemaVersion": 1,
	"id": "desktop.component.runtime-artifact",
	"kind": "component",
	"title": "Runtime artifact",
	"responsibility": "Presents recorded test result contents only after a verified read, keeping missing or unreadable evidence explicit.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.status-icon",
			"reports.component.entity-cases",
			"reports.component.shared-primitives-atoms-html-dd",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-dl",
			"reports.component.shared-primitives-atoms-html-dt",
			"reports.component.shared-primitives-atoms-html-h5",
			"reports.component.shared-primitives-atoms-html-li",
			"reports.component.shared-primitives-atoms-html-ol",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-pre",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.shared-primitives-atoms-html-ul"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/RuntimeArtifact.svelte",
			"packages/desktop/src/components/execution-runtimes/RuntimeArtifact.svelte"
		],
		"symbols": ["RuntimeArtifact", "RuntimeArtifact"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RuntimeArtifact.cell",
				"type": "BehaviorCell",
				"description": "Required result cell with capture and optional read. Missing capture means Not recorded; null media means bytes not stored. Only read.verified allows details."
			},
			{
				"name": "RuntimeArtifact.label",
				"type": "string",
				"description": "Required accessible name for the artifact group when a stored capture exists."
			},
			{
				"name": "RuntimeArtifact.lost",
				"type": "boolean",
				"description": "Whether reading failed instead of still pending. True makes absent reads unverified rather than loading."
			},
			{
				"name": "RuntimeArtifact.refusal",
				"type": "string",
				"description": "Optional backend refusal, preferred over the read problem and generic hash-check failure message."
			},
			{
				"name": "RuntimeArtifact.unit",
				"type": "string",
				"description": "Optional function identifier passed to case rendering, enabling callable rows scoped to that function."
			}
		],
		"outputs": [
			{
				"name": "RuntimeArtifact",
				"type": "markup",
				"description": "Verified cases plus expandable assertions, steps, traces and other facts. Unstated assertions remain unknown. Raw JSON renders only while expanded; non-JSON recorded text is shown. Each formatted text value is capped at 12,000 characters with a shortened marker. No capture, missing bytes, pending read and failed verification have distinct messages."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.status-icon",
			"via": "import",
			"origin": "derived"
		},
