	"id": "desktop.component.runtime-artifact",
	"uid": "u_nwynxsbstv",
	"kind": "component",
	"title": "Runtime artifact",
	"responsibility": "Presents recorded test result contents only after a verified read, keeping missing or unreadable evidence explicit.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.entity-cases",
			"reports.component.explorer-ui-explorer-kit-notice",
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h5",
			"reports.component.shared-primitives-atoms-html-li",
			"reports.component.shared-primitives-atoms-html-ol",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-pre",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.shared-primitives-atoms-html-ul",
			"reports.component.shared-primitives-detail-list"
		]
	},
	"owns": {
		"source": ["packages/desktop/src/components/execution-runtimes/RuntimeArtifact.svelte"],
		"symbols": [
			"RuntimeArtifact",
			"RuntimeArtifact.recorded",
			"RuntimeArtifact.label",
			"RuntimeArtifact.children"
		]
	},
	"contract": {
		"origin": "declared",
		"primitives": [
			"reports.component.explorer-ui-explorer-kit-notice",
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-detail-list"
		],
		"inputs": [
			{
				"name": "RuntimeArtifact.cell",
				"type": "BehaviorCell",
				"required": true,
				"description": "The recorded result for one side of a comparison: capture is the HarnessCapture that holds its bytes, null when nothing was recorded (shown as Not recorded), and read is the checked contents, undefined until it has been read. Its contents are shown only when read.verified is true, and a capture whose media is null shows Not stored instead.",
				"examples": [
					{
						"outcome": "passed",
						"capture": {
							"evidence": "run",
							"kind": "output",
							"state": "default",
							"status": "passed",
							"path": "slugify-run.json",
							"sha256": "5b9c0f1e7a3d2c48e6f1a0b9d7c3e5f2a1b8c4d6e9f0a3b7c2d5e8f1a4b6c9d2",
							"mediaType": "application/json",
							"capturedAt": "2026-11-14T18:02:37.512Z",
							"media": "media/5b9c0f1e7a3d2c48e6f1a0b9d7c3e5f2a1b8c4d6e9f0a3b7c2d5e8f1a4b6c9d2.json"
						},
						"read": {
							"verified": true,
							"problem": null,
							"text": "{\"scenario\":\"slugify\",\"output\":\"hello-world\"}",
							"document": {
								"scenario": "slugify",
								"output": "hello-world"
							},
							"behavior": {
								"scenario": "slugify",
								"environment": null,
								"fixture": null,
								"steps": [],
								"output": "hello-world",
								"assertions": [],
								"trace": [],
								"other": {}
							}
						}
					},
					{
						"outcome": "failed",
						"capture": {
							"evidence": "checks",
							"kind": "assertions",
							"state": "default",
							"status": "failed",
							"path": "slugify-checks.json",
							"sha256": "c41e7a92d03b5f68e1a4c7d9b2f05e83a6d1c4b97f2e0a58d3c6b1e9f47a2d05",
							"mediaType": "application/json",
							"capturedAt": "2026-11-14T18:02:41.087Z",
							"media": null
						},
						"read": {
							"verified": false,
							"problem": "The artifact is not stored.",
							"text": "",
							"document": null,
							"behavior": null
						}
					},
					{
						"outcome": "missing",
						"capture": null,
						"read": null
					}
				]
			},
			{
				"name": "RuntimeArtifact.label",
				"type": "string",
				"required": true,
				"description": "The accessible name (aria-label) of the group that wraps the artifact, which is rendered only when the cell has a capture whose media is not null. It is never shown as visible text.",
				"examples": ["output of default", "assertions of default", "trace of default"]
			},
			{
				"name": "RuntimeArtifact.lost",
				"type": "boolean",
				"required": true,
				"description": "Whether reading the cell failed (true) rather than still being in progress (false). It changes only a cell that has a capture with media and no read yet: true shows the Not verified notice instead of the Reading what it holds… placeholder.",
				"examples": [false, true]
			},
			{
				"name": "RuntimeArtifact.refusal",
				"type": "string",
				"required": false,
				"default": "undefined (omitted)",
				"description": "The backend's refusal message for this cell's bytes, shown first when the cell is not verified, before the read problem and the generic hash-check message. Defaults to JavaScript undefined (omitted), not the literal string.",
				"examples": [
					"The recorded file is too large for this page.",
					"The service sent a file of a kind this page does not show.",
					"This is not the recorded file that was asked for (SHA-256)."
				]
			},
			{
				"name": "RuntimeArtifact.unit",
				"type": "string",
				"required": false,
				"default": "undefined (omitted)",
				"description": "The unit id of the function this result is shown for, passed to EntityCases with callable set to true whenever it is defined, so that only that function's own calls become rows. Defaults to JavaScript undefined (omitted), not the literal string, which leaves callable false.",
				"examples": ["reports.function.entity-behavior", "reports.function.explorer-artifact"]
			}
		],
		"outputs": [
			{
				"name": "RuntimeArtifact",
				"type": "markup",
				"description": "The verified contents of one result: case rows when its document is an object that has a cases, output, outputs or response field, or that states no steps or assertions; a disclosure, titled Recorded output details for output captures and Assertions and recorded result otherwise, holds its steps, assertions, trace and other fields, and the recorded JSON sits in a nested disclosure (plain text when the bytes are not JSON). A cell with no capture, a capture whose media is null, a read still pending or an unverified read shows an explicit message instead, and an unverified read shows the backend refusal first, then the read problem, then the generic hash-check message."
			}
		],
		"errors": [],
		"errorStatus": "none-found",
		"operations": [],
		"initialization": [],
		"snippets": [
			{
				"name": "RuntimeArtifact.recorded",
				"inputs": [
					{
						"name": "RuntimeArtifact.recorded.stated",
						"type": "ExplorerArtifactBehavior",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "RuntimeArtifact.recorded",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			},
			{
				"name": "RuntimeArtifact.label",
				"inputs": [
					{
						"name": "RuntimeArtifact.label.[name]",
						"type": "[string, string]",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "RuntimeArtifact.label",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			},
			{
				"name": "RuntimeArtifact.children",
				"inputs": [
					{
						"name": "RuntimeArtifact.children.[, value]",
						"type": "[string, string]",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "RuntimeArtifact.children",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			}
		]
	},
