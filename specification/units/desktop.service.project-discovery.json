{
	"schemaVersion": 1,
	"id": "desktop.service.project-discovery",
	"kind": "service",
	"title": "Find account projects",
	"responsibility": "Lists owned and joined projects, avoids repeated snapshot reads, and removes revoked offline copies.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/lib/desktop-initialization/remote-http-project-adapter/ProjectDiscoveryService.ts",
			"packages/desktop/src/lib/development-tooling/desktop-initialization/remote-http-project-adapter/ProjectDiscoveryService.ts"
		],
		"symbols": [
			"ProjectDiscoveryService",
			"ProjectDiscoveryService",
			"ProjectDiscoveryService.constructor",
			"ProjectDiscoveryService.projects"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "account",
				"type": "HostedReadOptions",
				"description": "Native account, exact Hub origin, optional protected cache and access-change notifications."
			}
		],
		"outputs": [
			{
				"name": "projects",
				"type": "Promise<DesktopProject[]>",
				"description": "Projects authorized for this account. Offline discovery uses only a valid saved list for the same account.",
				"examples": [
					[
						{
							"id": "project-1",
							"name": "My project",
							"kind": "shared"
						}
					]
				]
			}
		],
		"errors": [
			{
				"name": "access changed",
				"type": "Error",
				"description": "An account change during discovery discards the answer."
			}
		]
	},
	"dependencies": [
		{
			"unit": "collaboration.model.collaboration-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.adapter.hosted-http",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.project-context-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.service.hosted-read",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.validator.remote-project-response",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/lib/development-tooling/desktop-initialization/remote-http-project-adapter/ProjectDiscoveryService.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/lib/development-tooling/desktop-initialization/remote-http-project-adapter/ProjectDiscoveryService.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
