{
	"schemaVersion": 1,
	"id": "reports.component.harness-explorer-content",
	"kind": "component",
	"title": "ExplorerContent",
	"responsibility": "Shows any address of the explorer for a host without a page for each screen: picks the one screen entry the address is and draws nothing of its own.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.explorer-dependencies-screen",
			"reports.component.explorer-ui-explorer-platforms",
			"reports.component.explorer-ui-explorer-translations-screen",
			"reports.component.explorer-ui-harness-explorer-styles-screen",
			"reports.component.harness-entity-behavior-screen",
			"reports.component.harness-entity-config-screen",
			"reports.component.harness-entity-details-screen",
			"reports.component.harness-entity-history-screen",
			"reports.component.harness-entity-visual-screen",
			"reports.component.harness-explorer-catalog-screen",
			"reports.component.harness-explorer-pages-screen",
			"reports.component.module-system-explorer-module-resources-screen",
			"reports.component.module-system-explorer-modules-screen",
			"reports.component.networking-security-explorer-permissions-screen",
			"reports.component.shared-primitives-atoms-html-div"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/ExplorerContent.svelte",
			"packages/reports/src/components/explorer-ui/ExplorerContent.types.ts"
		],
		"symbols": ["ExplorerContent", "Screen"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ExplorerContent.index",
				"type": "HarnessIndex",
				"required": true,
				"description": "Prepared history index for the selected repository and its recorded revisions."
			},
			{
				"name": "ExplorerContent.head",
				"type": "HarnessRevision",
				"required": true,
				"description": "Exact selected source revision supplying every displayed contract, measurement and capture."
			},
			{
				"name": "ExplorerContent.parent",
				"type": "HarnessRevision | null",
				"required": true,
				"description": "First parent of the selected commit, or null at a branch tip or first commit."
			},
			{
				"name": "ExplorerContent.scope",
				"type": "ExplorerScope",
				"required": true,
				"description": "Selected branch, commit and comparison scope shared by the explorer host."
			},
			{
				"name": "ExplorerContent.route",
				"type": "ExplorerLocation",
				"required": true,
				"description": "Current explorer location, including category, entity, section and tab."
			},
			{
				"name": "ExplorerContent.entities",
				"type": "ExplorerEntity[]",
				"required": true,
				"description": "Units projected from the selected revision, including entities removed by the shown commit."
			},
			{
				"name": "ExplorerContent.lens",
				"type": "EntityLens",
				"required": true,
				"description": "Host-provided readers for entity relationships, history and selected-revision details."
			},
			{
				"name": "ExplorerContent.client",
				"type": "Pick<HarnessClient, 'revision'>",
				"required": true,
				"description": "Revision reader used only for commits the displayed history requests."
			},
			{
				"name": "ExplorerContent.mediaBase",
				"type": "string",
				"required": true,
				"description": "Base URL for retained recorded evidence media."
			},
			{
				"name": "ExplorerContent.onroute",
				"type": "(to: ExplorerLocation) => void",
				"required": true,
				"description": "Receives the requested explorer destination for host-controlled navigation."
			}
		],
		"outputs": [
			{
				"name": "ExplorerContent.anyExplorerScreen",
				"type": "markup",
				"description": "The one screen the address is, for a host without a page for each screen."
			}
		],
		"errors": [
			{
				"name": "no-registry",
				"type": "stated",
				"description": "A revision that stores no unit registry says so; nothing of another revision is shown."
			},
			{
				"name": "entity-missing",
				"type": "stated",
				"description": "An entity the shown revision does not hold is said to be missing, with the way back to its collection."
			}
		],
		"operations": [],
		"initialization": []
	},
	"dependencies": [
