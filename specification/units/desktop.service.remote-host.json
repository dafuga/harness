	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RemoteHostService.constructor.options",
				"type": "RemoteHostOptions",
				"required": true,
				"description": "The dependencies the service is built from: the record store, the register function, the socket opener, the shared device-session options, and the optional name, link-tuning and locked-screen options. The constructor reads store, register and shared.registry at once; the other fields are read when the host runs or reports its status."
			},
			{
				"name": "RemoteHostService.onStatus.listener",
				"type": "(status: RemoteHostStatus) => void",
				"required": true,
				"description": "The function called with each published RemoteHostStatus. It is kept in a Set, so adding the same function twice still gives one listener."
			},
			{
				"name": "RemoteHostService.screen.locked",
				"type": "boolean",
				"required": true,
				"description": "Whether the screen is locked (true) or unlocked (false). It is sent to connected phones as the host connection state and changes nothing else; with no running host, nothing is sent.",
				"examples": [true, false]
			}
		],
		"outputs": [
			{
				"name": "RemoteHostService.enabled",
				"type": "boolean",
				"description": "Whether remote access is on according to the stored record: true only when the record exists and its enabled flag is true. It reads only the record, so it can be true while no runtime is running.",
				"examples": [true, false]
			},
			{
				"name": "RemoteHostService.name",
				"type": "string",
				"description": "The name of this computer shown in the host status and given to the runtime: the result of the name option, or the operating system hostname when no option is given. It is read on every call, so a changed option shows from the next call.",
				"examples": ["studio-mac.local", "build-box"]
			},
			{
				"name": "RemoteHostService.onStatus",
				"type": "()",
				"description": "The unsubscribe function returned by onStatus. Calling it removes that listener, so it gets no further statuses."
			},
			{
				"name": "RemoteHostService.start",
				"type": "Promise<void>",
				"description": "Resolves when the launch step through the switch has finished. At launch an enabled host goes back online from the stored record, and nothing is registered."
			},
