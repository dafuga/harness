	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "moduleResourceLocation.scope",
				"type": "Pick<ExplorerLocation, 'branch' | 'commit'>",
				"description": "Selected branch and commit; unrelated entity context is discarded."
			},
			{
				"name": "moduleResourceLocation.module",
				"type": "string",
				"description": "Identity of the module declaring this resource."
			},
			{
				"name": "moduleResourceLocation.resource",
				"type": "ModuleResource",
				"description": "Resource declaration with an optional existing catalog destination."
			}
		],
		"outputs": [
			{
				"name": "moduleResourceLocation",
				"type": "ExplorerLocation",
				"description": "A fresh catalog or module-resource location in the supplied branch and commit."
			}
		],
		"errors": [
			{
				"name": "TypeError",
				"type": "thrown",
				"description": "A nullish scope or resource throws TypeError; errors raised by a catalog accessor propagate unchanged."
			}
		]
	},
