{
	"schemaVersion": 1,
	"id": "service.regression-proof",
	"uid": "u_5n3y7cwxsh",
	"kind": "service",
	"title": "Run a committed regression",
	"responsibility": "Run committed regressions in isolated snapshots. Retain decoded screenshots for their declared units before cleanup and bind actual captures to the exact served revision.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/workflows/verification-evidence/record-regression/RegressionProofService.ts",
			"src/workflows/verification-evidence/record-regression/RegressionProofService.types.ts",
			"src/workflows/verification-evidence/record-regression/focusedScreens.ts"
		],
		"symbols": [
			"RegressionProofService",
			"RegressionProofService.constructor",
			"RegressionProofService.run",
			"environmentProfile",
			"RegressionRun",
			"RegressionRun",
			"Observation",
			"focusedScreens"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RegressionProofService.constructor.root",
				"type": "string",
				"required": true,
				"description": "The repository root that run() snapshots the input commit from, reads scenario manifests from and saves regression records into. The constructor stores it without checking, so an invalid root is only detected when run() first reads from it.",
				"examples": ["/workspace/project/checkouts/app", "/workspace/project/src/app"]
			},
			{
				"name": "RegressionProofService.run.input",
				"type": "RegressionRun",
				"required": true,
				"description": "The regression to run: the commit to snapshot, its loop and phase ('red', 'green' or 'capture'), the tests and units it covers, the shell command with its assertion text (which a red run's output must contain), and the timeoutMs limit. The optional knownUnits are the registered units that actual captures must resolve to, and the optional red record is the earlier red record whose environment profile this run must match.",
				"examples": [
					{
						"commit": "a37d0c9e5b218f4d6e0a7c3b91f25d8e4c60b7a2",
						"loop": "evidence-grid-review",
						"phase": "red",
						"tests": ["tests/e2e/evidence-grid.spec.ts"],
						"units": ["reports.component.evidence-grid"],
						"command": "bun x playwright test tests/e2e/evidence-grid.spec.ts",
						"assertion": "evidence grid shows the populated state",
						"timeoutMs": 600000
					},
					{
						"commit": "5c0e8a7d2f41b96e3a0d8c17f4b2e9a6d1c35f80",
						"loop": "evidence-grid-review",
						"phase": "capture",
						"tests": ["tests/e2e/evidence-grid.spec.ts"],
						"units": ["reports.component.evidence-grid"],
						"knownUnits": ["reports.component.evidence-grid"],
						"command": "bun x playwright test tests/e2e/evidence-grid.spec.ts",
						"assertion": "evidence grid shows the populated state",
						"timeoutMs": 600000
					}
				]
			},
			{
				"name": "environmentProfile.source",
				"type": "Record<string, string | undefined>",
				"required": false,
				"description": "Defaults to process.env: the variables fingerprinted into the environment profile. Variables named PWD, OLDPWD, _, SHLVL, XPC_SERVICE_NAME, HARNESS_AGENT_ID, HARNESS_VERIFY_REVISION, HARNESS_VERIFY_TREE, HARNESS_EVIDENCE_DIR or SCREENSHOT_LABEL are dropped, and the rest are hashed as canonical JSON with sorted keys.",
				"examples": [
					{
						"CI": "true",
						"NODE_ENV": "test",
						"TZ": "UTC"
					},
					{
						"LANG": "en_US.UTF-8",
						"HOME": "/workspace/home",
						"TERM": "xterm-256color"
					}
				]
			},
			{
				"name": "focusedScreens.gathered",
				"type": "Gathered[]",
				"required": true,
				"description": "The captures that one focused run inspected: each entry pairs a CaptureLine from captures.ndjson with its recorded Capture and, for screenshots and audio, its decoded MediaFacts. Only screenshot entries are retained, and each must decode to an image and, when it is an actual capture, have a server revision equal to context.commit.",
				"examples": [
					[
						{
							"line": {
								"evidence": "reports.component.evidence-grid",
								"kind": "screenshot",
								"state": "populated",
								"viewport": "desktop",
								"file": "evidence-grid-desktop.png",
								"mediaType": "image/png",
								"provenance": "actual-capture",
								"server": {
									"buildId": "8a4d2f7c1e96b03d5a2f8c4e7b1d90a3f6e2c85b4d7a1f09e3c6b28d5a7f41e0",
									"revision": "5c0e8a7d2f41b96e3a0d8c17f4b2e9a6d1c35f80"
								}
							},
							"capture": {
								"evidence": "reports.component.evidence-grid",
								"kind": "screenshot",
								"state": "populated",
								"viewport": "desktop",
								"status": "passed",
								"path": "focused/evidence-grid-desktop.png",
								"sha256": "2d8f6c1a9b07e54dc3a1f6280e97bd4ca5f3816e7b20c9d4e6a13f081c9d5b72",
								"bytes": 48213,
								"mediaType": "image/png",
								"capturedAt": "2026-11-14T18:42:07.311Z",
								"provenance": "actual-capture",
								"server": {
									"buildId": "8a4d2f7c1e96b03d5a2f8c4e7b1d90a3f6e2c85b4d7a1f09e3c6b28d5a7f41e0",
									"revision": "5c0e8a7d2f41b96e3a0d8c17f4b2e9a6d1c35f80"
								}
							},
							"facts": {
								"kind": "image",
								"width": 1280,
								"height": 800
							}
						}
					],
					[]
				]
			},
			{
				"name": "focusedScreens.directory",
				"type": "string",
				"required": true,
				"description": "The evidence directory the run wrote, which run() creates as a temporary directory and passes as HARNESS_EVIDENCE_DIR. Each retained screenshot's bytes are read from it by the file name in its CaptureLine, and a file missing there makes that read throw.",
				"examples": [
					"/workspace/tmp/harness-regression-d3Wv9A",
					"/workspace/tmp/harness-regression-Q8sK2d"
				]
			},
			{
				"name": "focusedScreens.context",
				"type": "{ commit: string; scenarios: ScenarioManifest[]; knownUnits?: string[] }",
				"required": true,
				"description": "The tested commit, the scenario manifests that resolve each screenshot's evidence, state and viewport to units, and the optional knownUnits. For an actual capture the server revision must be this commit and, when knownUnits is given, every resolved unit must be listed in it.",
				"examples": [
					{
						"commit": "5c0e8a7d2f41b96e3a0d8c17f4b2e9a6d1c35f80",
						"scenarios": [
							{
								"schemaVersion": 1,
								"id": "reports.evidence-grid",
								"title": "Evidence grid in the reports view",
								"kind": "ui",
								"units": ["reports.component.evidence-grid"],
								"states": [
									{
										"id": "populated",
										"title": "Grid with recorded captures",
										"coverage": "required"
									}
								],
								"viewports": [
									{
										"id": "desktop",
										"width": 1280,
										"height": 800
									}
								],
								"tests": [
									{
										"id": "reports.evidence-grid.e2e",
										"kind": "e2e",
										"runner": "playwright",
										"target": "tests/e2e/evidence-grid.spec.ts"
									}
								],
								"evidence": [
									{
										"id": "reports.component.evidence-grid",
										"kind": "screenshot",
										"states": ["populated"],
										"viewports": ["desktop"],
										"provenance": "actual-capture",
										"capture": "viewport",
										"required": true
									}
								]
							}
						],
						"knownUnits": ["reports.component.evidence-grid"]
					}
				]
			}
		],
