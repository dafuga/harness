{
	"schemaVersion": 1,
	"id": "desktop.service.native-account-status",
	"kind": "service",
	"title": "Check device sign-in",
	"responsibility": "Rechecks the saved Google identity and clears revoked access while preserving login during temporary outages.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["packages/desktop/src/services/NativeAccountStatusService.ts"],
		"symbols": [
			"NativeAccountStatusService",
			"NativeAccountStatusService.constructor",
			"NativeAccountStatusService.read"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "credential",
				"type": "NativeHostedCredential",
				"description": "Credential read from the native encrypted store; it never enters renderer status."
			}
		],
		"outputs": [
			{
				"name": "status",
				"type": "Promise<NativeHostedStatus>",
				"description": "Verified signed-in identity, or signed-out after revocation or an identity mismatch.",
				"examples": [
					{
						"configured": true,
						"state": "signed-out"
					}
				]
			}
		],
		"errors": [
			{
				"name": "temporary failure",
				"type": "HostedFailureValidator",
				"description": "Network or service failure preserves the saved credential and reports failure."
			}
		]
	},
	"dependencies": [
		{
			"unit": "desktop.adapter.hosted-http",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.adapter.native-session",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.project-context-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.validator.hosted-failure",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.validator.remote-project-response",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/services/NativeAccountStatusService.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/services/NativeAccountStatusService.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
