			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/EntityAudio.svelte",
			"packages/reports/src/components/explorer-ui/EntityAudio.types.ts"
		],
		"symbols": ["EntityAudio", "Pair"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityAudio.evidence",
				"type": "ExplorerEvidence",
				"description": "Required explorer evidence from which audio gallery items are selected and grouped by comparison identity. Commit mode creates paired panes; after falls back to current."
			},
			{
				"name": "EntityAudio.scope",
				"type": "ExplorerScope",
				"description": "Required selected commit and parent information used in pane labels."
			},
			{
				"name": "EntityAudio.mediaBase",
				"type": "string",
				"description": "Required asset prefix passed to each audio card."
			},
			{
				"name": "EntityAudio.empty",
				"type": "boolean",
				"description": "Optional flag, false by default; when no clips exist, show an explicit empty state instead of rendering nothing."
			}
		],
		"outputs": [
			{
				"name": "EntityAudio",
				"type": "markup",
				"description": "Audio section that pairs before/after clips in commit mode and shows one current-side card otherwise. Missing sides within a pair are explicit gaps. Cards supply playback, transcript and provenance. No clips renders nothing unless empty is true, when it states that no audio was recorded at this revision."
			}
		],
		"errors": []
	},
