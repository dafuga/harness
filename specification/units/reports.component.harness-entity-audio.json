{
	"schemaVersion": 1,
	"id": "reports.component.harness-entity-audio",
	"kind": "component",
	"title": "Entity audio",
	"responsibility": "Presents matching recorded audio before and after a commit or at the current tip.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.audio-evidence",
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-header",
