{
	"schemaVersion": 1,
	"id": "desktop.component.icon",
	"kind": "component",
	"title": "Entity icon",
	"responsibility": "Draws a small decorative icon for a category or action.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
		"uses": [
			"reports.component.shared-primitives-atoms-svg-path",
			"reports.component.shared-primitives-atoms-svg-svg"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/Icon.svelte",
			"packages/desktop/src/components/shared-primitives/Icon.svelte"
		],
		"symbols": ["Icon", "Icon"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "Icon.name",
				"type": "string",
				"description": "Which icon to draw. An unrecognized name uses the page icon."
			},
			{
				"name": "Icon.size",
				"type": "number",
				"description": "The icon’s width and height in pixels; 22 when no size is supplied."
			}
		],
		"outputs": [
			{
				"name": "Icon",
				"type": "markup",
				"description": "A line icon hidden from screen readers. The surrounding control supplies its accessible name."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.component.shared-primitives-atoms-svg-path",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-svg-svg",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/shared-primitives/Icon.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/shared-primitives/Icon.svelte"
			}
		]
	},
	"scenarios": ["desktop-native", "desktop-renderer", "shells-shared-app"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
