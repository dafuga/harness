	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "adoptUids.registry",
				"type": "Registry",
				"required": true,
				"description": "The registry to reconcile: byId holds the stored units and owners maps each source path of an active unit to its unit id. adoptUids updates owners and appends to result.moved on this same object, and it matches only active units that have a uid."
			},
			{
				"name": "adoptUids.index",
				"type": "SourceIndex",
				"required": true,
				"description": "The source index of one revision, keyed by repository-relative path with ignored files absent. Only files classified as source whose announced uid matches an active registered unit are adopted, and a unit's vanished paths are the ones absent from this index."
			},
			{
				"name": "mergedByUid.all",
				"type": "Group[]",
				"required": true,
				"description": "The groups of source files derived from their paths, each with its files. mergedByUid sorts this array in place by id and sets each group's uid from the first of its files that announces one, so the caller's array and group objects change.",
