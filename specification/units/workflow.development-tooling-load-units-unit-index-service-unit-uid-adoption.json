	"uid": "u_ivdxmstz3m",
	"kind": "workflow",
	"title": "unitUidAdoption",
	"responsibility": "Joins source files to registered units by the uid they announce, so a moved or renamed file keeps its unit.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/workflows/development-tooling/load-units/unit-index-service/unitUidAdoption.ts"
