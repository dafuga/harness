{
	"schemaVersion": 1,
	"id": "desktop.component.thread-history",
	"kind": "component",
	"title": "Thread history",
	"responsibility": "Shows entity events and lets a person choose a plan or design version.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.image-thumbnail",
			"reports.component.shared-primitives-atoms-html-article",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-atoms-html-summary"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/ThreadHistory.svelte",
			"packages/desktop/src/components/git-source-history/ThreadHistory.svelte"
		],
		"symbols": ["ThreadHistory", "ThreadHistory"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ThreadHistory.entity",
				"type": "EntityDetail",
				"description": "Entity history, versions, category, identifier and title. Functions show plan versions without image requests; other categories may show each version’s first relevant image."
			},
			{
				"name": "ThreadHistory.workspace",
				"type": "Workspace",
				"description": "Workspace supplied to version thumbnails for image retrieval."
			},
			{
				"name": "ThreadHistory.version",
				"type": "string",
				"description": "Required current version for highlighting and choosing its currently viewed option thumbnail."
			},
			{
				"name": "ThreadHistory.option",
				"type": "string",
				"description": "Optional current-version option, empty by default. Other versions use their approved or first option through the helper."
			},
			{
				"name": "ThreadHistory.select",
				"type": "(version: string) => void",
				"description": "Required callback receiving the clicked version. Does not itself mutate the version prop."
			}
		],
		"outputs": [
			{
				"name": "ThreadHistory",
				"type": "markup",
				"description": "Expandable event history with titles, raw recorded timestamps and details, plus a selectable version strip. Empty history is explicit. Versions show thumbnails where applicable and Plan/Design or approval labels. An approval tied to a known option names that option."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.image-thumbnail",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.thread-anchor",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.workspace",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-article",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-button",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-details",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-p",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-small",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-strong",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-summary",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/git-source-history/ThreadHistory.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/git-source-history/ThreadHistory.svelte"
			}
		]
	},
	"scenarios": ["desktop-native", "desktop-renderer"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
