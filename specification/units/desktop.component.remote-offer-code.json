{
	"schemaVersion": 1,
	"id": "desktop.component.remote-offer-code",
	"kind": "component",
	"title": "Remote offer code",
	"responsibility": "Displays a live pairing offer as a QR code and allows replacing or hiding it.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-svg-path",
			"reports.component.shared-primitives-atoms-svg-rect",
			"reports.component.shared-primitives-atoms-svg-svg"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/networking-security/remote-offer-code/RemoteOfferCode.svelte",
			"packages/desktop/src/components/remote-offer-code/RemoteOfferCode.svelte"
		],
		"symbols": ["RemoteOfferCode", "RemoteOfferCode"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RemoteOfferCode.offer",
				"type": "RemotePairingOffer",
				"description": "Required scan content and expiration. QR is drawn only while parsed expiration is in the future; scan content is not printed as text."
			},
			{
				"name": "RemoteOfferCode.store",
				"type": "RemoteHost",
				"description": "Host store providing busy state and createPairing/closePairing for New code/Hide code. Busy disables these actions."
			}
		],
		"outputs": [
			{
				"name": "RemoteOfferCode",
				"type": "markup",
				"description": "QR with instructions and countdown while live and drawable. Checks expiry every second and clears the timer on cleanup. Invalid/expired timestamps show expired; QR failures show cannot-show guidance. New code is always offered, Hide code only when a symbol is displayed."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.function.qr-symbol",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.remote-labels",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.environment-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.remote-host",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-button",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-small",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-span",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-svg-path",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-svg-rect",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-svg-svg",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/networking-security/remote-offer-code/RemoteOfferCode.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/networking-security/remote-offer-code/RemoteOfferCode.svelte"
			}
		]
	},
	"scenarios": ["remote-mobile-ui"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
