{
	"schemaVersion": 1,
	"id": "reports.endpoint.api-report-audio-comparison",
	"kind": "endpoint",
	"title": "/api/report-audio-comparison",
	"responsibility": "Accepts same-origin paired audio uploads and returns complete success or error responses.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["packages/reports/src/routes/api/report-audio-comparison/+server.ts"],
		"symbols": ["POST"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "Origin",
				"type": "string",
				"description": "Must equal the request URL origin."
			},
			{
				"name": "Content-Type",
				"type": "string",
				"description": "Must identify multipart form data."
			},
			{
				"name": "Content-Length",
				"type": "string | undefined",
				"description": "Requests over 101,000,000 bytes are refused before parsing."
			},
			{
				"name": "reportId",
				"type": "string",
				"description": "Report identity passed to the upload service; missing values become an empty string."
			},
			{
				"name": "title",
				"type": "string",
				"description": "Comparison title passed to the upload service."
			},
			{
				"name": "note",
				"type": "string",
				"description": "Optional note passed to the upload service; missing values become an empty string."
			},
			{
				"name": "source",
				"type": "string",
				"description": "Optional source passed to the upload service; missing values become an empty string."
			},
			{
				"name": "before",
				"type": "File",
				"description": "Required before audio file passed unchanged to the upload service."
			},
			{
				"name": "after",
				"type": "File",
				"description": "Required after audio file passed unchanged to the upload service."
			}
		],
		"outputs": [
			{
				"name": "POST",
				"type": "Promise<Response>",
				"description": "JSON report with status 201 and no-store after success, or an error JSON object with the relevant status."
			}
		],
		"errors": [
			{
				"name": "same-origin",
				"type": "HTTP 403",
				"description": "Missing or mismatched Origin is refused."
			},
			{
				"name": "multipart",
				"type": "HTTP 415",
				"description": "A non-multipart content type is refused."
			},
			{
				"name": "oversized",
				"type": "HTTP 413",
				"description": "A declared length over 101,000,000 bytes is refused."
			},
			{
				"name": "missing-file",
				"type": "HTTP 400",
				"description": "Both before and after must be files."
			},
			{
				"name": "finalized",
				"type": "HTTP 409",
				"description": "A finalized report error is returned."
			},
			{
				"name": "missing-report",
				"type": "HTTP 404",
				"description": "A missing report is reported without its internal message."
			},
			{
				"name": "invalid-audio",
				"type": "HTTP 400",
				"description": "Audio, format, WAV, title and size validation errors are returned."
			},
			{
				"name": "storage-failure",
				"type": "HTTP 500",
				"description": "Other service or form parsing failures return a generic error."
			}
		]
	},
	"dependencies": [
		{
			"unit": "reports.function.report-http",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.service.audio-upload",
