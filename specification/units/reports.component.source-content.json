{
	"schemaVersion": 1,
	"id": "reports.component.source-content",
	"kind": "component",
	"title": "SourceContent",
	"responsibility": "Connects source loading and cancellation to the shared source viewer.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": ["reports.component.source-viewer"]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/SourceContent.svelte",
			"packages/reports/src/components/explorer-ui/SourceContent.svelte"
		],
		"symbols": ["SourceContent", "SourceContent"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "SourceContent.files",
				"type": "SourceFiles",
				"description": "Async listing restricted to the selected entity and revision."
			},
			{
				"name": "SourceContent.read",
				"type": "SourceRead",
				"description": "Async reader for one recorded path at the same revision."
			},
			{
				"name": "SourceContent.commit",
				"type": "string",
				"description": "Exact revision associated with the contents."
			},
			{
				"name": "SourceContent.empty",
				"type": "string",
				"description": "Optional no-files explanation."
			}
		],
		"outputs": [
			{
				"name": "SourceContent",
				"type": "markup",
				"description": "Shows files, code and revision; changed callbacks start a new session. Unmounting cancels pending replies."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.component.source-viewer",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.store.source-reader",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/components/explorer-ui/SourceContent.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/components/explorer-ui/SourceContent.svelte"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
