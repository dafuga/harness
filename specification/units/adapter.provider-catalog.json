			"ProviderCatalogAdapter",
			"ProviderCatalogAdapter",
			"ProviderCatalogAdapter.constructor",
			"ProviderCatalogAdapter.list"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ProviderCatalogAdapter.constructor.paths",
				"type": "{ openai: string; claude: string }",
				"description": "Paths to the local OpenAI and Claude model catalog files."
			}
		],
		"outputs": [
			{
				"name": "ProviderCatalogAdapter.list",
				"type": "Promise<PickerModel[]>",
