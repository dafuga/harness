{
	"schemaVersion": 1,
	"id": "adapter.provider-catalog",
	"kind": "adapter",
	"title": "ProviderCatalogAdapter",
	"responsibility": "Reads local provider model catalogs independently, omitting hidden models and invalid catalogs.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/adapters/ProviderCatalogAdapter.ts",
			"src/adapters/agents-providers/ProviderCatalogAdapter.ts"
