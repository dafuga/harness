		"targets": [
			{
				"kind": "module",
				"entry": "src/adapters/agents-providers/ProviderCatalogAdapter.ts"
			}
		]
	},
	"scenarios": [],
	"testing": {
		"version": 1,
		"shape": "service",
		"states": ["initialized"],
		"cases": [
			{
				"id": "list.initialized",
				"state": "initialized",
				"subject": "ProviderCatalogAdapter.list",
				"test": {
					"file": "test/adapters/provider-catalog.test.ts",
					"title": "discovers each provider independently, omits hidden models and leaves missing catalogs empty"
				},
				"expected": {
