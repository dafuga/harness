{
	"schemaVersion": 1,
	"id": "desktop.service.desktop-run",
	"kind": "service",
	"title": "DesktopRunService",
	"responsibility": "Runs desktop agent work and prepares unapproved, reference-bound feature plans for the selected local project.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/services/agents-providers/desktop-run-service/DesktopRunService.ts",
			"packages/desktop/src/services/agents-providers/desktop-run-service/DesktopRunService.types.ts",
			"packages/desktop/src/services/desktop-run-service/DesktopRunService.ts"
		],
		"symbols": [
			"DesktopRunService",
			"DesktopRunService.constructor",
			"DesktopRunService.start",
			"DesktopRunService.prepareFeaturePlan",
			"DesktopRunService.cancelActive",
			"DesktopRunService.cancel",
			"Prepared",
			"DesktopRunService"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "DesktopRunService.constructor.session",
				"type": "ProjectSessionService"
			},
			{
				"name": "DesktopRunService.constructor.providers",
				"type": "ProviderDiscoveryService"
			},
			{
				"name": "DesktopRunService.constructor.generator",
				"type": "ImageGenerator"
			},
			{
				"name": "DesktopRunService.constructor.emit",
				"type": "(event: RunEvent) => void"
			},
			{
				"name": "DesktopRunService.start.request",
				"type": "RunRequest | ProjectRunRequest | ProjectTaskRequest"
			},
			{
				"name": "DesktopRunService.cancel.runId",
				"type": "string"
			},
			{
				"name": "DesktopRunService.prepareFeaturePlan.input",
				"type": "FeaturePlanPreparationRequest",
				"description": "Exact selected project and writable source revision; proposal goal/TLDR, module contracts and tasks; original request; each affected page reference and optional edit region; cancellation is owned by the service."
			}
		],
		"outputs": [
			{
				"name": "DesktopRunService.start",
				"type": "Promise<{ runId: string }>"
			},
			{
				"name": "DesktopRunService.cancelActive",
				"type": "void"
			},
			{
				"name": "DesktopRunService.cancel",
				"type": "boolean"
			},
			{
				"name": "DesktopRunService.prepareFeaturePlan",
				"type": "Promise<FeaturePlan>",
				"description": "Claims the local project operation and repository lease, verifies committed metadata and exact design references, generates three choices per affected page, commits their exact image paths and returns an unapproved plan draft. It never starts workers."
			}
		],
		"errors": [
			{
				"name": "Unavailable or busy project",
				"type": "Error",
				"description": "Rejects absent, stale, foreign or read-only local project context, or another active Harness operation before draft publication."
			},
			{
				"name": "Preparation failure",
				"type": "Error or preserved abort",
				"description": "Rejects source or metadata mismatch, missing references, failed image generation, commit conflicts or cancellation; releases the project lease and busy state."
			}
		]
	},
	"dependencies": [
		{
			"unit": "desktop.function.design-count",
