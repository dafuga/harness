	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/services/agents-providers/desktop-run-service/DesktopRunService.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/services/agents-providers/desktop-run-service/DesktopRunService.ts"
			}
		]
	},
	"scenarios": [
		"desktop-native",
		"desktop-project-runs",
		"remote-desktop-boundaries",
		"agent-creation",
		"plan-fixture-contracts"
	],
	"testing": {
		"version": 1,
		"shape": "service",
		"states": ["operation"],
		"cases": [
			{
				"id": "start-plan-run",
				"state": "operation",
				"subject": "DesktopRunService.start",
				"call": "start(request)",
				"input": "A committed plan request with an approved contract and valid project context.",
				"test": {
					"file": "packages/desktop/test/run-integration.test.ts",
					"title": "Plan uses read-only CLI and saves a committed immutable version without claiming verification"
				},
				"expected": {
					"kind": "value",
					"value": {
						"runId": "created"
					}
				}
			},
			{
				"id": "prepare-plan-guards",
				"state": "operation",
				"subject": "DesktopRunService.prepareFeaturePlan",
				"call": "prepareFeaturePlan(input)",
				"input": "A scoped preparation request for a selected project.",
				"test": {
					"file": "packages/desktop/test/services/agents-providers/desktop-run-feature-plan.test.ts",
					"title": "prepareFeaturePlan enforces project and revision guards while releasing its lease"
				},
				"expected": {
					"kind": "error",
					"value": "A project operation is already active"
				},
				"errors": ["Unavailable or busy project", "Preparation failure"]
			},
			{
				"id": "cancel-active-run",
				"state": "operation",
				"subject": "DesktopRunService.cancelActive",
				"call": "cancelActive()",
				"input": "A currently active run with an AbortController.",
				"test": {
					"file": "packages/desktop/test/services/agents-providers/desktop-run-feature-plan.test.ts",
					"title": "cancelActive aborts the currently active desktop run"
				},
				"expected": {
					"kind": "void"
				}
			},
			{
				"id": "cancel-matching-run",
				"state": "operation",
				"subject": "DesktopRunService.cancel",
				"call": "cancel(runId)",
				"input": "A run ID that may or may not match the active run.",
				"test": {
					"file": "packages/desktop/test/services/agents-providers/desktop-run-feature-plan.test.ts",
					"title": "cancel aborts only the matching desktop run ID"
				},
				"expected": {
					"kind": "value",
					"value": {
						"matching": true,
						"foreign": false
					}
				}
			}
		]
	},
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
