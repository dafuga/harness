	"kind": "entry",
	"title": "commandLoaders",
	"responsibility": "Maps canonical top-level command names to lazy loaders that import and register only the selected command family.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["src/cli/commandLoaders.ts"],
		"symbols": ["commandLoaders"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [],
		"outputs": [
			{
				"name": "commandLoaders",
				"type": "typeof commandLoaders",
				"description": "An object that maps canonical command names to async loaders used to attach the matching command family to a Commander program. Each loader imports and registers only its selected family when called, and resolves without a value."
			}
		],
		"errors": [
			{
				"name": "Command family loading failure",
				"type": "thrown",
				"description": "A loader rejects if its selected dynamic import fails or if the imported module's registration call throws; the implementation does not catch or replace either failure."
			}
		],
		"errorStatus": "declared",
		"operations": [],
		"initialization": []
	},
