{
	"schemaVersion": 1,
	"id": "desktop.component.remote-host-panel",
	"kind": "component",
	"title": "Remote host panel",
	"responsibility": "Manages computer-side phone access, pairing offers, pending approvals and approved devices.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.remote-approval",
			"desktop.component.remote-devices",
			"desktop.component.remote-offer-code",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/networking-security/remote-host-panel/RemoteHostPanel.svelte",
			"packages/desktop/src/components/remote-host-panel/RemoteHostPanel.svelte"
		],
		"symbols": ["RemoteHostPanel", "RemoteHostPanel"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RemoteHostPanel.store",
				"type": "RemoteHost",
				"description": "Host store with status, busy/errors and access/pairing operations. Missing status renders nothing; unsupported or disabled status shows its explanation."
			},
			{
				"name": "RemoteHostPanel.compact",
				"type": "boolean",
				"description": "Optional flag, false by default. True initially shows only summary and Manage; opening reveals controls in a sheet. False displays controls directly."
			}
		],
		"outputs": [
			{
				"name": "RemoteHostPanel",
				"type": "markup",
				"description": "Access panel with enable/disable actions, status, an unspent pairing code, pending requests and approved devices. An offer already represented by a request is not shown as scannable. Pair a phone appears without a scannable offer and requires online/not busy. Store errors appear only inside the expanded body."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.remote-approval",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.remote-devices",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.remote-offer-code",
