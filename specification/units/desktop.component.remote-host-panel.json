	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RemoteHostPanel.store",
				"type": "RemoteHost",
				"required": true,
				"description": "The RemoteHost instance supplies the status, busy flag, error text, and actions used by this panel. If status is absent the component renders nothing; otherwise status determines which controls and explanations appear."
			},
			{
				"name": "RemoteHostPanel.compact",
				"type": "boolean",
				"required": false,
				"default": false,
				"description": "Controls whether the panel is compact, and defaults to false. When true it initially shows the summary and Manage button, revealing its body only while open.",
				"examples": [false, true]
			}
		],
		"outputs": [
			{
				"name": "RemoteHostPanel",
				"type": "markup",
				"description": "Renders no markup until the store has a status; then shows phone-access summary or controls based on compact, support, enabled, pairing, request, and device state. In compact mode the body and store error are visible only while open, and an offer already represented by a request is not shown as scannable."
			}
		],
