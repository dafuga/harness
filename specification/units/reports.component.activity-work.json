{
	"schemaVersion": 1,
	"id": "reports.component.activity-work",
	"kind": "component",
	"title": "Activity work",
	"responsibility": "Shows recent committed work and its recorded component reasons.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.activity-list",
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.shared-primitives-atoms-html-time"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/ActivityWork.svelte",
			"packages/reports/src/components/projects-sessions/ActivityWork.svelte"
		],
		"symbols": ["ActivityWork", "ActivityWork"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ActivityWork.work",
				"type": "WorkItem[]",
				"description": "Required ordered commit summaries with branches, time, file/unit/reason counts and sampled unit/reason details. Full unit count falls back to listed length for its displayed count."
			},
			{
				"name": "ActivityWork.href",
				"type": "(commit: string) => string",
				"description": "Required callback producing each commit-page address."
			},
			{
				"name": "ActivityWork.recorded",
				"type": "boolean",
				"description": "Optional flag, false by default. True labels reasons as recorded on the commit or accepted by its records; false says recorded on the commit."
			}
		],
		"outputs": [
			{
				"name": "ActivityWork",
				"type": "markup",
				"description": "Recent-work list with five commits initially, expansion control and per-commit details. Shows branches or on no branch, counts, reasons and notices when additional details live on the commit page. No reasons and no commits are stated explicitly."
			}
		],
		"errors": []
	},
