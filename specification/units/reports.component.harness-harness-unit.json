			},
			{
				"name": "HarnessUnit.removed",
				"type": "boolean",
				"description": "Optional removed-unit label, defaulting to false. The caller must supply the appropriate historical unit and evidence."
			},
			{
				"name": "HarnessUnit.onselect",
				"type": "(id: string) => void",
				"description": "Required callback receiving a dependency or consumer identifier when selected."
			}
		],
		"outputs": [
			{
				"name": "HarnessUnit",
				"type": "markup",
				"description": "Ownership and interface details; dependencies and consumers; runtime, source, emitted-size and performance budgets; unprofiled measurements for this unit; and scenario requirements, exemptions, viewports, tests and recorded outcomes. Scenarios without a selected record remain not tested."
			}
