	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "toKebabCase.textToConvert",
				"type": "string",
				"description": "Text to split at lowercase-or-digit to uppercase transitions and non-alphanumeric separators.",
				"examples": ["Hello world"]
			},
			{
				"name": "toPascalCase.textToConvert",
				"type": "string",
				"description": "Text to split into normalized lowercase words before capitalizing each word.",
				"examples": ["Hello world"]
			},
			{
				"name": "toCamelCase.textToConvert",
				"type": "string",
				"description": "Text to split into words before building Pascal case and lowering its first character.",
				"examples": ["Hello world"]
			},
			{
				"name": "toSnakeCase.textToConvert",
				"type": "string",
				"description": "Text to split at case transitions and non-alphanumeric separators.",
				"examples": ["Hello world"]
			}
		],
		"outputs": [
			{
				"name": "toKebabCase.kebabCaseText",
				"type": "string",
				"description": "Lowercase words joined by hyphens; empty or separator-only input becomes an empty string.",
				"examples": ["hello-world"]
			},
			{
				"name": "toPascalCase.pascalCaseText",
				"type": "string",
				"description": "Words joined with each first letter capitalized; empty input becomes an empty string.",
				"examples": ["HelloWorld"]
			},
			{
				"name": "toCamelCase.camelCaseText",
				"type": "string",
				"description": "Joined words with a lowercase first character and capitalized later word initials.",
				"examples": ["helloWorld"]
			},
			{
				"name": "toSnakeCase.snakeCaseText",
				"type": "string",
				"description": "Lowercase words joined by underscores; empty or separator-only input becomes an empty string.",
				"examples": ["hello_world"]
			}
		],
		"errors": []
	},
