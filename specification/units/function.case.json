	"id": "function.case",
	"kind": "function",
	"title": "Code name casing",
	"responsibility": "Converts names into kebab, Pascal, camel or snake case using the same word boundaries.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/core/case.ts",
			"src/core/development-tooling/case.ts",
