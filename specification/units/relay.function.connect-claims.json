{
	"schemaVersion": 1,
	"id": "relay.function.connect-claims",
	"kind": "function",
	"title": "Relay connection claims",
	"responsibility": "Reads syntactically valid host or device connection claims from request headers.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/relay/src/utils/connectClaims.ts",
			"packages/relay/src/utils/development-tooling/connectClaims.ts"
		],
		"symbols": ["connectClaims", "connectClaims"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "connectClaims.headers",
				"type": "Headers",
				"description": "Headers containing Bearer authorization and the protocol role/device headers. The Bearer scheme is case-insensitive; the credential must match the protocol pattern."
			}
		],
		"outputs": [
			{
				"name": "connectClaims",
				"type": "ConnectClaims | undefined",
				"description": "Host claims with an empty device identifier, or device claims with a valid protocol device identifier. Returns undefined for missing/malformed credential, unknown role or invalid device identity."
			}
		],
		"errors": [
			{
				"name": "TypeError",
				"type": "thrown",
				"description": "A missing Headers instance fails while reading the authorization header."
			}
		]
	},
	"dependencies": [
		{
			"unit": "relay.function.matches-pattern",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "relay.model.relay-host-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "remote.entry.index",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/relay/src/utils/development-tooling/connectClaims.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/relay/src/utils/development-tooling/connectClaims.ts"
			}
		]
	},
	"scenarios": ["remote-desktop-boundaries"],
	"testing": {
		"version": 1,
		"shape": "helper",
		"examples": [
			{
				"subject": "connectClaims",
				"name": "Read a host claim with an empty device id",
				"call": "connectClaims(new Headers({ Authorization: 'Bearer Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-xyz', 'X-Harness-Role': 'host' }))",
				"input": [
					{
						"fixture": "Headers",
						"init": {
							"Authorization": "Bearer Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-xyz",
							"X-Harness-Role": "host"
						}
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"role": "host",
						"credential": "Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-xyz",
						"deviceId": ""
					}
				}
			},
			{
				"subject": "connectClaims",
				"name": "Read a device claim with its well-formed device id",
				"call": "connectClaims(new Headers({ Authorization: 'Bearer Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-Ab0_-xyz', 'X-Harness-Role': 'device', 'X-Harness-Device': 'c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3c3' }))",
