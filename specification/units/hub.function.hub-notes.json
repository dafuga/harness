{
	"schemaVersion": 1,
	"id": "hub.function.hub-notes",
	"kind": "function",
	"title": "Read pinned evidence notes",
	"responsibility": "Read commit-keyed notes from an immutable revision and memoize within one authorized context.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/hub/src/services/hub-evidence-service/hubNotes.ts",
			"packages/hub/src/utils/hubNotes.ts"
		],
		"symbols": ["hubNotes", "hubNotes"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "hubNotes.base",
				"type": "HubSourceContext",
				"description": "Authorized source context with repository, pinned commit, tree entries, source adapter and cache identity."
			},
			{
				"name": "hubNotes.pinned",
				"type": "string | null",
				"description": "Exact notes revision, or null for no notes."
			}
		],
		"outputs": [
			{
				"name": "hubNotes",
				"type": "Promise<Map<string, ReadNote>>",
				"description": "Map from 40-character commit IDs to parsed note lines; null pin yields an empty map. Reads for the same context and pin share a promise."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "function.note-lines",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.function.hub-json",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.function.hub-pinned-source",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.function.hub-raw",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.function.hub-source",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/hub/src/services/hub-evidence-service/hubNotes.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/hub/src/services/hub-evidence-service/hubNotes.ts"
			}
		]
	},
	"scenarios": ["hub-recorded-evidence"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
