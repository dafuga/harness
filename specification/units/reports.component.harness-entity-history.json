			{
				"name": "EntityHistory.client",
				"type": "Pick<HarnessClient, 'revision'>",
				"required": true,
				"description": "The revision reader, a pick of HarnessClient: its revision(commit) is called for each listed commit that has no detail yet and for the first ten unread commits on each Read the next commits click. A rejected promise from it is swallowed, while a synchronous exception propagates."
			},
			{
				"name": "EntityHistory.nav",
				"type": "EntityNav",
				"required": true,
				"description": "Navigation context for this entity at historical commits: route is the base location from which entityLens builds each history row's link, and href and go build and follow the tests-tab location of each regression commit in the regression proof. The same object is passed on to every history row."
			}
		],
		"outputs": [
			{
				"name": "EntityHistory",
				"type": "markup",
				"description": "The History card of this entity: a table with one EntityHistoryRow per listed commit and the columns Date, Commit, Behavior change, Size, Complexity and Latency (the latency header names the selected profile), or a 'No recorded change' notice when no commit is listed, with a Performance profile select when timings exist for more than one profile. While earlier commits are unread, a note below the table states how many are unread and gives their gap reasons, with a 'Read the next commits' button that is disabled and reads 'Reading…' while a read is pending; at 800px or narrower the table header is visually hidden, each row stacks under visible field labels, and the viewed commit's cells, except complexity, get an inset gold edge."
			}
		],
		"errors": [
			{
				"name": "Revision read rejection",
				"type": "handled",
				"description": "A rejected client.revision promise is swallowed: that commit gets no detail, so no change or measurement is invented for it, previously read details are kept, and a later Read the next commits click requests an unread commit again while it is among the first ten unread commits."
			},
			{
				"name": "Caller reader or navigation error",
				"type": "propagated",
				"description": "A synchronous client.revision exception escapes the listing effect, or rejects readMore and leaves reading true so the Reading control stays disabled. Exceptions from nav, entityLens and rendered components are not caught here either."
			},
			{
				"name": "Revision detail mapping error",
				"type": "thrown",
				"description": "An exception from historyDetail, such as a revision without a registry, is not caught: a known revision whose mapping throws stops the component from being created, and a read revision whose mapping throws rejects that read. That rejection leaves reading true when it comes from readMore, and it is an unhandled promise rejection when it comes from the listing effect."
			},
			{
				"name": "Listing or timing derivation error",
				"type": "thrown",
				"description": "An exception from historyListed, entityHistory or historyProfiles, such as an index without benchmarks, is not caught and propagates out of the component's rendering."
			}
		],
		"errorStatus": "declared",
