			"reports.component.regression-proof",
			"reports.component.select",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-header",
			"reports.component.shared-primitives-atoms-html-label",
			"reports.component.shared-primitives-atoms-html-option",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-th",
			"reports.component.shared-primitives-atoms-html-tr",
			"reports.component.shared-primitives-data-table"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/entity-history/EntityHistory.svelte"],
		"symbols": ["EntityHistory", "EntityHistory.header", "EntityHistory.children"]
	},
	"contract": {
		"origin": "declared",
		"primitives": [
			"reports.component.explorer-ui-explorer-kit-card",
			"reports.component.harness-harness-verdict",
			"reports.component.select",
			"reports.component.shared-primitives-data-table"
		],
		"inputs": [
			{
				"name": "EntityHistory.entity",
				"type": "ExplorerEntity",
				"required": true,
				"description": "Required entity identity/name used for revision details and navigation. Caller is expected to recreate this view for a new entity or commit."
			},
			{
				"name": "EntityHistory.rows",
				"type": "ExplorerHistoryRow[]",
				"required": true,
				"description": "Required newest-first history through the shown commit, including known changes and unread candidates."
			},
			{
				"name": "EntityHistory.index",
				"type": "HarnessIndex",
				"required": true,
				"description": "Required index used to derive historical timings and profiles."
			},
			{
				"name": "EntityHistory.scope",
				"type": "ExplorerScope",
				"required": true,
				"description": "Required viewed commit used for labels and preferred initial selection."
			},
			{
				"name": "EntityHistory.known",
				"type": "HarnessRevision[]",
				"required": true,
				"description": "Required revisions already read, used to seed the detail map once at creation. Later prop replacements do not reseed it."
			},
			{
				"name": "EntityHistory.client",
				"type": "Pick<HarnessClient, 'revision'>",
				"required": true,
				"description": "Required revision reader. Promise rejections are swallowed, leaving revision detail unknown; synchronous exceptions propagate."
			},
			{
				"name": "EntityHistory.nav",
				"type": "EntityNav",
				"required": true,
				"description": "Required context for links to this entity at historical commits."
			}
		],
		"outputs": [
			{
				"name": "EntityHistory",
				"type": "markup",
				"description": "Shows changed commits with direct links, relative dates, source size, complexity and profile-scoped latency. Phone rows stack under visible field labels; longer change reasons remain in an inline disclosure."
			}
		],
		"errors": [
			{
				"name": "Reader or navigation callback error",
				"type": "propagated",
				"description": "Synchronous errors from client.revision, nav.href or nav.go propagate. Rejected revision promises are handled and leave the corresponding detail unknown."
			}
		],
		"operations": [],
		"initialization": [],
		"snippets": [
			{
