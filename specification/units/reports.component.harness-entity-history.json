{
	"schemaVersion": 1,
	"id": "reports.component.harness-entity-history",
	"kind": "component",
	"title": "Entity history",
	"responsibility": "Shows changed commits with direct revision links, relative dates, source size, complexity and profile-scoped latency. Long reasons remain inline; no selected-change panel or duplicate action.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-entity-history-row",
			"reports.component.harness-harness-icon",
			"reports.component.harness-harness-verdict",
			"reports.component.regression-proof",
