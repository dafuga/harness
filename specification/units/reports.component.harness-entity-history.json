			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-table",
			"reports.component.shared-primitives-atoms-html-tbody",
			"reports.component.shared-primitives-atoms-html-th",
			"reports.component.shared-primitives-atoms-html-thead",
			"reports.component.shared-primitives-atoms-html-tr"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/entity-history/EntityHistory.svelte"],
		"symbols": ["EntityHistory"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityHistory.entity",
				"type": "ExplorerEntity",
				"description": "Required entity identity/name used for revision details and navigation. Caller is expected to recreate this view for a new entity or commit."
			},
			{
				"name": "EntityHistory.rows",
				"type": "ExplorerHistoryRow[]",
				"description": "Required newest-first history through the shown commit, including known changes and unread candidates."
			},
			{
				"name": "EntityHistory.index",
				"type": "HarnessIndex",
				"description": "Required index used to derive historical timings and profiles."
			},
			{
				"name": "EntityHistory.scope",
				"type": "ExplorerScope",
				"description": "Required viewed commit used for labels and preferred initial selection."
			},
			{
				"name": "EntityHistory.known",
				"type": "HarnessRevision[]",
				"description": "Required revisions already read, used to seed the detail map once at creation. Later prop replacements do not reseed it."
			},
			{
				"name": "EntityHistory.client",
				"type": "Pick<HarnessClient, 'revision'>",
				"description": "Required revision reader. Failures are swallowed, leaving revision detail unknown rather than supplying false evidence."
			},
			{
				"name": "EntityHistory.nav",
				"type": "EntityNav",
				"description": "Required context for links to this entity at historical commits."
			}
		],
		"outputs": [
			{
				"name": "EntityHistory",
				"type": "markup",
				"description": "Shows changed commits with direct revision links, relative dates, source size, complexity and profile-scoped latency. Long reasons remain inline; no selected-change panel or duplicate action."
			}
		],
		"errors": []
	},
