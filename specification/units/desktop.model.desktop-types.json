{
	"schemaVersion": 1,
	"id": "desktop.model.desktop-types",
	"kind": "model",
	"title": "Desktop",
	"responsibility": "Owns desktop catalog and entity models.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/models/Desktop.types.ts",
			"packages/desktop/src/models/development-tooling/Desktop.types.ts",
			"packages/desktop/src/models/development-tooling/DesktopValues.ts"
		],
		"symbols": [
			"categories",
			"Category",
			"ProviderId",
			"RunMode",
			"Verification",
			"Region",
			"ModelChoice",
			"ProviderState",
			"BranchInfo",
			"CommitInfo",
			"Revision",
			"ApprovalInfo",
			"ThreadInfo",
			"ThreadMessage",
			"ContractField",
			"EntityContract",
			"Relationship",
			"HistoryEvent",
			"DesignThumbnail",
			"Thumbnail",
			"CatalogEntity",
			"Measure",
			"EntityDetail",
			"ProjectSnapshot",
			"SourceChange",
			"DesignImage",
			"DesignOptionInfo",
			"DesignRevision",
			"DesignVersion",
			"categories",
			"DesignImage",
			"DesignOptionInfo",
			"DesignRevision",
			"DesignVersion",
			"categories"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityDetail",
				"type": "CatalogEntity & {documentation?:UnitDocumentation,historyCoverage?:{complete:boolean,nextPage:number|null,loadedPages:number},contract:EntityContract,relationships:Relationship[],versions:DesignVersion[],threads:ThreadInfo[],history:HistoryEvent[],sources:string[],size:Measure,performance:Measure}"
			},
			{
				"name": "CatalogEntity.thumbnail",
				"type": "DesignThumbnail | ({source:\"recorded\"} & Partial<NonNullable<ComponentManifest[\"preview\"]>>) | null",
				"description": "Design thumbnails bind version/hash/state/viewport; recorded thumbnails reference recorded evidence."
			}
		],
		"outputs": [
			{
				"name": "Relationship",
				"type": "{id:string,title:string,category:Category|null,direction:\"uses\"|\"used-by\",hasPlan:boolean,verification:Verification}"
			},
			{
				"name": "ApprovalInfo",
				"type": "{id:string,version:string,imageHashes:string[],contractHash:string,approvedAt:string,current:boolean,option?:string}"
			},
			{
				"name": "Revision",
				"type": "{branch:string,commit:string,tip:string,atTip:boolean}"
			},
			{
				"name": "Region",
				"type": "{x:number,y:number,width:number,height:number}",
				"description": "Coordinates are image-dimension fractions."
			},
			{
				"name": "Measure",
				"type": "{available:boolean,text:string}"
			},
			{
				"name": "categories",
				"type": "unknown"
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.model.design-version-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.model.project-context-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.unit-documentation",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "module.contracts",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/models/development-tooling/Desktop.types.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/models/development-tooling/Desktop.types.ts"
			}
		]
	},
	"scenarios": [
		"desktop-native",
		"desktop-project-runs",
		"shells-shared-app",
		"hosted-design-options"
	],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
