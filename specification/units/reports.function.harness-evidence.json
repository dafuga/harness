			{
				"name": "captureVideo.capture",
				"type": "HarnessCapture",
				"required": true,
				"description": "Validated capture whose video descriptor and SHA-256 are projected without changing recorded provenance. Non-video captures return undefined."
			},
			{
				"name": "captureVideo.reference",
				"type": "FrameClipReference",
				"required": true,
				"description": "Original verification record, tested source revision, clip owner, clip ID and viewport. Invalid record or revision identities omit flagging capability."
			},
			{
				"name": "captureVideo.selectedRevision",
				"type": "string",
				"required": true,
				"description": "Revision the gallery currently displays, kept separately from the original tested source revision."
			},
			{
				"name": "captureVideo.freshness",
				"type": "EvidenceVideo['freshness']",
				"required": true,
				"description": "Existing explorer standing for this clip: current, inherited, stale or historical."
			},
			{
				"name": "originalClipReference.capture",
				"type": "HarnessCapture",
				"required": true,
				"description": "Video capture carrying an optional exact original parent and tested revision."
			},
			{
				"name": "originalClipReference.fallback",
				"type": "FrameClipReference",
				"required": true,
				"description": "Current scenario clip address used when the capture has no original parent reference."
			},
			{
				"name": "mediaFile.capture",
				"type": "HarnessCapture",
				"required": true,
				"description": "The stored capture whose media name is read; only its media field is used. A null or undefined media gives an empty name, and a media value that is neither null, undefined nor a string makes the call throw a TypeError.",
