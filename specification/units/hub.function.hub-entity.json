{
	"schemaVersion": 1,
	"id": "hub.function.hub-entity",
	"kind": "function",
	"title": "Read hosted entity details",
	"responsibility": "Combine a catalog entity with its contract, sources, designs, shared threads and first history page.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/hub/src/services/hub-projection-service/hubEntity.ts",
			"packages/hub/src/utils/hubEntity.ts"
		],
		"symbols": [
			"hubEntity"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "hubEntity.context",
				"type": "HubSourceContext",
				"description": "Authorized source context with repository, pinned commit, tree entries, source adapter and cache identity."
			},
			{
				"name": "hubEntity.query",
				"type": "{ entityId: string; commit: string; branch: string; shared: CommittedThread[] }",
				"description": "Entity ID, commit, branch and already-authorized shared threads."
			}
		],
		"outputs": [
			{
				"name": "hubEntity",
				"type": "Promise<EntityDetail>",
				"description": "Entity detail with source sizes, relationships, design introduction commits, shared-thread count and history coverage; performance is explicitly not measured."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		},
