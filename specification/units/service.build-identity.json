	"runtime": {
		"kind": "module",
		"entry": "src/services/BuildIdentityService.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/services/BuildIdentityService.ts"
			}
		]
	},
	"scenarios": [],
