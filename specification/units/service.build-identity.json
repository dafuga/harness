{
	"schemaVersion": 1,
	"id": "service.build-identity",
	"kind": "service",
	"title": "BuildIdentityService",
	"responsibility": "Reads a build directory and reports the identity of the files it holds.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["src/services/BuildIdentityService.ts"],
		"symbols": [
			"IdentifiedBuild",
			"DeclaredBuild",
			"BuiltIdentity",
			"BuildIdentityService",
			"BuildIdentityService.declared",
			"BuildIdentityService.changed",
			"BuildIdentityService.identify"
		]
	},
	"contract": {
