		"inputs": [
			{
				"name": "BuildIdentityService.declared.root",
				"type": "string"
			},
			{
				"name": "BuildIdentityService.declared.builds",
				"type": "DeclaredBuild[]"
			},
			{
				"name": "BuildIdentityService.changed.root",
				"type": "string"
			},
			{
				"name": "BuildIdentityService.changed.builds",
