	"kind": "component",
	"title": "Email proof panel",
	"responsibility": "Collects the emailed verification code needed to finish sign-in.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
		"uses": [
			"reports.component.shared-primitives-atoms-html-button",
