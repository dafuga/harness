			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong",
			"reports.component.shared-primitives-compare-panes",
			"reports.component.shared-primitives-detail-list"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/EntityBehavior.svelte"],
		"symbols": [
			"EntityBehavior",
			"EntityBehavior.children",
			"EntityBehavior.label",
