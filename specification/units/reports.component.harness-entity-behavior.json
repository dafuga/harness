	},
	"contract": {
		"origin": "declared",
		"primitives": [
			"reports.component.explorer-ui-explorer-kit-card",
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-compare-panes",
			"reports.component.shared-primitives-detail-list"
		],
		"inputs": [
			{
				"name": "EntityBehavior.behavior",
				"type": "ExplorerBehavior",
				"required": true,
				"description": "Required metadata for recorded rows before their contents are read. Row before/after hashes form the identity used to retain a completed reading."
			},
			{
				"name": "EntityBehavior.read",
				"type": "ExplorerBehavior | null",
				"required": false,
				"default": null,
				"description": "Optional already-read behavior, default null. Non-null bypasses local reading; null means no preloaded result and does not itself indicate failure."
			},
			{
				"name": "EntityBehavior.scope",
				"type": "ExplorerScope",
				"required": true,
				"description": "Required mode, commit and parent context. Paired panes require commit behavior with a parent."
			},
			{
				"name": "EntityBehavior.mediaBase",
				"type": "string",
				"required": true,
				"description": "Required base used by the artifact-reading helper and passed to run panels."
			},
			{
				"name": "EntityBehavior.nav",
				"type": "EntityNav",
				"required": true,
				"description": "Required route context and navigation callbacks for full tests and selected-commit links."
			},
			{
				"name": "EntityBehavior.reasons",
				"type": "Reasons",
				"required": false,
				"description": "Optional entity change reasons, displayed separately from test observations. Supplied behavior text remains visible while recorded results load and takes precedence over derived comparison explanation. Defaults to JavaScript undefined (omitted)."
			},
			{
				"name": "EntityBehavior.duration",
				"type": "string",
				"required": false,
				"description": "Optional displayed end-to-end duration, defaulting to Not measured; the component does not calculate it. Defaults to Not measured."
			},
			{
				"name": "EntityBehavior.unit",
				"type": "string",
				"required": false,
				"description": "Optional function identifier passed to run/artifact case rendering. Defaults to JavaScript undefined (omitted), not the literal string."
			}
		],
		"outputs": [
			{
				"name": "EntityBehavior",
				"type": "markup",
				"description": "Current or before/after test panel. Reads artifacts when not supplied and ignores completion whose row-hash signature no longer matches. Pending reading omits settled reason-absence text; completed explanations use separate paragraphs. Missing groups are explicit. Shows scenario outcomes, duration, original reasons and navigation. A passing current/unchanged verdict requires passing results. Footer outcome values stay together."
			}
		],
		"errors": [
			{
				"name": "Navigation callback error",
				"type": "propagated",
				"description": "Errors from nav.href while rendering links or nav.go when following them propagate. Rejected recorded-artifact reads become an unknown behavior state."
			}
		],
		"operations": [],
		"initialization": [],
		"snippets": [
			{
				"name": "EntityBehavior.children",
				"inputs": [
					{
						"name": "EntityBehavior.children.pane",
						"type": "unknown",
						"required": true
					}
				],
				"outputs": [
