		"outputs": [
			{
				"name": "impactSeeds",
				"type": "ImpactSeeds",
				"description": "Result of one call: `changed` keeps every input change with its `classification` and, when a unit is found, its `unit`; `seeds` lists the `unit:`, `file:` and `scenario:` node ids of each non-ignored change in input order, without de-duplication; `direct` is the set of units whose unit manifest changed or that actively own a changed file; and `expansions` holds a `global-change` entry per `global` change and an `unclassified-change` entry per `other` change, which select everything. Ignored paths add no seeds or expansions but still appear in `changed` and can still mark a unit as direct."
			}
		],
		"errors": [],
		"errorStatus": "none-found",
