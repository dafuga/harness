		"origin": "declared",
		"inputs": [
			{
				"name": "impactSeeds.changes",
				"type": "TreeChange[]",
				"required": true,
				"description": "Changed repository-relative paths, each with status `added`, `modified` or `removed`. A removed path is classified and owned on the base side, while an added or modified path is classified on the head side and takes its owner from an active head manifest, or else from an active base manifest; every entry is kept in the output in input order.",
