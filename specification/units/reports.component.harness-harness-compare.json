	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "HarnessCompare.mediaBase",
				"type": "string",
				"description": "Required media prefix for the paired gallery."
			},
			{
				"name": "HarnessCompare.base",
				"type": "HarnessRevision | undefined",
				"description": "Required comparison base or undefined. No base receives explicit guidance. Removed units come from this registry."
			},
			{
				"name": "HarnessCompare.head",
				"type": "HarnessRevision",
				"description": "Required selected revision supplying active units, reasons and records."
			},
			{
				"name": "HarnessCompare.client",
				"type": "HarnessClient",
				"description": "Required source-comparison client used to derive compared sides when base exists. Failure falls back to null comparison data."
			},
			{
				"name": "HarnessCompare.selected",
				"type": "string | null",
				"description": "Required unit identifier or null, selecting a unit-detail panel when found."
			},
			{
				"name": "HarnessCompare.onselect",
				"type": "(id: string) => void",
				"description": "Required callback for selecting impact-list or map units."
			}
		],
		"outputs": [
			{
				"name": "HarnessCompare",
				"type": "markup",
				"description": "Impact groups and uncertainty/source explanations, reasons for directly touched units, before/after measured metrics and emitted sizes, media, dependency map and selected-unit detail. Removed units use base records/scenarios. Missing measurements stay unavailable."
			}
		],
		"errors": []
	},
