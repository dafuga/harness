{
	"schemaVersion": 1,
	"id": "reports.component.report-view",
	"kind": "component",
	"title": "Report viewer",
	"responsibility": "Presents a report with its recorded evidence and expandable review details.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.brand-mark",
			"reports.component.coverage-list",
			"reports.component.evidence-grid",
			"reports.component.gameplay-replay",
			"reports.component.modal",
			"reports.component.report-checks",
			"reports.component.report-findings",
			"reports.component.report-summary",
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-footer",
			"reports.component.shared-primitives-atoms-html-main",
			"reports.component.shared-primitives-atoms-html-nav",
			"reports.component.shared-primitives-atoms-html-section",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/ReportView.svelte",
			"packages/reports/src/components/reports-media/ReportView.svelte",
			"packages/reports/src/components/reports-media/ReportView.types.ts"
		],
		"symbols": ["ReportView", "ReportView", "Detail"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ReportView.report",
				"type": "Report",
				"description": "Required report providing summary, findings, checks, acceptance criteria, coverage, evidence and replay data."
			},
			{
				"name": "ReportView.assetBase",
				"type": "string",
				"description": "Required media address prefix passed to evidence and replay viewers."
			},
			{
				"name": "ReportView.downloadBase",
				"type": "string",
				"description": "Required download address prefix passed to the report summary."
			},
			{
				"name": "ReportView.portable",
				"type": "boolean",
				"description": "Optional portable presentation, defaulting to false. True changes the brand destination and hides project-history navigation and upload eligibility."
			},
			{
				"name": "ReportView.onUploaded",
				"type": "(report: Report) => void",
				"description": "Optional callback forwarded to evidence uploads so the host can receive the updated report."
			}
		],
		"outputs": [
			{
				"name": "ReportView",
				"type": "markup",
				"description": "Report summary, findings, evidence gallery, replay and footer. Checks, acceptance and coverage open in a dialog; closing returns focus to the triggering button. Upload eligibility is passed only for an active, nonportable report."
			}
		],
		"errors": []
	},
