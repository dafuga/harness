{
	"schemaVersion": 1,
	"id": "desktop.component.runtime-pane",
	"kind": "component",
	"title": "Runtime pane",
	"responsibility": "Shows one recorded screenshot or the reason its capture is unavailable.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.status-icon",
			"reports.component.shared-primitives-atoms-html-figcaption",
			"reports.component.shared-primitives-atoms-html-figure",
			"reports.component.shared-primitives-atoms-html-img",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-strong"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/RuntimePane.svelte",
			"packages/desktop/src/components/execution-runtimes/RuntimePane.svelte"
		],
		"symbols": ["RuntimePane", "RuntimePane"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "RuntimePane.item",
				"type": "Evidence",
				"description": "Evidence item with file, phase, missing flag/note and display facts. Missing items are not fetched. Before phase reads before; other phases read after."
			},
			{
				"name": "RuntimePane.title",
				"type": "string",
				"description": "Required figure heading and accessible name."
			},
			{
				"name": "RuntimePane.role",
				"type": "string",
				"description": "Required descriptive badge such as Parent commit or Branch tip."
			},
			{
				"name": "RuntimePane.evidence",
				"type": "EntityEvidence",
				"description": "URL-reading state. Failed promises become displayed problems; callbacks from superseded requests are ignored."
			}
		],
		"outputs": [
			{
				"name": "RuntimePane",
				"type": "markup",
				"description": "Figure with screenshot after URL resolution, plus standing/status. Missing capture, failed verification and loading have separate messages. Non-Fresh capture standings receive stale styling."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.status-icon",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.entity-evidence",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-figcaption",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-figure",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-img",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-p",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-span",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-strong",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.report-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/execution-runtimes/RuntimePane.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/execution-runtimes/RuntimePane.svelte"
			}
		]
	},
	"scenarios": ["runtime-evidence-ui"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
