{
	"schemaVersion": 1,
	"id": "desktop.component.workspace-shell",
	"kind": "shell",
	"title": "Shared workspace shell",
	"responsibility": "Assembles workspace navigation, the catalog or entity view, project-agent controls and status.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.catalog-view",
			"desktop.component.entity-view",
			"desktop.component.nav-bar",
			"desktop.component.project-agent",
			"desktop.component.status-bar",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-p"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/WorkspaceShell.svelte",
			"packages/desktop/src/components/projects-sessions/WorkspaceShell.svelte"
		],
		"symbols": ["WorkspaceShell", "WorkspaceShell"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "WorkspaceShell.workspace",
				"type": "Workspace",
				"description": "Required workspace supplying current project, entity, snapshot, errors and navigation context. Entity views are keyed by project and entity; catalogs by project. Project-agent state is keyed by project and snapshot writability."
			},
			{
				"name": "WorkspaceShell.account",
				"type": "Snippet",
				"description": "Optional host-account content forwarded to the navigation bar. Omitted means no supplied account controls."
			}
		],
		"outputs": [
			{
				"name": "WorkspaceShell",
				"type": "markup",
				"description": "Workspace shell showing navigation, any workspace error alert, either entity detail or category catalog, status footer and project-agent component. Keyed views are recreated at the stated identity boundaries."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.catalog-view",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.entity-view",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.nav-bar",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.project-agent",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.status-bar",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.workspace",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-p",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/projects-sessions/WorkspaceShell.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/projects-sessions/WorkspaceShell.svelte"
			}
		]
	},
	"scenarios": ["shared-test-cases", "agent-creation", "shells-shared-app"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
