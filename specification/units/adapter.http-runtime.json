{
	"schemaVersion": 1,
	"id": "adapter.http-runtime",
	"kind": "adapter",
	"title": "HttpRuntimeAdapter",
	"responsibility": "Calls an independently served unit over HTTP behind the runtime contract.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["src/adapters/HttpRuntimeAdapter.ts"],
		"symbols": [
			"HttpRuntimeAdapter",
			"HttpRuntimeAdapter.constructor",
			"HttpRuntimeAdapter.invoke",
			"HttpRuntimeAdapter.close"
		]
	},
	"contract": {
		"origin": "derived",
		"inputs": [
			{
				"name": "HttpRuntimeAdapter.constructor.url",
				"type": "string"
			},
			{
				"name": "HttpRuntimeAdapter.constructor.options",
				"type": "RuntimeOptions"
			},
			{
				"name": "HttpRuntimeAdapter.invoke.request",
				"type": "RuntimeRequest"
			}
		],
		"outputs": [
			{
				"name": "HttpRuntimeAdapter.invoke",
				"type": "Promise<RuntimeResponse>"
			},
			{
				"name": "HttpRuntimeAdapter.close",
				"type": "Promise<void>"
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "function.portable-json",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.runtime-response",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.runtime-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/adapters/HttpRuntimeAdapter.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/adapters/HttpRuntimeAdapter.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
