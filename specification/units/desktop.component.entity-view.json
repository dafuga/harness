{
	"schemaVersion": 1,
	"id": "desktop.component.entity-view",
	"kind": "component",
	"title": "Entity view",
	"responsibility": "Coordinates an entity\u2019s overview, design or plan, its uses and consumers, evidence, history, details and conversation within the current workspace.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["packages/desktop/src/components/EntityView.svelte"],
		"symbols": ["EntityView"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityView.workspace",
				"type": "Workspace",
				"description": "Loaded workspace with an entity, navigation context, capabilities, revision and bridge operations. The entity must exist before rendering. The URL suffix selects a section, with unknown suffixes falling back to Overview and an old designs suffix opening Plan for a function. Agent-backed annotation requires agent capability and a writable snapshot; comment capability also permits annotations."
			}
		],
		"outputs": [
			{
				"name": "EntityView",
				"type": "markup",
				"description": "Entity identity, verification, tabs and selected content with optional details and conversation. Components retain runtime screenshots above every tab and read evidence on direct section entry. Other entities read evidence on Overview, Evidence and History. Existing routing, annotation and teardown behavior is preserved."
			}
		],
		"errors": []
	},
