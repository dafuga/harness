	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityView.workspace",
				"type": "Workspace",
				"description": "Loaded workspace with an entity, navigation context, capabilities, revision and bridge operations. The entity must exist before rendering. The URL suffix selects a section, with unknown suffixes falling back to Overview and an old designs suffix opening Plan for a function. Agent-backed annotation requires agent capability and a writable snapshot; comment capability also permits annotations."
			}
		],
		"outputs": [
			{
				"name": "EntityView",
				"type": "markup",
				"description": "Entity identity, verification and the selected tab, with optional Source and conversation. Components keep their runtime screenshot above every tab; existing evidence and annotation rules remain in force."
			}
		],
		"errors": []
