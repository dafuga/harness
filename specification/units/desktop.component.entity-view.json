	"owns": {
		"source": [
			"packages/desktop/src/components/explorer-ui/entity-view/EntityView.svelte",
			"packages/desktop/src/components/explorer-ui/entity-view/EntityView.types.ts"
		],
		"symbols": ["EntityView", "Section"]
	},
	"contract": {
		"origin": "declared",
		"primitives": [
			"reports.component.explorer-ui-explorer-kit-pill",
			"reports.component.harness-harness-verdict"
		],
		"inputs": [
			{
				"name": "EntityView.workspace",
				"type": "Workspace",
				"required": true,
				"description": "Live Workspace state supplied to the view, including the current entity, route suffix, snapshot, capabilities and bridge. The view reads an entity immediately, derives its sections from the entity category and suffix, and requires the entity to be loaded."
			}
		],
		"outputs": [
			{
				"name": "EntityView",
				"type": "markup",
				"description": "Rendered markup for the loaded workspace entity, with its heading, Overview by default or a recognized suffix-selected section, and the applicable category-specific panels. Conversation visibility is stateful and starts closed on screens at or below 850 px; component runtime evidence stays above the tabs."
			}
		],
		"errors": [
			{
				"name": "Missing entity context",
				"type": "thrown",
				"description": "The view assumes a loaded entity: it derives the entity from workspace.entity and immediately reads its properties. If the entity is absent, rendering raises a TypeError."
			},
			{
				"name": "Workspace or thread operation failure",
				"type": "thrown",
				"description": "A rejection from workspace.bridge!.openThread(...) propagates out of annotate because that handler has no catch, and this path runs only with agent capability and a writable snapshot. After a successful open, workspace.refresh() is awaited; WorkspaceState.navigate catches navigation errors and stores them in workspace.error."
			}
		],
		"errorStatus": "declared",
		"operations": [],
		"initialization": []
	},
