{
	"schemaVersion": 1,
	"id": "reports.function.entity-screens",
	"kind": "function",
	"title": "Entity screenshot selection",
	"responsibility": "Selects matching recorded screenshots and builds gallery items while retaining capture provenance and explicit gaps.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/reports/src/utils/entityScreens.ts",
			"packages/reports/src/utils/explorer-ui/entityScreens.ts",
			"packages/reports/src/utils/explorer-ui/entityScreens.types.ts",
			"packages/reports/src/utils/explorer-ui/focusedAudioIdentity.ts"
		],
		"symbols": [
			"screenOptions",
			"screenPick",
			"entityScreens",
			"catalogShot",
			"galleryItems",
			"screenOptions",
			"screenPick",
			"entityScreens",
			"catalogShot",
			"galleryItems",
			"ScreenOption",
			"ScreenPick",
			"EntityScreens",
			"ScreenOption",
			"ScreenPick",
			"EntityScreens",
			"Phase",
			"Pane",
			"focusedAudioIdentity"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "screenOptions.scenarios",
				"type": "HarnessScenario[]",
				"description": "Scenario declarations; only those with viewports become screenshot choices."
			},
			{
				"name": "screenPick.options",
				"type": "ScreenOption[]",
				"description": "Available scenario/state/viewport options."
			},
			{
				"name": "screenPick.wanted",
				"type": "Partial<ScreenPick>",
				"description": "Partial requested selection; unknown choices fall back to the first available choice at each level."
			},
			{
				"name": "entityScreens.evidence",
				"type": "ExplorerEvidence",
				"description": "Host-selected evidence for the current revision or compared revisions."
			},
			{
				"name": "entityScreens.pick",
				"type": "ScreenPick | null",
				"description": "Selected scenario, state and viewport, or null when there is no visual scenario."
			},
			{
				"name": "galleryItems.evidence",
				"type": "ExplorerEvidence",
				"description": "Evidence whose screenshot and audio captures should become gallery items."
			},
			{
				"name": "catalogShot.evidence",
				"type": "ExplorerEvidence",
				"description": "The host-selected evidence for one entity at the shown revision. Captures from other states or entities must already be excluded by its declared coverage."
			},
			{
				"name": "catalogShot.preview",
				"type": "ScreenPick | undefined",
				"description": "Optional exact scenario, state and viewport for the catalog image. If absent, choose usable evidence with fresh captures first. If specified but missing, return no image.",
				"examples": [
					{
						"scenario": "agent-settings",
						"state": "settings",
						"viewport": "desktop"
					}
				]
			}
		],
		"outputs": [
			{
				"name": "screenOptions",
				"type": "ScreenOption[]",
				"description": "Scenario choices with required states and labeled viewport dimensions."
			},
			{
				"name": "screenPick",
				"type": "ScreenPick | null",
				"description": "Resolved choice, or null when no scenarios exist. Missing state or viewport choices become an empty string."
			},
			{
				"name": "entityScreens",
				"type": "EntityScreens",
				"description": "Matching after screenshot or gap, plus before at a selected commit. Validated unchanged captures remain visible with their origin and fresh=false; rejected, unvalidated or unavailable captures remain gaps. Matching scenario, state and viewport is required."
			},
			{
				"name": "galleryItems",
				"type": "Evidence[]",
				"description": "Before media then after media in commit mode, or current media alone, with sequence order, status, provenance and media details. Includes unusable or inherited captures. Focused audio retains its bound case and tested revision; screenshot source identifies its served build revision, never the target of inherited proof."
			},
			{
				"name": "catalogShot",
				"type": "Evidence | null",
				"description": "A usable screenshot of the shown version, preferring a fresh capture. Validated unchanged evidence keeps its original captured commit, standing and explanation. Returns null for missing, rejected, unvalidated, wrong-build or unrelated evidence; never borrows from the parent."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.function.capture-provenance",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.harness-evidence",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.explorer-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.harness-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.report-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/utils/explorer-ui/entityScreens.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/utils/explorer-ui/entityScreens.ts"
			}
		]
	},
