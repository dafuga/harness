{
	"schemaVersion": 1,
	"id": "desktop.component.details-panel",
	"kind": "component",
	"title": "Source files",
	"responsibility": "Lets a person read source files from the displayed entity and revision, only on the Source tab.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-code",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h2",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-pre",
			"reports.component.shared-primitives-atoms-html-section"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/DetailsPanel.svelte",
			"packages/desktop/src/components/shared-primitives/DetailsPanel.svelte"
		],
		"symbols": ["DetailsPanel", "DetailsPanel"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "DetailsPanel.entity",
				"type": "EntityDetail",
				"description": "Entity supplying its kind, size and performance text, owned source paths and identifier. A source request is scoped to this identifier. An empty source list produces “No source files recorded.”"
			},
			{
				"name": "DetailsPanel.workspace",
				"type": "Workspace",
				"description": "Workspace supplying the source-reading bridge, snapshot revision commit and project context. These are required when a source is selected. Failures during that request, including unavailable required context, are caught and shown as text."
			}
		],
		"outputs": [
			{
				"name": "DetailsPanel",
				"type": "markup",
				"description": "Source files for the displayed entity and revision. Choosing a file clears old text and errors, requests its contents and shows the result. A failed read displays an alert."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.workspace",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-button",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-code",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-h2",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-p",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-pre",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-section",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/shared-primitives/DetailsPanel.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/shared-primitives/DetailsPanel.svelte"
			}
		]
	},
	"scenarios": ["desktop-native", "desktop-renderer"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
