{
	"schemaVersion": 1,
	"id": "reports.function.entity-contract",
	"kind": "function",
	"title": "Readable entity contracts",
	"responsibility": "Converts declared interfaces and category-specific context into readable contract rows.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/entity-sections/entityContract.ts",
			"packages/reports/src/components/explorer-ui/entity-sections/entityContract.types.ts",
			"packages/reports/src/helpers/strings/humanize.ts",
			"packages/reports/src/utils/entityContract.ts",
			"packages/reports/src/utils/explorer-ui/entityContract.ts",
			"packages/reports/src/utils/explorer-ui/entityContract.types.ts"
		],
		"symbols": [
			"requiredStates",
			"entityContract",
			"Field",
			"humanize",
			"requiredStates",
			"entityContract",
			"humanize",
			"requiredStates",
			"entityContract",
			"ContractRow",
			"ContractFacts",
			"humanize",
			"ContractRow",
			"ContractFacts"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "humanize.name",
				"type": "string",
				"description": "Identifier to split into ordinary lowercase words."
			},
			{
				"name": "requiredStates.unit",
				"type": "HarnessUnit",
				"description": "Unit whose required states are requested."
			},
			{
				"name": "requiredStates.scenarios",
				"type": "HarnessScenario[]",
				"description": "Scenario declarations to examine."
			},
			{
				"name": "requiredStates.units",
				"type": "HarnessUnit[]",
				"description": "Registry units used to determine which scenario states actually show the unit."
			},
			{
				"name": "entityContract.unit",
				"type": "HarnessUnit",
				"description": "Unit supplying its responsibility, contract and runtime."
			},
			{
				"name": "entityContract.facts",
				"type": "ContractFacts",
				"description": "Display category plus an optional app route."
			}
		],
		"outputs": [
			{
				"name": "humanize",
				"type": "string",
				"description": "Words separated at camel-case, acronym and underscore/dot/hyphen boundaries, trimmed and lowercased."
			},
			{
				"name": "requiredStates",
				"type": "string[]",
				"description": "Unique required state identifiers from scenarios naming the unit, narrowed through scenarioFor."
			},
			{
				"name": "entityContract",
				"type": "ContractRow[]",
				"description": "Category-specific rows: pages include purpose and address; configs show purpose and provided outputs; other categories show inputs, outputs and errors, with service runtime. Verification states appear only in evidence views. Field descriptions are retained, with missing descriptions stated when some fields are described. Component-self markup outputs read rendered markup."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.function.explorer-state",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.explorer-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.harness-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"helperContracts": [
		{
			"name": "humanize",
			"source": "packages/reports/src/helpers/strings/humanize.ts",
			"inputs": [
				{
					"name": "humanize.name",
					"type": "string"
				}
			],
			"output": "string",
			"pure": true,
			"examples": [
				{
					"name": "Separate lowercase words from uppercase letters",
					"call": "humanize(\"orderID\")",
					"input": ["orderID"],
					"output": "order id"
				},
				{
					"name": "Separate an acronym from the following word",
					"call": "humanize(\"HTTPServer\")",
					"input": ["HTTPServer"],
					"output": "http server"
				},
				{
					"name": "Replace identifier separators with spaces and trim",
					"call": "humanize(\" order-item_count.total \")",
					"input": [" order-item_count.total "],
					"output": "order item count total"
				},
				{
					"name": "Leave an empty identifier blank",
					"call": "humanize(\"\")",
					"input": [""],
					"output": ""
				},
				{
					"name": "Separate a lower camel identifier",
					"call": "humanize(\"searchText\")",
					"input": ["searchText"],
					"output": "search text"
				},
				{
					"name": "Replace an underscore separator",
					"call": "humanize(\"page_size\")",
					"input": ["page_size"],
					"output": "page size"
				},
				{
					"name": "Replace a hyphen separator",
					"call": "humanize(\"on-select\")",
					"input": ["on-select"],
					"output": "on select"
				},
				{
					"name": "Separate an acronym before a suffix",
					"call": "humanize(\"HTTPStatus\")",
					"input": ["HTTPStatus"],
					"output": "http status"
				},
				{
					"name": "Reject a null identifier",
					"call": "humanize(null)",
					"input": [null],
					"error": "Cannot read properties of null (reading 'replace')"
				}
			],
			"consumers": [
				{
					"unit": "desktop.component.contract-panel"
				},
