{
	"schemaVersion": 1,
	"id": "reports.initializer.initialize-preview",
	"kind": "initializer",
	"title": "Start or reuse the preview",
	"responsibility": "Starts one local preview or prints the address of the matching preview already running.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"documentation": "packages/reports/specification/features/planned/managed-preview-server.md",
	"owns": {
		"source": [
			"packages/reports/src/initializers/initializePreview.ts",
			"packages/reports/src/lib/initialize-preview/initializePreview.ts"
		],
		"symbols": ["initializePreview", "initializePreview"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "initializePreview.args",
				"type": "string[]",
				"description": "Launch options from the dev command.",
				"examples": [
					[
						"--port",
						"5688",
						"--config",
						"/projects/harness/packages/reports/vite.config.ts",
						"--host",
						"127.0.0.1"
					]
				]
			}
		],
		"outputs": [
			{
				"name": "initializePreview",
				"type": "Promise<void>",
				"description": "Prints the running preview URL. The owning process stays alive until it is closed."
			}
		],
		"errors": [
			{
				"name": "Error",
				"type": "thrown"
			}
		]
	},
	"dependencies": [
		{
			"unit": "reports.function.preview-arguments",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.preview-health",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.preview-node",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.preview-owner",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.service.preview-server",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/lib/initialize-preview/initializePreview.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/lib/initialize-preview/initializePreview.ts"
			}
		]
	},
	"scenarios": ["local-project-chat"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
