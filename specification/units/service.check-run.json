{
	"schemaVersion": 1,
	"id": "service.check-run",
	"kind": "service",
	"title": "CheckRunService",
	"responsibility": "Runs one planned check in the snapshot under isolation and collects what it captured.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": ["src/services/CheckRunService.ts"],
		"symbols": [
			"RunContext",
			"CheckOutcome",
			"CheckRunService",
			"CheckRunService.constructor",
			"CheckRunService.run"
		]
	},
	"contract": {
		"origin": "derived",
		"inputs": [
			{
				"name": "CheckRunService.constructor.context",
				"type": "RunContext"
			},
			{
				"name": "CheckRunService.run.check",
				"type": "PlannedCheck"
			}
		],
		"outputs": [
			{
				"name": "CheckRunService.run",
				"type": "Promise<CheckOutcome>"
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "function.gather-captures",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.run-isolated",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.verification-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.verify-plan",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/services/CheckRunService.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/services/CheckRunService.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
