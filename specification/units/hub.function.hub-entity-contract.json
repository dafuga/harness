{
	"schemaVersion": 1,
	"id": "hub.function.hub-entity-contract",
	"kind": "function",
	"title": "Choose a hosted entity contract",
	"responsibility": "Prefer the plan contract, otherwise hash the registered unit contract.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/hub/src/services/hub-projection-service/hubEntityContract.ts",
			"packages/hub/src/utils/hubEntityContract.ts"
		],
		"symbols": ["hubEntityContract", "hubEntityContract"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "hubEntityContract.unit",
				"type": "Pick<ComponentManifest, 'contract'>",
				"description": "Optional unit contract."
			},
			{
				"name": "hubEntityContract.plan",
				"type": "Pick<PlanRecord, 'contract'>",
				"description": "Optional plan contract, which takes precedence."
			}
		],
		"outputs": [
			{
				"name": "hubEntityContract",
				"type": "unknown",
				"description": "Plan contract unchanged, or unit contract with a computed hash; when neither exists, empty input/output/error lists with hash null."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.model.planning-port-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.unit-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "hub.function.hub-json",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/hub/src/services/hub-projection-service/hubEntityContract.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/hub/src/services/hub-projection-service/hubEntityContract.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
