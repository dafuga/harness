	"title": "ProjectImageCacheService",
	"responsibility": "Owns the ProjectImageCacheService service workflow.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/lib/desktop-bridge/ProjectImageCacheService.ts",
