{
	"schemaVersion": 1,
	"id": "desktop.component.recorded-preview",
	"kind": "component",
	"title": "RecordedPreview",
	"responsibility": "Shows the pinned runtime screenshot of an implemented visual unit.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-figcaption",
			"reports.component.shared-primitives-atoms-html-figure",
			"reports.component.shared-primitives-atoms-html-img",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/recorded-preview/RecordedPreview.svelte",
			"packages/desktop/src/components/shared-primitives/recorded-preview/RecordedPreview.svelte"
		],
		"symbols": ["RecordedPreview", "RecordedPreview"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "workspace",
				"type": "Workspace",
				"description": "The selected project and commit, and its evidence connection."
			},
			{
				"name": "entityId",
				"type": "string",
				"description": "The page or component to preview."
			},
			{
				"name": "title",
				"type": "string",
				"description": "The readable name used for the screenshot description."
			},
			{
				"name": "thumbnail",
				"type": "RecordedThumbnail",
				"description": "The recorded scenario, state and viewport; older pages may name their state in the recorded contract."
			},
			{
				"name": "RecordedPreview.compact",
				"type": "boolean",
				"description": "Defaults to false. Hide the caption for minimal page cards; keep capture origin and missing-image details available on hover.",
				"examples": [true, false]
			}
		],
		"outputs": [
			{
				"name": "preview",
				"type": "markup",
				"description": "A checked screenshot with its state and tested commit, or an explicit loading or unavailable state."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.function.recorded-preview",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.workspace",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-figcaption",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-figure",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-img",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-small",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-span",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/shared-primitives/recorded-preview/RecordedPreview.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/shared-primitives/recorded-preview/RecordedPreview.svelte"
			}
		]
	},
	"scenarios": ["catalog-previews"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
