{
	"schemaVersion": 1,
	"id": "desktop.adapter.ios-remote",
	"kind": "adapter",
	"title": "iOS remote bridge",
	"responsibility": "Provide the native iOS remote bridge, its camera pairing scan and protected cache.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/ios/App/App/HarnessViewController.swift",
			"packages/desktop/ios/App/App/Remote/HarnessRemotePlugin.swift",
			"packages/desktop/ios/App/App/Remote/RemoteCache.swift",
			"packages/desktop/ios/App/App/Remote/RemoteCacheIndex.swift",
			"packages/desktop/ios/App/App/Remote/RemoteChannel.swift",
			"packages/desktop/ios/App/App/Remote/RemoteCoding.swift",
			"packages/desktop/ios/App/App/Remote/RemoteCrypto.swift",
			"packages/desktop/ios/App/App/Remote/RemoteKeychain.swift",
			"packages/desktop/ios/App/App/Remote/RemoteLink.swift",
			"packages/desktop/ios/App/App/Remote/RemoteMedia.swift",
			"packages/desktop/ios/App/App/Remote/RemoteModels.swift",
			"packages/desktop/ios/App/App/Remote/RemoteOffer.swift",
			"packages/desktop/ios/App/App/Remote/RemotePairing.swift",
			"packages/desktop/ios/App/App/Remote/RemotePairingMaterial.swift",
			"packages/desktop/ios/App/App/Remote/RemotePolicy.swift",
			"packages/desktop/ios/App/App/Remote/RemotePulse.swift",
			"packages/desktop/ios/App/App/Remote/RemoteRelayClient.swift",
			"packages/desktop/ios/App/App/Remote/RemoteRequests.swift",
			"packages/desktop/ios/App/App/Remote/RemoteScan.swift",
			"packages/desktop/ios/App/App/Remote/RemoteSecureState.swift",
			"packages/desktop/ios/App/App/Remote/RemoteSession.swift",
			"packages/desktop/ios/App/App/Remote/RemoteSessionAuthority.swift",
			"packages/desktop/ios/App/App/Remote/RemoteSessionEvents.swift",
			"packages/desktop/ios/App/App/Remote/RemoteSessionLink.swift",
			"packages/desktop/ios/App/App/Remote/RemoteSessionPairing.swift",
			"packages/desktop/ios/App/App/Remote/RemoteSessionReads.swift",
			"packages/desktop/ios/App/App/Remote/RemoteSessionScan.swift",
			"packages/desktop/ios/App/App/Remote/RemoteSocketDelegate.swift",
			"packages/desktop/ios/App/App/Scanner/RemoteCameraScanner.swift",
			"packages/desktop/ios/App/App/Scanner/RemoteScannerViewController.swift"
		],
		"symbols": []
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "request",
				"type": "RemoteMethod + explicit project/revision input"
			},
			{
				"name": "scan",
				"type": "Device name only; the offer is read by the camera of this phone, never handed in"
			},
			{
				"name": "offer",
				"type": "QR text of one short-lived single-use pairing offer, read by the rule of pairingOffer"
			},
			{
				"name": "relay",
				"type": "Authenticated encrypted Remote protocol v1"
			}
		],
		"outputs": [
			{
				"name": "bridge",
				"type": "DesktopBridge over HarnessRemote Capacitor plugin"
			},
			{
				"name": "status",
				"type": "RemotePhoneStatus with explicit offline cached state"
			}
		],
		"errors": [
			{
				"name": "permission-denied",
				"type": "refused and protected cache purged"
			},
			{
				"name": "uncertain",
				"type": "disconnected mutation is never re-sent"
			},
			{
				"name": "scan-failure",
				"type": "camera or offer refusal by its remoteScanFailures code; nothing is sent"
			},
			{
				"name": "scan-ended",
				"type": "Disconnect ends an open scan; a late camera answer begins no pairing"
			}
		]
	},
	"dependencies": [
		{
			"unit": "remote.model.remote-types",
			"via": "contract",
			"origin": "declared",
			"contract": "Remote protocol v1"
		},
		{
			"unit": "remote.model.remote-secure-types",
			"via": "contract",
			"origin": "declared",
			"contract": "Secure-channel keys, counters and packet envelope"
		},
		{
			"unit": "remote.model.remote-relay-types",
			"via": "contract",
			"origin": "declared",
			"contract": "Relay connection and pairing envelope"
		},
		{
			"unit": "remote.model.remote-control-types",
			"via": "contract",
			"origin": "declared",
			"contract": "Remote approval and control messages; scan input and failure codes"
		},
		{
			"unit": "remote.model.remote-local-types",
			"via": "contract",
			"origin": "declared",
			"contract": "Local contract shared by adapters"
		},
		{
			"unit": "remote.function.pairing-offer",
			"via": "contract",
			"origin": "declared",
			"contract": "QR offer text grammar and refusals, held to the shared offer vectors"
		},
		{
			"unit": "remote.script.secure-vectors",
			"via": "contract",
			"origin": "declared",
			"contract": "Frozen secure-channel known-answer vectors"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/ios/App/App/Remote/HarnessRemotePlugin.swift",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/ios/App/App/Remote/HarnessRemotePlugin.swift",
				"environment": "iOS + Capacitor 7.4.5"
			}
		]
	},
	"scenarios": ["remote-mobile-native"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
