		"inputs": [
			{
				"name": "GameCreate.bridge",
				"type": "DesktopBridge",
				"required": false,
				"description": "Optional. Defaults to JavaScript undefined, then uses window.harness after mount. Creation stays hidden when neither bridge provides gameCreate."
			},
			{
				"name": "GameCreate.created",
				"type": "(snapshot: ProjectSnapshot) => void",
				"required": false,
				"description": "Optional. Defaults to JavaScript undefined. On success, absence navigates to /harness for an app or /game?projectId=<id> for a game; otherwise receives the snapshot."
			}
		],
		"outputs": [
			{
				"name": "GameCreate",
				"type": "markup",
				"description": "Renders a ready host creation form, creates one app/game, then calls created(snapshot) or navigates. Creation, callback and missing-project-id errors are caught and displayed as an alert."
			}
		],
