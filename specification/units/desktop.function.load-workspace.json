{
	"schemaVersion": 1,
	"id": "desktop.function.load-workspace",
	"uid": "u_u4ayhuatau",
	"kind": "function",
	"title": "Load the selected workspace",
	"responsibility": "Loads the project snapshot and optional entity named by a workspace address, determines available actions, and makes cached views read-only.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/utils/loadWorkspace.ts",
			"packages/desktop/src/utils/projects-sessions/load-workspace/loadWorkspace.ts",
			"packages/desktop/src/utils/projects-sessions/load-workspace/loadWorkspace.types.ts"
		],
