			"ProjectSelection",
			"LoadedWorkspace",
			"ProjectSelection"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "loadWorkspace.bridge",
				"type": "DesktopBridge",
				"required": true,
				"description": "The desktop connection the load reads through: `snapshot` is read unless a project switch already returned one that the route shows, `entity` only when the route names one, and `capabilities` is asked only when the snapshot carries none. Without `selectProject` no project switch happens, and without `capabilities` such a snapshot gets a fixed legacy set: agents, planning and approval on, comments off."
			},
			{
				"name": "loadWorkspace.route",
				"type": "WorkspaceRoute",
				"required": true,
				"description": "The parsed address: its `projectId`, `branch`, `commit` and `entityId` decide what is read, and `category` and `suffix` are not read here. A snapshot opened by a project switch is reused only when the route pins no commit and any requested branch matches that snapshot's branch; otherwise a snapshot is requested for the route's branch and commit.",
				"examples": [
					{
						"projectId": "local-3f9a0c6e2b1d4a7f8e5c9b0d3a6f1e2c4b7d8a9f0e1c2b3a4d5e6f7a8b9c0d1e",
						"branch": null,
						"commit": null,
						"category": "functions",
						"entityId": "desktop.function.load-workspace",
						"suffix": null
					},
					{
						"projectId": "local-3f9a0c6e2b1d4a7f8e5c9b0d3a6f1e2c4b7d8a9f0e1c2b3a4d5e6f7a8b9c0d1e",
						"branch": "main",
						"commit": "c08d3e5a71f29b4d6e0c8a3f5b7d1e9c2a4f6b80",
						"category": "functions",
						"entityId": "desktop.function.load-workspace",
						"suffix": "source"
					},
					{
						"projectId": null,
						"branch": "main",
						"commit": null,
						"category": "pages",
						"entityId": null,
						"suffix": null
					}
				]
			},
			{
				"name": "loadWorkspace.selection",
				"type": "ProjectSelection",
				"required": true,
				"description": "A mutable record of the last selected project id, or `null` while that is not known. It is cleared before a project switch, so a failed switch leaves it `null`; a successful switch and a returned snapshot's `project.id` set it.",
				"examples": [
					{
						"id": "local-3f9a0c6e2b1d4a7f8e5c9b0d3a6f1e2c4b7d8a9f0e1c2b3a4d5e6f7a8b9c0d1e"
					},
					{
						"id": null
					}
				]
			}
		],
		"outputs": [
			{
				"name": "loadWorkspace",
				"type": "Promise<LoadedWorkspace>",
				"description": "The resolved workspace: the snapshot, the entity read at that snapshot's commit (or `null` when the route names none), the allowed actions, and the cached-view information (or `null` for a current snapshot). A cached view comes back with `writable` false and every change action disabled even when its saved capabilities allowed them, and a failed capabilities read leaves every action disabled with a reason.",
				"examples": [
					{
						"snapshot": {
							"project": {
								"name": "sample-app",
								"root": "/Users/example/projects/sample-app",
