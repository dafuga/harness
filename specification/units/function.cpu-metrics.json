{
	"schemaVersion": 1,
	"id": "function.cpu-metrics",
	"uid": "u_yscgsfsrql",
	"kind": "function",
	"title": "CPU interval accounting",
	"responsibility": "Converts two CPU readings into machine use and process groups, assigning descendants to their nearest recognized owner without counting lifetime CPU for new processes.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/services/development-tooling/cpu-usage-service/cpuMetrics.ts",
			"src/utils/development-tooling/cpuMetrics.ts"
		],
		"symbols": ["cpuMetrics", "CpuReading", "CpuGroup", "CpuSnapshot", "cpuMetrics"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "cpuMetrics.before",
				"type": "CpuReading",
				"required": true,
				"description": "Earlier CpuReading that starts every delta: `at` is a performance.now() value in milliseconds rather than an epoch time, and `cpu.idle` and `cpu.total` are cumulative counters summed across all logical CPUs. Its `cpu.cores` and every process field other than `pid` and `cpuMs` are ignored, a process absent from this list contributes zero elapsed CPU, and a process whose `cpuMs` is higher here than in `after` also contributes zero.",
				"examples": [
					{
						"at": 52817.349,
						"cpu": {
							"idle": 91234567,
							"total": 118765432,
							"cores": 8
						},
						"processes": [
							{
								"pid": 4312,
								"parentPid": 1,
								"cpuMs": 184230,
								"role": "harness",
								"label": "Harness"
							},
							{
								"pid": 9120,
								"parentPid": 4312,
								"cpuMs": 61840,
								"role": "agent",
								"label": "Claude"
							},
							{
								"pid": 9164,
								"parentPid": 9120,
								"cpuMs": 22410
							},
							{
								"pid": 881,
								"parentPid": 1,
								"cpuMs": 912340,
								"role": "codex",
								"label": "Codex app"
							}
						]
					},
					{
						"at": 9120.25,
						"cpu": {
							"idle": 3920110,
							"total": 4700440,
							"cores": 4
						},
						"processes": [
							{
								"pid": 1,
								"parentPid": 0,
								"cpuMs": 21340
							},
							{
								"pid": 2214,
								"parentPid": 1,
								"cpuMs": 1234560,
								"role": "codex",
								"label": "Codex app"
							},
							{
								"pid": 3307,
								"parentPid": 2214,
								"cpuMs": 40120,
								"role": "agent",
								"label": "Codex CLI"
							}
						]
					}
				]
			},
			{
				"name": "cpuMetrics.after",
				"type": "CpuReading",
				"required": true,
				"description": "Later CpuReading that ends the interval: `at` sets the end of `intervalMs`, `cpu.cores` sets `logicalCores` and is the divisor for group and agent `machinePercent`, and its `cpu.idle` and `cpu.total` are differenced against `before` to give the snapshot `machinePercent`. Only the processes in this list are reported: each is attributed to its nearest ancestor-or-self with a `role`, found by following `parentPid` through this list, agent labels come from that owner's `label` (defaulting to 'Local agent'), processes with no owner are skipped, and a process absent from `before` contributes zero CPU.",
				"examples": [
					{
						"at": 53818.112,
						"cpu": {
							"idle": 91239767,
							"total": 118773432,
							"cores": 8
						},
						"processes": [
							{
								"pid": 4312,
								"parentPid": 1,
								"cpuMs": 184290,
								"role": "harness",
								"label": "Harness"
							},
							{
								"pid": 9120,
								"parentPid": 4312,
								"cpuMs": 62840,
								"role": "agent",
								"label": "Claude"
							},
							{
								"pid": 9164,
								"parentPid": 9120,
								"cpuMs": 22910
							},
							{
								"pid": 881,
								"parentPid": 1,
								"cpuMs": 912890,
								"role": "codex",
								"label": "Codex app"
							}
						]
					},
					{
						"at": 10121.4,
						"cpu": {
							"idle": 3921630,
							"total": 4704440,
							"cores": 4
						},
						"processes": [
							{
								"pid": 1,
								"parentPid": 0,
								"cpuMs": 21340
							},
							{
								"pid": 2214,
								"parentPid": 1,
								"cpuMs": 1236310,
								"role": "codex",
								"label": "Codex app"
							},
							{
								"pid": 3307,
								"parentPid": 2214,
								"cpuMs": 41380,
								"role": "agent",
								"label": "Codex CLI"
							}
						]
					}
				]
			}
		],
		"outputs": [
			{
				"name": "cpuMetrics",
				"type": "CpuSnapshot",
				"description": "Snapshot whose `status` is always 'available' and whose `sampledAt` is the current time rather than `after.at`; `intervalMs` is `after.at` minus `before.at`, not clamped, so it can be zero or negative, and `machinePercent` is clamped to 0 to 100 or is null when `cpu.total` did not increase between `before` and `after`. The codex, harness and agents groups are always present, with `trackedPercent` as the sum of their `machinePercent` values (never null from this function), and `agents` has one entry per owning agent `pid`, sorted by descending `corePercent`, which can exceed 100 for multi-core use.",
				"examples": [
					{
						"status": "available",
						"sampledAt": "2026-11-14T09:30:02.415Z",
						"intervalMs": 1000.763,
						"logicalCores": 8,
						"machinePercent": 35,
						"trackedPercent": 26.3549,
						"groups": [
							{
								"id": "codex",
