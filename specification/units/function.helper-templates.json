{
	"schemaVersion": 1,
	"id": "function.helper-templates",
	"kind": "function",
	"title": "helperTemplates",
	"responsibility": "Reads runtime template expressions with Svelte block scope preserved for helper reuse analysis.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/services/explorer-ui/revision-detail-service/helperTemplates.ts",
			"src/services/explorer-ui/revision-detail-service/helperTemplates.types.ts",
			"src/services/revision-detail-service/helperTemplates.ts",
			"src/utils/helperTemplates.ts"
		],
		"symbols": ["helperTemplates", "Node", "helperTemplates", "helperTemplates"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "helperTemplates.code",
				"type": "string",
				"description": "Svelte component source to parse. Plain markup and string contents do not become helper calls.",
				"examples": ["<script>const title = 'Orders';</script><h1>{title}</h1>"]
			}
		],
		"outputs": [
			{
				"name": "helperTemplates",
				"type": "string",
				"description": "Script code and isolated template-expression wrappers, with template-bound names represented as local parameters so shadowing remains visible."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "function.scan-imports",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/utils/helperTemplates.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/utils/helperTemplates.ts"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
