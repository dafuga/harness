{
	"schemaVersion": 1,
	"id": "desktop.component.status-bar",
	"kind": "component",
	"title": "Status bar",
	"responsibility": "Summarizes revision, access limits, cache provenance and connection controls for the displayed project.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.hosted-connection",
			"desktop.component.remote-connection",
			"reports.component.shared-primitives-atoms-html-footer",
			"reports.component.shared-primitives-atoms-html-span"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/StatusBar.svelte",
			"packages/desktop/src/components/shared-primitives/StatusBar.svelte"
		],
		"symbols": ["StatusBar", "StatusBar"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "StatusBar.workspace",
				"type": "Workspace",
				"description": "Workspace providing busy/snapshot, revision, source/comment capabilities, pinned/offline state, cache and connection context. It supplies the facts; the view does not verify publication or connectivity."
			}
		],
		"outputs": [
			{
				"name": "StatusBar",
				"type": "markup",
				"description": "Footer with loading, offline, local/shared, historical and access-limited status. Offline copies are read-only and not server-checked, with save time when available; local unpublished revisions are named accordingly. Includes compact hosted/remote controls and seven-character commit."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.hosted-connection",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.remote-connection",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.time-label",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.workspace",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-footer",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-span",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/shared-primitives/StatusBar.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/shared-primitives/StatusBar.svelte"
			}
		]
	},
	"scenarios": ["desktop-native", "desktop-renderer", "remote-mobile-ui"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
