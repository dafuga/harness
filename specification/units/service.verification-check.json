{
	"schemaVersion": 1,
	"id": "service.verification-check",
	"kind": "service",
	"title": "VerificationCheckService",
	"responsibility": "Decides whether a stored record proves a commit: identity, integrity and outcome.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/services/VerificationCheckService.ts",
			"src/services/verification-evidence/VerificationCheckService.ts",
			"src/services/verification-evidence/VerificationCheckService.types.ts"
		],
		"symbols": [
			"VerificationCheckService",
			"VerificationCheckService",
			"VerificationCheckService.constructor",
			"VerificationCheckService.check",
			"VerificationCheckService.integrity",
			"CheckReport",
			"CheckReport"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "VerificationCheckService.constructor.root",
				"type": "string",
				"description": "Path of the Git repository and verification store."
			},
			{
				"name": "VerificationCheckService.constructor.indexer",
				"type": "SourceIndexService",
				"description": "Optional source indexer; a new indexer is used when omitted."
			},
			{
				"name": "VerificationCheckService.check.commit",
				"type": "string",
				"description": "Commit the stored verification is expected to prove."
			},
			{
				"name": "VerificationCheckService.check.stored",
				"type": "StoredRecord",
				"description": "Stored verification record and its evidence directory."
			},
			{
				"name": "VerificationCheckService.integrity.commit",
				"type": "string",
				"description": "Commit the stored verification must identify."
			},
			{
				"name": "VerificationCheckService.integrity.stored",
				"type": "StoredRecord",
				"description": "Stored verification record and its evidence directory."
			}
		],
		"outputs": [
			{
				"name": "VerificationCheckService.check",
				"type": "Promise<CheckReport>",
				"description": "Report containing the commit, record, status and integrity or lineage problems."
			},
			{
				"name": "VerificationCheckService.integrity",
				"type": "Promise<string[]>",
				"description": "Identity, component and evidence problems independent of the recorded outcome."
			}
		],
		"errors": [
			{
				"name": "Error",
				"type": "thrown",
				"description": "Git cannot read the requested repository or commit, including a non-repository root."
			}
		]
	},
	"dependencies": [
		{
			"unit": "adapter.commit-tree",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "adapter.git",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.component-version",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.evidence-manifest",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.record-lineage",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.seal-record",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "function.verification-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "repository.verification-store",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "service.source-index",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "workflow.load-revisions",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/services/verification-evidence/VerificationCheckService.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/services/verification-evidence/VerificationCheckService.ts"
			}
		]
	},
	"scenarios": ["history-fixture-integrity"],
	"testing": {
		"version": 1,
		"shape": "service",
		"states": ["default", "indexer-parity", "invalid-root"],
		"cases": [
			{
				"id": "integrity.default",
				"state": "default",
				"subject": "VerificationCheckService.integrity",
				"fixture": "test/support/budgetFixture.ts",
				"test": {
					"file": "test/verification-check-shared.test.ts",
					"title": "VerificationCheckService.integrity from default initialization"
				},
				"expected": {
					"kind": "value",
					"value": [false, true, false]
				}
			},
			{
				"id": "integrity.indexer-parity",
				"state": "indexer-parity",
				"subject": "VerificationCheckService.integrity",
				"fixture": "test/support/budgetFixture.ts",
				"test": {
					"file": "test/verification-check-shared.test.ts",
					"title": "a checker shared by the records of a chain answers as a fresh checker for each"
				},
				"expected": {
					"kind": "value",
					"value": [false, true, false]
				}
			},
			{
				"id": "check.default",
				"state": "default",
				"subject": "VerificationCheckService.check",
				"fixture": "test/support/budgetFixture.ts",
				"test": {
					"file": "test/verification-check-shared.test.ts",
					"title": "VerificationCheckService.check from default initialization"
				},
				"expected": {
					"kind": "value",
					"value": ["passed", "failed", "failed"]
				}
			},
			{
				"id": "check.indexer-parity",
				"state": "indexer-parity",
				"subject": "VerificationCheckService.check",
				"fixture": "test/support/budgetFixture.ts",
				"test": {
					"file": "test/verification-check-shared.test.ts",
					"title": "VerificationCheckService.check with an injected indexer"
				},
				"expected": {
					"kind": "value",
					"value": ["passed", "failed", "failed"]
				}
			},
			{
				"id": "integrity.invalid-root",
				"state": "invalid-root",
				"subject": "VerificationCheckService.integrity",
				"fixture": "test/support/budgetFixture.ts",
				"test": {
					"file": "test/verification-check-shared.test.ts",
					"title": "VerificationCheckService.integrity rejects a non-repository root"
				},
				"expected": {
					"kind": "error",
					"value": {
						"name": "Error",
						"message": "fatal: not a git repository"
					}
				},
				"errors": ["Error"]
			},
			{
				"id": "check.invalid-root",
				"state": "invalid-root",
				"subject": "VerificationCheckService.check",
				"fixture": "test/support/budgetFixture.ts",
				"test": {
					"file": "test/verification-check-shared.test.ts",
					"title": "VerificationCheckService.check rejects a non-repository root"
				},
				"expected": {
					"kind": "error",
					"value": {
						"name": "Error",
						"message": "fatal: not a git repository"
					}
				},
				"errors": ["Error"]
			}
		]
	},
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
