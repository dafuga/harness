{
	"schemaVersion": 1,
	"id": "reports.component.audio-comparison",
	"uid": "u_ysl5rsdgp5",
	"kind": "component",
	"title": "Audio comparison",
	"responsibility": "Summarizes two related recordings as one gallery card while keeping their statuses separate.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-article",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-h3",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-time",
			"reports.component.verification-evidence-audio-icon"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/reports-media/AudioComparison.svelte"],
		"symbols": ["AudioComparison"]
	},
	"contract": {
		"origin": "declared",
		"primitives": ["reports.component.harness-harness-verdict"],
		"inputs": [
			{
				"name": "AudioComparison.before",
				"type": "Evidence",
				"required": true,
				"description": "Required Evidence for the Before row; its id becomes the preserved #evidence-{id} gallery anchor. The row is unavailable when missing is truthy or file is empty, and duration is shown only for finite positive durationSeconds.",
				"examples": [
					{
						"id": "before-home|ready|voice-pair|desktop",
						"title": "home · ready",
						"category": "home",
						"file": "home/ready-before.wav",
						"status": "passed",
						"phase": "before",
						"comparison": "home|ready|voice-pair|desktop",
						"mediaType": "audio",
						"durationSeconds": 12.4
					}
				]
			},
			{
				"name": "AudioComparison.after",
				"type": "Evidence",
				"required": true,
				"description": "Required Evidence for the After row; its title and category fill the card labels, and its id sets the card anchor. The row is unavailable when missing is truthy or file is empty, and duration is shown only for finite positive durationSeconds.",
				"examples": [
					{
						"id": "after-home|ready|voice-pair|desktop",
						"title": "home · ready",
						"category": "home",
						"file": "home/ready-after.wav",
						"status": "failed",
						"phase": "after",
						"comparison": "home|ready|voice-pair|desktop",
						"mediaType": "audio",
						"durationSeconds": 15.6
					}
				]
			},
			{
				"name": "AudioComparison.onopen",
				"type": "() => void",
				"required": true,
				"description": "Required zero-argument callback invoked when the preview button is activated. The button remains disabled until onMount marks the component ready."
			}
		],
		"outputs": [
			{
				"name": "AudioComparison",
				"type": "markup",
				"description": "Renders one article card whose button opens the comparison and whose Before and After rows keep each recording’s status separate. A row is unavailable when missing is truthy or file is empty, and duration text appears only for finite positive durationSeconds; this component does not play audio."
			}
		],
		"errors": [
			{
				"name": "onopen callback error",
				"type": "thrown",
				"description": "An exception thrown synchronously by onopen when the preview button is activated is not caught by this component."
			}
		],
		"errorStatus": "declared",
		"operations": [],
		"initialization": []
	},
