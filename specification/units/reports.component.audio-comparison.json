	"schemaVersion": 1,
	"id": "reports.component.audio-comparison",
	"kind": "component",
	"title": "Audio comparison",
	"responsibility": "Summarizes two related recordings as one gallery card while keeping their statuses separate.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-article",
			"reports.component.shared-primitives-atoms-html-button",
