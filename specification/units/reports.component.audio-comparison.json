			"reports.component.status-badge"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/AudioComparison.svelte",
			"packages/reports/src/components/reports-media/AudioComparison.svelte"
		],
		"symbols": ["AudioComparison", "AudioComparison"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "AudioComparison.before",
				"type": "Evidence",
				"description": "Required original recording whose identity preserves its gallery anchor. Missing flag or empty file marks its side unavailable."
			},
			{
				"name": "AudioComparison.after",
				"type": "Evidence",
				"description": "Required updated recording supplying the card title, category and main anchor. Missing flag or empty file marks its side unavailable."
			},
			{
				"name": "AudioComparison.onopen",
				"type": "() => void",
				"description": "Required callback for opening the comparison viewer. Its button is disabled until mount completes."
			}
		],
		"outputs": [
			{
				"name": "AudioComparison",
				"type": "markup",
				"description": "Paired-audio card with independent before/after badges and positive finite duration labels. Unavailable sides show not-proven. Does not create a combined passing result or play audio itself."
			}
		],
		"errors": []
	},
