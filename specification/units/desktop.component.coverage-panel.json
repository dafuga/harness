	"contract": {
		"origin": "declared",
		"primitives": [
			"reports.component.explorer-ui-explorer-kit-empty-state",
			"reports.component.explorer-ui-explorer-kit-notice",
			"reports.component.explorer-ui-explorer-kit-pill",
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-data-table"
		],
		"inputs": [
			{
				"name": "CoveragePanel.entity",
				"type": "EntityDetail",
				"required": true,
				"description": "Entity whose kind informs evidence notices and whose category and identifier scope the behavior display. Function entities pass their identifier to the behavior panel; other categories leave that filter unset."
			},
			{
				"name": "CoveragePanel.evidence",
				"type": "EntityEvidence",
				"required": true,
				"description": "Evidence state supplying loading or failure notices and, only when ready, the recorded result. Its status is one of idle, planned, unavailable, loading, failed or ready; idle and planned show the planned or no-record notice. Uses the result’s after side for coverage, including its commit, record, gaps, scenario and state standings, test statuses and capture slots. Coverage checks may carry browser-error diagnostics from the test attempt that produced their result."
			},
			{
				"name": "CoveragePanel.workspace",
				"type": "Workspace",
				"required": false,
				"description": "Optional current workspace used to resolve recorded evidence and regression links. Undefined by default: the regression proof section is then not offered. The default catalog state passes it, and the without-workspace state omits it."
			}
		],
		"outputs": [
			{
				"name": "CoveragePanel",
				"type": "markup",
				"description": "Evidence panel with a runtime-capture label, recorded commit and record identifier when available, and any evidence notice. When no notice blocks it, shows coverage gaps, scenarios, states and captures from the record. Only passed coverage receives a check mark; other standings receive a cross with recorded reasons. Shows observed behavior when rows exist, otherwise explicitly says no input and observed output were recorded at that commit. Each check with recorded diagnostics also offers an expandable browser-error display with observations, expectations and test-attempt context. Catalog states: default, loading, failed (failed notice), unavailable, planned and without-workspace. The before and after images come from the entity states component, not from this panel."
			}
		],
		"errors": [],
		"errorStatus": "none-found",
		"operations": [],
		"initialization": [],
		"snippets": [
