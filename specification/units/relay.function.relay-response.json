{
	"schemaVersion": 1,
	"id": "relay.function.relay-response",
	"kind": "function",
	"title": "Relay JSON responses",
	"responsibility": "Builds standard JSON replies and concise coded failures.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/relay/src/utils/networking-security/relayResponse.ts",
			"packages/relay/src/utils/relayResponse.ts"
		],
		"symbols": ["relayResponse", "relayError", "relayResponse", "relayError"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "relayResponse.status",
				"type": "number",
				"description": "HTTP response status."
			},
			{
				"name": "relayResponse.body",
				"type": "unknown",
				"description": "JSON-serializable response body."
			},
			{
				"name": "relayResponse.headers",
				"type": "Record<string, string>",
				"description": "Optional additional headers, defaulting to empty; supplied keys override the default headers."
			},
			{
				"name": "relayError.status",
				"type": "number",
				"description": "HTTP failure status."
			},
			{
				"name": "relayError.error",
				"type": "RelayErrorCode",
				"description": "Typed relay error code, serialized as the only body field."
			},
			{
				"name": "relayError.headers",
				"type": "Record<string, string>",
				"description": "Optional additional failure-response headers, defaulting to empty."
			}
		],
		"outputs": [
			{
				"name": "relayResponse",
				"type": "Response",
				"description": "Response containing JSON with default application/json, no-store and nosniff headers."
			},
			{
				"name": "relayError",
				"type": "Response",
				"description": "Response containing only the error code object, using the same response/header construction."
			}
		],
		"errors": [
			{
				"name": "Error",
				"type": "thrown",
				"description": "Invalid response status or HTTP header syntax rejects response construction."
			}
		]
	},
	"dependencies": [
		{
			"unit": "remote.entry.index",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/relay/src/utils/networking-security/relayResponse.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/relay/src/utils/networking-security/relayResponse.ts"
			}
		]
	},
	"scenarios": ["remote-desktop-boundaries"],
	"testing": {
		"version": 1,
		"shape": "helper",
		"examples": [
			{
				"subject": "relayResponse",
				"name": "Answer requested JSON with the default relay headers",
				"call": "await projectResponse(relayResponse(202, { state: 'requested' }))",
				"input": [
					202,
					{
						"state": "requested"
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"status": 202,
						"headers": {
							"cache-control": "no-store",
							"content-type": "application/json",
							"x-content-type-options": "nosniff"
						},
						"body": {
							"state": "requested"
						},
						"raw": "{\"state\":\"requested\"}"
					}
				}
			},
			{
				"subject": "relayResponse",
				"name": "Merge extra headers and override a default",
				"call": "await projectResponse(relayResponse(201, { state: 'accepted' }, { 'Cache-Control': 'public, max-age=60', 'X-Relay-Trace': 'trace-1' }))",
				"input": [
					201,
					{
						"state": "accepted"
					},
					{
						"Cache-Control": "public, max-age=60",
						"X-Relay-Trace": "trace-1"
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"status": 201,
						"headers": {
							"cache-control": "public, max-age=60",
							"content-type": "application/json",
							"x-content-type-options": "nosniff",
							"x-relay-trace": "trace-1"
						},
						"body": {
							"state": "accepted"
						},
						"raw": "{\"state\":\"accepted\"}"
					}
				}
			},
			{
				"subject": "relayResponse",
				"name": "Reject a status outside the Response range",
				"call": "await projectResponse(relayResponse(199, { state: 'requested' }))",
				"input": [
					199,
					{
						"state": "requested"
					}
				],
				"expected": {
					"kind": "error",
					"value": "init[\"status\"] must be in the range of 200 to 599, inclusive."
				}
			},
			{
				"subject": "relayResponse",
				"name": "Return an empty body when JSON is omitted",
				"call": "await projectResponse(relayResponse(202, undefined))",
				"input": [202],
				"expected": {
					"kind": "value",
					"value": {
						"status": 202,
						"headers": {
							"cache-control": "no-store",
							"content-type": "application/json",
							"x-content-type-options": "nosniff"
						},
						"raw": ""
					}
				}
			},
			{
				"subject": "relayResponse",
				"name": "Reject an invalid header name",
				"call": "await projectResponse(relayResponse(202, { state: 'requested' }, { 'Bad Header': 'x' }))",
				"input": [
					202,
					{
						"state": "requested"
					},
					{
						"Bad Header": "x"
					}
				],
				"expected": {
					"kind": "error",
					"value": "Headers.append: \"Bad Header\" is an invalid header name."
				}
			},
			{
				"subject": "relayError",
				"name": "Answer a not-found failure with its code and default headers",
				"call": "await projectResponse(relayError(404, 'not-found'))",
				"input": [404, "not-found"],
				"expected": {
					"kind": "value",
					"value": {
						"status": 404,
						"headers": {
							"cache-control": "no-store",
							"content-type": "application/json",
							"x-content-type-options": "nosniff"
						},
						"body": {
							"error": "not-found"
						},
						"raw": "{\"error\":\"not-found\"}"
					}
				}
			},
			{
				"subject": "relayError",
				"name": "Merge an extra failure header",
				"call": "await projectResponse(relayError(429, 'rate-limited', { 'Retry-After': '30' }))",
				"input": [
					429,
					"rate-limited",
					{
						"Retry-After": "30"
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"status": 429,
						"headers": {
							"cache-control": "no-store",
							"content-type": "application/json",
							"retry-after": "30",
							"x-content-type-options": "nosniff"
						},
						"body": {
							"error": "rate-limited"
						},
						"raw": "{\"error\":\"rate-limited\"}"
					}
				}
			},
			{
				"subject": "relayError",
				"name": "Reject a status outside the Response range",
				"call": "await projectResponse(relayError(600, 'forbidden'))",
				"input": [600, "forbidden"],
				"expected": {
					"kind": "error",
					"value": "init[\"status\"] must be in the range of 200 to 599, inclusive."
				}
			},
			{
				"subject": "relayError",
				"name": "Serialize an unrecognized error code unchanged",
				"call": "await projectResponse(relayError(404, 'unknown-code'))",
				"input": [404, "unknown-code"],
				"expected": {
					"kind": "value",
					"value": {
						"status": 404,
						"headers": {
							"cache-control": "no-store",
							"content-type": "application/json",
							"x-content-type-options": "nosniff"
						},
						"body": {
							"error": "unknown-code"
						},
						"raw": "{\"error\":\"unknown-code\"}"
					}
				}
			},
			{
				"subject": "relayError",
				"name": "Reject an invalid failure header name",
				"call": "await projectResponse(relayError(404, 'not-found', { 'Bad Header': 'x' }))",
				"input": [
					404,
					"not-found",
					{
						"Bad Header": "x"
					}
				],
				"expected": {
					"kind": "error",
					"value": "Headers.append: \"Bad Header\" is an invalid header name."
				}
			},
			{
				"subject": "relayResponse",
				"name": "Preserve a null JSON body",
				"call": "await projectResponse(relayResponse(200, null))",
				"input": [200, null],
				"expected": {
					"kind": "value",
					"value": {
						"status": 200,
						"headers": {
							"cache-control": "no-store",
							"content-type": "application/json",
							"x-content-type-options": "nosniff"
						},
						"raw": "null",
						"body": null
					}
				}
			},
			{
				"subject": "relayResponse",
				"name": "Reject a null response status",
				"call": "await projectResponse(relayResponse(null, {}))",
				"input": [null, {}],
				"expected": {
					"kind": "error",
					"value": "init[\"status\"] must be in the range of 200 to 599, inclusive."
				}
			},
			{
				"subject": "relayResponse",
				"name": "Retain default headers for null extra headers",
				"call": "await projectResponse(relayResponse(200, {}, null))",
				"input": [200, {}, null],
				"expected": {
					"kind": "value",
					"value": {
						"status": 200,
						"headers": {
							"cache-control": "no-store",
							"content-type": "application/json",
							"x-content-type-options": "nosniff"
						},
						"raw": "{}",
						"body": {}
					}
				}
			},
			{
				"subject": "relayError",
				"name": "Preserve a null error value",
				"call": "await projectResponse(relayError(404, null))",
				"input": [404, null],
				"expected": {
					"kind": "value",
					"value": {
						"status": 404,
						"headers": {
							"cache-control": "no-store",
							"content-type": "application/json",
							"x-content-type-options": "nosniff"
						},
						"raw": "{\"error\":null}",
						"body": {
							"error": null
						}
					}
				}
			},
			{
				"subject": "relayError",
				"name": "Retain the missing error field when its value is omitted",
				"call": "await projectResponse(relayError(404))",
				"input": [404],
				"expected": {
					"kind": "value",
					"value": {
						"status": 404,
						"headers": {
							"cache-control": "no-store",
							"content-type": "application/json",
							"x-content-type-options": "nosniff"
						},
						"raw": "{}",
						"body": {}
					}
				}
			},
			{
				"subject": "relayError",
				"name": "Reject a null failure status",
				"call": "await projectResponse(relayError(null, \"not-found\"))",
				"input": [null, "not-found"],
				"expected": {
					"kind": "error",
					"value": "init[\"status\"] must be in the range of 200 to 599, inclusive."
				}
			},
			{
				"subject": "relayError",
				"name": "Retain default failure headers for null extra headers",
				"call": "await projectResponse(relayError(404, \"not-found\", null))",
				"input": [404, "not-found", null],
				"expected": {
					"kind": "value",
					"value": {
						"status": 404,
						"headers": {
							"cache-control": "no-store",
							"content-type": "application/json",
							"x-content-type-options": "nosniff"
						},
						"raw": "{\"error\":\"not-found\"}",
						"body": {
							"error": "not-found"
						}
					}
				}
			}
		],
		"states": ["input", "boundary", "invalid"],
		"props": ["status", "body", "error", "headers"],
