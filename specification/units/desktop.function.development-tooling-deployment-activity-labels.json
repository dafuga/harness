		"outputs": [
			{
				"name": "standingFailures",
				"type": "number",
				"description": "The number of failed deployments that stand: a failed deployment is not counted when an earlier-listed, newer deployment has the same projectId and environment, whatever that newer deployment's phase.",
				"examples": [1, 0]
			},
			{
				"name": "activitySummary",
				"type": "string",
				"description": "The summary label: 'No active deployments' when the active count is 0, '1 active deployment' for exactly 1 and 'N active deployments' otherwise. ' · N failed' is appended when the failed count is truthy.",
				"examples": [
					"No active deployments · 1 failed",
					"1 active deployment",
					"2 active deployments"
				]
			},
			{
				"name": "activityLight",
				"type": "DeploymentLight",
				"description": "The light for the whole activity: 'active' while any deployment is under way, otherwise 'failed' while a failure stands, otherwise 'recent' once any deployment is listed and 'idle' when none is. It never returns 'queued'.",
				"examples": ["active", "failed", "recent"]
			},
			{
				"name": "phaseLabel",
				"type": "string",
				"description": "The phase text: 'Queued' while queued and 'Deployed' once complete, whatever the step. For a failed deployment it is 'Failed at <step title>' when the step matches an entry in steps, and 'Failed' otherwise; for any other phase it is the title of the matching step, or 'Starting' when none matches.",
				"examples": ["Build source", "Failed at Deploy to Cloudflare"]
			},
			{
				"name": "itemLight",
				"type": "DeploymentLight",
				"description": "The light for one deployment's list row: 'queued' for queued, 'failed' for failed, 'recent' for complete, and 'active' for every other phase.",
				"examples": ["queued", "active", "recent"]
			}
		],
