			},
			{
				"name": "activitySummary.failed",
				"type": "number",
				"required": true,
				"description": "The number of failed deployments that still stand, as the caller supplies it (standingFailures counts the same thing). Any truthy value appends ' · N failed' to the summary, so 0 leaves the failure part out.",
				"examples": [0, 1]
			},
			{
				"name": "activityLight.activeCount",
				"type": "number",
				"required": true,
				"description": "The number of deployments under way, as the caller counts them; any non-zero value makes the light 'active', and the function does not check their phases.",
				"examples": [0, 2]
			},
			{
				"name": "activityLight.failed",
				"type": "number",
				"required": true,
				"description": "The number of failed deployments that still stand, as the caller supplies it; it matters only when nothing is under way, because any non-zero value then makes the light 'failed'.",
