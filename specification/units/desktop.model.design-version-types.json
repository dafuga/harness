{
	"schemaVersion": 1,
	"id": "desktop.model.design-version-types",
	"kind": "model",
	"title": "DesignVersion",
	"responsibility": "Owns desktop design version and option models.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/models/DesignVersion.types.ts",
			"packages/desktop/src/models/planning-collaboration/DesignVersion.types.ts"
		],
		"symbols": ["DesignImage", "DesignOptionInfo", "DesignRevision", "DesignVersion"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [],
		"outputs": [
			{
				"name": "DesignImage",
				"type": "{file:string,state:string,viewport:string,sha256:string,bytes:number,option?:string}",
				"description": "file is the exact committed relative image filename for this version; bytes is size metadata, and option identifies the stored design choice."
			},
			{
				"name": "DesignOptionInfo",
				"type": "{id:string,direction:string,prompt:string|null,revisedPrompt:string|null,generator:string,imageHashes:string[]}",
				"description": "Option ids o1 through o10; no preferred field is declared."
			},
			{
				"name": "DesignRevision",
				"type": "{version:string,imageSha256:string,option?:string,region:Region|null,threadId:string|null}"
			},
			{
				"name": "DesignVersion",
				"type": "{version:string,createdAt:string,commit:string|null,generator:string,prompt:string,notes?:string,baseRevision:string,images:DesignImage[],approval:ApprovalInfo|null,options?:DesignOptionInfo[],revises?:DesignRevision|null}",
				"description": "Images preserve each exact committed file path and option binding; optioned versions expose alternatives but no preferred or selected field."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.model.desktop-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/models/planning-collaboration/DesignVersion.types.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/models/planning-collaboration/DesignVersion.types.ts"
			}
		]
	},
	"scenarios": ["hosted-design-options"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
