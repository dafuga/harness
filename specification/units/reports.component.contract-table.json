		"inputs": [
			{
				"name": "ContractTable.group",
				"type": "ContractGroup",
				"required": true,
				"description": "Named parameter, return or component fields with types and authored or illustrative examples."
			},
			{
				"name": "ContractTable.plain",
				"type": "boolean",
				"required": false,
				"default": false,
				"description": "Optional compact labels beneath a callable heading."
			},
			{
				"name": "ContractTable.onexample",
				"type": "(field: ContractField, opener: HTMLButtonElement) => void",
				"required": true,
				"description": "Open the existing example modal and retain its focus return target."
			}
		],
		"outputs": [
			{
				"name": "ContractTable",
				"type": "markup",
				"description": "A field table with unbroken names and types, clipped long examples and keyboard-accessible detail controls; wider tables scroll within their frame and return tables omit names."
			}
		],
		"errors": [
			{
				"name": "onexample callback error",
				"type": "thrown",
				"description": "An error from the example callback propagates when a field's example button is activated."
