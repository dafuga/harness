{
	"schemaVersion": 1,
	"id": "reports.component.harness-entity-artifact",
	"kind": "component",
	"title": "Entity artifact",
	"responsibility": "Shows verified recorded result contents and a link to the original artifact.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.entity-cases",
			"reports.component.harness-harness-verdict",
