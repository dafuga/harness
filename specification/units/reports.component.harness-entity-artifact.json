{
	"schemaVersion": 1,
	"id": "reports.component.harness-entity-artifact",
	"kind": "component",
	"title": "Entity artifact",
	"responsibility": "Shows verified recorded result contents and a link to the original artifact.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.entity-cases",
			"reports.component.harness-harness-verdict",
			"reports.component.shared-primitives-atoms-html-a",
			"reports.component.shared-primitives-atoms-html-dd",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-dl",
			"reports.component.shared-primitives-atoms-html-dt",
			"reports.component.shared-primitives-atoms-html-h4",
			"reports.component.shared-primitives-atoms-html-li",
			"reports.component.shared-primitives-atoms-html-ol",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-pre",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.shared-primitives-atoms-html-ul"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/EntityArtifact.svelte"],
		"symbols": ["EntityArtifact", "EntityArtifact.recorded"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityArtifact.cell",
				"type": "BehaviorCell",
				"required": true,
				"description": "Required result cell with capture and read state. Missing capture or null media produces a gap; details require a verified read."
			},
			{
				"name": "EntityArtifact.label",
				"type": "string",
				"required": true,
				"description": "Required accessible group name, also naming the original-file link."
			},
			{
				"name": "EntityArtifact.mediaBase",
				"type": "string",
				"required": true,
				"description": "Required prefix joined with the capture’s media path for the original-file link."
			},
			{
				"name": "EntityArtifact.lost",
				"type": "boolean",
				"required": false,
				"default": false,
				"description": "Optional flag, false by default. True turns an absent read into an unverified state instead of pending."
			},
			{
				"name": "EntityArtifact.unit",
				"type": "string",
				"required": false,
				"description": "Optional function identifier limiting direct-call rows; absent uses general recorded-case presentation. Defaults to JavaScript undefined (omitted), not the literal string."
			}
		],
		"outputs": [
			{
				"name": "EntityArtifact",
				"type": "markup",
				"description": "Recorded cases plus expandable assertions, facts, steps, trace and other content after verification. Steps and assertion rows share consistent spacing. Unknown assertions stay Not stated. Formatted values are shortened after 12,000 characters with a file-opening reminder. Raw JSON is inserted only while expanded. A stored capture always gets an original-file link, including while pending or unverified."
			}
		],
		"errors": [],
		"errorStatus": "none-found",
		"operations": [],
		"initialization": [],
		"snippets": [
			{
				"name": "EntityArtifact.recorded",
				"inputs": [
					{
						"name": "EntityArtifact.recorded.run",
						"type": "ExplorerArtifactBehavior",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "EntityArtifact.recorded",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			}
		]
	},
