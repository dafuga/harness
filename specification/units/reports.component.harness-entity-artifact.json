			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-summary",
			"reports.component.shared-primitives-atoms-html-ul"
		]
	},
	"owns": {
		"source": ["packages/reports/src/components/explorer-ui/EntityArtifact.svelte"],
		"symbols": ["EntityArtifact"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "EntityArtifact.cell",
				"type": "BehaviorCell",
				"description": "Required result cell with capture and read state. Missing capture or null media produces a gap; details require a verified read."
			},
			{
				"name": "EntityArtifact.label",
				"type": "string",
				"description": "Required accessible group name, also naming the original-file link."
			},
			{
				"name": "EntityArtifact.mediaBase",
				"type": "string",
				"description": "Required prefix joined with the capture’s media path for the original-file link."
			},
			{
				"name": "EntityArtifact.lost",
				"type": "boolean",
				"description": "Optional flag, false by default. True turns an absent read into an unverified state instead of pending."
			},
			{
				"name": "EntityArtifact.unit",
				"type": "string",
				"description": "Optional function identifier limiting direct-call rows; absent uses general recorded-case presentation."
			}
		],
		"outputs": [
			{
				"name": "EntityArtifact",
				"type": "markup",
				"description": "Recorded cases plus expandable assertions, facts, steps, trace and other content after verification. Unknown assertions stay Not stated. Formatted values are shortened after 12,000 characters with a file-opening reminder. Raw JSON is inserted only while expanded. A stored capture always gets an original-file link, including while pending or unverified."
			}
		],
		"errors": []
	},
