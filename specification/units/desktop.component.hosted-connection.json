	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "HostedConnection.workspace",
				"type": "Workspace",
				"description": "Workspace used once to create connection state. Loads that state on mount and disposes it on unmount; the connection store owns endpoint and session operations."
			},
			{
				"name": "HostedConnection.compact",
				"type": "boolean",
				"description": "Optional compact styling flag, false by default; does not change the available connection actions."
			}
		],
		"outputs": [
			{
				"name": "HostedConnection",
				"type": "markup",
				"description": "Renders when support and status exist. Shows not-configured guidance, signed-in identity with Disconnect, or browser sign-in code with expiry/waiting text and Cancel. Shows only the store-approved address, otherwise an invalid-address alert. Other states offer Connect shared projects. Busy disables actions; store errors are alerts."
			}
		],
