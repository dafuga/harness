{
	"schemaVersion": 1,
	"id": "service.catalog-write",
	"kind": "service",
	"title": "CatalogWriteService",
	"responsibility": "Atomically projects revision snapshots into SQLite, preserving entity metadata and distinct dependency relations.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/services/git-source-history/CatalogWriteService.ts",
			"src/services/git-source-history/CatalogWriteService.types.ts"
		],
		"symbols": [
			"CatalogWriteService",
