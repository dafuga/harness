			"CatalogWriteService.replace",
			"CatalogSnapshot",
			"CatalogSnapshot"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "CatalogWriteService.constructor.adapter",
				"type": "SqliteAdapter",
				"description": "Transactional database adapter for replacing the derived catalog tables."
			},
			{
				"name": "CatalogWriteService.replace.index",
				"type": "HistoryIndex",
				"description": "History branches, revisions, records and metadata to project."
			},
			{
				"name": "CatalogWriteService.replace.snapshots",
				"type": "CatalogSnapshot[]",
				"description": "Revision registries retained verbatim; identical target and relation pairs share one query edge."
			}
		],
		"outputs": [
			{
				"name": "CatalogWriteService.replace",
				"type": "void",
				"description": "Replaces catalog tables atomically; repeated dependency keys do not discard raw provenance or distinct relation types."
			}
		],
		"errors": []
	},
