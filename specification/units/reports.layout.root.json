{
	"schemaVersion": 1,
	"id": "reports.layout.root",
	"kind": "layout",
	"title": "Reports root layout",
	"responsibility": "Applies report styles and renders the current page with the explorer chat where available.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "layout",
		"uses": ["reports.component.console-chat"]
	},
	"catalog": {
		"visibility": "internal"
	},
	"owns": {
		"source": ["packages/reports/src/routes/+layout.svelte"],
		"symbols": ["+layout"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "+layout.children",
				"type": "import('svelte').Snippet",
				"description": "Page content rendered through the layout children snippet."
			}
		],
		"outputs": [
			{
				"name": "+layout",
				"type": "markup",
				"description": "Rendered child page with the shared styles and session context."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "reports.component.console-chat",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.style.base",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.style.base-2",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.style.base-3",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.style.gallery",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.style.gallery-2",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/routes/+layout.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/routes/+layout.svelte"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
