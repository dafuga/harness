{
	"schemaVersion": 1,
	"id": "reports.component.filter-dialog",
	"kind": "component",
	"title": "Catalog filters",
	"responsibility": "Opens catalog filters and sorting from one compact icon.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": ["reports.component.harness-harness-icon", "reports.component.modal"]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/FilterDialog.svelte",
			"packages/reports/src/components/shared-primitives/FilterDialog.svelte"
		],
		"symbols": ["FilterDialog", "FilterDialog", "FilterDialog.footer"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "FilterDialog.active",
				"type": "number",
				"required": false,
				"default": 0,
				"description": "Optional number of nondefault filter and sort choices. Defaults to 0, highlights the icon and excludes local search."
			},
			{
				"name": "FilterDialog.onreset",
				"type": "() => void",
				"required": true,
				"description": "Restores default filter and sort choices while preserving the local search query."
			},
			{
				"name": "FilterDialog.children",
				"type": "Snippet",
				"required": true,
				"description": "The catalog’s existing filter controls, rendered inside the dialog."
			}
		],
		"outputs": [
			{
				"name": "FilterDialog",
				"type": "markup",
				"description": "One icon opens a Filters modal. Done, Escape and backdrop close it and restore focus to the icon. Reset invokes the supplied callback."
			}
		],
		"errors": [],
		"operations": [],
		"initialization": [],
		"snippets": [
			{
				"name": "FilterDialog.footer",
				"inputs": [],
				"outputs": [
					{
						"name": "FilterDialog.footer",
						"type": "markup"
					}
				],
				"errors": [],
				"errorStatus": "none-found"
			}
		]
	},
	"dependencies": [
		{
			"unit": "reports.component.harness-harness-icon",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.modal",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/components/shared-primitives/FilterDialog.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/components/shared-primitives/FilterDialog.svelte"
			}
		]
	},
	"scenarios": ["harness-console"],
	"preview": {
		"scenario": "component-catalog-previews",
		"state": "reports-component-filter-dialog",
		"viewport": "desktop"
	},
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
