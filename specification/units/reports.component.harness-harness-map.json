{
	"schemaVersion": 1,
	"id": "reports.component.harness-harness-map",
	"kind": "component",
	"title": "Unit dependency map",
	"responsibility": "Lets users inspect, search and select units in a dependency diagram or list.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "molecule",
