	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/harness-map/HarnessMap.svelte",
			"packages/reports/src/components/explorer-ui/harness-map/mapUnitLabel.ts"
		],
		"symbols": ["HarnessMap", "markLabels", "mapUnitLabel"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "HarnessMap.units",
				"type": "HarnessUnit[]",
				"description": "Required units supplying diagram nodes, dependencies and searchable identifiers, kinds and responsibilities."
			},
			{
				"name": "HarnessMap.marks",
				"type": "Map<string, HarnessMark>",
				"description": "Optional map of added, removed, directly changed or indirectly affected units, defaulting to an empty map. Marks add styling and a legend."
			},
			{
				"name": "HarnessMap.selected",
				"type": "string | null",
				"description": "Optional selected unit identifier, defaulting to null. Highlights its neighborhood and controls relevant dependency edges."
			},
			{
				"name": "HarnessMap.onselect",
				"type": "(id: string) => void",
				"description": "Required callback invoked when a diagram node or list entry is selected."
			}
		],
		"outputs": [
			{
				"name": "HarnessMap",
				"type": "markup",
				"description": "Searchable dependency diagram with pan, pinch, zoom and fit controls, plus a sorted unit list. Search dims unmatched nodes; arrow keys move among nodes and Enter or Space selects. Long displayed identifiers are shortened without changing the identifiers passed to callbacks."
			}
		],
		"errors": []
	},
