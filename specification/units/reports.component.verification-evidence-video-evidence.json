	},
	"owns": {
		"source": [
			"packages/reports/src/components/verification-evidence/VideoEvidence.svelte",
			"packages/reports/src/components/verification-evidence/VideoEvidence.types.ts",
			"packages/reports/src/components/verification-evidence/video-evidence/videoEvidence.css",
			"packages/reports/src/components/verification-evidence/video-evidence/videoFeedback.ts",
			"packages/reports/src/components/verification-evidence/video-evidence/videoProvenance.ts"
		],
		"symbols": [
			"VideoEvidence",
			"VideoEvidenceProps",
			"loadVideoFlags",
			"submitVideoFlag",
			"videoProvenance"
		]
	},
	"contract": {
		"origin": "declared",
		"primitives": ["reports.component.harness-harness-verdict"],
		"inputs": [
			{
				"name": "VideoEvidence.item",
				"type": "Evidence",
				"required": true,
				"description": "Retained video evidence with original clip identity, viewport, optional poster URL and selected revision. Missing files show an explicit gap."
			},
			{
				"name": "VideoEvidence.assetBase",
				"type": "string",
				"required": true,
				"description": "Prefix for relative clip and poster URLs; absolute and data URLs are used unchanged."
			},
			{
				"name": "VideoEvidence.initialFlags",
				"type": "FrameFlag[]",
				"required": false,
				"default": [],
				"description": "Optional initial frame feedback shown before the owner-protected list request completes; defaults to an empty list."
			},
			{
				"name": "VideoEvidence.playbackOnly",
				"type": "boolean",
				"required": false,
				"default": false
			},
			{
				"name": "VideoEvidence.metadata",
				"type": "Snippet",
				"required": false,
				"default": "undefined (omitted)"
			}
		],
		"outputs": [
			{
				"name": "VideoEvidence",
				"type": "markup",
				"description": "User-controlled video, frame timeline, active, stale and resolved feedback markers, note submission and original provenance; no autoplay. Catalog input and outcome checks cover empty-asset-base, without-initial-flags, with-initial-flags, initial-flags-none, initial-flags-one, initial-flags-many, failed, error, empty, none, one, many. Selecting a frame shows that exact decoded frame despite browser timestamp rounding, and retained frame images preserve their intrinsic aspect ratio."
			}
		],
		"errors": [
			{
				"name": "FrameFeedbackFailure",
				"type": "FrameFeedbackFailure { message: string }",
				"description": "Failed feedback requests and invalid response shapes become visible alerts; playback errors show a download explanation."
			}
		],
		"errorStatus": "declared",
		"operations": [
			{
				"name": "loadVideoFlags",
				"inputs": [
					{
						"name": "loadVideoFlags.video",
						"type": "EvidenceVideo",
						"required": true,
						"description": "Video supplied to loadVideoFlags under its declared EvidenceVideo contract."
					},
					{
						"name": "loadVideoFlags.signal",
						"type": "AbortSignal",
						"required": true,
						"description": "Signal supplied to loadVideoFlags under its declared AbortSignal contract."
					}
				],
				"outputs": [
					{
						"name": "loadVideoFlags",
						"type": "Promise<FrameFlag[]>",
						"description": "The Promise<FrameFlag[]> result of loadVideoFlags; it retains the declared source and evidence bindings where applicable."
					}
				],
				"errors": [
					{
						"name": "FrameFeedbackFailure",
						"type": "FrameFeedbackFailure { message: string }",
						"description": "Rejects failed HTTP requests or a response without a flags array; the player displays the error."
					}
				],
				"errorStatus": "declared"
			},
			{
				"name": "submitVideoFlag",
				"inputs": [
					{
						"name": "submitVideoFlag.video",
						"type": "EvidenceVideo",
						"required": true,
						"description": "Video supplied to submitVideoFlag under its declared EvidenceVideo contract."
					},
					{
						"name": "submitVideoFlag.frameNumber",
						"type": "number",
						"required": true,
						"description": "Zero-based decoded frame index within the retained clip interval."
					},
					{
						"name": "submitVideoFlag.note",
						"type": "string",
						"required": true,
						"description": "Note supplied to submitVideoFlag under its declared string contract."
					},
					{
						"name": "submitVideoFlag.signal",
						"type": "AbortSignal",
						"required": true,
						"description": "Signal supplied to submitVideoFlag under its declared AbortSignal contract."
					}
				],
				"outputs": [
					{
						"name": "submitVideoFlag",
						"type": "Promise<FrameFlag>",
						"description": "The Promise<FrameFlag> result of submitVideoFlag; it retains the declared source and evidence bindings where applicable."
					}
				],
				"errors": [
					{
						"name": "FrameFeedbackFailure",
						"type": "FrameFeedbackFailure { message: string }",
						"description": "Rejects absent references, failed HTTP requests or a response without a saved flag; the player displays the error."
					}
				],
				"errorStatus": "declared"
			},
			{
				"name": "videoProvenance",
				"inputs": [
					{
						"name": "videoProvenance.item",
						"type": "Evidence",
						"required": true
					}
				],
				"outputs": [
					{
						"name": "videoProvenance",
						"type": "Evidence"
					}
				],
				"errors": [],
				"errorStatus": "unknown"
			}
		],
		"initialization": []
	},
