	"id": "reports.component.verification-evidence-video-evidence",
	"uid": "u_ytdcym5zkw",
	"kind": "component",
	"title": "VideoEvidence",
	"responsibility": "Plays one retained video clip and lets reviewers seek, flag and inspect exact frame feedback.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.evidence-provenance",
			"reports.component.harness-harness-verdict",
