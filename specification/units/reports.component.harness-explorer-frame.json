{
	"schemaVersion": 1,
	"id": "reports.component.harness-explorer-frame",
	"kind": "component",
	"title": "ExplorerFrame",
	"responsibility": "Draws the root of an explorer screen with its styles, and says that a revision has no registry instead of drawing the screen.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"reports.component.harness-entity-missing",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.source-dialog"
		]
	},
	"owns": {
		"source": [
			"packages/reports/src/components/explorer-ui/ExplorerFrame.svelte",
			"packages/reports/src/components/explorer-ui/ExplorerFrame.types.ts"
		],
		"symbols": ["ExplorerFrame", "Opened"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ExplorerFrame.host",
				"type": "ExplorerScreenProps",
				"description": "Everything the host gives a screen: the shown revision, address, entities and its answers."
			},
			{
				"name": "ExplorerFrame.children",
				"type": "Snippet<[EntityNav]>",
				"description": "The screen to draw inside."
			},
			{
				"name": "ExplorerFrame.registryRequired",
				"type": "boolean | undefined",
				"description": "Defaults to true. Platform configuration can be read without a unit registry."
			}
		],
		"outputs": [
			{
				"name": "ExplorerFrame.screenRoot",
				"type": "markup",
				"description": "The root of a screen with the styles of the explorer."
			}
		],
		"errors": [
			{
				"name": "no-registry",
				"type": "stated",
				"description": "A revision that stores no unit registry says so; nothing of another revision is shown."
			}
		]
	},
	"dependencies": [
		{
			"unit": "reports.component.harness-entity-missing",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.shared-primitives-atoms-html-div",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.source-dialog",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.function.entity-lens",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.explorer-screen-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.model.explorer-types",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.store.source-reader",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.style.entity",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.style.entity-evidence",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.style.entity-history",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.style.entity-index",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.style.entity-summary",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/components/explorer-ui/ExplorerFrame.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/components/explorer-ui/ExplorerFrame.svelte"
			}
		]
	},
	"scenarios": [],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
