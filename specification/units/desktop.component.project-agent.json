{
	"schemaVersion": 1,
	"id": "desktop.component.project-agent",
	"kind": "component",
	"title": "Project chat",
	"responsibility": "Keeps project chat available on every screen and links discussed or changed units to their commit history.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/components/ProjectAgent.svelte",
			"packages/desktop/src/components/agents-providers/ProjectAgent.svelte"
		],
		"symbols": ["ProjectAgent", "ProjectAgent"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ProjectAgent.workspace",
				"type": "Workspace",
				"description": "The selected project, revision, permissions, bridge and navigation. Conversation state stays with this project as its screens change."
			}
		],
		"outputs": [
			{
				"name": "ProjectAgent",
				"type": "markup",
				"description": "A persistent round chat bubble and conversation panel. Read users browse; Comment users leave comments; Write users can choose a model and ask, plan or change at a writable branch tip. Registered unit references open their history."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.component.agents-providers-chat-agents",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.composer",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.component.reference-text",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.function.compose-modes",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.project-agent",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "desktop.store.workspace",
			"via": "import",
			"origin": "derived"
		},
		{
			"unit": "reports.component.floating-chat",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/components/agents-providers/ProjectAgent.svelte",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/components/agents-providers/ProjectAgent.svelte"
			}
		]
	},
	"scenarios": ["agent-creation", "agent-references"],
	"budgets": {
		"size": "frozen",
		"complexity": "frozen",
		"performance": []
	}
}
