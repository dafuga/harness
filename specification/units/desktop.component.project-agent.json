			}
		],
		"outputs": [
			{
				"name": "ProjectAgent",
				"type": "markup",
				"description": "Markup for a FloatingChat project panel with Chat and Agents views, chat history, status, error and draft elements, and a Composer; the launcher label depends on whether the agent is allowed. Message state, permissions, provider discovery and agent actions are supplied by the project-agent store or child components."
