{
	"schemaVersion": 1,
	"id": "desktop.component.project-agent",
	"kind": "component",
	"title": "Project chat",
	"responsibility": "Provide one project conversation with shared Chat, Work and Agents views and live committed work progress.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"composition": {
		"level": "organism",
		"uses": [
			"desktop.component.agents-providers-chat-agents",
			"desktop.component.agents-providers-project-work",
			"desktop.component.composer",
			"desktop.component.reference-text",
			"reports.component.floating-chat",
			"reports.component.shared-primitives-atoms-html-button",
			"reports.component.shared-primitives-atoms-html-details",
			"reports.component.shared-primitives-atoms-html-div",
			"reports.component.shared-primitives-atoms-html-li",
			"reports.component.shared-primitives-atoms-html-ol",
			"reports.component.shared-primitives-atoms-html-p",
			"reports.component.shared-primitives-atoms-html-small",
			"reports.component.shared-primitives-atoms-html-span",
			"reports.component.shared-primitives-atoms-html-summary"
		]
	},
	"owns": {
		"source": [
			"packages/desktop/src/components/ProjectAgent.svelte",
			"packages/desktop/src/components/agents-providers/ProjectAgent.svelte",
			"packages/desktop/src/components/agents-providers/project-agent/projectAgent.css"
		],
		"symbols": ["ProjectAgent", "ProjectAgent"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "ProjectAgent.workspace",
				"type": "Workspace",
				"description": "Selected project, revision, permissions, bridge and navigation."
			},
			{
				"name": "ProjectAgent.open",
				"type": "boolean | undefined",
				"description": "Optional bindable open state, false by default."
			}
		],
		"outputs": [
			{
				"name": "ProjectAgent",
				"type": "markup",
				"description": "Chat and Work share one selected-project committed work snapshot. Chat includes a compact task summary with colored to-do, in-progress, completed and failed dots and counts. Work exposes page choices, wanted contracts, digest-bound selection and explicit approval. Plans use committed Harness contracts and metadata; no implementation task is admitted before approval. Polling runs only while the panel is open and cleans up. Existing conversation and access rules remain in force."
			}
		],
		"errors": [
			{
				"name": "work unavailable",
				"type": "visible error",
				"description": "Shows committed stale data with a stale marker or an unavailable message; never fabricates progress."
			}
		]
	},
