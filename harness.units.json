{
	"schemaVersion": 1,
	"workspaces": [
		{
			"name": "",
			"root": "."
		},
		{
			"name": "reports",
			"root": "packages/reports"
		},
		{
			"name": "planning",
			"root": "packages/planning"
		},
		{
			"name": "desktop",
			"root": "packages/desktop"
		},
		{
			"name": "collaboration",
			"root": "packages/collaboration"
		},
		{
			"name": "hub",
			"root": "packages/hub"
		},
		{
			"name": "remote",
			"root": "packages/remote"
		},
		{
			"name": "relay",
			"root": "packages/relay"
		}
	],
	"tests": ["test/", "tests/"],
	"global": ["**/.prettierignore", "tsconfig.api.json", "specification/measurements/"],
	"ignored": [
		"**/*.md",
		"specification/features/",
		"specification/loops/",
		"**/.gitignore",
		"**/src/pages/*/plan.json",
		"**/src/pages/*/.gitattributes",
		"**/src/pages/*/designs/**/*",
		"**/src/pages/*/threads/**/*",
		"**/src/components/*/plan.json",
		"**/src/components/*/.gitattributes",
		"**/src/components/*/designs/**/*",
		"**/src/components/*/threads/**/*",
		"**/src/functions/*/plan.json",
		"**/src/functions/*/.gitattributes",
		"**/src/functions/*/designs/**/*",
		"**/src/functions/*/threads/**/*",
		"**/src/services/*/plan.json",
		"**/src/services/*/.gitattributes",
		"**/src/services/*/designs/**/*",
		"**/src/services/*/threads/**/*",
		"**/src/configs/*/plan.json",
		"**/src/configs/*/.gitattributes",
		"**/src/configs/*/designs/**/*",
		"**/src/configs/*/threads/**/*"
	],
	"references": [
		{
			"from": "src/utils/kernelArtifacts.ts",
			"specifier": "./kernel/",
			"external": "kernel-build",
			"reason": "Built kernel beside the bundled CLI; the dependency on kernel.impact-kernel is declared on the unit."
		},
		{
			"from": "src/utils/kernelArtifacts.ts",
			"specifier": "../kernel/",
			"external": "kernel-build",
			"reason": "Built kernel beside the bundled public API; the dependency on kernel.impact-kernel is declared on the unit."
		},
		{
			"from": "src/utils/kernelArtifacts.ts",
			"specifier": "../../target/kernel/",
			"external": "kernel-build",
			"reason": "Built kernel in a source checkout; the dependency on kernel.impact-kernel is declared on the unit."
		},
		{
			"from": "packages/reports/src/utils/e2eFixtures.ts",
			"specifier": "../../../../.cache/reports-e2e/",
			"external": "browser-run-build",
			"reason": "Where a browser run keeps its copy of the finished build: a generated directory in the checkout cache, never source."
		},
		{
			"from": "packages/hub/src/components/HostedWorkspace.svelte",
			"specifier": "$desktop/components/WorkspaceShell.svelte",
			"to": "packages/desktop/src/components/WorkspaceShell.svelte",
			"reason": "The hub's build alias $desktop is packages/desktop/src: the Web workspace renders the very shell the Electron and iOS workspace renders."
		},
		{
			"from": "packages/hub/src/components/HostedWorkspace.svelte",
			"specifier": "$desktop/lib/stores/workspace.svelte",
			"to": "packages/desktop/src/lib/stores/workspace.svelte.ts",
			"reason": "The hub's build alias $desktop is packages/desktop/src: the Web workspace keeps its state in the same workspace store."
		},
		{
			"from": "packages/hub/src/components/HostedWorkspace.svelte",
			"specifier": "$desktop/utils/workspaceRoute",
			"to": "packages/desktop/src/utils/workspaceRoute.ts",
			"reason": "The hub's build alias $desktop is packages/desktop/src: the Web workspace reads the same workspace addresses."
		}
	]
}
