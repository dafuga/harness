	"tools": [
		{
			"id": "node",
			"command": "node --version"
		},
		{
			"id": "git",
			"command": "git --version"
		},
		{
			"id": "git-lfs",
			"command": "git lfs version"
		},
		{
			"id": "cargo",
			"command": "bun scripts/rust.ts cargo --version"
		},
		{
			"id": "rustc",
			"command": "bun scripts/rust.ts rustc --version"
		},
		{
			"id": "playwright",
			"command": "bun x playwright --version"
		},
		{
			"id": "chromium",
			"command": "node -e \"const fs=require('node:fs');const found=JSON.parse(fs.readFileSync('node_modules/playwright-core/browsers.json','utf8')).browsers.find((browser)=>browser.name==='chromium');console.log('chromium '+found.browserVersion+' revision '+found.revision)\""
		},
		{
			"id": "wrangler",
			"command": "XDG_CONFIG_HOME=.cache/wrangler WRANGLER_SEND_METRICS=false bun x wrangler --version"
		}
	],
	"timeouts": {
		"test": 600000
	},
	"builds": [
