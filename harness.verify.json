{
	"schemaVersion": 1,
	"setup": [
		{
			"command": "bun install --frozen-lockfile --backend=copyfile",
			"timeoutMs": 600000
		},
		{
			"command": "bun run build",
			"timeoutMs": 1200000
		},
		{
			"command": "bun run --cwd packages/reports build:shell",
			"timeoutMs": 300000
		},
		{
			"command": "cd packages/reports && ENTITY_PREVIEW_HOME=output/entity-preview bun -e \"import setup from './test/entityPreviewSetup'; await setup()\"",
			"timeoutMs": 300000
		},
		{
			"command": "bun run build:desktop",
			"timeoutMs": 600000
		},
		{
			"command": "bun src/index.ts verify stamp packages/desktop/build",
			"timeoutMs": 60000
		},
		{
			"command": "bun run --cwd packages/desktop cap copy ios",
			"timeoutMs": 120000
		}
	],
	"link": ["node_modules"],
	"outputs": [
		".cache/",
		"coverage/",
		"dist/",
		"node_modules/",
		"packages/reports/.cache/",
