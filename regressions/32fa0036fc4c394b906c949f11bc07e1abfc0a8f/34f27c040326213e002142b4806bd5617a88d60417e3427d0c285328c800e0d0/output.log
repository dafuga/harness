  verify:
    name: Verify the exact commit
    # Native evidence comes from Swift, the iOS SDK and a simulator, which exist only on macOS.
    # The full check above stays on Linux; this job runs on Apple silicon.
    runs-on: macos-15
    # Time for the run to end and leave its record: where an uncertain reference widens the
    # impact, every test and scenario is run, one command each, and that took more than an hour.
    # It allows time only; it is no budget and it approves nothing.
    timeout-minutes: 180
    env:
      DEVELOPER_DIR: /Applications/Xcode_26.3.app/Contents/Developer
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ env.COMMIT }}
          fetch-depth: 0
          persist-credentials: false
      - name: Select the pinned Xcode and log what runs
        # The image carries several Xcodes and defaults to another. The job fails when the
        # pinned one is absent. Tools that ask xcode-select and tools that read DEVELOPER_DIR
        # must get the same answer, so the runner's selection is set to it as well.
        run: |
          test \"$(uname -m)\" = arm64
          test -d \"$DEVELOPER_DIR\"
          sudo xcode-select --switch \"$DEVELOPER_DIR\"
          test \"$(xcode-select -p)\" = \"$DEVELOPER_DIR\"
          echo \"DEVELOPER_DIR=$DEVELOPER_DIR\"
          xcodebuild -version
          xcodebuild -version | grep -Fx \"Xcode 26.3\"
          xcodebuild -showsdks
          xcrun --sdk iphonesimulator --show-sdk-version
          xcrun simctl list runtimes
      - name: Install the pinned Bun
        run: npm install --global bun@1.2.18
      - name: Install the pinned Rust toolchain and its Wasm target from rust-toolchain.toml
        run: rustup show
      - name: Install dependencies exactly as locked
        run: bun install --frozen-lockfile
      - name: Install the locked browser
        run: node node_modules/@playwright/test/cli.js install chromium
      - name: Install Git LFS and video dependencies
        env:
          HOMEBREW_NO_AUTO_UPDATE: 1
        run: |
          brew install git-lfs ffmpeg
          git lfs install --local
      - name: Prepare the pinned PDF runtime
        run: |
          python3 -m venv \"$RUNNER_TEMP/harness-pdf\"
          \"$RUNNER_TEMP/harness-pdf/bin/python\" -m pip install reportlab==4.4.9 Pillow==12.3.0 pypdf==6.10.0
          echo \"PROJECT_REPORTS_PYTHON=$RUNNER_TEMP/harness-pdf/bin/python\" >> \"$GITHUB_ENV\"
      - name: Read existing notes, evidence and media
        # Read-only. Without them nothing is proven, and the whole revision is verified.
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          header=\"AUTHORIZATION: basic $(printf 'x-access-token:%s' \"$GH_TOKEN\" | base64 | tr -d '\\n')\"
          git config --local http.https://github.com/.extraheader \"$header\"
          bun run dev -- history fetch origin || echo \"::warning::Existing evidence could not be read.\"
          git config --local --unset-all http.https://github.com/.extraheader
      - name: Verify in a clean snapshot of the commit
        # Performance budgets are judged only against a baseline reviewed for this machine
        # profile. A runner without one fails that gate; it never borrows another profile's
        # baseline and nothing here establishes or approves one.
        id: verify
        continue-on-error: true
        run: bun run dev -- verify run --commit \"$COMMIT\"
      - name: Keep the record and its evidence, pass or fail
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: harness-record
          path: .cache/harness/verifications/${{ env.COMMIT }}
          include-hidden-files: true
          if-no-files-found: error
      - name: Fail when the verification failed
        if: steps.verify.outcome != 'success'
        run: exit 1
