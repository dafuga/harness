{
	"schemaVersion": 1,
	"id": "function.comparison-differences",
	"kind": "function",
	"title": "Measurement comparability",
	"responsibility": "Determines whether a measurement and baseline describe the same quantity and sampling method before their numeric values are compared.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"src/services/budget-service/comparisonDifferences.ts",
			"src/services/verification-evidence/budget-service/comparisonDifferences.ts",
			"src/utils/comparisonDifferences.ts",
			"src/utils/verification-evidence/comparisonDifferences.ts"
		],
		"symbols": [
			"comparisonDifferences",
			"comparisonDifferences",
			"comparisonDifferences",
			"MeasuredDefinition",
			"ComparisonVerdict",
			"comparisonDifferences"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "comparisonDifferences.metric",
				"type": "string",
				"description": "Metric name used to enforce the expected unit for known latency, throughput and memory metrics; custom metrics require matching units."
			},
			{
				"name": "comparisonDifferences.measured",
				"type": "MeasuredDefinition",
				"description": "Current measurement\u2019s unit, method description and comparison context; missing or invalid metadata is reported as incomplete."
			},
			{
				"name": "comparisonDifferences.baseline",
				"type": "MeasuredDefinition",
				"description": "Reviewed baseline\u2019s unit, method description and comparison context."
			}
		],
		"outputs": [
			{
				"name": "comparisonDifferences",
				"type": "ComparisonVerdict",
				"description": "Comparable with no differences when definitions match; incomplete when metadata is missing or invalid; otherwise incompatible with ordered differences for unit, request, boundary, protocol, sampling and method."
			}
		],
		"errors": [
			{
				"name": "incomplete metadata",
				"type": "ComparisonVerdict",
				"description": "Missing, empty or invalid unit, method or comparison context on either side returns status incomplete with each gap in side order. The verdict is returned, not thrown; no difference is computed."
			},
			{
				"name": "incompatible definitions",
				"type": "ComparisonVerdict",
				"description": "A unit, request, boundary, protocol, sampling or method difference, or a known metric's unexpected unit, returns status incompatible with every difference in fixed order. The verdict is returned, not thrown."
			}
		]
	},
	"dependencies": [
		{
			"unit": "function.comparison-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "src/utils/verification-evidence/comparisonDifferences.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "src/utils/verification-evidence/comparisonDifferences.ts"
			}
		]
	},
	"scenarios": [],
	"testing": {
		"version": 1,
		"shape": "helper",
		"states": ["comparable", "incomplete", "incompatible"],
		"props": [
			"metric",
			"unitOfMeasure",
			"method",
			"comparison",
			"comparison.request",
			"comparison.boundary",
			"comparison.protocol",
			"comparison.sampling"
		],
		"examples": [
			{
				"subject": "comparisonDifferences",
				"name": "Identical definitions are comparable",
				"call": "comparisonDifferences(\"latency-floor-ms\", measured, baseline)",
