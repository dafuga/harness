							"request": "5d7a12e7a33893751760c740c01eb411d2db3f9e5a4334789232a934e3e003ff",
							"boundary": "public-invocation",
							"protocol": "harness-rounds/1",
							"sampling": {
								"warmup": 3,
								"rounds": 5,
								"iterations": 30
							}
						}
					},
					{
						"unitOfMeasure": "ms",
						"method": "Fastest call.",
						"comparison": {
							"request": "5d7a12e7a33893751760c740c01eb411d2db3f9e5a4334789232a934e3e003ff",
							"boundary": "public-invocation",
							"protocol": "harness-rounds/1",
							"sampling": {
								"warmup": 3,
								"rounds": 5,
								"iterations": 30
							}
						}
					}
				],
				"expected": {
					"kind": "value",
					"value": {
						"status": "comparable",
						"differences": []
					}
				}
			},
			{
