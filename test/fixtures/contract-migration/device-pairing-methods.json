			{"id": "exchange-initialized", "state": "initialized", "subject": "DevicePairingService.exchange", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "exchange initialized rejects an absent pending pairing"}, "expected": {"kind": "error", "value": "TypeError"}, "props": ["pending"], "errors": ["Error"]},
			{"id": "scanned-requested", "state": "requested", "subject": "DevicePairingService.scanned", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "scanned requested keeps an earlier code from replacing the current offer"}, "expected": {"kind": "value", "value": {"state": "requested", "spentOffer": "refused"}}, "props": ["text", "reading"], "errors": ["Error"]},
			{"id": "request-requested", "state": "requested", "subject": "DevicePairingService.request", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "request requested keeps the host refusal boundary"}, "expected": {"kind": "value", "value": {"requests": 1, "secondRelayRequest": null}}, "props": ["input"]},
			{"id": "poll-requested", "state": "requested", "subject": "DevicePairingService.poll", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "poll requested reports requested"}, "expected": {"kind": "value", "value": {"state": "requested"}}, "props": ["pending"]},
			{"id": "exchange-requested", "state": "requested", "subject": "DevicePairingService.exchange", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "exchange requested refuses before approval"}, "expected": {"kind": "error", "value": "Error"}, "props": ["pending"], "errors": ["Error"]},
			{"id": "scanned-approved", "state": "approved", "subject": "DevicePairingService.scanned", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "scanned approved can start a separate current offer"}, "expected": {"kind": "value", "value": {"state": "requested", "newOffer": "accepted"}}, "props": ["text", "device", "reading"]},
			{"id": "request-approved", "state": "approved", "subject": "DevicePairingService.request", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "request approved can start a separate current offer"}, "expected": {"kind": "value", "value": {"state": "requested", "newOffer": "accepted"}}, "props": ["input"]},
			{"id": "poll-approved", "state": "approved", "subject": "DevicePairingService.poll", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "poll approved reports approved"}, "expected": {"kind": "value", "value": {"state": "approved"}}, "props": ["pending"]},
			{"id": "exchange-approved", "state": "approved", "subject": "DevicePairingService.exchange", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "exchange approved returns credentials once"}, "expected": {"kind": "value", "value": {"credential": "structural remote credential", "key": "approved device key", "reuse": "Error"}}, "props": ["pending", "approval.deviceId", "approval.sealed"], "errors": ["Error"]},
