			{"id": "request-denied", "state": "denied", "subject": "DevicePairingService.request", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "request denied can start a separate current offer"}, "expected": {"kind": "value", "value": {"state": "requested", "newOffer": "accepted"}}, "props": ["input"]},
			{"id": "poll-denied", "state": "denied", "subject": "DevicePairingService.poll", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "poll denied reports denied"}, "expected": {"kind": "value", "value": {"state": "denied"}}, "props": ["pending"]},
			{"id": "exchange-denied", "state": "denied", "subject": "DevicePairingService.exchange", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "exchange denied refuses credentials"}, "expected": {"kind": "error", "value": "Error"}, "props": ["pending"], "errors": ["Error"]},
			{"id": "scanned-exchanged", "state": "exchanged", "subject": "DevicePairingService.scanned", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "scanned exchanged can start a separate current offer"}, "expected": {"kind": "value", "value": {"state": "requested", "newOffer": "accepted"}}, "props": ["text", "device", "reading"]},
			{"id": "request-exchanged", "state": "exchanged", "subject": "DevicePairingService.request", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "request exchanged can start a separate current offer"}, "expected": {"kind": "value", "value": {"state": "requested", "newOffer": "accepted"}}, "props": ["input"]},
			{"id": "poll-exchanged", "state": "exchanged", "subject": "DevicePairingService.poll", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "poll exchanged refuses the consumed pairing"}, "expected": {"kind": "error", "value": "Error"}, "props": ["pending"], "errors": ["Error"]},
			{"id": "exchange-exchanged", "state": "exchanged", "subject": "DevicePairingService.exchange", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "exchange exchanged refuses a second credential"}, "expected": {"kind": "error", "value": "Error"}, "props": ["pending"], "errors": ["Error"]}
		]
