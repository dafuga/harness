		"cases": [
			{"id": "scanned-initialized", "state": "initialized", "subject": "DevicePairingService.scanned", "fixture": "packages/remote/test/support/memoryRelay.ts", "test": {"file": "packages/remote/test/services/device-pairing.test.ts", "title": "scanned initialized accepts a current offer and sends the exact request"}, "expected": {"kind": "value", "value": {"state": "approved", "credential": "structural remote credential", "wire": "sealed request"}}, "props": ["text", "device", "reading"]},
