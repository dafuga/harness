{
	"schemaVersion": 1,
	"id": "reports.function.report-filter",
	"kind": "function",
	"title": "Report and evidence filtering",
	"responsibility": "Classifies viewport sizes and filters report galleries and project lists.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/reports/src/components/evidence-grid/reportFilter.ts",
			"packages/reports/src/components/verification-evidence/evidence-grid/reportFilter.ts",
			"packages/reports/src/utils/reportFilter.ts",
			"packages/reports/src/utils/verification-evidence/reportFilter.ts",
			"packages/reports/src/utils/verification-evidence/reportFilter.types.ts"
		],
		"symbols": [
			"reportFilter",
			"reportFilter",
			"reportFilter",
			"screenSize",
			"galleryEvidence",
			"projectFilter",
			"screenSize",
			"galleryEvidence",
			"projectFilter",
			"reportFilter",
			"ScreenSize",
			"Filters",
			"ScreenSize",
			"Filters"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "screenSize.item",
				"type": "Evidence",
				"description": "Evidence viewport label to classify."
			},
			{
				"name": "galleryEvidence.items",
				"type": "Evidence[]",
				"description": "Evidence items to choose gallery representatives from."
			},
			{
				"name": "galleryEvidence.pairs",
				"type": "unknown",
				"description": "Optional after-to-before audio pair map, defaulting to audioPairs(items)."
			},
			{
				"name": "reportFilter.items",
				"type": "Evidence[]",
				"description": "Evidence items to filter."
			},
			{
				"name": "reportFilter.filter",
				"type": "Filters",
				"description": "Search text and optional exact category, phase and status filters."
			},
			{
				"name": "reportFilter.pairs",
				"type": "ReadonlyMap<string, Evidence>",
				"description": "Optional after-to-before pair map allowing either member to satisfy all filters."
			},
			{
				"name": "projectFilter.run",
				"type": "Report",
				"description": "Report to test for a project-list match."
			},
			{
				"name": "projectFilter.query",
				"type": "string",
				"description": "Case-insensitive text query, not trimmed."
			},
			{
				"name": "projectFilter.project",
				"type": "string",
				"description": "Optional exact project identifier; empty accepts all projects."
			}
		],
		"outputs": [
			{
				"name": "screenSize",
				"type": "ScreenSize",
				"description": "Mobile/tablet/desktop from known words first, otherwise the first numeric width with boundaries at 700 and 1100; other when no positive width is found."
			},
			{
				"name": "galleryEvidence",
				"type": "unknown",
				"description": "All non-before items plus unpaired before-audio items. Paired before audio and all before images are hidden as separate gallery entries."
			},
			{
				"name": "reportFilter",
				"type": "unknown",
				"description": "Matches where either the item or its paired before item satisfies all filters, sorted by order with missing order treated as zero. Search spans title, notes, category, viewport, source and transcript."
			},
			{
				"name": "projectFilter",
				"type": "unknown",
				"description": "True when project selection matches and the lowercased project name, title or summary contains the query."
			}
		],
		"errors": []
	},
	"dependencies": [
		{ "unit": "reports.function.audio-pairs", "via": "import", "origin": "derived" },
		{ "unit": "reports.function.evidence-media", "via": "import", "origin": "derived" },
		{ "unit": "reports.model.report-types", "via": "import", "origin": "derived" }
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/reports/src/utils/verification-evidence/reportFilter.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/reports/src/utils/verification-evidence/reportFilter.ts"
			}
		]
	},
