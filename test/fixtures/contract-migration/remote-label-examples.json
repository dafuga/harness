{
	"schemaVersion": 1,
	"id": "desktop.function.remote-labels",
	"kind": "function",
	"title": "Phone-access wording",
	"responsibility": "Format connection, identity, permission and lock-state wording for phone access.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/desktop/src/components/networking-security/remote-host-panel/remoteLabels.ts",
