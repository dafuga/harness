			"grantLabel"
		]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "relayName.origin",
				"type": "string | null",
				"description": "Relay origin to display; invalid URLs produce an empty label."
			},
			{
				"name": "timeLeft.milliseconds",
				"type": "number",
				"description": "Remaining milliseconds; rounded up to seconds and clamped at zero."
			},
			{
				"name": "keyLabel.deviceId",
				"type": "string",
				"description": "Device ID whose first 12 characters are grouped in fours."
			},
			{
				"name": "identityLabel.deviceId",
				"type": "string",
				"description": "Full device ID to group in fours."
			},
			{
				"name": "grantLabel.grant",
				"type": "{ agents: boolean }",
				"description": "Grant whose agents flag determines permission wording."
			},
			{
				"name": "grantSummary.grant",
				"type": "{ projects: unknown[]; agents: boolean }",
				"description": "Grant containing project list and agents flag."
			},
			{
				"name": "hostLine.status",
				"type": "RemoteHostStatus",
				"description": "Host status used for relay and connection-state wording."
			},
			{
				"name": "hostSummary.status",
				"type": "RemoteHostStatus",
				"description": "Host status used for enabled state and approved-phone count."
			},
			{
				"name": "remoteLabels.status",
				"type": "RemoteNativeStatus",
				"description": "Mobile connection status used for heading and supporting text."
			}
		],
		"outputs": [
			{
				"name": "lockNote",
				"type": "unknown",
				"description": "Explanation that approved phones work while the computer is locked and awake, but not asleep."
			},
			{
				"name": "awakeNote",
				"type": "unknown",
				"description": "Wording for an awake computer."
			},
			{
				"name": "lockedNote",
				"type": "unknown",
				"description": "Wording for a locked, awake computer."
			},
			{
				"name": "unlockedNote",
				"type": "unknown",
				"description": "Wording for an unlocked, awake computer."
			},
			{
				"name": "approveNote",
				"type": "unknown",
				"description": "Instruction to approve the phone on the computer."
			},
			{
				"name": "awayNote",
				"type": "unknown",
				"description": "Explanation that an offline computer is asleep or disconnected and nothing is sent until it returns."
			},
			{
				"name": "revokedNote",
				"type": "unknown",
				"description": "Instruction to pair again after revocation."
			},
			{
				"name": "relayName",
				"type": "string",
				"description": "Relay host and optional port, or an empty string for an invalid URL."
			},
			{
				"name": "timeLeft",
				"type": "string",
				"description": "Minutes and two-digit seconds remaining."
			},
			{
				"name": "keyLabel",
				"type": "string",
				"description": "Short grouped device identifier."
			},
			{
				"name": "identityLabel",
				"type": "string",
				"description": "Full grouped device identifier."
			},
			{
				"name": "grantLabel",
				"type": "string",
				"description": "Plan and Change allowed, or Read and comment only."
			},
			{
				"name": "grantSummary",
				"type": "string",
				"description": "Project count followed by permission wording."
			},
			{
				"name": "hostLine",
				"type": "string",
				"description": "Phone-access-on line with relay and applicable registering, connecting or offline suffix."
			},
			{
				"name": "hostSummary",
				"type": "string",
				"description": "Phone access off, or the approved-phone count."
			},
			{
				"name": "remoteLabels",
				"type": "{ title: string; detail: string }",
				"description": "Heading and supporting text for the mobile state, using host name and lock state where available."
			}
		],
		"errors": []
	},
	"dependencies": [
		{
			"unit": "desktop.model.environment-types",
			"via": "import",
			"origin": "derived"
		}
	],
	"helperContracts": [
		{
			"name": "identityLabel",
			"source": "packages/desktop/src/helpers/networking-security/identityLabel.ts",
			"inputs": [
				{
					"name": "identityLabel.deviceId",
					"type": "string"
				}
			],
			"output": "string",
			"pure": true,
			"examples": [
				{
					"name": "Group a full device identity in fours for comparison",
					"call": "identityLabel(\"4f2a91c07b3edddddddddddddddddddddddddddd\")",
					"input": ["4f2a91c07b3edddddddddddddddddddddddddddd"],
					"output": "4f2a 91c0 7b3e dddd dddd dddd dddd dddd dddd dddd"
				},
				{
					"name": "Leave an empty identity blank",
					"call": "identityLabel(\"\")",
					"input": [""],
					"output": ""
				},
				{
					"name": "Reject a null identity",
					"call": "identityLabel(null)",
					"input": [null],
					"error": "Cannot read properties of null (reading 'match')"
				}
			],
			"consumers": [
				{
					"unit": "desktop.component.remote-approval"
				},
				{
					"unit": "desktop.component.remote-phone-panel"
				}
			]
		},
		{
			"name": "plural",
			"source": "packages/desktop/src/helpers/strings/plural.ts",
			"inputs": [
				{
					"name": "plural.count",
					"type": "number"
				},
				{
					"name": "plural.word",
					"type": "string"
				}
			],
			"output": "unknown",
			"pure": true,
			"examples": [
				{
					"name": "Keep the singular word for one item",
					"call": "plural(1, \"task\")",
					"input": [1, "task"],
					"output": "1 task"
				},
				{
					"name": "Add s for other counts",
					"call": "plural(2, \"task\")",
					"input": [2, "task"],
					"output": "2 tasks"
				}
			],
			"consumers": [
				{
					"unit": "desktop.function.remote-labels",
					"symbol": "grantSummary"
				},
				{
					"unit": "desktop.function.remote-labels",
					"symbol": "hostSummary"
				}
			]
		}
	],
	"runtime": {
		"kind": "module",
		"entry": "packages/desktop/src/utils/networking-security/remoteLabels.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/desktop/src/utils/networking-security/remoteLabels.ts"
			}
		]
	},
	"scenarios": ["remote-mobile-ui"],
