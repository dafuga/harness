			"packages/desktop/src/components/networking-security/remote-phone-panel/remoteLabels.types.ts",
			"packages/desktop/src/components/remote-host-panel/remoteLabels.ts",
			"packages/desktop/src/components/remote-offer-code/remoteLabels.ts",
			"packages/desktop/src/components/remote-phone-panel/remoteLabels.ts",
			"packages/desktop/src/helpers/networking-security/identityLabel.ts",
			"packages/desktop/src/helpers/strings/plural.ts",
			"packages/desktop/src/utils/networking-security/remoteLabels.ts",
			"packages/desktop/src/utils/remoteLabels.ts"
		],
		"symbols": [
			"relayName",
			"hostLine",
			"hostSummary",
			"timeLeft",
			"grantSummary",
			"remoteLabels",
