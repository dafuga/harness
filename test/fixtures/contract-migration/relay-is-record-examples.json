{
	"schemaVersion": 1,
	"id": "relay.function.is-record",
	"kind": "function",
	"title": "Object shape guard",
	"responsibility": "Distinguishes non-null, non-array objects from scalar values.",
	"responsibilityOrigin": "declared",
	"status": "active",
	"owns": {
		"source": [
			"packages/relay/src/utils/development-tooling/isRecord.ts",
			"packages/relay/src/utils/isRecord.ts"
		],
		"symbols": ["isRecord", "isRecord"]
	},
	"contract": {
		"origin": "declared",
		"inputs": [
			{
				"name": "isRecord.value",
				"type": "unknown",
				"description": "Unknown value to inspect."
			}
		],
		"outputs": [
			{
				"name": "isRecord",
				"type": "value is Record<string, unknown>",
				"description": "True for a non-null object that is not an array, narrowing its static type to a string-keyed record."
			}
		],
		"errors": []
	},
	"dependencies": [],
	"runtime": {
		"kind": "module",
		"entry": "packages/relay/src/utils/development-tooling/isRecord.ts",
		"targets": [
			{
				"kind": "module",
				"entry": "packages/relay/src/utils/development-tooling/isRecord.ts"
			}
		]
	},
	"scenarios": ["remote-desktop-boundaries"],
	"testing": {
		"version": 1,
		"shape": "helper",
		"examples": [
			{
				"subject": "isRecord",
				"name": "Accept an empty object",
				"call": "isRecord({})",
				"input": [{}],
				"expected": { "kind": "value", "value": true }
			},
			{
				"subject": "isRecord",
				"name": "Accept an object with JSON fields",
				"call": "isRecord({ type: 'ack', ok: true })",
				"input": [{ "type": "ack", "ok": true }],
				"expected": { "kind": "value", "value": true }
			},
			{
				"subject": "isRecord",
				"name": "Accept an object without a prototype",
				"call": "isRecord(Object.create(null))",
				"input": [{ "$fixture": "null-prototype" }],
				"expected": { "kind": "value", "value": true }
			},
			{
				"subject": "isRecord",
				"name": "Accept an object whose properties include null and an array",
				"call": "isRecord({ value: null, items: [] })",
				"input": [{ "value": null, "items": [] }],
				"expected": { "kind": "value", "value": true }
			},
			{
				"subject": "isRecord",
				"name": "Accept an array-like object that is not an array",
				"call": "isRecord({ length: 0 })",
				"input": [{ "length": 0 }],
				"expected": { "kind": "value", "value": true }
			},
			{
				"subject": "isRecord",
				"name": "Refuse null",
				"call": "isRecord(null)",
				"input": [null],
				"expected": { "kind": "value", "value": false }
			},
			{
				"subject": "isRecord",
				"name": "Refuse undefined",
				"call": "isRecord(undefined)",
				"input": [{ "$fixture": "undefined" }],
				"expected": { "kind": "value", "value": false }
			},
			{
				"subject": "isRecord",
